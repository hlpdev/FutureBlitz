// Tests that end their program, which fb test starts again for the rest: one panics, one fails
// an Assert, and one exits; and one that leaks a cycle of Nodes, which fails it.
Import std.core
Import std.os
Import std.test

Class Node
    Field next: Node?
End Class

@Test
Function Panics()
    Local counts = [1, 2]
    Print(counts[5])
End Function

@Test
Function Asserts()
    Assert(1 + 1 == 3, "arithmetic broke")
End Function

@Test
Function Exits()
    Process.Exit(3)
End Function

@Test
Function Leaks()
    Local node = Node()
    node.next = node
End Function
