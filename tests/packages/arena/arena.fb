// A game's arena over the stand-in engine, whose errors it says as text.

Import std.core
Import engine

Public Class Arena
    Field world: World
    Field drops: Int = 0

    Public New(name: String)
        world = World(name)
    End New

    // A rock falling from `x`, `y`, or -1 where the engine won't have one.
    Public Method Drop(x: Float32, y: Float32): Int32
        Try
            drops += 1
            Return world.Spawn(Shape.Circle, Point(x, y), Point(4.0, -10.0))
        Catch e As EngineError
            Print("no rock: {e.Message}")
            Return -1
        End Try
    End Method

    Public Method Run(seconds: Float32, steps: Int)
        For i = 1 To steps
            world.Step(seconds)
        End For
    End Method

    // Run, for a count of steps that can't be below 0.
    Public Method RunFor(seconds: Float32, steps: Int)
        If steps < 0 Then Panic("{steps} steps")
        Run(seconds, steps)
    End Method

    Public Method Place(body: Int32): String
        Try
            Return "{world.Position(body)}"
        Catch e As EngineError
            Return e.Message
        End Try
    End Method

    Public Method Describe(): String => "{world.Name}: {world.Count} bodies from {drops} drops"

    Field kept: Object?

    // Keeps the program's object of any Class, and gives it back as the one it asks for.
    Public Method Keep(thing: Object?)
        kept = thing
    End Method

    // An Interface's value, as an Object, which this binary's 'As?' tests.
    Public Method KeepShown(thing: Printable)
        kept = thing As? Object
    End Method

    Public Method Kept<T: Class>(): T? => kept As? T

    Public Method KeepsArena(): Bool => kept Is Arena
End Class
