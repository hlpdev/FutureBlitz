CheckBig("9 from 31 upper", BigInt.Parse("-C4OM88OH7OU14UTMBN8JHIQG7BQU4FUOSMAJ0FN563SRSM1LP2DM4ML57D6SO4FCO8JRACIGHQJBSBJRPT63A9JS2N6T58GOUE4U5", 31) ?? BigInt(-424242), "-1663089210313699206838621661005614753621536220188763903055871633492573857176630886859128054037218477627347612843056175825273569862965750464064929983959")
