CheckBig("9 from 36", BigInt.Parse("-6jlnhlwhrw29zd7e0hu1wzeszccq1ngjh6022ca2a4xcd45zrbfifc0fkzghpibidys7ugztpkzdm1e621wffhdd29tufpl1z", 36) ?? BigInt(-424242), "-1663089210313699206838621661005614753621536220188763903055871633492573857176630886859128054037218477627347612843056175825273569862965750464064929983959")
