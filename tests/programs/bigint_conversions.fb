Done("radixes")

CheckBig("parse +5", BigInt.Parse("+5", 10) ?? BigInt(-424242), "5")
CheckBig("parse -0", BigInt.Parse("-0", 10) ?? BigInt(-424242), "0")
CheckBig("parse 000123", BigInt.Parse("000123", 10) ?? BigInt(-424242), "123")
CheckBig("parse -000", BigInt.Parse("-000", 10) ?? BigInt(-424242), "0")
CheckBig("parse zz", BigInt.Parse("zz", 36) ?? BigInt(-424242), "1295")
CheckBig("parse ZZ", BigInt.Parse("ZZ", 36) ?? BigInt(-424242), "1295")
CheckBig("parse -ff", BigInt.Parse("-ff", 16) ?? BigInt(-424242), "-255")
CheckBig("parse 101", BigInt.Parse("101", 2) ?? BigInt(-424242), "5")
CheckBig("parse 999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999", BigInt.Parse("999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999", 10) ?? BigInt(-424242), "999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999")
Expect("parse  in 10", BigInt.Parse("", 10) == Null)
Expect("parse - in 10", BigInt.Parse("-", 10) == Null)
Expect("parse + in 10", BigInt.Parse("+", 10) == Null)
Expect("parse --1 in 10", BigInt.Parse("--1", 10) == Null)
Expect("parse +-1 in 10", BigInt.Parse("+-1", 10) == Null)
Expect("parse 1.0 in 10", BigInt.Parse("1.0", 10) == Null)
Expect("parse  1 in 10", BigInt.Parse(" 1", 10) == Null)
Expect("parse 1  in 10", BigInt.Parse("1 ", 10) == Null)
Expect("parse 1_000 in 10", BigInt.Parse("1_000", 10) == Null)
Expect("parse 0x10 in 16", BigInt.Parse("0x10", 16) == Null)
Expect("parse 12a in 10", BigInt.Parse("12a", 10) == Null)
Expect("parse 1e5 in 10", BigInt.Parse("1e5", 10) == Null)
Expect("parse ١٢ in 10", BigInt.Parse("١٢", 10) == Null)
Expect("parse 102 in 2", BigInt.Parse("102", 2) == Null)
Expect("parse z in 35", BigInt.Parse("z", 35) == Null)
Expect("parse g in 16", BigInt.Parse("g", 16) == Null)
Expect("parse 1\\0 in 10", BigInt.Parse("1\0", 10) == Null)
Done("parsing")

Check("0 bytes", Hex(B("0").ToBytes()), "")
CheckBig("0 from bytes", BigInt.FromBytes(Unhex("")), "0")
Check("1 bytes", Hex(B("1").ToBytes()), "01")
CheckBig("1 from bytes", BigInt.FromBytes(Unhex("01")), "1")
Check("255 bytes", Hex(B("255").ToBytes()), "ff")
CheckBig("255 from bytes", BigInt.FromBytes(Unhex("ff")), "255")
Check("256 bytes", Hex(B("256").ToBytes()), "0100")
CheckBig("256 from bytes", BigInt.FromBytes(Unhex("0100")), "256")
Check("615 bytes", Hex(B("18446744073709551615").ToBytes()), "ffffffffffffffff")
CheckBig("615 from bytes", BigInt.FromBytes(Unhex("ffffffffffffffff")), "18446744073709551615")
Check("616 bytes", Hex(B("18446744073709551616").ToBytes()), "010000000000000000")
CheckBig("616 from bytes", BigInt.FromBytes(Unhex("010000000000000000")), "18446744073709551616")
Check("862 bytes", Hex(B("").ToBytes()), "971c5660fce4638386b1658da48e56516a95efb666a32f13bfba16c4238263370b1a88417c949623b8f5a989b1d523b6457635e9c2669b1f2308e2c944d4593494b3538e87dc34db7d05da51455af235932985039bb884fcac77c8391f80ea33a4faf9fd6d8c143f1c0e34b712d7c737191b2cf2cc42561b309fc35af6")
CheckBig("862 from bytes", BigInt.FromBytes(Unhex("971c5660fce4638386b1658da48e56516a95efb666a32f13bfba16c4238263370b1a88417c949623b8f5a989b1d523b6457635e9c2669b1f2308e2c944d4593494b3538e87dc34db7d05da51455af235932985039bb884fcac77c8391f80ea33a4faf9fd6d8c143f1c0e34b712d7c737191b2cf2cc42561b309fc35af6")), "")
CheckBig("leading zeros", BigInt.FromBytes(Unhex("000001")), "1")
CheckBig("no bytes", BigInt.FromBytes(Unhex("")), "0")
Done("bytes")

Local int0 = B("0").ToInt64()
Check("0 as Int64", int0 == Null ? "Null" : "{int0}", "0")
Local int1 = B("-1").ToInt64()
Check("-1 as Int64", int1 == Null ? "Null" : "{int1}", "-1")
Local int2 = B("9223372036854775807").ToInt64()
Check("9223372036854775807 as Int64", int2 == Null ? "Null" : "{int2}", "9223372036854775807")
Local int3 = B("-9223372036854775808").ToInt64()
Check("-9223372036854775808 as Int64", int3 == Null ? "Null" : "{int3}", "-9223372036854775808")
Local int4 = B("9223372036854775808").ToInt64()
Check("9223372036854775808 as Int64", int4 == Null ? "Null" : "{int4}", "Null")
Local int5 = B("-9223372036854775809").ToInt64()
Check("-9223372036854775809 as Int64", int5 == Null ? "Null" : "{int5}", "Null")
Local int6 = B("18446744073709551616").ToInt64()
Check("18446744073709551616 as Int64", int6 == Null ? "Null" : "{int6}", "Null")
Local int7 = B("123456789").ToInt64()
Check("123456789 as Int64", int7 == Null ? "Null" : "{int7}", "123456789")
Done("Int64s")

Expect("0 as a Double", B("0").ToDouble() == 0.0)
Expect("1 as a Double", B("1").ToDouble() == 1.0)
Expect("99999 as a Double", B("-1").ToDouble() == -1.0)
Expect("40992 as a Double", B("9007199254740992").ToDouble() == 9007199254740992.0)
Expect("40993 as a Double", B("9007199254740993").ToDouble() == 9007199254740992.0)
Expect("40995 as a Double", B("9007199254740995").ToDouble() == 9007199254740996.0)
Expect("75807 as a Double", B("9223372036854775807").ToDouble() == 9.223372036854776e+18)
Expect("51615 as a Double", B("18446744073709551615").ToDouble() == 1.8446744073709552e+19)
Expect("23904 as a Double", B("1208925819614629308923904").ToDouble() == 1.2089258196146292e+24)
Expect("23905 as a Double", B("1208925819614629308923905").ToDouble() == 1.2089258196146294e+24)
Expect("59360 as a Double", B("1208925819614629577359360").ToDouble() == 1.2089258196146297e+24)
Expect("40640 as a Double", B("-1208925819614629577359360").ToDouble() == -1.2089258196146297e+24)
Expect("0 as a Double", B("10000000000000000000000").ToDouble() == 1e+22)
Expect("0 as a Double", B("100000000000000000000000").ToDouble() == 1e+23)
Expect("0 as a Double", B("").ToDouble() == 1e+308)
Expect("97792 as a Double", B("").ToDouble() == Infinity())
Expect("97791 as a Double", B("").ToDouble() == 1.7976931348623157e+308)
Expect("37216 as a Double", B("").ToDouble() == Infinity())
Expect("0 as a Double", B("").ToDouble() == Infinity())
Expect("0 as a Double", B("-").ToDouble() == -Infinity())
Expect("4367 as a Double", B("").ToDouble() == 1.0272931287288766e+301)
Expect("45449 as a Double", B("-3375649221850806637148034183179518036494754587199732169676638031367928830023961558119058890376975741025564458519193353547816430904375041300682143940107988915946943693412901225976730304377536102897118818696254551").ToDouble() == -3.3756492218508065e+210)
Expect("53733 as a Double", B("9281967977937553733").ToDouble() == 9.281967977937553e+18)
CheckBig("from 0.0", BigInt.FromDouble(0.0), "0")
CheckBig("from -0.0", BigInt.FromDouble(-0.0), "0")
CheckBig("from 0.5", BigInt.FromDouble(0.5), "0")
CheckBig("from -2.9", BigInt.FromDouble(-2.9), "-2")
CheckBig("from 1e+300", BigInt.FromDouble(1e+300), "")
CheckBig("from -1.5e+20", BigInt.FromDouble(-1.5e+20), "-150000000000000000000")
CheckBig("from 9007199254740992.0", BigInt.FromDouble(9007199254740992.0), "9007199254740992")
CheckBig("from 5e-324", BigInt.FromDouble(5e-324), "0")
CheckBig("from 1.7976931348623157e+308", BigInt.FromDouble(1.7976931348623157e+308), "")
CheckBig("from 123456.789", BigInt.FromDouble(123456.789), "123456")
Done("Doubles")

Local a = B("1692457004678024202222790980889884077886608845191472372527834566939885402738373221937502240479184296398293311821583506367")
Local b = B("-1129086280497959555840868598314373819350867721")
Local quotient, remainder = a.DivRem(b)
CheckBig("quotient", quotient,
         "-1498961624023632576335508951516584875653468668089834813707494527272461494360")
CheckBig("remainder", remainder, "1011703629129802095454650201832240395235952807")
Expect("equal hashes", a.Hash() == (a * b / b).Hash() && BigInt(0).Hash() == B("-0").Hash())
Expect("other hashes", a.Hash() != (a + 1).Hash() && BigInt(1).Hash() != BigInt(-1).Hash())
Expect("zero and one", BigInt.Zero() == 0 && BigInt.One() == 1)
Check("shown", "{a}", "1692457004678024202222790980889884077886608845191472372527834566939885402738373221937502240479184296398293311821583506367")
Done("the rest")
