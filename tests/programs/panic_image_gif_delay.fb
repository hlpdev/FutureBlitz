// A GIF's frame is shown for 655350 milliseconds at most, 65535 hundredths of a second, and
// EncodeAnimation panics where it's called for an animation with a longer one.
Import std.core
Import std.image

Local animation = Animation(1, 1)
animation.Add(Image(1, 1), 655350)
Print(Gif.EncodeAnimation(animation).Count > 0)
animation.Add(Image(1, 1), 655351)
Gif.EncodeAnimation(animation)
