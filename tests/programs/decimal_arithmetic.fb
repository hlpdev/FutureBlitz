CheckDecimal("6+5", d[6] + 5, "128.456")
CheckDecimal("5+6", 5 + d[6], "128.456")
CheckDecimal("6-5", d[6] - 5, "118.456")
CheckDecimal("5-6", 5 - d[6], "-118.456")
CheckDecimal("6*5", d[6] * 5, "617.280")
CheckDecimal("5*6", 5 * d[6], "617.280")
CheckDecimal("6/5", d[6] / 5, "24.6912")
CheckDecimal("5/6", 5 / d[6], "0.04050025920165889061689994816")
CheckDecimal("6%5", d[6] % 5, "3.456")
CheckDecimal("5%6", 5 % d[6], "5.000")
Expect("6==5", (d[6] == 5) == False)
Expect("5==6", (5 == d[6]) == False)
Expect("6<5", (d[6] < 5) == False)
Expect("5<6", (5 < d[6]) == True)
Expect("6>5", (d[6] > 5) == True)
Expect("5>6", (5 > d[6]) == False)
Expect("6<=5", (d[6] <= 5) == False)
Expect("5<=6", (5 <= d[6]) == True)
Expect("6>=5", (d[6] >= 5) == True)
Expect("5>=6", (5 >= d[6]) == False)
CheckDecimal("6+-3", d[6] + -3, "120.456")
CheckDecimal("-3+6", -3 + d[6], "120.456")
CheckDecimal("6--3", d[6] - -3, "126.456")
CheckDecimal("-3-6", -3 - d[6], "-126.456")
CheckDecimal("6*-3", d[6] * -3, "-370.368")
CheckDecimal("-3*6", -3 * d[6], "-370.368")
CheckDecimal("6/-3", d[6] / -3, "-41.152")
CheckDecimal("-3/6", -3 / d[6], "-0.02430015552099533437013996890")
CheckDecimal("6%-3", d[6] % -3, "0.456")
CheckDecimal("-3%6", -3 % d[6], "-3.000")
Expect("6==-3", (d[6] == -3) == False)
Expect("-3==6", (-3 == d[6]) == False)
Expect("6<-3", (d[6] < -3) == False)
Expect("-3<6", (-3 < d[6]) == True)
Expect("6>-3", (d[6] > -3) == True)
Expect("-3>6", (-3 > d[6]) == False)
Expect("6<=-3", (d[6] <= -3) == False)
Expect("-3<=6", (-3 <= d[6]) == True)
Expect("6>=-3", (d[6] >= -3) == True)
Expect("-3>=6", (-3 >= d[6]) == False)
CheckDecimal("6+1000000007", d[6] + 1000000007, "1000000130.456")
CheckDecimal("1000000007+6", 1000000007 + d[6], "1000000130.456")
CheckDecimal("6-1000000007", d[6] - 1000000007, "-999999883.544")
CheckDecimal("1000000007-6", 1000000007 - d[6], "999999883.544")
CheckDecimal("6*1000000007", d[6] * 1000000007, "123456000864.192")
CheckDecimal("1000000007*6", 1000000007 * d[6], "123456000864.192")
CheckDecimal("6/1000000007", d[6] / 1000000007, "1.234559991358080060493439577E-7")
CheckDecimal("1000000007/6", 1000000007 / d[6], "8100051.897032141005702436496")
CheckDecimal("6%1000000007", d[6] % 1000000007, "123.456")
CheckDecimal("1000000007%6", 1000000007 % d[6], "110.744")
Expect("6==1000000007", (d[6] == 1000000007) == False)
Expect("1000000007==6", (1000000007 == d[6]) == False)
Expect("6<1000000007", (d[6] < 1000000007) == True)
Expect("1000000007<6", (1000000007 < d[6]) == False)
Expect("6>1000000007", (d[6] > 1000000007) == False)
Expect("1000000007>6", (1000000007 > d[6]) == True)
Expect("6<=1000000007", (d[6] <= 1000000007) == True)
Expect("1000000007<=6", (1000000007 <= d[6]) == False)
Expect("6>=1000000007", (d[6] >= 1000000007) == False)
Expect("1000000007>=6", (1000000007 >= d[6]) == True)
Expect("1.0 == 1", D("1.0") == 1 && 1 == D("1.00") && D("1.5") != 1)
