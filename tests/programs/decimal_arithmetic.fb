CheckDecimal("0+0", d[0] + d[0], "0")
CheckDecimal("0-0", d[0] - d[0], "0")
CheckDecimal("0*0", d[0] * d[0], "0")
Expect("0==0", (d[0] == d[0]) == True)
Expect("0<0", (d[0] < d[0]) == False)
Expect("0>=0", (d[0] >= d[0]) == True)
