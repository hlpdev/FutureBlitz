// std.data's CSV: rows of fields as RFC 4180 has them, quoted and not, over LF and CRLF lines and
// other separators; records by a header; where a ParseError says it is; and what Write and
// WriteRecords write, which reads back as the same.

Import std.core
Import std.collections
Import std.data.csv

Function Show(rows: String[][])
    For row In rows
        Local parts: String[] = []
        For field In row
            parts.Add("<" + field + ">")
        End For
        Print(row.Count, parts.Join(" "))
    End For
End Function

Show(Try Csv.Read("name,age\nAda,36\n\"Lovelace, Ada\",\"say \"\"hi\"\"\"\n"))
Show(Try Csv.Read("a,b\r\n\"two\nlines\",\r\n,\n\nlast,row"))
Print((Try Csv.Read("\"two\r\nlines\"\r\n"))[0][0] == "two\r\nlines")
Show(Try Csv.Read("\u{FEFF}x;y;\"z;w\"", ";"))
Show(Try Csv.Read("tab\tseparated\t", "\t"))
Show(Try Csv.Read("ü,\"é\""))
Print((Try Csv.Read("")).Count)

Function Failure(text: String)
    Try
        Csv.Read(text)
        Print("reads:", text)
    Catch e As ParseError
        Print(e.Kind, e.Line, e.Column, e.Message)
    End Try
End Function

Failure("a,\"b")
Failure("a,b\"c")
Failure("ok\n\"a\"b,c")

Local records = Try Csv.ReadRecords("id,name\n1,Ada\n2,\"Grace Hopper\"\n")
Print(records)
Try
    Csv.ReadRecords("id,name\n1\n")
Catch e As ParseError
    Print(e.Kind, e.Line, e.Message)
End Try
Try
    Csv.ReadRecords("id,id\n1,2\n")
Catch e As ParseError
    Print(e.Kind, e.Message)
End Try
Print(Try Csv.ReadRecords(""))

// Write quotes what must be quoted, and reads back as the same rows.
Local rows: String[][] = [["plain", "with,comma", "with \"quote\"", "two\nlines", " padded ", ""],
                          [""], ["ü"]]
Local written = Csv.Write(rows)
Print(written)
Print((Try Csv.Read(written)) == rows)
Print(Csv.Write([["a;b", "c,d"]], ";"))

// WriteRecords takes every key the records have, in order, and writes a field's text.
Local people = Value.Array()
Local ada = Value.Object()
ada["name"] = Value("Ada")
ada["age"] = Value(36 As Int64)
people.Add(ada)
Local grace = Value.Object()
grace["name"] = Value("Grace")
grace["admiral"] = Value(True)
grace["height"] = Value(1.65)
grace["age"] = Value()
people.Add(grace)
Local table = Csv.WriteRecords(people)
Print(table)
Print(Try Csv.ReadRecords(table))
