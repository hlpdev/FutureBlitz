/ -> / []
/other -> /*all [all=other]
/deep/er -> /*all [all=deep/er]
/files -> /files []
/files/ -> /files/*path [path=]
/files/a/b -> /files/*path [path=a/b]
/a/q -> /a/:b [b=q]
/a/q/ -> /a/:b/*rest [b=q, rest=]
/a/q/r/s -> /a/:b/*rest [b=q, rest=r/s]
/a/fixed -> /a/fixed []
/a/fixed/more -> /a/:b/*rest [b=fixed, rest=more]
/x/1/z -> /x/:y/z [y=1]
/x/1/w -> /x/*rest [rest=1/w]
/x -> /x/*rest [rest=]
