// SortedMap and SortedSet keep their keys in order through many random additions and removals,
// matching a Map whose keys are sorted, with First, Last, Floor, Ceiling, and Range too.
Import std.core
Import std.collections

// The same numbers each run, from a linear congruential generator.
Global seed: UInt64 = 12345

Function Next(limit: Int): Int
    seed = seed.WrappingMultiply(6364136223846793005).WrappingAdd(1442695040888963407)
    Return ((seed >> 33) % (limit As UInt64)) As Int
End Function

Local sorted = SortedMap<Int, Int>()
Local plain = Map<Int, Int>()
Local wrong = 0
For round = 1 To 4000
    Local key = Next(500)
    If Next(3) == 0
        If sorted.Remove(key) != plain.Remove(key) Then wrong += 1
    Else
        sorted.Add(key, round)
        plain.Add(key, round)
    End If

    If round % 500 == 0
        Local keys = plain.Keys()
        keys.Sort()
        If sorted.Keys() != keys || sorted.Count != plain.Count Then wrong += 1
        If (sorted.First()?.0 ?? -1) != (keys.Count == 0 ? -1 : keys[0]) Then wrong += 1
        If (sorted.Last()?.0 ?? -1) != (keys.Count == 0 ? -1 : keys[keys.Count - 1]) Then wrong += 1
        For k In keys
            If sorted.Get(k) != plain.Get(k) Then wrong += 1
        End For

        // Floor, Ceiling, and Range against going over the sorted keys.
        For probe = -1 To 501 Step 7
            Local floor: Int? = Null
            Local ceiling: Int? = Null
            For k In keys
                If k <= probe Then floor = k
                If k >= probe && ceiling == Null Then ceiling = k
            End For
            If (sorted.Floor(probe)?.0 ?? -100) != (floor ?? -100) Then wrong += 1
            If (sorted.Ceiling(probe)?.0 ?? -100) != (ceiling ?? -100) Then wrong += 1
            Local inRange = keys.Filter(Function(k: Int) => k >= probe && k < probe + 40)
            If sorted.Range(probe, probe + 40).Map(Function(e: (Int, Int)) => e.0) != inRange
                wrong += 1
            End If
        End For
    End If
End For
Print(sorted.Count == plain.Count, wrong)

// Removing everything, in a random order, leaves it empty.
Local keys = sorted.Keys()
While keys.Count > 0
    Local at = Next(keys.Count)
    If !sorted.Remove(keys[at]) Then wrong += 1
    keys.RemoveAt(at)
End While
Print(sorted.Count, sorted.First() == Null, sorted.Last() == Null, wrong)

// The basics, on small ones.
Local ages = SortedMap<String, Int>()
ages["cy"] = 41
ages["al"] = 30
ages.Add("bo", 25)
ages["al"] = 31
Print(ages, ages.Count, ages["bo"], ages.Get("zz") ?? -1, ages.Get("zz", 0), ages.Contains("cy"))
Print(ages.First()?.0 ?? "", ages.Last()?.0 ?? "", ages.Floor("b")?.0 ?? "-",
      ages.Ceiling("b")?.0 ?? "-")
Print(ages.Keys(), ages.Values(), ages.Range("al", "c"))
For name, age In ages
    Print(name, age)
End For
Local copy = ages.Clone()
copy.Remove("al")
Print(copy, ages, copy == ages, ages.Clone() == ages)
ages.Clear()
Print(ages, ages.Count, ages.First() == Null)

Local set = SortedSet<Int>()
For n In [5, 1, 9, 3, 7, 1]
    set.Add(n)
End For
Print(set, set.Count, set.First() ?? -1, set.Last() ?? -1, set.Floor(4) ?? -1, set.Ceiling(4) ?? -1)
Print(set.Range(3, 9), set.Remove(3), set.Remove(3), set.ToArray(), set.Contains(9))
Local same = SortedSet<Int>()
same.Add(9)
same.Add(1)
same.Add(5)
same.Add(7)
Print(set == same, set.Clone() == set, SortedSet<Int>().First() ?? -1)

// SortedSet against a Set whose values are sorted.
Local sortedSet = SortedSet<Int>()
Local plainSet = Set<Int>()
wrong = 0
For round = 1 To 3000
    Local value = Next(300)
    If Next(2) == 0
        If sortedSet.Add(value) != plainSet.Add(value) Then wrong += 1
    Else
        If sortedSet.Remove(value) != plainSet.Remove(value) Then wrong += 1
    End If

    If sortedSet.Contains(value) != plainSet.Contains(value) Then wrong += 1
    If round % 100 == 0
        Local values = plainSet.ToArray()
        values.Sort()
        If sortedSet.ToArray() != values || sortedSet.Count != plainSet.Count Then wrong += 1
        Local probe = Next(320) - 10
        Local below = values.Filter(Function(v: Int) => v <= probe)
        Local above = values.Filter(Function(v: Int) => v >= probe)
        If (sortedSet.Floor(probe) ?? -1) != (below.Count == 0 ? -1 : below[below.Count - 1])
            wrong += 1
        End If

        If (sortedSet.Ceiling(probe) ?? -1) != (above.Count == 0 ? -1 : above[0]) Then wrong += 1
        If sortedSet.Range(probe, probe + 30) != values.Filter(Function(v: Int) => v >= probe &&
           v < probe + 30)
            wrong += 1
        End If
    End If
End For
Print(sortedSet.Count == plainSet.Count, wrong)

// A value that's Null is still there.
Local maybe = SortedMap<Int, String?>()
maybe.Add(1, Null)
maybe.Add(2, "two")
Print(maybe.Contains(1), maybe.Contains(3), maybe[1] ?? "null", maybe.Get(1, "fallback") ?? "null",
      maybe.Get(3, "fallback") ?? "null", maybe.Count)

// A tree of four levels: keys from a wide range, grown, then shrunk, then emptied, against a Map.
Local deep = SortedMap<Int, Int>()
Local deepPlain = Map<Int, Int>()
wrong = 0
For round = 1 To 60000
    Local key = Next(100000)
    If round > 40000 || Next(4) == 0
        If deep.Remove(key) != deepPlain.Remove(key) Then wrong += 1
    Else
        deep.Add(key, round)
        deepPlain.Add(key, round)
    End If

    If round % 10000 == 0
        Local deepKeys = deepPlain.Keys()
        deepKeys.Sort()
        If deep.Keys() != deepKeys || deep.Count != deepPlain.Count Then wrong += 1
        If (deep.First()?.0 ?? -1) != deepKeys[0] ||
           (deep.Last()?.0 ?? -1) != deepKeys[deepKeys.Count - 1]
            wrong += 1
        End If

        For i = 1 To 50
            Local probe = Next(100000)
            Local at = deepKeys.BinarySearch(probe)
            Local floor = at != Null ? probe : -1
            Local ceiling = floor
            If at == Null
                For k In deepKeys
                    If k < probe Then floor = k
                    If k > probe && ceiling == -1 Then ceiling = k
                End For
            End If

            If (deep.Floor(probe)?.0 ?? -1) != floor || (deep.Ceiling(probe)?.0 ?? -1) != ceiling
                wrong += 1
            End If

            If deep.Get(probe, -1) != deepPlain.Get(probe, -1) Then wrong += 1
        End For
    End If
End For

Local left = deep.Keys()
While left.Count > 0
    Local at = Next(left.Count)
    If !deep.Remove(left[at]) Then wrong += 1
    left.RemoveAt(at)
    If deep.Count != left.Count Then wrong += 1
End While
Print(deep.Count, wrong)

// Giving a key a new value while going over the entries is fine, and so is removing a key that
// isn't there: neither changes the tree.
Local loop = SortedMap<Int, Int>()
For i = 1 To 200
    loop.Add(i, i)
End For

Local seen = 0
For key, value In loop
    loop[key] = value * 2
    loop.Remove(1000 + key)
    seen += value
End For
Print(seen, loop[50], loop.Count, SortedMap<Int, Int>.DefaultValue().Count,
      SortedSet<Int>.DefaultValue().Count)
Local cleared = SortedSet<Int>()
cleared.Add(1)
cleared.Clear()
Print(cleared.Count, cleared.First() ?? -1, cleared)

// A consumer or a For ... In goes over a copy of an Iterator, so one partly used doesn't move.
Local fiftyMap = SortedMap<Int, Int>()
Local fiftySet = SortedSet<Int>()
For i = 0 Until 50
    fiftyMap.Add(i, i)
    fiftySet.Add(i)
End For

Local mapEntries = fiftyMap.Iterate()
mapEntries.Next()
Print(mapEntries.Count(), mapEntries.Count(), mapEntries.Next() ?? (-1, -1))
Local setValues = fiftySet.Iterate()
setValues.Next()
Local looped = 0
For value In setValues
    looped += 1
End For
Print(looped, setValues.Count(), setValues.Next() ?? -1)
