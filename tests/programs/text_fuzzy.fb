// std.text.fuzzy against fzf's own tests of its FuzzyMatchV2 (src/algo/algo_test.go), whose
// scores are fzf's: each gives fzf's score and the first and last places it matched; then
// positions in bytes, case, and Rank's order.
Import std.core
Import std.text.fuzzy

Const M = 16
Const GAP_START = -3
Const GAP_EXTENSION = -1
Const BOUNDARY = 8
Const WHITE = 10
Const DELIMITER = 9
Const NON_WORD = 8
Const CAMEL = 7
Const CONSECUTIVE = 4

For check In [("fooBarbaz1", "obz", 2, 9, M * 3 + CAMEL + GAP_START + GAP_EXTENSION * 3),
              ("foo bar baz", "fbb", 0, 9, M * 3 + WHITE * 2 + WHITE * 2 + 2 * GAP_START +
                                           4 * GAP_EXTENSION),
              ("/AutomatorDocument.icns", "rdoc", 9, 13, M * 4 + CAMEL + CONSECUTIVE * 2),
              ("/man1/zshcompctl.1", "zshc", 6, 10, M * 4 + DELIMITER * 2 + DELIMITER * 3),
              ("/.oh-my-zsh/cache", "zshc", 8, 13, M * 4 + BOUNDARY * 2 + BOUNDARY * 2 +
                                                   GAP_START + DELIMITER),
              ("ab0123 456", "12356", 3, 10, M * 5 + CONSECUTIVE * 3 + GAP_START +
                                             GAP_EXTENSION),
              ("abc123 456", "12356", 3, 10, M * 5 + CAMEL * 2 + CAMEL * 2 + CONSECUTIVE +
                                             GAP_START + GAP_EXTENSION),
              ("foo/bar/baz", "fbb", 0, 9, M * 3 + WHITE * 2 + DELIMITER * 2 + 2 * GAP_START +
                                           4 * GAP_EXTENSION),
              ("fooBarBaz", "fbb", 0, 7, M * 3 + WHITE * 2 + CAMEL * 2 + 2 * GAP_START +
                                         2 * GAP_EXTENSION),
              ("foo barbaz", "fbb", 0, 8, M * 3 + WHITE * 2 + WHITE + GAP_START * 2 +
                                          GAP_EXTENSION * 3),
              ("fooBar Baz", "foob", 0, 4, M * 4 + WHITE * 2 + WHITE * 3),
              ("xFoo-Bar Baz", "foo-b", 1, 6, M * 5 + CAMEL * 2 + CAMEL * 2 + NON_WORD +
                                              BOUNDARY)]
    Local found = Fuzzy.Match(check.1, check.0)
    If found == Null
        Print(check.0, check.1, "none")
    Else
        Local positions = found.Positions
        Print(check.0, check.1, found.Score, positions, found.Score == check.4 &&
              positions[0] == check.2 && positions[positions.Count - 1] + 1 == check.3)
    End If
End For

// Positions are bytes; a pattern with a capital matches case, and one without doesn't; and a
// pattern whose characters aren't all there in order doesn't match.
// A one-character pattern takes, as fzf's does, its first place with a word's start's bonus or
// more, or else its best, the first of those that score the same.
For check In [("é", "café"), ("ca", "😀cat"), ("FB", "foo_bar"), ("FB", "Foo_Bar"),
              ("fb", "FOO_BAR"), ("zz", "abc"), ("ba", "ab"), ("", "x"), ("a", "1.A aB"),
              ("a", "baca"), ("a", "b a a"), ("b", "ab_b")]
    Local found = Fuzzy.Match(check.0, check.1)
    If found == Null
        Print(check.0, check.1, "none")
    Else
        Print(check.0, check.1, found.Score, found.Positions)
    End If
End For

Print(Fuzzy.Rank("mf", ["main.fb", "my_file.txt", "readme.md", "MakeFile", "mf", "m_f"]))
Print(Fuzzy.Score("abc", "ab") ?? -1, Fuzzy.Score("abc", "a-b-c") ?? -1)
