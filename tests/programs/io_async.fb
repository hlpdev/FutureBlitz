// An Async read through a Reader value waits on the main thread, while what else is waiting
// there goes on: through std.io's buffered streams, CopyAsync, ReadAllAsync, and ReadExactAsync
// too, and the Async twins a stream that only blocks has from its Interface.

Import std.core
Import std.ffi
Import std.io

// Gives its text a byte at a time, each a tick after it's asked for, as a socket might.
Class Trickle Implements Reader
    Field Bytes: UInt8[]
    Field At: Int

    Public New(text: String)
        Bytes = text.Bytes
    End New

    Method Read(into: Buffer<UInt8>): Int64 Throws IOError
        If into.Count == 0 || At == Bytes.Count Then Return 0
        into[0] = Bytes[At]
        At += 1
        Return 1
    End Method

    Async Method ReadAsync(into: Buffer<UInt8>): Int64 Throws IOError
        Await NextTick()
        Return Try Read(into)
    End Method
End Class

// Takes a tick for each write, and keeps what it's given.
Class Slow Implements Writer
    Field Kept: StringWriter
    Field Writes: Int

    Public New()
        Kept = StringWriter()
    End New

    Method Write(from: Buffer<UInt8>) Throws IOError
        Writes += 1
        Try Kept.Write(from)
    End Method

    Async Method WriteAsync(from: Buffer<UInt8>) Throws IOError
        Await NextTick()
        Try Write(from)
    End Method
End Class

// Gives each of its parts in turn, and throws an INTERRUPTED IOError for an empty one; its
// ReadAsync is Reader's, which reads.
Class Flaky Implements Reader
    Field Parts: String[]
    Field At: Int

    Public New(parts: String[])
        Parts = parts
    End New

    Method Read(into: Buffer<UInt8>): Int64 Throws IOError
        If At == Parts.Count Then Return 0
        Local part = Parts[At].Bytes
        At += 1
        If part.Count == 0 Then Throw IOError(IOErrorKind.INTERRUPTED, "interrupted")
        For i = 0 Until part.Count
            into[i] = part[i]
        End For
        Return part.Count
    End Method
End Class

// Counts the ticks that go by while `waiting` says the reads go on.
Global ticks = 0
Global waiting = True

Async Function Count()
    While waiting
        Await NextTick()
        ticks += 1
    End While
End Function

Async Function Lines(source: Reader): String Throws IOError
    Local reader = BufferedReader(source, 4)
    Local all = ""
    Loop
        Local line = Try Await reader.ReadLineAsync()
        If line == Null Then Return all
        all += "[{line}]"
    End Loop
End Function

Local counting = Count()
Local source: Reader = Trickle("hey")
Local into = Buffer<UInt8>(8)
Local read = Try Await source.ReadAsync(into)
Print("{read} {into[0]} {ticks > 0}")
Local before = ticks
Local rest = TextOf(Try Await ReadAllAsync(source))
Print("{rest} {ticks > before}")

Print(Try Await Lines(Trickle("one\r\ntwo\nthree")))
Local slow = Slow()
Print("{Try Await CopyAsync(Trickle("copied"), slow)} {slow.Kept.ToString()} {slow.Writes}")

// A BufferedWriter sends what it keeps through WriteAsync, a buffer at a time.
Local buffered = BufferedWriter(slow, 4)
For part In ["ab", "cdef", "g"]
    Try Await buffered.WriteAsync(Buffer<UInt8>.From(part.Bytes))
End For

Print("{slow.Kept.ToString()} {slow.Writes}")
Try Await buffered.FlushAsync()
Print("{slow.Kept.ToString()} {slow.Writes}")

Local exact = Buffer<UInt8>(5)
Try
    Try Await ReadExactAsync(Trickle("abc"), exact)
Catch e As IOError
    Print("{e.Kind}: {e.Message}")
End Try

// A stream that only blocks has its Interface's Async twins, which read and write as it does.
Local memory: Reader = MemoryStream([1, 2, 3])
Print("{Try Await memory.ReadAsync(into)} {into[2]} {Try Await ReadAllAsync(memory)}")
Local sink: Writer = StringWriter()
Try Await sink.WriteAsync(Buffer<UInt8>.From([104, 105]))
Try Await sink.FlushAsync()
Print((sink As StringWriter).ToString())

// A BufferedReader's ReadByteAsync and ReadAsync, through a Reader value too, wait for what it
// wraps, and a ReadAsync of a whole buffer or more goes straight to that.
Local bytewise = BufferedReader(Trickle("xy"), 2)
Print("{Try Await bytewise.ReadByteAsync() ?? 0} {Try Await bytewise.ReadByteAsync() ?? 0} " +
      "{Try Await bytewise.ReadByteAsync() == Null}")
Local wrapped: Reader = BufferedReader(Trickle("abc"), 2)
Local small = Buffer<UInt8>(1)
Local large = Buffer<UInt8>(2)
Print("{Try Await wrapped.ReadAsync(small)} {small[0]} {Try Await wrapped.ReadAsync(large)} " +
      "{large[0]}")

// When what it wraps throws, it has nothing left over, so a retry reads on, a line it had begun
// too.
Local retried = BufferedReader(Flaky(["abcd", "", "ef"]), 4)
Local got = ""
Loop
    Try
        Local byte = Try Await retried.ReadByteAsync()
        If byte == Null Then Break
        got += "{byte} "
    Catch e As IOError
        got += "({e.Kind}) "
    End Try
End Loop

Local lines = BufferedReader(Flaky(["x\nab", "", "cd\n"]), 4)
Loop
    Try
        Local line = Try Await lines.ReadLineAsync()
        If line == Null Then Break
        got += "[{line}] "
    Catch e As IOError
        got += "({e.Kind}) "
    End Try
End Loop
Print(got)

waiting = False
Await counting
Print("done")

Function TextOf(bytes: UInt8[]): String
    Local text = StringWriter()
    Try? text.WriteBytes(bytes)
    Return text.ToString()
End Function
