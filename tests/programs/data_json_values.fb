// Json.Read reads documents into Values, integers exact, and Json.Write writes Values as
// documents, on one line or indented, which read back as the same Values.
Import std.core
Import std.collections
Import std.data

// What Read gives for text: the Value, as it shows, or the ParseError.
Function ReadText(text: String): String
    Try
        Local value = Json.Read(text)
        Return "{value.Kind} {value}"
    Catch e As ParseError
        Return "ParseError {e.Kind} at {e.Line}:{e.Column}"
    End Try
End Function

Print("== read")
Local document = r"""
    {"name": "Ada", "age": 36, "langs": ["en", "fr"], "ok": true, "none": null, "pi": 3.25}
    """
Print(ReadText(document))
Print(ReadText("  [] "))
Print(ReadText(r"{}"))
Print(ReadText("-12"))
Print(ReadText("9223372036854775807"))
Print(ReadText("9223372036854775808"))
Print(ReadText("18446744073709551615"))
Print(ReadText("18446744073709551616"))
Print(ReadText("-9223372036854775809"))
Print(ReadText("1.0"))
Print(ReadText("1e2"))
Print(ReadText("\"text\""))
Print(ReadText("false"))
Print(ReadText("null"))
Print(ReadText(r"""
    {"k": 1, "j": 2, "k": 3}
    """))
Print(ReadText(r"""
    [[[[["deep"]]]], {"a": {"b": {"c": []}}}]
    """))
Print(ReadText("[1, 2"))
Print(ReadText(r"""
    {"a" 1
    """))

Print("== exact integers")
Try
    Local numbers = Json.Read("[9007199254740993, -9007199254740993, 18446744073709551614]")
    For i = 0 Until numbers.Count
        Local number = numbers[i] ?? Value()
        Print("{number.Kind} {number.AsInt64() ?? 0} {number.AsUInt64() ?? 0}")
    End For
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== path")
Try
    Local parsed = Json.Read(document)
    Print(parsed.Path("langs[1]") ?? Value())
    Print((parsed["age"] ?? Value()).AsInt() ?? 0)
    Print((parsed["pi"] ?? Value()).AsDouble() ?? 0.0)
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== bytes")
Try
    Print(Json.Read([239, 187, 191, 123, 34, 97, 34, 58, 49, 125] As UInt8[]))
    Print(ReadText("[\"\u{0}\"]"))
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== write")
Local value = Value.Object()
value["name"] = Value("Ada \"the first\"\n")
value["age"] = Value(36)
value["big"] = Value(18446744073709551615 As UInt64)
value["ratio"] = Value(0.5)
value["whole"] = Value(2.0)
value["ok"] = Value(True)
value["none"] = Value()
value["bytes"] = Value([0, 1, 2, 250, 251, 252, 253] As UInt8[])
Local list = Value.Array()
list.Add(Value(1))
list.Add(Value.Array())
list.Add(Value.Object())
Local inner = Value.Object()
inner["x"] = Value(-1)
list.Add(inner)
value["list"] = list
Print(Json.Write(value))
Print(Json.Write(value, 2))
Print(Json.Write(Value(1.5)))
Print(Json.Write(Value("lone")))
Print(Json.Write(Value.Array(), 4))

Print("== round trips")
// What Write wrote reads back as the same Value, but bytes, which read back as base64 text.
Local trips = 0
For text In ["[1, -2, 3.5, \"é😀\", true, null, [], {{}}]", document, "18446744073709551615",
             "[0.1, 1e-300, 1.7976931348623157e308, -0.0, 5e-324]"]
    Try
        Local first = Json.Read(text)
        For indent In [0, 1, 3]
            Local again = Json.Read(Json.Write(first, indent))
            If again == first
                trips += 1
            Else
                Print("differs: {first} and {again}")
            End If
        End For
    Catch e As ParseError
        Print("ParseError {e.Message}")
    End Try
End For
Print("{trips} round trips")
Try
    Local bytes = Json.Read(Json.Write(value))
    Print(bytes["bytes"] ?? Value())
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== deep")
// A thousand arrays deep reads and writes without a call for each.
Local deep = ""
For i = 1 To 1000
    deep = deep + "["
End For
For i = 1 To 1000
    deep = deep + "]"
End For
Try
    Local nested = Json.Read(deep)
    Print(Json.Write(nested) == deep)
    Print(ReadText("[" + deep + "]"))
    Print(Json.Write(Json.Read("[" + deep + "]", 1001)).Bytes.Count)
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try
