// A *name takes the rest of a path, so one before another segment panics where it's added.
Import std.core
Import std.net
Import std.net.http

Function Ok(request: HttpRequest): Task<HttpResponse> => Done()
Async Function Done(): HttpResponse => HttpResponse.Of(204)

Local server = HttpServer()
server.Get("/files/*path/raw", Function(request: HttpRequest) => Ok(request))
