// An ellipse's radii aren't negative, and drawing one with a negative radius panics where it's
// drawn.
Import std.core
Import std.math.color
Import std.math.vector
Import std.image

Local canvas = Canvas(Image(4, 4))
canvas.FillCircle(Vec2(2, 2), 0, Color32.Black)
Print(canvas.Image[2, 2].a)
canvas.FillEllipse(Vec2(2, 2), Vec2(1, -1), Color32.Black)
