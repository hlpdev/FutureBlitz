// Wycheproof's PS256 vectors: a valid signature verifies, and an invalid one
// doesn't.
Local ps256Key0 = Rsa.PublicKey(Unhex(""), Unhex("010001"))
Expect("PS256 1", Rsa.VerifyPss(ps256Key0, Unhex(""), Unhex("")))
