// New keys sign and verify, and agree on a secret.
Local signer = EcdsaP256.NewPrivateKey()
Local signature = EcdsaP256.Sign(signer, "move 12 to e4")
Expect("P-256 new key", EcdsaP256.Verify(EcdsaP256.PublicKeyOf(signer), "move 12 to e4", signature))
Expect("P-256 other key", !EcdsaP256.Verify(EcdsaP256.PublicKeyOf(EcdsaP256.NewPrivateKey()), "move 12 to e4", signature))
Expect("P-256 not a key", !EcdsaP256.Verify(Unhex("010203"), "move 12 to e4", signature))
Local alice = X25519.NewPrivateKey()
Local bob = X25519.NewPrivateKey()
Local aliceSecret = X25519.SharedSecret(alice, X25519.PublicKeyOf(bob)) ?? []
Expect("X25519 new keys", aliceSecret.Count == 32 && X25519.SharedSecret(bob, X25519.PublicKeyOf(alice)) == aliceSecret)
Done("New keys")
