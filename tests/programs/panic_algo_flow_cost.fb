// A FlowField's cells cost nothing below 0, and a negative cost panics where it's made.
Import std.core
Import std.math
Import std.algo

Local mud = Function(c: Vec2i): Double? => c.x == 1 ? 5 : 1
Print(FlowField(3, 1, [Vec2i(0, 0)], mud).Distance(Vec2i(2, 0)) ?? -1)
Local odd = Function(c: Vec2i): Double? => c.x == 1 ? -5 : 1
Local field = FlowField(3, 1, [Vec2i(0, 0)], odd)
