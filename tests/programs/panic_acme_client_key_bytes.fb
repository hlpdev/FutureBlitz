// An AcmeClient's account key is an ECDSA P-256 private key of 32 bytes, which signs its
// requests: one of 16 panics where the client is made, not at the first request.
Import std.core
Import std.collections
Import std.crypto
Import std.net

Local bytes: UInt8[] = []
For i = 1 To 32
    bytes.Add(i As UInt8)
End For

Print(AcmeClient("http://127.0.0.1:1/dir", Key(KeyKind.ECDSA_P256, True, bytes)).Account ?? "-")
AcmeClient("http://127.0.0.1:1/dir", Key(KeyKind.ECDSA_P256, True, bytes[0..16]))
Print("unreachable")
