// An Array's items are each an element, and FromValue panics at an Array in an Array.
Import std.core
Import std.data.xml

Local value = Value.Object()
Local items = Value.Array()
items.Add(Value(1 As Int64))
value["items"] = items
Print(Xml.FromValue("a", value))
items.Add(Value.Array())
Print(Xml.FromValue("a", value))
