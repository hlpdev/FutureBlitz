// A Statement given values panics where it's called once its Database is closed, before it binds
// them, so a value SQLite can't hold doesn't throw first.
Import std.core
Import std.db

Try
    Local db = Database.Open(":memory:")
    Local statement = db.Prepare("SELECT ?")
    db.Close()
    statement.Execute(18446744073709551615 As UInt64)
Catch e As DatabaseError
    Print(e.Message)
End Try
