// M6's integration program, which uses std alone. It fetches three cities' temperatures as JSON
// over HTTPS, from a feed of its own on std's TLS with the test CA's certificate, keeps them in a
// SQLite database, sums them up in SQL, and draws them as a chart, a PNG. Then it serves the
// summary and the chart from an HttpServer, as JSON, as static files, and to a WebSocket, and
// its own HttpClient and WebSocket client check that what they get is what it made.
Import std.core
Import std.crypto
Import std.data
Import std.image
Import std.net
Import std.net.http
Import std.net.ws
Import std.text
Import std.time
Import "./readings/source"
Import "./readings/store"
Import "./readings/chart"
Import "./readings/feed"
Import "./readings/site"

// How many of a chart's pixels are colored, not a gray, and how many of those are outside its
// plot, which is 24 pixels in from each edge, less the 5 a dot or a line on its edge takes.
Function Colored(image: Image): (Int, Int)
    Local bytes = image.ToBytes()
    Local colored = 0
    Local outside = 0
    For y = 0 Until image.Height
        For x = 0 Until image.Width
            Local at = (y * image.Width + x) * 4
            If bytes[at] == bytes[at + 1] && bytes[at] == bytes[at + 2] Then Continue
            colored += 1
            If x < 19 || x >= image.Width - 19 || y < 19 || y >= image.Height - 19 Then outside += 1
        End For
    End For

    Return (colored, outside)
End Function

// The chart of readings, in a store of their own: how many pixels are colored, and outside.
Function Drawn(readings: Reading[]): String Throws DatabaseError
    Local store = Try Store.Open()
    Try store.Add(readings)
    Local counted = Colored(Try Chart(store, 480, 270))
    Return "{counted.0} colored, {counted.1} outside the plot"
End Function

Async Function Run() Throws Error
    // The feed, over HTTPS: a client that trusts only the OS's roots is refused, and one that
    // trusts the test CA gets the document.
    Local readings = Readings(26, 36)
    Local feed = Try FeedServer.Start(FeedOf(readings))
    Local answering = feed.Answer(2)
    Local refused = "fetched"
    Try
        Try Await HttpClient().GetAsync(feed.Url)
    Catch e As NetError
        refused = "refused, {e.Kind}"
    End Try

    Local client = HttpClient()
    client.TrustOnly(TestRoots())
    Local fetched = Try Await client.GetAsync(feed.Url)
    Await answering
    feed.Close()
    Print("feed: untrusted", refused, "| trusted", fetched.Status, fetched.Headers.Get("Content-Type") ?? "-",
          fetched.Bytes.Count, "bytes, answered", feed.Served, "and refused", feed.Refused)

    // The JSON, read into the document's Structs, is the readings it was written from.
    Local document = Try Json.Read<Feed>(fetched.Text)
    Local taken = ReadingsOf(document)
    Print("json:", document.Cities.Count, "cities,", taken.Count, "readings, the same", taken == readings)

    // Kept in SQLite: a reading again takes the place of the one before it, a warmer one too, and
    // then the first back.
    Local store = Try Store.Open()
    Try store.Add(taken)
    Local again = taken[0]
    Try store.Add([Reading(again.City, again.Hour, again.Celsius + 10.0)])
    Local replaced = (Try store.Series(again.City))[0].1
    Try store.Add(taken[0..5])
    Print("stored:", Try store.Count(), "readings of", Try store.Cities(), "| again, warmer:",
          replaced == again.Celsius + 10.0, "then back:", (Try store.Series(again.City))[0].1 == again.Celsius)
    Local summaries = Try store.Summaries()
    For summary In summaries
        Print("  {summary.City}: low {summary.Low:.1}, high {summary.High:.1}, mean {summary.Mean:.2}, {summary.Count} readings")
    End For

    // Drawn as a chart, and written as a PNG, which reads back as the same pixels.
    Local image = Try Chart(store, 480, 270)
    Local pixels = image.ToBytes()
    Local png = Png.Encode(image)
    Print("chart:", image.Width, image.Height, "a png", Image.FormatOf(png) == ImageFormat.PNG,
          "reads back the same", (Try Image.Decode(png)).ToBytes() == pixels)
    Print("pixels:", Hex.Encode(Sha256.Hash(pixels)), "| colored, outside:", Colored(image))

    // A flat line, none, and readings 12 hours apart draw inside the plot too.
    Print("flat:", Try Drawn([Reading("Oslo", 0, 5.0), Reading("Oslo", 1, 5.0)]))
    Print("empty:", Try Drawn([]))
    Print("every 12 hours:", Try Drawn([Reading("Oslo", 0, 1.0), Reading("Oslo", 12, 9.0), Reading("Oslo", 24, 3.0)]))
    Print("from hour 30:", Try Drawn([Reading("Oslo", 30, 1.0), Reading("Oslo", 31, 9.0)]))

    // Served: the summary as JSON, and both as static files.
    Local site = Try Site.Start(summaries, png)
    Local serving = site.Serve()
    Local web = HttpClient()
    Local summary = Try Await web.GetAsync("{site.Url}/summary.json")
    Local read = Try Json.Read<Summary[]>(summary.Text)
    Print("summary.json:", summary.Status, summary.Headers.Get("Content-Type") ?? "-", "the same", read == summaries)
    Local file = Try Await web.GetAsync("{site.Url}/files/chart.png")
    Print("files/chart.png:", file.Status, file.Headers.Get("Content-Type") ?? "-", "the same", file.Bytes == png)
    Local text = Try Await web.GetAsync("{site.Url}/files/summary.json")
    Local missing = Try Await web.GetAsync("{site.Url}/files/missing.png")
    Print("files/summary.json:", text.Status, "the same", text.Text == Json.Write(summaries), "| missing.png:", missing.Status)

    // To its own WebSocket client: the summary as text, the chart as bytes, then the close.
    Local live = Try Await WebSocket.ConnectAsync("ws://127.0.0.1:{site.Url.Split(":")[2]}/live")
    Local first = Try Await live.ReceiveAsync()
    Local second = Try Await live.ReceiveAsync()
    Local last = Try Await live.ReceiveAsync()
    Local sentSummary = first != Null && first.IsText && (Try Json.Read<Summary[]>(first.Text)) == summaries
    Local sentChart = second != Null && !second.IsText && (Try Image.Decode(second.Bytes)).ToBytes() == pixels
    Print("websocket: summary", sentSummary, "chart", sentChart, "then closed", last == Null, live.CloseCode ?? 0)
    // The server counts it served once the client's close has come back to it.
    For i = 0 Until 5000
        If site.Lives > 0 Then Break
        Await Wait(1.Milliseconds)
    End For

    Try site.Stop()
    Await serving
    Print("served:", site.Lives, "websocket, and stopped", !site.IsRunning)
End Function

Try
    Await Run()
Catch e As Error
    Print("failed:", e.Message)
End Try
