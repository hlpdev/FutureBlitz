// Const type arguments computed with +, -, *, /, and %, / and % rounding toward 0 as an Int's do,
// and of any value of their type, 0 and below among them, wherever they aren't sizes.
Import std.core

Struct Q<Const A: Int>
    Method Get(): Int => A
End Struct

Function Over<Const A: Int, Const B: Int>(x: Q<A>, y: Q<B>): Q<A - B> => Q<A - B>()

Function Show<Const M: Int>(): Int => M

Function Parts<Const N: Int>(): String
    Return "{Show<N / 3>()} {Show<N % 3>()} {Show<-N>()} {Show<(N - 10) * 2>()} {Show<N - -1>()}"
End Function

Print(Over(Q<1>(), Q<3>()).Get(), Q<0>().Get(), Q<-5>().Get(), Over(Q<-2>(), Q<-2>()).Get())
Print(Parts<7>(), "|", Parts<-7>(), "|", Parts<0>())

// A size computed from them is checked in each instance: one less, a half, a remainder past 1.
Function Trimmed<Const N: Int>(a: Int[N]): Int[N - 1]
    Local trimmed: Int[N - 1]
    For i = 0 Until N - 1
        trimmed[i] = a[i + 1]
    End For
    Return trimmed
End Function

Function Halves<Const N: Int>(a: Int[N]): Int
    Local halves: Int[N / 2, N % 3 + 1]
    Return halves.Count
End Function

Local a: Int[4] = [10, 20, 30, 40]
Local trimmed = Trimmed(a)
Print(trimmed.Count, trimmed[0], trimmed[2], Trimmed(trimmed).Count, Halves(a))

// A value is the same argument whatever its parameter's type, so it's one instance, with one
// Static, however code reaches it, and a size computed as an argument is computed is one type.
Struct Counter<Const M: Int>
    Static Field Made: Int = 0
End Struct

Function Bump<Const M: Int>(): Int
    Counter<M>.Made += 1
    Return Counter<M>.Made
End Function

Function Via<Const N: Int8>(): Int => Bump<N>()

Struct Small<Const S: Int8>
End Struct

Function Of<Const N: Int>(s: Small<N>): Int => Bump<N>()

Struct Box<Const M: Int>
    Field Items: Int[M]
End Struct

Struct Box8<Const M: Int8>
End Struct

Function Make<Const N: Int>(): Box8<N> => Box8<N>()

Function Sized<Const N: Int>(a: Int[N]): Int => N

Function Inner<Const N: Int>(): Int
    Local b = Box<N - 1>()
    Local t: Int[N - 1] = b.Items
    Return t.Count + Sized<N - 1>(t)
End Function

Local made: Box8<5> = Make<5>()
Print(Bump<5>(), Via<5>(), Of(Small<5>()), Bump<5>(), Inner<5>())

// A call infers a size from generic code's array, whose size is a Const type parameter or
// computed from one.
Function Count<Const N: Int>(a: Int[N]): Int => N

Function Wrap<Const N: Int>(a: Int[N]): Int => Count(a) * 100 + Count(Trimmed(a))

Print(Wrap(a))

// Recursion through / or % can come back to an instance it made: Bits<8> needs Bits<4>, <2>,
// <1>, and <0>, which needs itself.
Function Bits<Const N: Int>(): Int
    If N == 0 Then Return 0
    Return 1 + Bits<N / 2>()
End Function

Function Cycle<Const N: Int>(n: Int): Int
    If n == 0 Then Return N
    Return Cycle<(N + 1) % 3>(n - 1)
End Function

Print(Bits<8>(), Bits<255>(), Cycle<0>(4), Cycle<2>(7))

// A known part of a computed argument is worked out in an Int64 too, so only what it comes to has
// to fit its parameter's type.
Struct Q8<Const A: Int8>
    Method Get(): Int => A
End Struct

Struct U8<Const A: UInt8>
    Method Get(): Int => A
End Struct

Function Narrow<Const N: Int>(): Int => Q8<N - 200>().Get()

Function Wide<Const N: Int>(): Int => U8<300 - N>().Get() * 1000 + U8<N + -1>().Get()

Print(Narrow<100>(), Wide<100>())
