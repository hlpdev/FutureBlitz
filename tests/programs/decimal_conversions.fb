Check("9223372036854775808 as Int64", int6 == Null ? "Null" : "{int6}", "Null")
Local big6 = D("9223372036854775808").ToBigInt()
Check("9223372036854775808 as BigInt", big6 == Null ? "Null" : "{big6}", "9223372036854775808")
Expect("9223372036854775808 is whole", D("9223372036854775808").IsInteger == True)
Local int7 = D("-9223372036854775808").ToInt64()
Check("-9223372036854775808 as Int64", int7 == Null ? "Null" : "{int7}", "-9223372036854775808")
