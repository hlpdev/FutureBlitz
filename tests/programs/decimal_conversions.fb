// std.math.big's Decimal reads text exactly and writes it as Python's str and format(d, "f")
// do, rounds by each RoundingMode as Python's quantize does, and converts to and from Doubles,
// Int64s, and BigInts: a Double to the shortest Decimal that reads back as it, as it prints.
Import std.core
Import std.math.big

Global checked = 0
Global zero = 0.0

// An infinity, which a Double divided by 0 is.
Function Infinity(): Double => 1.0 / zero

// Counts a check, and says which one failed.
Function Expect(name: String, passed: Bool)
    checked += 1
    If !passed Then Print("{name} failed")
End Function

// Counts a check of what a value shows as, and says what it was when it's another.
Function Check(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// Says how many checks a section made, and starts counting again.
Function Done(section: String)
    Print("{section}: {checked} check{checked == 1 ? "" : "s"}")
    checked = 0
End Function

Function D(text: String): Decimal => Decimal.Parse(text) ?? Decimal(-424242)

// Counts a check of a Decimal against what Python's str shows.
Function CheckDecimal(name: String, actual: Decimal, expected: String)
    Check(name, actual.ToString(), expected)
End Function

CheckDecimal("parse 1.", D("1."), "1")
CheckDecimal("parse .5", D(".5"), "0.5")
CheckDecimal("parse +1", D("+1"), "1")
CheckDecimal("parse -0", D("-0"), "-0")
CheckDecimal("parse 1E5", D("1E5"), "1E+5")
CheckDecimal("parse 1e-5", D("1e-5"), "0.00001")
CheckDecimal("parse 00012.300", D("00012.300"), "12.300")
CheckDecimal("parse 0E-10", D("0E-10"), "0E-10")
CheckDecimal("parse -1.50", D("-1.50"), "-1.50")
CheckDecimal("parse 123456789012345678901234567890.123456789", D("123456789012345678901234567890.123456789"), "123456789012345678901234567890.123456789")
CheckDecimal("parse 1.23E+999999999", D("1.23E+999999999"), "1.23E+999999999")
CheckDecimal("parse -0.000E-7", D("-0.000E-7"), "-0E-10")
CheckDecimal("parse 999999999999999999999999999999999999999999999999999999999999", D("999999999999999999999999999999999999999999999999999999999999"), "999999999999999999999999999999999999999999999999999999999999")
CheckDecimal("parse 1E-999999999", D("1E-999999999"), "1E-999999999")
Expect("parse ", Decimal.Parse("") == Null)
Expect("parse abc", Decimal.Parse("abc") == Null)
Expect("parse 1e", Decimal.Parse("1e") == Null)
Expect("parse 1.2.3", Decimal.Parse("1.2.3") == Null)
Expect("parse  1", Decimal.Parse(" 1") == Null)
Expect("parse 1 ", Decimal.Parse("1 ") == Null)
Expect("parse NaN", Decimal.Parse("NaN") == Null)
Expect("parse -Infinity", Decimal.Parse("-Infinity") == Null)
Expect("parse inf", Decimal.Parse("inf") == Null)
Expect("parse sNaN", Decimal.Parse("sNaN") == Null)
Expect("parse 1_000", Decimal.Parse("1_000") == Null)
Expect("parse 0x10", Decimal.Parse("0x10") == Null)
Expect("parse e5", Decimal.Parse("e5") == Null)
Expect("parse .", Decimal.Parse(".") == Null)
Expect("parse +", Decimal.Parse("+") == Null)
Expect("parse -", Decimal.Parse("-") == Null)
Expect("parse 1e+", Decimal.Parse("1e+") == Null)
Expect("parse ١", Decimal.Parse("١") == Null)
Expect("parse 1E+9999999999999999999", Decimal.Parse("1E+9999999999999999999") == Null)
Expect("parse NUL", Decimal.Parse("1\0") == Null)
Done("parsing")

Check("plain 0", D("0").ToPlainString(), "0")
CheckDecimal("shown 0", D("0"), "0")
Expect("0 as a Double", D("0").ToDouble() == 0.0)
Check("plain -0", D("-0").ToPlainString(), "-0")
CheckDecimal("shown -0", D("-0"), "-0")
Expect("-0 as a Double", D("-0").ToDouble() == -0.0)
Check("plain 1.50", D("1.50").ToPlainString(), "1.50")
CheckDecimal("shown 1.50", D("1.50"), "1.50")
Expect("1.50 as a Double", D("1.50").ToDouble() == 1.5)
Check("plain 1E+3", D("1E+3").ToPlainString(), "1000")
CheckDecimal("shown 1E+3", D("1E+3"), "1E+3")
Expect("1E+3 as a Double", D("1E+3").ToDouble() == 1000.0)
Check("plain 1.5E+3", D("1.5E+3").ToPlainString(), "1500")
CheckDecimal("shown 1.5E+3", D("1.5E+3"), "1.5E+3")
Expect("1.5E+3 as a Double", D("1.5E+3").ToDouble() == 1500.0)
Check("plain 1E-7", D("1E-7").ToPlainString(), "0.0000001")
CheckDecimal("shown 1E-7", D("1E-7"), "1E-7")
Expect("1E-7 as a Double", D("1E-7").ToDouble() == 1e-07)
Check("plain 0.000001", D("0.000001").ToPlainString(), "0.000001")
CheckDecimal("shown 0.000001", D("0.000001"), "0.000001")
Expect("0.000001 as a Double", D("0.000001").ToDouble() == 1e-06)
Check("plain 0.0000001", D("0.0000001").ToPlainString(), "0.0000001")
CheckDecimal("shown 0.0000001", D("0.0000001"), "1E-7")
Expect("0.0000001 as a Double", D("0.0000001").ToDouble() == 1e-07)
Check("plain -12.3400", D("-12.3400").ToPlainString(), "-12.3400")
CheckDecimal("shown -12.3400", D("-12.3400"), "-12.3400")
Expect("-12.3400 as a Double", D("-12.3400").ToDouble() == -12.34)
Check("plain 123456789012345678901234567890", D("123456789012345678901234567890").ToPlainString(), "123456789012345678901234567890")
CheckDecimal("shown 123456789012345678901234567890", D("123456789012345678901234567890"), "123456789012345678901234567890")
Expect("123456789012345678901234567890 as a Double", D("123456789012345678901234567890").ToDouble() == 1.2345678901234568e+29)
Check("plain 1.23E+30", D("1.23E+30").ToPlainString(), "1230000000000000000000000000000")
CheckDecimal("shown 1.23E+30", D("1.23E+30"), "1.23E+30")
Expect("1.23E+30 as a Double", D("1.23E+30").ToDouble() == 1.23e+30)
Check("plain 0E-10", D("0E-10").ToPlainString(), "0.0000000000")
CheckDecimal("shown 0E-10", D("0E-10"), "0E-10")
Expect("0E-10 as a Double", D("0E-10").ToDouble() == 0.0)
Check("plain 5E-999", D("5E-999").ToPlainString(), "0.")
CheckDecimal("shown 5E-999", D("5E-999"), "5E-999")
Expect("5E-999 as a Double", D("5E-999").ToDouble() == 0.0)
Check("plain -1E+6", D("-1E+6").ToPlainString(), "-1000000")
CheckDecimal("shown -1E+6", D("-1E+6"), "-1E+6")
Expect("-1E+6 as a Double", D("-1E+6").ToDouble() == -1000000.0)
Expect("1E+400 as a Double", D("1E+400").ToDouble() == Infinity())
Expect("-1E+400 as a Double", D("-1E+400").ToDouble() == -Infinity())
Expect("1E-400 as a Double", D("1E-400").ToDouble() == 0.0)
Expect("0.1 as a Double", D("0.1").ToDouble() == 0.1)
Expect("2.5 as a Double", D("2.5").ToDouble() == 2.5)
Expect("1.7976931348623157E+308 as a Double", D("1.7976931348623157E+308").ToDouble() == 1.7976931348623157e+308)
Expect("1.7976931348623159E+308 as a Double", D("1.7976931348623159E+308").ToDouble() == Infinity())
Expect("4.9E-324 as a Double", D("4.9E-324").ToDouble() == 5e-324)
Expect("2.4703282292062328E-324 as a Double", D("2.4703282292062328E-324").ToDouble() == 5e-324)
Expect("0.30000000000000004441 as a Double", D("0.30000000000000004441").ToDouble() == 0.30000000000000004)
CheckDecimal("from 0.1", Decimal.FromDouble(0.1), "0.1")
CheckDecimal("from -2.5", Decimal.FromDouble(-2.5), "-2.5")
CheckDecimal("from 1e22", Decimal.FromDouble(1e22), "1E+22")
CheckDecimal("from 5e-324", Decimal.FromDouble(5e-324), "5E-324")
CheckDecimal("from 1.7976931348623157e308", Decimal.FromDouble(1.7976931348623157e308), "1.7976931348623157E+308")
CheckDecimal("from 100.0", Decimal.FromDouble(100.0), "100")
CheckDecimal("from 123456789.0", Decimal.FromDouble(123456789.0), "123456789")
CheckDecimal("from 0.0", Decimal.FromDouble(0.0), "0")
CheckDecimal("from -0.0", Decimal.FromDouble(-0.0), "-0")
CheckDecimal("from 1.5e-7", Decimal.FromDouble(1.5e-7), "1.5E-7")
CheckDecimal("from 0.30000000000000004", Decimal.FromDouble(0.30000000000000004), "0.30000000000000004")
CheckDecimal("from 1e16", Decimal.FromDouble(1e16), "1E+16")
CheckDecimal("from 12345678901234567.0", Decimal.FromDouble(12345678901234567.0), "12345678901234568")
Done("text and Doubles")

Local int0 = D("5").ToInt64()
Check("5 as Int64", int0 == Null ? "Null" : "{int0}", "5")
Local big0 = D("5").ToBigInt()
Check("5 as BigInt", big0 == Null ? "Null" : "{big0}", "5")
Expect("5 is whole", D("5").IsInteger == True)
Local int1 = D("5.00").ToInt64()
Check("5.00 as Int64", int1 == Null ? "Null" : "{int1}", "5")
Local big1 = D("5.00").ToBigInt()
Check("5.00 as BigInt", big1 == Null ? "Null" : "{big1}", "5")
Expect("5.00 is whole", D("5.00").IsInteger == True)
Local int2 = D("5.5").ToInt64()
Check("5.5 as Int64", int2 == Null ? "Null" : "{int2}", "Null")
Local big2 = D("5.5").ToBigInt()
Check("5.5 as BigInt", big2 == Null ? "Null" : "{big2}", "Null")
Expect("5.5 is whole", D("5.5").IsInteger == False)
Local int3 = D("1E+3").ToInt64()
Check("1E+3 as Int64", int3 == Null ? "Null" : "{int3}", "1000")
Local big3 = D("1E+3").ToBigInt()
Check("1E+3 as BigInt", big3 == Null ? "Null" : "{big3}", "1000")
Expect("1E+3 is whole", D("1E+3").IsInteger == True)
Local int4 = D("-0").ToInt64()
Check("-0 as Int64", int4 == Null ? "Null" : "{int4}", "0")
Local big4 = D("-0").ToBigInt()
Check("-0 as BigInt", big4 == Null ? "Null" : "{big4}", "0")
Expect("-0 is whole", D("-0").IsInteger == True)
