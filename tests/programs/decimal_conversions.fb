Check("-9223372036854775809 as Int64", int8 == Null ? "Null" : "{int8}", "Null")
Local big8 = D("-9223372036854775809").ToBigInt()
Check("-9223372036854775809 as BigInt", big8 == Null ? "Null" : "{big8}", "-9223372036854775809")
Expect("-9223372036854775809 is whole", D("-9223372036854775809").IsInteger == True)
Local int9 = D("1E+30").ToInt64()
Check("1E+30 as Int64", int9 == Null ? "Null" : "{int9}", "Null")
Local big9 = D("1E+30").ToBigInt()
Check("1E+30 as BigInt", big9 == Null ? "Null" : "{big9}", "1000000000000000000000000000000")
Expect("1E+30 is whole", D("1E+30").IsInteger == True)
Local int10 = D("-12.000").ToInt64()
Check("-12.000 as Int64", int10 == Null ? "Null" : "{int10}", "-12")
Local big10 = D("-12.000").ToBigInt()
Check("-12.000 as BigInt", big10 == Null ? "Null" : "{big10}", "-12")
Expect("-12.000 is whole", D("-12.000").IsInteger == True)
Local int11 = D("0.001").ToInt64()
Check("0.001 as Int64", int11 == Null ? "Null" : "{int11}", "Null")
Local big11 = D("0.001").ToBigInt()
Check("0.001 as BigInt", big11 == Null ? "Null" : "{big11}", "Null")
Expect("0.001 is whole", D("0.001").IsInteger == False)
CheckDecimal("from a BigInt", Decimal(BigInt.Parse("-1339977575150401604775368152201573794918385195880954042616080") ?? BigInt(0)), "-1339977575150401604775368152201573794918385195880954042616080")
CheckDecimal("from an Int64", Decimal(-9223372036854775807 - 1), "-9223372036854775808")
Expect("zero and one", Decimal.Zero() == 0 && Decimal.One() == 1)
Expect("1.0 hashes as 1.00", D("1.0").Hash() == D("1.00").Hash())
Expect("0 hashes as -0E+5", D("0").Hash() == D("-0E+5").Hash())
Expect("1E+2 hashes as 100", D("1E+2").Hash() == D("100").Hash())
Expect("-1.50 hashes as -1.5", D("-1.50").Hash() == D("-1.5").Hash())
Expect("123.4560 hashes as 123.456", D("123.4560").Hash() == D("123.456").Hash())
Expect("0E-30 hashes as 0", D("0E-30").Hash() == D("0").Hash())
Expect("other hashes", D("1.5").Hash() != D("-1.5").Hash() && D("1").Hash() != D("10").Hash())
Done("whole numbers")

CheckDecimal("2.5 to -2 HALF_EVEN", D("2.5").Round(-2, RoundingMode.HALF_EVEN), "0E+2")
