Check("9223372036854775807 as Int64", int5 == Null ? "Null" : "{int5}", "9223372036854775807")
Local big5 = D("9223372036854775807").ToBigInt()
Check("9223372036854775807 as BigInt", big5 == Null ? "Null" : "{big5}", "9223372036854775807")
Expect("9223372036854775807 is whole", D("9223372036854775807").IsInteger == True)
