// XML 1.0's well-formedness rules, as XmlReader keeps them: each document that keeps them reads,
// as the canonical form given, as James Clark's canonical XML writes it, and each that breaks one
// throws. These are the rules the W3C XML conformance suite checks, which std.data passes, but
// whose cases can't be copied here.

Import std.core
Import std.collections
Import std.data.xml_reader

Function AddEscaped(out: UInt8[], text: String)
    For b In text.Bytes
        If b == 38
            out.AddAll("&amp;".Bytes)
        ElseIf b == 60
            out.AddAll("&lt;".Bytes)
        ElseIf b == 62
            out.AddAll("&gt;".Bytes)
        ElseIf b == 34
            out.AddAll("&quot;".Bytes)
        ElseIf b == 9
            out.AddAll("&#9;".Bytes)
        ElseIf b == 10
            out.AddAll("&#10;".Bytes)
        ElseIf b == 13
            out.AddAll("&#13;".Bytes)
        Else
            out.Add(b)
        End If
    End For
End Function

// The document's canonical form: elements with their attributes in order, text and CDATA
// escaped, processing instructions, and no comments.
Function Canonical(text: String): UInt8[] Throws ParseError
    Local reader = XmlReader(text)
    Local out: UInt8[] = []
    Loop
        Local event = Try reader.Next()
        If event == Null Then Return out
        Select event.Kind
            Case XmlEventKind.START
                out.Add(60)
                out.AddAll(event.Name.Bytes)
                Local names = event.Attributes.Keys()
                names.Sort()
                For name In names
                    out.Add(32)
                    out.AddAll(name.Bytes)
                    out.AddAll("=\"".Bytes)
                    AddEscaped(out, event.Attributes[name])
                    out.Add(34)
                End For
                out.Add(62)
            Case XmlEventKind.END
                out.AddAll("</".Bytes)
                out.AddAll(event.Name.Bytes)
                out.Add(62)
            Case XmlEventKind.TEXT
                AddEscaped(out, event.Text)
            Case XmlEventKind.CDATA
                AddEscaped(out, event.Text)
            Case XmlEventKind.INSTRUCTION
                out.AddAll("<?".Bytes)
                out.AddAll(event.Name.Bytes)
                out.Add(32)
                out.AddAll(event.Text.Bytes)
                out.AddAll("?>".Bytes)
            Default
        End Select
    End Loop
End Function

// A document that keeps the rules, and its canonical form.
Function Good(about: String, text: String, canonical: String)
    Try
        Local found = Try Canonical(text)
        Print(found == canonical.Bytes ? "ok  " : "DIFF", about)
    Catch e As ParseError
        Print("FAIL", about, e.Message)
    End Try
End Function

// A document that breaks one.
Function Bad(about: String, text: String)
    Try
        Canonical(text)
        Print("FAIL", about, "reads")
    Catch e As ParseError
        Print("ok  ", about)
    End Try
End Function

// Documents, prologs, and declarations.
Good("a declaration, then misc", "<?xml version='1.0'?>\n<!-- c --><?p x?>\n<a/>\n<?q?>", "<?p x?><a></a><?q ?>")
Good("encoding and standalone", "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone='no' ?><a/>", "<a></a>")
Good("a later version 1.x", "<?xml version='1.7'?><a/>", "<a></a>")
Good("a byte order mark", "\u{FEFF}<a/>", "<a></a>")
Bad("no root", "<!-- only -->")
Bad("two roots", "<a/><b/>")
Bad("text before the root", "x<a/>")
Bad("text after the root", "<a/>x")
Bad("a declaration not at the start", " <?xml version='1.0'?><a/>")
Bad("a declaration without a version", "<?xml encoding='UTF-8'?><a/>")
Bad("a declaration's parts out of order", "<?xml version='1.0' standalone='yes' encoding='UTF-8'?><a/>")
Bad("standalone that isn't yes or no", "<?xml version='1.0' standalone='maybe'?><a/>")
Bad("a version that isn't 1.x", "<?xml version='2.0'?><a/>")
Bad("a doctype after the root", "<a/><!DOCTYPE a>")
Bad("two doctypes", "<!DOCTYPE a><!DOCTYPE a><a/>")

// Elements, attributes, and names.
Good("attributes in quotes of either kind", "<a y='2' x=\"1\"/>", "<a x=\"1\" y=\"2\"></a>")
Good("names of letters past ASCII", "<übung ñ='1'><x.y-z_9/></übung>", "<übung ñ=\"1\"><x.y-z_9></x.y-z_9></übung>")
Good("spaces in tags", "<a  b = '1' ></a >", "<a b=\"1\"></a>")
Bad("an end tag that doesn't match", "<a></b>")
Bad("an unclosed element", "<a><b></b>")
Bad("an attribute twice", "<a b='1' b='2'/>")
Bad("an attribute without a value", "<a b/>")
Bad("an attribute without quotes", "<a b=1/>")
Bad("attributes without a space", "<a b='1'c='2'/>")
Bad("a name starting with a digit", "<1a/>")
Bad("'<' in an attribute", "<a b='<'/>")
Bad("an end tag with an attribute", "<a></a b='1'>")

// Character data and references.
Good("references in text", "<a>&lt;&gt;&amp;&apos;&quot;&#65;&#x42;&#x1F600;</a>", "<a>&lt;&gt;&amp;'&quot;AB😀</a>")
Good("line ends normalized", "<a>x\r\ny\rz</a>", "<a>x&#10;y&#10;z</a>")
Good("a character reference to CR", "<a>x&#13;y</a>", "<a>x&#13;y</a>")
Good("CDATA as text", "<a><![CDATA[<&]]]></a>", "<a>&lt;&amp;]</a>")
Good("']]' and '>' alone in text", "<a>]] > ]</a>", "<a>]] &gt; ]</a>")
Bad("']]>' in text", "<a>]]></a>")
Bad("a bare '&'", "<a>&</a>")
Bad("a reference without ';'", "<a>&amp</a>")
Bad("a reference to 0", "<a>&#0;</a>")
Bad("a reference to a surrogate", "<a>&#xD800;</a>")
Bad("a reference to FFFE", "<a>&#xFFFE;</a>")
Bad("a control character", "<a>\u{1}</a>")
Bad("an undeclared entity", "<a>&nope;</a>")

// Comments and processing instructions.
Good("a comment with dashes apart", "<a><!-- a - b --></a>", "<a></a>")
Good("an instruction's text kept", "<a><?pi  some data ?></a>", "<a><?pi some data ?></a>")
Bad("'--' in a comment", "<a><!-- a -- b --></a>")
Bad("a comment ending '--->'", "<a><!-- a ---></a>")
Bad("an instruction named xml", "<a><?XmL x?></a>")
Bad("an instruction without a space after its target", "<a><?pi\u{1}?></a>")
Bad("an unended instruction", "<a><?pi x</a>")

// Attribute values: normalization, and types from ATTLIST.
Good("spaces in a value made spaces", "<a b='x\ty\nz'/>", "<a b=\"x y z\"></a>")
Good("character references to spaces kept", "<a b='x&#9;y&#10;z'/>", "<a b=\"x&#9;y&#10;z\"></a>")
Good("a tokenized type's spaces collapsed",
     "<!DOCTYPE a [<!ATTLIST a b NMTOKENS #IMPLIED c CDATA #IMPLIED>]><a b='  x   y ' c=' x  y '/>",
     "<a b=\"x y\" c=\" x  y \"></a>")
Good("defaults given, and the first declaration taken",
     "<!DOCTYPE a [<!ATTLIST a b CDATA 'one' c (x|y) 'y' d CDATA #FIXED 'f' e CDATA #REQUIRED>" +
     "<!ATTLIST a b CDATA 'two'>]><a e='1'/>",
     "<a b=\"one\" c=\"y\" d=\"f\" e=\"1\"></a>")
Good("a default that refers to an entity",
     "<!DOCTYPE a [<!ENTITY e 'v&#38;#38;w'><!ATTLIST a b CDATA '&e;'>]><a/>", "<a b=\"v&amp;w\"></a>")

// Entities.
Good("an internal entity's text, markup and all",
     "<!DOCTYPE a [<!ENTITY e '<b x=\"1\">t</b>'>]><a>&e;&e;</a>", "<a><b x=\"1\">t</b><b x=\"1\">t</b></a>")
Good("entities in entities", "<!DOCTYPE a [<!ENTITY e '[&f;]'><!ENTITY f 'F'>]><a>&e;</a>", "<a>[F]</a>")
Good("an entity's character references replaced where it's declared",
     "<!DOCTYPE a [<!ENTITY e '&#38;#60;'>]><a>&e;</a>", "<a>&lt;</a>")
Good("an entity in an attribute", "<!DOCTYPE a [<!ENTITY e 'v\nw'>]><a b='&e;'/>", "<a b=\"v w\"></a>")
Good("a parameter entity's declarations",
     "<!DOCTYPE a [<!ENTITY % p '<!ENTITY e \"from p\">'>%p;]><a>&e;</a>", "<a>from p</a>")
Good("an entity declared twice keeps the first", "<!DOCTYPE a [<!ENTITY e '1'><!ENTITY e '2'>]><a>&e;</a>",
     "<a>1</a>")
Good("an undeclared entity with an external subset", "<!DOCTYPE a SYSTEM 'a.dtd'><a>x&nope;y</a>", "<a>xy</a>")
Bad("an undeclared entity, standalone",
    "<?xml version='1.0' standalone='yes'?><!DOCTYPE a SYSTEM 'a.dtd'><a>&nope;</a>")
Bad("an entity that refers to itself", "<!DOCTYPE a [<!ENTITY e '&f;'><!ENTITY f '&e;'>]><a>&e;</a>")
Bad("an entity that starts an element it doesn't end", "<!DOCTYPE a [<!ENTITY e '<b>'>]><a>&e;</b></a>")
Bad("an entity that ends an element it didn't start", "<!DOCTYPE a [<!ENTITY e '</a>'>]><a>&e;")
Bad("'<' from an entity in an attribute", "<!DOCTYPE a [<!ENTITY e '<'>]><a b='&e;'/>")
Bad("an external entity in an attribute", "<!DOCTYPE a [<!ENTITY e SYSTEM 'e.txt'>]><a b='&e;'/>")
Bad("an unparsed entity in text", "<!DOCTYPE a [<!NOTATION n SYSTEM 'n'><!ENTITY e SYSTEM 'e' NDATA n>]><a>&e;</a>")
Bad("a parameter entity in an internal subset's declaration",
    "<!DOCTYPE a [<!ENTITY % p 'CDATA'><!ATTLIST a b %p; #IMPLIED>]><a/>")
Bad("a parameter entity in an internal entity's value", "<!DOCTYPE a [<!ENTITY % p 'x'><!ENTITY e '%p;'>]><a/>")
Bad("a parameter entity's text that isn't whole declarations", "<!DOCTYPE a [<!ENTITY % p '<!ENTITY'>%p; e 'x'>]><a/>")

// Past a parameter entity that isn't read, declarations are taken in a standalone document, and
// only checked in one that isn't, an element's earlier ATTLIST or not (XML 1.0's 5.1).
Good("standalone, an entity past an unread parameter entity",
     "<?xml version='1.0' standalone='yes'?><!DOCTYPE a [<!ENTITY % e SYSTEM 'e.dtd'>%e;<!ENTITY x 'y'>]><a>&x;</a>",
     "<a>y</a>")
Good("standalone, an ATTLIST past an unread parameter entity",
     "<?xml version='1.0' standalone='yes'?><!DOCTYPE a [<!ENTITY % e SYSTEM 'e.dtd'>%e;<!ATTLIST a b CDATA 'v'>]><a/>",
     "<a b=\"v\"></a>")
Good("an ATTLIST past an unread parameter entity, after the element's first",
     "<!DOCTYPE a [<!ATTLIST a x CDATA 'one'><!ENTITY % e SYSTEM 'e.dtd'>%e;<!ATTLIST a y CDATA 'two'>]><a/>",
     "<a x=\"one\"></a>")
Good("an ATTLIST's type past an unread parameter entity",
     "<!DOCTYPE a [<!ATTLIST a x CDATA #IMPLIED><!ENTITY % e SYSTEM 'e.dtd'>%e;<!ATTLIST a y NMTOKENS #IMPLIED>]>" +
     "<a y='  p   q '/>", "<a y=\"  p   q \"></a>")
Bad("an ATTLIST past an unread parameter entity, still checked",
    "<!DOCTYPE a [<!ENTITY % e SYSTEM 'e.dtd'>%e;<!ATTLIST a y NUMBER #IMPLIED>]><a/>")

// The internal subset's declarations' syntax.
Good("element declarations of each kind",
     "<!DOCTYPE a [<!ELEMENT a (b, (c | d)*, e?)+><!ELEMENT b EMPTY><!ELEMENT c ANY>" +
     "<!ELEMENT d (#PCDATA)><!ELEMENT e (#PCDATA | b | c)*>]><a/>", "<a></a>")
Good("notations, and public IDs", "<!DOCTYPE a [<!NOTATION n PUBLIC '-//x//y' 'z'><!NOTATION m PUBLIC 'p'>]><a/>",
     "<a></a>")
Good("comments and instructions in the subset", "<!DOCTYPE a [<!-- c --><?p x?>]><a/>", "<a></a>")
Bad("a content model mixing ',' and '|'", "<!DOCTYPE a [<!ELEMENT a (b, c | d)>]><a/>")
Bad("mixed content with names, without '*'", "<!DOCTYPE a [<!ELEMENT a (#PCDATA | b)>]><a/>")
Bad("an element declaration without content", "<!DOCTYPE a [<!ELEMENT a>]><a/>")
Bad("an attribute type that isn't one", "<!DOCTYPE a [<!ATTLIST a b NUMBER #IMPLIED>]><a/>")
Bad("an ATTLIST default without quotes", "<!DOCTYPE a [<!ATTLIST a b CDATA x>]><a/>")
Bad("an entity declaration without a space before its value", "<!DOCTYPE a [<!ENTITY e'x'>]><a/>")
Bad("a public ID with a bad character", "<!DOCTYPE a PUBLIC 'a{{b' 'c'><a/>")
Bad("a subset that isn't ended", "<!DOCTYPE a [<!ENTITY e 'x'><a/>")
Bad("text in the subset", "<!DOCTYPE a [text]><a/>")
