// HTTPS through a program's own HttpServer, as ListenTls has it, with the test certificates
// net_tls/make_certificates.sh made: requests through an HttpClient that trusts the test CA, on
// its connections kept open, and through a client each, fifty at once; a client that trusts
// only the OS's roots, which refuses the server, one that speaks HTTP to it, and one that
// connects and says nothing, after which the server still answers, and one that sends its
// handshake a byte at a time, which the IdleTimeout closes; and WebSockets at wss://,
// Async and blocking on a Thread of their own, which a handler takes over, and one that trusts
// only the OS's roots. The server holds nothing of them after it stops, which the leak report at
// the end would show.

Import std.core
Import std.collections
Import std.concurrent
Import std.crypto
Import std.ffi
Import std.net
Import std.net.http
Import std.net.ws
Import std.time
Import "./http_server_tls/certificates"

// The certificates in pem, which make_certificates.sh made, so they read.
Function Certificates(pem: String): Certificate[]
    Return (Try? Certificate.AllFromPem(pem)).Expect("the test's certificates read")
End Function

// A client that trusts only the test CA.
Function Trusting(): HttpClient
    Local client = HttpClient()
    client.TrustOnly(Certificates(ca_pem))
    Return client
End Function

// A TLS client that trusts only the test CA, for a WebSocket.
Function TlsTrusting(): TlsClient
    Local client = TlsClient()
    client.TrustOnly(Certificates(ca_pem))
    Return client
End Function

// Echoes each message of a WebSocket the request opens until the client's Close.
Async Function Echo(request: HttpRequest): HttpResponse
    Try
        Local ws = Try Await WebSocket.AcceptAsync(request)
        Loop
            Local message = Try Await ws.ReceiveAsync()
            If message == Null Then Break
            Try Await ws.SendAsync(message.Text)
        End Loop
    Catch e As NetError
        Return HttpResponse.Of(StatusCode.BAD_REQUEST)
    End Try

    Return HttpResponse.Of(StatusCode.OK)
End Function

// Whether a request through a client of its own to `url` gets the route's answer.
Async Function Fetched(url: String): Bool
    Try
        Return (Try Await Trusting().GetAsync(url)).Text == "hello over HTTP/1.1"
    Catch e As Error
        Return False
    End Try
End Function

Function Count(results: Bool[]): Int
    Local count = 0
    For result In results
        If result Then count += 1
    End For
    Return count
End Function

Local server = HttpServer()
server.IdleTimeout = 1.Seconds
server.Get("/hello", Async Function(request: HttpRequest): HttpResponse
    Return HttpResponse.Of(Body.Text("hello over {request.Version}"))
End Function)
server.Get("/ws", Function(request: HttpRequest) => Echo(request))
Try
    Local key = (Try? Key.FromPem(localhost_key)).Expect("the test's keys read")
    server.ListenTls(SocketAddress(IpAddress.Loopback, 0),
                     TlsServer(Certificates(localhost_pem), key))
    Local serving = server.Serve()
    Local port = server.LocalAddress.Port
    Local url = "https://127.0.0.1:{port}/hello"

    Local client = Trusting()
    Local same = 0
    For n = 1 To 100
        If (Try Await client.GetAsync(url)).Text == "hello over HTTP/1.1" Then same += 1
    End For
    Print("one client:", same)

    Local tasks: Task<Bool>[] = []
    For n = 1 To 50
        tasks.Add(Fetched(url))
    End For
    Print("a client each, fifty at once:", Count(Await WhenAll(tasks)))

    Try
        Try Await HttpClient().GetAsync(url)
        Print("the OS's roots took the test CA")
    Catch e As NetError
        Print("the OS's roots: NetError {e.Kind}")
    End Try

    Try
        Try Await HttpClient().GetAsync("http://127.0.0.1:{port}/hello")
        Print("HTTP was answered")
    Catch e As NetError
        Print("HTTP: a NetError")
    End Try

    // A client that connects and says nothing holds no one else up, and is closed after the
    // IdleTimeout.
    Local silent = Try Await TcpStream.ConnectAsync("127.0.0.1", port)
    Print("with a silent client:", Await Fetched(url))
    silent.ReadTimeout = 5.Seconds
    Print("the silent client was closed:", (Try? Await silent.ReadAsync(Buffer<UInt8>(16))) == 0)

    // One that sends a handshake's record a byte at a time, each well inside the IdleTimeout, is
    // closed once the IdleTimeout has passed for the whole handshake. Its record takes 30 seconds
    // or more to send, so it's closed long before it has sent it, however busy the machine is,
    // where a limit on each read alone would wait for the whole record.
    Local trickling = Try Await TcpStream.ConnectAsync("127.0.0.1", port)
    trickling.ReadTimeout = Duration.Zero()
    Local record: UInt8[] = [0x16, 0x03, 0x01, 0x01, 0x2C]
    For i = 0 Until 300
        record.Add(i As UInt8)
    End For

    // How many of its bytes were left to send when it was closed, or 0 for none.
    Local left = 0
    For i = 0 Until record.Count
        If (Try? Await trickling.ReadAsync(Buffer<UInt8>(16))) == 0
            left = record.Count - i
            Break
        End If

        Try? Await trickling.WriteAsync(Buffer<UInt8>.From([record[i]]))
        Await Timer.After(100.Milliseconds)
    End For

    Print("a client that sends a byte at a time was closed before it sent its record:",
          left > 50)
    trickling.Close()

    // WebSockets over TLS: Async on the main thread, and blocking on a Thread of their own.
    Local wss = "wss://127.0.0.1:{port}/ws"
    Local ws = Try Await WebSocket.ConnectAsync(wss, [], 5.Seconds, TlsTrusting())
    Try Await ws.SendAsync("hello over wss")
    Print("Async:", (Try Await ws.ReceiveAsync())?.Text ?? "-")
    Await ws.CloseAsync()
    Print("closed:", (Try Await ws.ReceiveAsync()) == Null, ws.State)

    // The Thread gets the URL, and gives what it said, through Channels.
    Const urls = Channel<String>(1)
    Const said = Channel<String>(1)
    urls.Send(wss)
    Local blocking = Thread.Start(Function()
        Try
            Local socket = WebSocket.Connect(urls.Receive() ?? "", [], 5.Seconds, TlsTrusting())
            socket.Send("hello from a Thread")
            Local back = socket.Receive()?.Text ?? "-"
            socket.Close()
            said.Send("{back}, {socket.Receive() == Null}")
        Catch e As Error
            said.Send("failed: {e.Message}")
        End Try
    End Function)
    Loop
        Local back = said.TryReceive()
        If back != Null
            Print("blocking:", back)
            Break
        End If

        Await Timer.After(10.Milliseconds)
    End Loop

    blocking.Join()
    Try
        Try Await WebSocket.ConnectAsync(wss)
        Print("the OS's roots took the test CA")
    Catch e As NetError
        Print("wss with the OS's roots: NetError {e.Kind}")
    End Try

    server.Stop()
    Await serving
Catch e As Error
    Print("failed: {e.Message}")
End Try
