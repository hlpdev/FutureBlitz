// A zip's LZMA entry takes LZMA's levels from 1 to 9, as minizip-ng stores an entry at 0, and Add
// panics where it's called for another.
Import std.core
Import std.compress

Local zip = ZipWriter()
zip.Add("fine.txt", "fine".Bytes, ZipMethod.STORE, 100)
zip.Add("past.txt", "past".Bytes, ZipMethod.LZMA, 10)
