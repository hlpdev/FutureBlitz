// std.db's Query<T> reads each row as a T, which Load<T> makes of an Object of its columns by
// their names: an integer, a real, text, a blob, or NULL each, into a Struct's or Class's Fields
// of their names, or of the keys @Rename gives them, an Enum by its member's name, a Bool by 0 or
// 1, and a T? as Null for NULL, and a Field no column has its default or its zero; a Statement's
// after its parameters are bound. A row that doesn't make a T throws a ParseError at its index
// and its Field.
Import std.core
Import std.collections
Import std.db

Enum Role
    GUEST, ADMIN
End Enum

Struct Player
    Field Name: String
    Field Level: Int
    Field Score: Double
    Field Role: Role
    Field Note: String?
    Field Active: Bool
    Field Badge: UInt8[]
End Struct

Alias S = String

Struct Named
    Field Name: String
End Struct

Class Summary
    Field Players = 0
    @Rename("best") Field Top = 0.0
End Class

Const Everything = "SELECT name AS Name, level AS Level, score AS Score, role AS Role, " +
                   "note AS Note, active AS Active, badge AS Badge FROM players"

Function Run() Throws DatabaseError, ParseError
    Local db = Try Database.Open(":memory:")
    Try db.Execute("CREATE TABLE players (name TEXT, level INTEGER, score REAL, role TEXT, " +
                   "note TEXT, active INTEGER, badge BLOB)")
    Try db.Execute("INSERT INTO players VALUES ('ada', 3, 1.5, 'ADMIN', NULL, 1, x'0aff'), " +
                   "('bob', 1, 2, 'guest', 'new', 0, x'01')")
    For player In Try db.Query<Player>(Everything)
        Print(player.Name, player.Level, player.Score, player.Role, player.Note ?? "none",
              player.Active, player.Badge)
    End For

    // A Field no column has takes its default, or else its zero.
    For player In Try db.Query<Player>("SELECT name AS Name, badge AS Badge FROM players")
        Print(player.Name, player.Level, player.Score, player.Role, player.Note ?? "none",
              player.Active, player.Badge)
    End For

    Local summary = Try db.Query<Summary>("SELECT count(*) AS Players, max(score) AS best " +
                                          "FROM players")
    Print(summary.Count, summary[0].Players, summary[0].Top)

    // Columns a T has no Field for are left alone, and of two of one name the first counts.
    Print(Try db.Query<Named>("SELECT 'first' AS Name, 'second' AS Name, 7 AS Other")[0].Name)
    Print((Try db.Query<Named>("SELECT name AS Name FROM players WHERE level > 9")).Count)

    Local strong = Try db.Prepare(Everything + " WHERE level >= ? ORDER BY name")
    Try strong.Bind(1, 2)
    Print((Try strong.Query<Player>()).Count)
    Try strong.Bind(1, 0)
    Print((Try strong.Query<Named>()).Count)
    Print((Try strong.Query<Named, Int>(3)).Count)

    // Values bind in order, as Rows' do, one to eight of them.
    Print((Try db.Query<Named, String>("SELECT name AS Name FROM players WHERE role = ?",
                                       "ADMIN"))[0].Name)
    Local eight = Try db.Query<Named, Int, Int, Int, Int, Int, Int, Int, String>(
        "SELECT (? + ? + ? + ? + ? + ? + ?) || ? AS Name", 1, 2, 3, 4, 5, 6, 7, "!")
    Print(eight[0].Name)

    Local sql: String[] = []
    For n = 1 To 8
        sql.Add("SELECT " + Repeated("?", n).ToArray().Join(" || ") + " AS Name")
    End For

    Local joined: String[] = []
    joined.Add((Try db.Query<Named, S>(sql[0], "a"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[0])).Query<Named, S>("a"))[0].Name)
    joined.Add((Try db.Query<Named, S, S>(sql[1], "a", "b"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[1])).Query<Named, S, S>("a", "b"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S>(sql[2], "a", "b", "c"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[2])).Query<Named, S, S, S>("a", "b", "c"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S, S>(sql[3], "a", "b", "c", "d"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[3])).Query<Named, S, S, S, S>("a", "b", "c", "d"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S, S, S>(sql[4], "a", "b", "c", "d", "e"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[4])).Query<Named, S, S, S, S, S>(
        "a", "b", "c", "d", "e"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S, S, S, S>(
        sql[5], "a", "b", "c", "d", "e", "f"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[5])).Query<Named, S, S, S, S, S, S>(
        "a", "b", "c", "d", "e", "f"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S, S, S, S, S>(
        sql[6], "a", "b", "c", "d", "e", "f", "g"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[6])).Query<Named, S, S, S, S, S, S, S>(
        "a", "b", "c", "d", "e", "f", "g"))[0].Name)
    joined.Add((Try db.Query<Named, S, S, S, S, S, S, S, S>(
        sql[7], "a", "b", "c", "d", "e", "f", "g", "h"))[0].Name)
    joined.Add((Try (Try db.Prepare(sql[7])).Query<Named, S, S, S, S, S, S, S, S>(
        "a", "b", "c", "d", "e", "f", "g", "h"))[0].Name)
    Print(joined.Join(" "))

    Try
        Print((Try db.Query<Named>("SELECT name AS Name FROM players UNION ALL SELECT 5")).Count)
    Catch e As ParseError
        Print("{e.Kind}: {e.Message}")
    End Try

    Try
        Print((Try db.Query<Player>("SELECT name AS Name FROM players")).Count)
    Catch e As ParseError
        Print("{e.Kind}: {e.Message}")
    End Try
End Function

Try
    Try Run()
Catch e As Error
    Print("{e.Message}")
End Try
