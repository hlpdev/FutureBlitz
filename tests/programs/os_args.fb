// std.os's Args: a Struct's Fields read from a command line by their attributes, with the help
// and errors they make, and an ArgsParser built at run time, with commands. The program runs
// itself too, for what Args.Parse<T>() prints and the code the program ends with.

Import std.core
Import std.os
Import std.text

Enum CopyMode
    NEWER, ALL
End Enum

@Program(Name: "tool", About: "Copies files somewhere.", Version: "1.2.3")
Struct Copy
    @Positional(Help: "Where they go", Name: "to")
    Field Destination: String
    @Positional(Help: "What to copy", Name: "file")
    Field Sources: String[]
    @Option(Help: "How many at once", Short: "j", Name: "count")
    Field Jobs: Int = 4
    @Flag(Help: "Says what it does", Short: "v")
    Field Verbose: Int
    @Flag(Help: "Copies nothing")
    Field DryRun: Bool
    @Option(Help: "Leaves these out", Name: "glob")
    Field Exclude: String[]
    Field Mode: CopyMode = CopyMode.NEWER
    @Rename("log")
    Field LogFile: String?
End Struct

// Commands as T? Fields, each a Struct of its own, which the rest of the command line fills.
Struct CommitArgs
    @Option(Help: "The commit's message", Short: "m", Required: True)
    Field Message: String
    @Flag(Help: "Commits every change", Short: "a")
    Field All: Bool
End Struct

Struct PushArgs
    @Positional(Help: "Where to", Optional: True)
    Field Remote: String = "origin"
End Struct

@Program(Name: "git", About: "Keeps versions.")
Struct Git
    @Flag(Help: "Says less", Short: "q")
    Field Quiet: Bool
    @Subcommand(Help: "Records changes")
    Field Commit: CommitArgs?
    @Subcommand(Help: "Sends commits", Name: "send")
    Field Push: PushArgs?
End Struct

// A short flag beside a positional argument that can be left out.
Struct Named
    @Flag(Short: "v")
    Field Verbose: Bool
    @Positional(Optional: True)
    Field Name: String
End Struct

// An option that takes -h for itself.
@Program(Name: "app")
Struct Sizes
    @Flag(Help: "Prints sizes for people", Short: "h")
    Field Human: Bool
End Struct

// T? Fields, and zeros, which the help doesn't show as defaults.
@Program(Name: "t")
Struct Maybe
    @Flag(Help: "More output", Short: "v")
    Field Verbose: Int?
    @Option(Help: "Tags to add")
    Field Tag: String[]?
    Field Ratio: Double = 0.0
    Field Count: Int = 0
End Struct

// An OnLoaded that needs what the command line gives.
@Program(Name: "sized")
Struct Sized
    @Positional(Help: "The file")
    Field Path: String
    @Option(Help: "How big")
    Field Size: Int = 5

    ByRef Method OnLoaded()
        Print("OnLoaded with '{Path}'")
        Size = 100 / Path.Length
    End Method
End Struct

// Commands whose help says what they do, by @Program or by @Subcommand.
Struct AddArgs
    @Positional(Help: "Its name")
    Field Name: String
End Struct

@Program(About: "Manages remotes.")
Struct RemoteArgs
    @Subcommand(Help: "Adds one")
    Field Add: AddArgs?
    @Subcommand(Help: "Takes one out")
    Field Remove: AddArgs?
End Struct

@Program(Name: "git")
Struct Remotes
    @Subcommand(Help: "Remotes")
    Field Remote: RemoteArgs?
End Struct

Function ShowGit(arguments: String[])
    Try
        Local git = Try Args.Parse<Git>(arguments)
        Local commit = git.Commit
        Local push = git.Push
        Print("quiet={git.Quiet}",
              commit != Null ? "commit message={commit.Message} all={commit.All}" : "no commit",
              push != Null ? "push remote={push.Remote}" : "no push")
    Catch e As ArgsError
        Print("{e.Kind} {e.Message} | {e.Usage}")
    Catch e As ArgumentError
        Print("help:", e.Message)
    End Try
End Function

Function Show(copy: Copy)
    Print("to={copy.Destination} files={copy.Sources} jobs={copy.Jobs} verbose={copy.Verbose}",
          "dry={copy.DryRun} exclude={copy.Exclude} mode={copy.Mode} log={copy.LogFile ?? "Null"}")
End Function

Function Tries(arguments: String[])
    Try
        Show(Try Args.Parse<Copy>(arguments))
    Catch e As ArgsHelp
        Print("help:", e.Message)
    Catch e As ArgsError
        Print("{e.Kind} [{e.Name ?? "Null"}] {e.Message}")
    Catch e As ArgumentError
        Print("not an ArgsError:", e.Message)
    End Try
End Function

// As its own child, the program reads its command line as a tool would.
If Env.Get("FB_ARGS_CHILD") != Null
    Show(Args.Parse<Copy>())
    Process.Exit(0)
End If

// Positional arguments by their places, the last taking the rest; options long and short, with
// their values after them, after '=', or after the letter; flags, together and counted.
Tries(["out", "a.txt", "b.txt", "-j", "8", "-vv", "--dry-run", "--exclude", "*.tmp",
       "--exclude=*.bak", "--mode", "all", "--log", "copy.log"])
Tries(["out"])
Tries(["-vj3", "out", "-v", "a"])
Tries(["out", "--", "-weird", "--jobs"])
Tries(["out", "-", "--mode=Newer"])

// What's wrong, said with the names the command line has.
Tries([])
Tries(["out", "--jobs", "many"])
Tries(["out", "--jbos", "3"])
Tries(["out", "-x"])
Tries(["out", "--jobs"])
Tries(["out", "--dry-run=yes"])
Tries(["out", "-j", "1", "--jobs", "2"])
Tries(["out", "--mode", "sideways"])

// --help and -h, and --version and -V.
Tries(["--version"])
Tries(["-V"])
Print(Args.Help<Copy>())
Try
    Try Args.Parse<Copy>(["out", "-h"])
Catch e As ArgsHelp
    Print(e.Message == Args.Help<Copy>())
End Try

// An ArgsParser built at run time, with commands, each reading the rest of the command line.
Local commit = ArgsParser("git commit").Option("Message", "message", "m", "The commit's message",
                                                required: True)
commit.Flag("All", "all", "a", "Commits every change")
Local push = ArgsParser("git push").Positional("Remote", "Where to", required: False)
Local git = ArgsParser("git", "Keeps versions.").Flag("Quiet", "quiet", "q", "Says less")
git.Command("commit", "Commit", commit, "Records changes")
git.Command("push", "Push", push, "Sends commits")
Print(Try git.Parse(["-q", "commit", "-am", "first"]))
Print(Try git.Parse(["push", "origin"]))
Print(git.Help())
For arguments In [["comit"], ["zzz"], [], ["commit"], ["commit", "-m"]]
    Try
        Try git.Parse(arguments)
    Catch e As ArgsError
        Print("{e.Kind} {e.Message} | {e.Usage}")
    End Try
End For

// The same, from a Struct's Fields: a command takes the rest of the command line.
ShowGit(["-q", "commit", "-am", "first"])
ShowGit(["send"])
ShowGit(["send", "upstream"])
ShowGit([])
ShowGit(["commit"])
ShowGit(["comit"])
ShowGit(["send", "--help"])
Print(Args.Help<Git>())

// OnLoaded runs once, on what the command line gives, and never on the defaults the help
// shows.
Local sized = Try Args.Parse<Sized>(["abcd"])
Print(sized.Path, sized.Size)
Print(Args.Help<Sized>())

// A short group goes a letter at a time, one of more than one byte too.
For arguments In [["-é"], ["-vé"], ["-v", "é"]]
    Try
        Local named = Try Args.Parse<Named>(arguments)
        Print("ok", named.Verbose, named.Name)
    Catch e As ArgsError
        Print("{e.Kind} {e.Message}")
    End Try
End For

// An option can take -h, --help, -V, or --version, which the help then leaves out.
Print(Args.Help<Sizes>())
Print((Try Args.Parse<Sizes>(["-h"])).Human)
Local taken = ArgsParser("taken", version: "1.0").Flag("Hidden", "help", "h", "Hides it")
taken.Flag("Old", "version", help: "Shows the old one")
Print(taken.Help())

// A name that's only short isn't '--', which '--=x' gives.
Local short = ArgsParser("tool").Flag("Verbose", short: "v").Option("Out", short: "o")
Print(Try short.Parse(["-v", "-o", "x"]))
Try
    Print(Try short.Parse(["--=x"]))
Catch e As ArgsError
    Print("{e.Kind} {e.Message}")
End Try

// A command has to be given when any Command says so, before or after an optional one.
For first In [False, True]
    Local p = ArgsParser("tool").Command("a", "A", ArgsParser("a"), optional: first)
    p.Command("b", "B", ArgsParser("b"), optional: !first)
    Print(p.Usage())
    Try
        Print(Try p.Parse([]))
    Catch e As ArgsError
        Print("error:", e.Message)
    End Try
End For

// A T? Field reads as its T: an Int? flag counts, a String[]? option takes each, and either is
// Null when it isn't given.
For arguments In [["-vv"], ["--tag", "a", "--tag", "b"]]
    Try
        Local maybe = Try Args.Parse<Maybe>(arguments)
        Print("ok {maybe.Verbose ?? -1} {maybe.Tag ?? ["none"]}")
    Catch e As ArgsError
        Print("{e.Kind} {e.Message}")
    End Try
End For

Print(Args.Help<Maybe>())

// A command's help says what it does: its @Program's About, or else its @Subcommand's Help.
For arguments In [["remote", "--help"], ["remote", "remove", "--help"]]
    Try
        Try Args.Parse<Remotes>(arguments)
    Catch e As ArgsHelp
        Print(e.Message)
    End Try
End For

// Args.Parse<T>() prints the help or the error itself, and ends the program with 0 or 2.
Local self = Folders.Executable.Expect("the program's path")
For arguments In [["out", "a", "-v"], ["--help"], ["out", "--jobs", "x"]]
    Local output = Try Command(self).Args(arguments).Env("FB_ARGS_CHILD", "1").Output()
    Print(output.Status.Code ?? -1, "[{output.Text}]", "[{output.ErrorText}]")
End For
