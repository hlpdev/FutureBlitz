// JsonReader's tokens, with what each holds, its depth and place, and Skip, from text and bytes;
// and JsonWriter's text, on one line and indented, of each kind of value.
Import std.core
Import std.collections
Import std.data

// text as JSON writes it, so control characters show as escapes.
Function Quoted(text: String): String
    Local writer = JsonWriter()
    writer.WriteString(text)
    Return writer.ToString()
End Function

// Each token the reader reads, with its value and depth, to the end, or what refused it.
Function Tokens(reader: JsonReader): String
    Local out: String[] = []
    Try
        Loop
            Local token = reader.Next()
            Local text = "{token}"
            Select token
                Case JsonToken.KEY, JsonToken.STRING
                    text = "{token}({Quoted(reader.GetString())})"
                Case JsonToken.INT
                    text = "INT({reader.GetInt64()})"
                Case JsonToken.UINT
                    text = "UINT({reader.GetUInt64()})"
                Case JsonToken.DOUBLE
                    text = "DOUBLE({reader.GetDouble()})"
                Case JsonToken.BOOL
                    text = "BOOL({reader.GetBool()})"
                Default
            End Select
            out.Add("{text}@{reader.Depth}")
            If token == JsonToken.END Then Break
        End Loop
    Catch e As ParseError
        out.Add("ParseError({e.Kind}, {e.Line}:{e.Column}: {e.Message})")
    End Try
    Return out.Join(" ")
End Function

Function Read(text: String): String => Tokens(JsonReader(text))

Print("== reader")
Print(Read(r"""
    {"a": [1, {"b": null}], "c": "d", "e": []}
    """))
Print(Read("  42  "))
Print(Read("\"lone\""))
Print(Read("true"))
Print(Read(r"""
    [0, -0, 9223372036854775807, -9223372036854775808, 9223372036854775808, 18446744073709551615]
    """))
Print(Read(r"""
    [18446744073709551616, -9223372036854775809, 1.5, -2.5e-3, 1E2, 0e0, 1e-400]
    """))
Print(Read(r"""
    ["\"\\\/\b\f\n\r\t", "\u0041\u00E9\u4e2d\uD834\uDD1E", "\uDD1E\uD834", "é😀"]
    """))
Print(Read(r"""
    {"": 1, "k": {"k": {"k": {}}}}
    """))

Print("== numbers as each type")
Local reader = JsonReader("[7, 18446744073709551615, 2.5]")
Try
    reader.Next()
    reader.Next()
    Print("{reader.Token} {reader.GetInt64()} {reader.GetUInt64()} {reader.GetDouble()}")
    reader.Next()
    Print("{reader.Token} {reader.GetUInt64()} {reader.GetDouble()}")
    reader.Next()
    Print("{reader.Token} {reader.GetDouble()}")
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== places")
Local placed = JsonReader("[\n  1,\n  \"é\", \"x\",\n  true\n]")
Try
    While placed.Next() != JsonToken.END
        Print("{placed.Token} at {placed.Line}:{placed.Column}")
    End While
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

// A place asked for at every token is counted on from the one before, so a long document's
// places cost no more than reading it, and one asked for twice is the same.
Local lines: String[] = []
For i = 1 To 50000
    lines.Add("{i}")
End For

Local long = JsonReader("[" + lines.Join(",\n") + ", \"é\", x]")
Local last = ""
Try
    While long.Next() != JsonToken.END
        last = "{long.Token} at {long.Line}:{long.Column}, {long.Line}:{long.Column}"
    End While
Catch e As ParseError
    Print("{last}; ParseError at {e.Line}:{e.Column}")
End Try

// A byte order mark, which the reader leaves out, isn't a column either.
Function Place(reader: JsonReader): String
    Try
        reader.Next()
        Local first = "{reader.Token} at {reader.Line}:{reader.Column}"
        reader.Next()
        Return first
    Catch e As ParseError
        Return "ParseError at {e.Line}:{e.Column}"
    End Try
End Function

Print(Place(JsonReader([91, 120, 93] As UInt8[])),
      Place(JsonReader([239, 187, 191, 91, 120, 93] As UInt8[])),
      Place(JsonReader("\u{FEFF}[x]")), Place(JsonReader([239, 187, 191, 91, 49, 93] As UInt8[])))

// A string that isn't JSON leaves the token before it with its own text.
Local refused = JsonReader(r"""
    {"name": "bc\q"}
    """)
Try? refused.Next()
Try? refused.Next()
Print("{refused.Token} {refused.GetString()}")
Local threw = False
Try
    refused.Next()
Catch e As ParseError
    threw = True
End Try
Print("{threw} {refused.Token} {refused.GetString()}")

Print("== skip")
Local skipping = JsonReader(r"""
    {"skip": {"a": [1, [2, 3]], "b": {}}, "keep": 1, "also": [true], "last": 2}
    """)
Try
    skipping.Next()
    While skipping.Next() == JsonToken.KEY
        Local key = skipping.GetString()
        skipping.Next()
        If key == "keep" || key == "last"
            Print("{key} = {skipping.GetInt64()}")
        Else
            skipping.Skip()
            Print("skipped {key}, at depth {skipping.Depth}")
        End If
    End While
    Print(skipping.Token)
Catch e As ParseError
    Print("ParseError {e.Message}")
End Try

Print("== bytes")
// A byte order mark is left out, and bytes that aren't UTF-8 are refused.
Print(Tokens(JsonReader([239, 187, 191, 91, 34, 195, 169, 34, 93] As UInt8[])))
Print(Tokens(JsonReader([34, 255, 34] As UInt8[])))
Print(Tokens(JsonReader([] As UInt8[])))

Print("== depth")
Print(Read("[[[1]]]"))
Print(Tokens(JsonReader("[[[1]]]", 3)))
Print(Tokens(JsonReader("[[[1]]]", 2)))
Print(Tokens(JsonReader(r"""
    {"a": {"b": 1}}
    """, 1)))

Print("== refused")
Print(Read(""))
Print(Read("   "))
Print(Read("[1,]"))
Print(Read(r"""
    {"a" 1}
    """))
Print(Read(r"""
    {"a": 1,}
    """))
Print(Read(r"{1: 2}"))
Print(Read("[1] [2]"))
Print(Read("[\"tab\there\"]"))
Print(Read("[\"\\x\"]"))
Print(Read("[\"\\u12\"]"))
Print(Read("[tru]"))
Print(Read("[-]"))
Print(Read("[1.]"))
Print(Read("[1e]"))
Print(Read("[.5]"))
Print(Read("[+1]"))
Print(Read("[01]"))
Print(Read("[1e400]"))
Print(Read(r"[1}"))
Print(Read(r"""
    {"a": 1]
    """))
Print(Read("\"open"))
Print(Read("[NaN]"))

Print("== writer")
Local writer = JsonWriter()
Print("[{writer}] {writer.IsComplete}")
writer.BeginObject()
writer.Key("text")
writer.WriteString("quote \" backslash \\ line\nnul \u{0} bell \u{7} é")
writer.Key("ints")
writer.BeginArray()
writer.WriteInt(0)
writer.WriteInt(-9223372036854775808)
writer.WriteUInt(18446744073709551615)
writer.EndArray()
writer.Key("doubles")
writer.BeginArray()
writer.WriteDouble(1.0)
writer.WriteDouble(-0.0)
writer.WriteDouble(0.1)
writer.WriteDouble(1e21)
writer.WriteDouble(1.5e-7)
writer.WriteDouble(123456789012345680.0)
writer.EndArray()
writer.Key("empty")
writer.BeginObject()
writer.EndObject()
writer.Key("none")
writer.BeginArray()
writer.EndArray()
writer.Key("")
writer.WriteNull()
writer.Key("yes")
writer.WriteBool(True)
Print("{writer.IsComplete}")
writer.EndObject()
Print(writer)
Print(writer.IsComplete)

// Read back, the writer's text gives what was written.
Print(Read(writer.ToString()))

Local indented = JsonWriter(4)
indented.BeginArray()
indented.WriteInt(1)
indented.BeginObject()
indented.Key("a")
indented.BeginArray()
indented.BeginArray()
indented.EndArray()
indented.WriteBool(False)
indented.EndArray()
indented.Key("b")
indented.BeginObject()
indented.EndObject()
indented.EndObject()
indented.EndArray()
Print(indented)

Local lone = JsonWriter(2)
lone.WriteString("only")
Print("{lone} {lone.IsComplete}")
