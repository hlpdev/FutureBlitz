// std.io's one-call files and folders, in a temporary folder of the program's own, with names
// beyond ASCII: writing, reading, adding to, renaming, copying, and deleting files, atomic
// writes, lines with either ending, what's at a path, folders and what's in them, mapping,
// watching, and locking files. Failures come as IOErrors with their Kinds, and nothing's left
// behind.
Import std.core
Import std.io
Import std.time

// C's chmod, whose mode 0 makes a folder one no one can list on POSIX; on Windows it only makes
// it read-only.
Extern "C"
    Function chmod(path: CString, mode: Int32): Int32
End Extern

Local temp = Try TempDir("fb-files-")
Local root = temp.Path
Print("made {Dir.Exists(root)} {(Try Dir.Entries(root)).Count}")

// Prints what's in the folder, all the way down, from it.
Function Tree(folder: Path) Throws IOError
    For entry In Try Dir.Walk(folder)
        Print("  {entry.Relative} {entry.Kind}")
    End For
End Function

// What doing `what` to a and b throws: its IOError's Kind, or "fine".
Function Failure(what: String, a: Path, b: Path? = Null): String
    Try
        Select what
            Case "read"
                File.ReadText(a)
            Case "write"
                File.WriteText(a, "x")
            Case "write atomically"
                File.WriteTextAtomic(a, "x")
            Case "size"
                File.Size(a)
            Case "delete"
                File.Delete(a)
            Case "metadata"
                File.Metadata(a)
            Case "copy"
                File.Copy(a, b ?? a)
            Case "move"
                File.Move(a, b ?? a)
            Case "create"
                Dir.Create(a)
            Case "create all"
                Dir.CreateAll(a)
            Case "remove"
                Dir.Remove(a)
            Case "entries"
                Dir.Entries(a)
            Case "map"
                MappedFile(a)
            Case "map writable"
                MappedFile(a, True)
            Case "temporary folder"
                TempDir(a.Text)
            Default
                Panic("no {what}")
        End Select
    Catch e As IOError
        Return "{what} {e.Kind}"
    End Try

    Return "{what} fine"
End Function

Print("files")
Local save = root / "größe.txt"
Try File.WriteText(save, "first\r\nsecond\nthird")
// The text stays as written, "\r\n" too.
Print("{(Try File.ReadText(save)).Bytes}")
Print("{Try File.ReadLines(save)} {Try File.Size(save)} {File.Exists(save)} {Dir.Exists(save)}")
Try File.AppendText(save, "\n")
Try File.AppendLines(save, ["fourth", "fifth"], LineEnding.CRLF)
Print("{Try File.ReadLines(save)} {Try File.Size(save)}")
Try File.WriteLines(root / "lines.txt", ["a", "", "b"])
Print("{Try File.ReadBytes(root / "lines.txt")} {Try File.ReadLines(root / "lines.txt")}")
Try File.WriteBytes(root / "empty.bin", [])
Print("{Try File.ReadBytes(root / "empty.bin")} {Try File.ReadLines(root / "empty.bin")} [{Try File.ReadText(root / "empty.bin")}]")
Try File.WriteBytes(root / "bytes.bin", [0, 255, 128, 10, 13])
Try File.AppendBytes(root / "bytes.bin", [1, 2])
Print("{Try File.ReadBytes(root / "bytes.bin")}")

// A byte that doesn't start UTF-8 reads as U+FFFD, and a NUL stays.
Try File.WriteBytes(root / "odd.txt", [104, 255, 0, 105])
Local points: Int[] = []
For c In (Try File.ReadText(root / "odd.txt")).Chars
    points.Add(c As Int)
End For

Print("{points}")

Print("atomic")
Try File.WriteTextAtomic(save, "replaced whole")
Print("[{Try File.ReadText(save)}]")
Try File.WriteBytesAtomic(root / "new.bin", [7, 8, 9])
Print("{Try File.ReadBytes(root / "new.bin")}")
Try Tree(root)

Print("rename, copy, delete")
Local renamed = root / "セーブ.dat"
Try File.Move(save, renamed)
Print("{File.Exists(save)} {File.Exists(renamed)} [{Try File.ReadText(renamed)}]")
Try File.Copy(renamed, save)
Print("{File.Exists(save)} [{Try File.ReadText(save)}]")
Try File.WriteText(save, "over")
Try File.Move(save, renamed)
Print("[{Try File.ReadText(renamed)}] {File.Exists(save)}")
Try File.Copy(renamed, root / "copy.dat")
Try File.Copy(root / "new.bin", root / "copy.dat")
Print("{Try File.ReadBytes(root / "copy.dat")}")
Print("{Try File.Delete(root / "copy.dat")} {Try File.Delete(root / "copy.dat")} {File.Exists(root / "copy.dat")}")

Print("metadata")
Local found = Try File.Metadata(renamed)
// A file made a moment ago was changed, read, and made since 2020 began, where the OS says when it
// was made.
Local since = Timestamp.FromUnixSeconds(1577836800)
Print("{found.Kind} {found.Size} {found.IsFile()} {found.IsDirectory()} {found.IsReadOnly} {found.Modified > since}")
Print("{found.Accessed > since} {(found.Created ?? Timestamp.FromUnixSeconds(1600000000)) > since}")
Local folderFound = Try File.Metadata(root)
Print("{folderFound.Kind} {folderFound.IsDirectory()}")
Try File.SetReadOnly(renamed, True)
Print("{(Try File.Metadata(renamed)).IsReadOnly} {Failure("write", renamed)}")
Try File.SetReadOnly(renamed, False)
Print("{(Try File.Metadata(renamed)).IsReadOnly} [{Try File.ReadText(renamed)}]")
Try File.WriteText(renamed, "yes")
Print("[{Try File.ReadText(renamed)}]")

Print("folders")
Local nested = root / "ä" / "b" / "ç"
Try Dir.CreateAll(nested)
Try Dir.CreateAll(nested)
Print("{Dir.Exists(nested)} {File.Exists(nested)}")
Try Dir.Create(root / "plain")
Try File.WriteText(nested / "deep.txt", "deep")
Try File.WriteText(root / "ä" / "top.png", "")
Try File.WriteText(root / "ä" / "b" / "mid.png", "")
Try File.WriteText(root / "ä" / ".hidden.png", "")
Try Tree(root)
For entry In Try Dir.Entries(root / "ä")
    Print("  entry {entry.Name()} {entry.Relative} {entry.IsDirectory()} {entry.Path == root / "ä" / entry.Name()}")
End For

Print("glob")
For pattern In ["*.png", "**/*.png", "ä/*.png", "ä/**/*.png", "**", "ä/b/*", "*", "?/b", "[äb]/[!x]",
                "ä/[a-c]/ç/*.txt", "**/ç", "[", "ä/b/**", "nothing/*", "*.dat", "**/*.PNG", "", "./*.dat"]
    Local matched: String[] = []
    For entry In Try Dir.Glob(root, pattern)
        matched.Add(entry.Relative.Text)
    End For

    Print("  {pattern}: {matched}")
End For

// A name that fails late against a pattern of many '*'s matches in a moment.
Local long = ""
For i = 1 To 200
    long += "a"
End For

Try Dir.Create(root / "long")
Try File.WriteText(root / "long" / long, "")
Print("  long: {(Try Dir.Glob(root / "long", "*a*a*a*a*a*a*a*b")).Count} {(Try Dir.Glob(root / "long", "*a*a*a*a*a*a*a")).Count}")
Try Dir.RemoveAll(root / "long")

// A folder the pattern can't reach into isn't listed, so one no one can list doesn't matter to
// it, and Walk's error names the folder it couldn't list.
Try Dir.CreateAll(root / "globs" / "open")
Try File.WriteText(root / "globs" / "open" / "a.txt", "a")
Try Dir.Create(root / "globs" / "shut")
chmod((root / "globs" / "shut").Text, 0)
Local reached: String[] = []
For entry In Try Dir.Glob(root / "globs", "open/*")
    reached.Add(entry.Relative.Text)
End For

Print("  past a shut folder: {reached}")
Local named = "the folder it couldn't list"
Try
    Dir.Walk(root / "globs")
Catch e As IOError
    If e.Path != (root / "globs" / "shut").Text Then named = e.Path ?? "none"
End Try

Print("  walk names {named}")
chmod((root / "globs" / "shut").Text, 448)
Try Dir.RemoveAll(root / "globs")

Print("errors")
Print(Failure("read", root / "missing.txt"))
Print(Failure("read", root / "ä"))
Print(Failure("write", root / "ä"))
Print(Failure("write atomically", root / "ä"))
Print(Failure("write atomically", root / "missing" / "x.txt"))
Print(Failure("size", root / "ä"))
Print(Failure("delete", root / "ä"))
Print(Failure("create", root / "plain"))
Print(Failure("create", root / "missing" / "x"))
Print(Failure("create all", renamed / "x"))
Print(Failure("remove", root / "ä"))
Print(Failure("remove", renamed))
Print(Failure("entries", renamed))
Print(Failure("entries", root / "missing"))
Print(Failure("copy", root / "missing", root / "x"))
Print(Failure("copy", root / "ä", root / "x"))
Print(Failure("move", root / "missing", root / "x"))
Print(Failure("write", root / "missing" / "x.txt"))
Print(Failure("write", "a\u{0}b"))
Print(Failure("metadata", root / "missing"))
Print(Failure("temporary folder", "no-such-folder/"))

// From the folder itself, paths and messages don't depend on where it is.
Local before = Try Dir.Current()
Try Dir.SetCurrent(root)
// macOS's temporary folder is a link, so the current folder's path can differ from root's.
Local here = Try Dir.Current()
Print("{here.FileName() == root.FileName()} {(Try Path("x").Absolute()) == here / "x"} {(Try Path("a/../x").Absolute()) == here / "x"}")
Try
    File.ReadText("missing.txt")
Catch e As IOError
    Print("{e.Message} [{e.Path ?? ""}]")
End Try

Try
    File.Copy("missing.txt", "other.txt")
Catch e As IOError
    Print("{e.Message} [{e.Path ?? ""}]")
End Try

Print("[{Try File.ReadText("セーブ.dat")}] {(Try Dir.Entries(".")).Count}")
Try Dir.SetCurrent(before)

Print("locks")
Local lockPath = root / "lock.lck"
Local held = Try FileLock.Acquire(lockPath)
Print("{held.IsHeld()} {held.IsShared} {File.Exists(lockPath)}")
Print("{(Try FileLock.TryAcquire(lockPath)) == Null} {(Try FileLock.TryAcquireShared(lockPath)) == Null}")
// A lock leaves the file to read and write.
Try File.WriteText(lockPath, "locked")
Print("[{Try File.ReadText(lockPath)}]")
held.Close()
held.Close()
Print("{held.IsHeld()}")
Local shared = Try FileLock.AcquireShared(lockPath)
Local other = Try FileLock.TryAcquireShared(lockPath)
Print("{shared.IsShared} {other != Null} {(Try FileLock.TryAcquire(lockPath)) == Null}")
shared.Close()
other?.Close()
Local again = Try FileLock.TryAcquire(lockPath)
Print("{again != Null}")
again = Null
Print("{(Try FileLock.TryAcquire(lockPath)) != Null}")

Print("maps")
Local mapPath = root / "mapped ü.bin"
Try File.WriteBytes(mapPath, [1, 2, 3, 4, 5])
Local reading = Try MappedFile(mapPath)
Print("{reading.Count()} {reading[0]} {reading[4]} {reading.ReadBytes(1, 3)} {reading.ReadBytes(5, 0)}")
Print("{reading.IsWritable} {reading.IsOpen()} {reading.Path == mapPath}")
Try reading.Flush()
reading.Close()
reading.Close()
Print("{reading.IsOpen()} {reading.Count()}")
Local writing = Try MappedFile(mapPath, True)
writing[0] = 10
writing[1] += 10
writing.WriteBytes(3, [40, 50])
Try writing.Flush()
// The file has what was written through the map, which a read sees at once.
Print("{Try File.ReadBytes(mapPath)} {writing[1]}")
writing.Close()
Print("{Try File.ReadBytes(mapPath)}")
Local empty = Try MappedFile(root / "empty.bin", True)
Print("{empty.Count()} {empty.ReadBytes(0, 0)}")
empty.WriteBytes(0, [])
empty.Close()
Print(Failure("map", root / "missing.bin"))
Print(Failure("map", root / "ä"))
Print(Failure("map", "a\u{0}b"))

Print("watching")
Local watcher = Try FileWatcher(root)
Try File.WriteText(root / "watched.txt", "w")
// Whatever comes next, waited for ten seconds at most.
Local next = watcher.NextAsync()
For tries = 1 To 1000
    If next.IsDone() Then Break
    Await RealWait(10.Milliseconds)
End For

Print("{next.IsDone()}")
watcher.Close()
Local event = Await next
Print("{event != Null}")
Print("{watcher.Next() == Null}")

Print("removing")
Print("{Try Dir.RemoveAll(root / "ä")} {Try Dir.RemoveAll(root / "ä")} {Dir.Exists(root / "ä")}")
Print("{Try Dir.Remove(root / "plain")} {Try Dir.Remove(root / "plain")}")
Try Tree(root)

Print("temporary files")
Local scratch = Try TempFile("fb-scratch-")
Print("{File.Exists(scratch.Path)} {Try File.Size(scratch.Path)} {scratch.Path.FileName().Bytes.Count}")
Try File.WriteText(scratch.Path, "scratch")
Local scratchPath = scratch.Path
Try scratch.Close()
Try scratch.Close()
Print("{File.Exists(scratchPath)}")
Local dropped = Try TempFile()
Local droppedPath = dropped.Path
dropped = Try TempFile()
Print("{File.Exists(droppedPath)} {File.Exists(dropped.Path)}")
Try dropped.Close()

Try temp.Close()
Print("left {Dir.Exists(root)}")
