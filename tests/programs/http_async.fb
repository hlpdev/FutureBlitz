// HttpClient's Async twins, which the I/O thread runs while the main thread goes on: requests at
// once, each method's twin, downloads with progress on the main thread, and failures thrown where
// they're awaited.
Import std.core
Import std.collections
Import std.net.http

Global base = Input() ?? ""
Global secure = Input() ?? ""
Global refused = Input() ?? ""
Global client = HttpClient()

// What awaiting a GET of path gives, its status and text, or what failed.
Async Function Fetched(url: String): String
    Try
        Local response = Await client.GetAsync(url)
        Return "{response.Status} {response.Text}"
    Catch e As NetError
        Return "NetError {e.Kind}"
    Catch e As TimeoutError
        Return "TimeoutError"
    End Try
End Function

// What awaiting a request of method gives, with body.
Async Function Sent(method: HttpMethod, path: String, body: Body? = Null): String
    Try
        Local response = Await client.SendAsync(method, "{base}{path}", body)
        Return "{response.Status} {response.Text}"
    Catch e As NetError
        Return "NetError {e.Kind}"
    Catch e As TimeoutError
        Return "TimeoutError"
    End Try
End Function

// A coroutine that counts ticks while the requests go, so the main thread runs meanwhile.
Global ticks = 0
Global counting = True
Async Function CountTicks()
    While counting
        ticks += 1
        Await NextTick()
    End While
End Function

Local counter = CountTicks()

Print("== at once")
Local tasks: Task<String>[] = []
For path In ["/hello", "/redirect/2", "/status/418", "/chunked", "/multi", "/cookies"]
    tasks.Add(Fetched("{base}{path}"))
End For

For task In tasks
    Print(task.Wait())
End For

Print("== methods")
Print(Await Sent(HttpMethod.POST, "/echo", Body.Text("posted")))
Print(Await Sent(HttpMethod.PUT, "/moved/307", Body.Text("kept")))
Print(Await Sent(HttpMethod.POST, "/moved/303", Body.Text("dropped")))
Print(Await Sent(HttpMethod.DELETE, "/echo"))
Try
    Print((Await client.PostAsync("{base}/echo", Body.Json("[1]"))).Text)
    Print((Await client.PutAsync("{base}/echo", Body.Text("put"))).Text)
    Print((Await client.PatchAsync("{base}/echo", Body.Text("patch"))).Text)
    Print((Await client.DeleteAsync("{base}/echo")).Text)
    Local head = Await client.HeadAsync("{base}/hello")
    Print("head {head.Status} {head.Bytes.Count}")
Catch e As NetError
    Print("NetError {e.Kind}")
Catch e As TimeoutError
    Print("TimeoutError")
End Try

Print("== cookies")
Print(Await Fetched("{base}/cookies/set?name=late&value=1"))
Print(Await Fetched("{base}/cookies"))
Print(Fetched(base + "/cookies").Wait())

Print("== downloads")
// Half of it comes 300 ms before the rest, which progress is told of before the end.
Global early = 0
Global ordered = True
Global last: Int64 = 0
Global expected: Int64 = 0
Try
    Local url = "{base}/bytes/200000?pause=100000"
    Local bytes = Await client.DownloadAsync(url, Function(got: Int64, all: Int64)
        If got < all Then early += 1
        If got < last Then ordered = False
        last = got
        expected = all
    End Function)
    Local right = True
    For i, byte In bytes
        If byte != (i % 251) As UInt8 Then right = False
    End For
    Print("{bytes.Count} {right} {early > 0} {ordered} {last} {expected}")
    Print((Await client.DownloadAsync("{base}/hello")).Count)
    Await client.DownloadAsync("{base}/status/404")
Catch e As NetError
    Print("NetError {e.Kind}")
Catch e As TimeoutError
    Print("TimeoutError")
End Try

Print("== failures")
Print(Await Fetched("{refused}/hello"))
Print(Await Fetched("{base}/close"))
Print(Await Fetched("{base}/reset"))
Print(Await Fetched("{secure}/hello"))
Print(Await Fetched("ftp://127.0.0.1/file"))
Print(Await Fetched("{base}/hello"))

counting = False
counter.Wait()
Print("the main thread ran meanwhile: {ticks > 1}")
