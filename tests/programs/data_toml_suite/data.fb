            "ouraged\n'' = 'blank'     # VALID but discouraged\n"),
        ("spec-1.0.0/string-4-0",
            "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"" +
            "\"\nstr5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INVAL" +
            "ID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6 =" +
            " \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\".\"" +
            "\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\nstr" +
            "7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"\"\"" +
            "\n"),
        ("spec-1.0.0/string-7-0",
            "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"" +
            "\"'''\n\napos15 = '''Here are fifteen apostrophes: ''''''''''''" +
            "''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: ''" +
            "'''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\nst" +
            "r = ''''That,' she said, 'is still pointless.''''\n"),
        ("spec-1.0.0/table-9-0",
