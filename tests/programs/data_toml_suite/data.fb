            "\"not a leap year\" = 2100-02-29T15:15:15\n"),
        ("local-datetime/feb-30",
            "\"only 28 or 29 days in february\" = 1988-02-30T15:15:15\n\n"),
        ("local-datetime/hour-over",
            "# time-hour       = 2DIGIT  ; 00-23\nd = 2006-01-01T24:00:00\n"),
        ("local-datetime/mday-over",
            "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 bas" +
            "ed on\n#                           ; month/year\nd = 2006-01-3" +
            "2T00:00:00\n"),
        ("local-datetime/mday-under",
            "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 bas" +
            "ed on\n#                           ; month/year\nd = 2006-01-0" +
            "0T00:00:00\n"),
        ("local-datetime/minute-over",
            "# time-minute     = 2DIGIT  ; 00-59\nd = 2006-01-01T00:60:00\n"),
        ("local-datetime/month-over",
            "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01T00:00:00\n"),
        ("local-datetime/month-under",
            "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01T00:00:00\n"),
        ("local-datetime/no-leads-with-milli",
            "# Day \"5\" instead of \"05\"; the leading zero is required.\nwit" +
            "h-milli = 1987-07-5T17:45:00.12\n"),
        ("local-datetime/no-leads",
            "# Month \"7\" instead of \"07\"; the leading zero is required.\nn" +
            "o-leads = 1987-7-05T17:45:00\n"),
        ("local-datetime/no-secs",
            "# No seconds in time.\nno-secs = 1987-07-05T17:45\n"),
        ("local-datetime/no-t",
            "# No \"t\" or \"T\" between the date and time.\nno-t = 1987-07-05" +
            "17:45:00\n"),
        ("local-datetime/second-over",
            "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on l" +
            "eap second\n#                           ; rules\nd = 2006-01-0" +
            "1T00:00:61\n"),
        ("local-datetime/time-no-leads",
            "# Leading 0 is always required.\nd = 2023-10-01T1:32:00Z\n"),
        ("local-datetime/y10k",
            "# Maximum RFC3399 year is 9999.\nd = 10000-01-01 00:00:00\n"),
        ("local-time/hour-over",
            "# time-hour       = 2DIGIT  ; 00-23\nd = 24:00:00\n"),
        ("local-time/minute-over",
            "# time-minute     = 2DIGIT  ; 00-59\nd = 00:60:00\n"),
        ("local-time/no-secs",
            "# No seconds in time.\nno-secs = 17:45\n"),
        ("local-time/second-over",
            "# time-second     = 2DIGIT  ; 00-58, 00-59, 00-60 based on l" +
