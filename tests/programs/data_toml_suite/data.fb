        ("inline-table/bool",
            "a = {{a = true, b = false}}\n",
            "{{\"a\": {{\"a\": true, \"b\": false}}}}"),
        ("inline-table/empty",
            "empty1 = {{}}\nempty2 = {{ }}\nempty_in_array = [ {{ not_empty = 1 " +
            "}}, {{}} ]\nempty_in_array2 = [{{}},{{not_empty=1}}]\nmany_empty = [{{" +
