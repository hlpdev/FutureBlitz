        ("string/wrong-close",
            "bad-ending-quote = \"double and single'\n"),
        ("table/append-with-dotted-keys-01",
            "# First a.b.c defines a table: a.b.c = {{z=9}}\n#\n# Then we def" +
            "ine a.b.c.t = \"str\" to add a str to the above table, making " +
            "it:\n#\n#   a.b.c = {{z=9, t=\"...\"}}\n#\n# While this makes sense," +
            " logically, it was decided this is not valid TOML as\n# it's " +
            "too confusing/convoluted.\n# \n# See: https://github.com/toml-" +
            "lang/toml/issues/846\n#      https://github.com/toml-lang/tom" +
            "l/pull/859\n\n[a.b.c]\n  z = 9\n\n[a]\n  b.c.t = \"Using dotted key" +
            "s to add to [a.b.c] after explicitly defining it above is no" +
            "t allowed\"\n"),
        ("table/append-with-dotted-keys-02",
            "# This is the same issue as in injection-1.toml, except that" +
            " nests one level\n# deeper. See that file for a more complete" +
            " description.\n\n[a.b.c.d]\n  z = 9\n\n[a]\n  b.c.d.k.t = \"Using d" +
            "otted keys to add to [a.b.c.d] after explicitly defining it " +
            "above is not allowed\"\n"),
        ("table/append-with-dotted-keys-03",
            "[[a.b]]\n\n[a]\nb.y = 2\n"),
        ("table/append-with-dotted-keys-04",
            "[dependencies.foo]\nversion = \"0.16\"\n\n[dependencies]\nlibc = \"" +
            "0.2\"\n\n[dependencies]\nrand = \"0.3.14\"\n"),
        ("table/append-with-dotted-keys-05",
            "a.b.c = 1\na.b = 2\n"),
        ("table/append-with-dotted-keys-06",
            "a = 1\na.b = 2\n"),
        ("table/append-with-dotted-keys-07",
            "a = {{k1 = 1, k1.name = \"joe\"}}\n"),
        ("table/append-with-dotted-keys-08",
            "[a.b.c]\nz = 9\n\n[[totally_unrelated]]\nx = 123\n\n[a]\nb.c.t = \"t" +
            "his should NOT be allowed\"\n"),
        ("table/array-empty",
            "[[]]\nname = \"Born to Run\"\n"),
        ("table/array-implicit",
            "# This test is a bit tricky. It should fail because the firs" +
            "t use of\n# `[[albums.songs]]` without first declaring `album" +
            "s` implies that `albums`\n# must be a table. The alternative " +
            "would be quite weird. Namely, it wouldn't\n# comply with the " +
            "TOML spec: \"Each double-bracketed sub-table will belong to \n" +
            "# the most *recently* defined table element *above* it.\"\n#\n#" +
            " This is in contrast to the *valid* test, table-array-implic" +
            "it where\n# `[[albums.songs]]` works by itself, so long as `[" +
            "[albums]]` isn't declared\n# later. (Although, `[albums]` cou" +
            "ld be.)\n[[albums.songs]]\nname = \"Glory Days\"\n\n[[albums]]\nnam" +
            "e = \"Born in the USA\"\n"),
        ("table/array-no-close-01",
            "[[albums]\nname = \"Born to Run\"\n"),
        ("table/array-no-close-02",
            "[[closing-bracket.missing]\nblaa=2\n"),
        ("table/array-no-close-03",
            "[[a\n[[b]]\n"),
        ("table/array-no-close-04",
            "[[a\nb = 2\n"),
        ("table/array-no-close-05",
            "[[a]\n"),
        ("table/array-no-close-06",
            "[[a]x\n"),
