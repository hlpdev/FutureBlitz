            " \"table-array\": [{{\"a\": 1}}, {{\"b\": 2}}]}}"),
        ("inline-table/key-dotted-01",
            "a = {{   a.b  =  1   }}\nb = {{   \"a\".\"b\"  =  1   }}\nc = {{   a   " +
            ".   b  =  1   }}\nd = {{   'a'   .   \"b\"  =  1   }}\ne = {{a.b=1}}\n",
            "{{\"a\": {{\"a\": {{\"b\": 1}}}}, \"b\": {{\"a\": {{\"b\": 1}}}}, \"c\": {{\"a\": {{\"b\"" +
            ": 1}}}}, \"d\": {{\"a\": {{\"b\": 1}}}}, \"e\": {{\"a\": {{\"b\": 1}}}}}}"),
        ("inline-table/key-dotted-02",
            "many.dots.here.dot.dot.dot = {{a.b.c = 1, a.b.d = 2}}\n",
            "{{\"many\": {{\"dots\": {{\"here\": {{\"dot\": {{\"dot\": {{\"dot\": {{\"a\": {{\"b" +
            "\": {{\"c\": 1, \"d\": 2}}}}}}}}}}}}}}}}}}"),
        ("inline-table/key-dotted-03",
            "[tbl]\na.b.c = {{d.e=1}}\n\n[tbl.x]\na.b.c = {{d.e=1}}\n",
            "{{\"tbl\": {{\"a\": {{\"b\": {{\"c\": {{\"d\": {{\"e\": 1}}}}}}}}, \"x\": {{\"a\": {{\"b\"" +
            ": {{\"c\": {{\"d\": {{\"e\": 1}}}}}}}}}}}}}}"),
        ("inline-table/key-dotted-04",
            "[[arr]]\nt = {{a.b=1}}\nT = {{a.b=1}}\n\n[[arr]]\nt = {{a.b=2}}\nT = {{a." +
            "b=2}}\n",
            "{{\"arr\": [{{\"T\": {{\"a\": {{\"b\": 1}}}}, \"t\": {{\"a\": {{\"b\": 1}}}}}}, {{\"T\":" +
            " {{\"a\": {{\"b\": 2}}}}, \"t\": {{\"a\": {{\"b\": 2}}}}}}]}}"),
        ("inline-table/key-dotted-05",
            "arr-1 = [{{a.b = 1}}]\narr-2 = [\"str\", {{a.b = 1}}]\n\narr-3 = [{{a." +
            "b = 1}}, {{a.b = 2}}]\narr-4 = [\"str\", {{a.b = 1}}, {{a.b = 2}}]\n",
            "{{\"arr-1\": [{{\"a\": {{\"b\": 1}}}}], \"arr-2\": [\"str\", {{\"a\": {{\"b\": 1}}" +
            "}}], \"arr-3\": [{{\"a\": {{\"b\": 1}}}}, {{\"a\": {{\"b\": 2}}}}], \"arr-4\": [\"" +
            "str\", {{\"a\": {{\"b\": 1}}}}, {{\"a\": {{\"b\": 2}}}}]}}"),
        ("inline-table/key-dotted-06",
            "top.dot.dot = [\n\t{{dot.dot.dot = 1}},\n\t{{dot.dot.dot = 2}},\n]\n",
            "{{\"top\": {{\"dot\": {{\"dot\": [{{\"dot\": {{\"dot\": {{\"dot\": 1}}}}}}, {{\"dot" +
            "\": {{\"dot\": {{\"dot\": 2}}}}}}]}}}}}}"),
        ("inline-table/key-dotted-07",
            "arr = [\n\t{{a.b = [{{c.d = 1}}]}}\n]\n",
            "{{\"arr\": [{{\"a\": {{\"b\": [{{\"c\": {{\"d\": 1}}}}]}}}}]}}"),
        ("inline-table/multiline",
            "tbl_multiline = {{ a = 1, b = \"\"\"\nmultiline\n\"\"\", c = \"\"\"and y" +
            "et\nanother line\"\"\", d = 4 }}\n",
            "{{\"tbl_multiline\": {{\"a\": 1, \"b\": \"multiline\\u000a\", \"c\": \"and" +
            " yet\\u000aanother line\", \"d\": 4}}}}"),
        ("inline-table/nest",
            "tbl_tbl_empty = {{ tbl_0 = {{}} }}\ntbl_tbl_val   = {{ tbl_1 = {{ o" +
            "ne = 1 }} }}\ntbl_arr_tbl   = {{ arr_tbl = [ {{ one = 1 }} ] }}\narr" +
            "_tbl_tbl   = [ {{ tbl = {{ one = 1 }} }} ]\n\n# Array-of-array-of-" +
            "table is interesting because it can only\n# be represented in" +
            " inline form.\narr_arr_tbl_empty = [ [ {{}} ] ]\narr_arr_tbl_val" +
            " = [ [ {{ one = 1 }} ] ]\narr_arr_tbls  = [ [ {{ one = 1 }}, {{ tw" +
            "o = 2 }} ] ]\n",
            "{{\"arr_arr_tbl_empty\": [[{{}}]], \"arr_arr_tbl_val\": [[{{\"one\": 1" +
            "}}]], \"arr_arr_tbls\": [[{{\"one\": 1}}, {{\"two\": 2}}]], \"arr_tbl_tb" +
            "l\": [{{\"tbl\": {{\"one\": 1}}}}], \"tbl_arr_tbl\": {{\"arr_tbl\": [{{\"one" +
            "\": 1}}]}}, \"tbl_tbl_empty\": {{\"tbl_0\": {{}}}}, \"tbl_tbl_val\": {{\"tb" +
            "l_1\": {{\"one\": 1}}}}}}"),
        ("inline-table/spaces",
            "# https://github.com/toml-lang/toml-test/issues/146\nclap-1 =" +
            " {{ version = \"4\"  , features = [\"derive\", \"cargo\"] }}\n\n# Cont" +
            "ains some literal tabs!\nclap-2 = {{ version = \"4\"\t   \t,\t  \tfe" +
            "atures = [   \"derive\" \t  ,  \t  \"cargo\"   ]   , nest   =   {{ " +
            " \t  \"a\"   =   'x'  , \t  'b'   = [ 1.5    ,   9.0  ]  }}  }}\n",
            "{{\"clap-1\": {{\"features\": [\"derive\", \"cargo\"], \"version\": \"4\"}}" +
            ", \"clap-2\": {{\"features\": [\"derive\", \"cargo\"], \"nest\": {{\"a\": " +
            "\"x\", \"b\": [4609434218613702656, 4621256167635550208]}}, \"vers" +
            "ion\": \"4\"}}}}"),
        ("integer/float64-max",
            "# Maximum and minimum safe float64 natural numbers. Mainly h" +
            "ere for\n# -int-as-float.\nmax_int =  9_007_199_254_740_991\nmi" +
            "n_int = -9_007_199_254_740_991\n",
            "{{\"max_int\": 9007199254740991, \"min_int\": -9007199254740991}}"),
        ("integer/integer",
            "answer = 42\nposanswer = +42\nneganswer = -42\nzero = 0\n",
            "{{\"answer\": 42, \"neganswer\": -42, \"posanswer\": 42, \"zero\": 0}}"),
        ("integer/literals",
            "bin1 = 0b11010110\nbin2 = 0b1_0_1\n\noct1 = 0o01234567\noct2 = 0" +
            "o755\noct3 = 0o7_6_5\n\nhex1 = 0xDEADBEEF\nhex2 = 0xdeadbeef\nhex" +
            "3 = 0xdead_beef\nhex4 = 0x00987\n",
            "{{\"bin1\": 214, \"bin2\": 5, \"hex1\": 3735928559, \"hex2\": 3735928" +
            "559, \"hex3\": 3735928559, \"hex4\": 2439, \"oct1\": 342391, \"oct2" +
            "\": 493, \"oct3\": 501}}"),
        ("integer/long",
            "# int64 \"should\" be supported, but is not mandatory. It's fi" +
            "ne to skip this\n# test.\nint64-max     = 9223372036854775807\n" +
            "int64-max-neg = -9223372036854775808\n",
            "{{\"int64-max\": 9223372036854775807, \"int64-max-neg\": -9223372" +
            "036854775808}}"),
        ("integer/underscore",
            "kilo = 1_000\nx = 1_1_1_1\n",
            "{{\"kilo\": 1000, \"x\": 1111}}"),
        ("integer/zero",
            "d1 = 0\nd2 = +0\nd3 = -0\n\nh1 = 0x0\nh2 = 0x00\nh3 = 0x00000\n\no1 " +
            "= 0o0\na2 = 0o00\na3 = 0o00000\n\nb1 = 0b0\nb2 = 0b00\nb3 = 0b0000" +
            "0\n",
            "{{\"a2\": 0, \"a3\": 0, \"b1\": 0, \"b2\": 0, \"b3\": 0, \"d1\": 0, \"d2\":" +
            " 0, \"d3\": 0, \"h1\": 0, \"h2\": 0, \"h3\": 0, \"o1\": 0}}"),
        ("key/alphanum",
            "alpha = \"a\"\n123 = \"num\"\n000111 = \"leading\"\n10e3 = \"false flo" +
            "at\"\none1two2 = \"mixed\"\nwith-dash = \"dashed\"\nunder_score = \"_" +
            "__\"\n34-11 = 23\n\n[2018_10]\n001 = 1\n\n[a-a-a]\n_ = false\n",
            "{{\"000111\": \"leading\", \"10e3\": \"false float\", \"123\": \"num\", \"" +
            "2018_10\": {{\"001\": 1}}, \"34-11\": 23, \"a-a-a\": {{\"_\": false}}, \"a" +
            "lpha\": \"a\", \"one1two2\": \"mixed\", \"under_score\": \"___\", \"with" +
            "-dash\": \"dashed\"}}"),
        ("key/case-sensitive",
            "sectioN = \"NN\"\n\n[section]\nname = \"lower\"\nNAME = \"upper\"\nName" +
            " = \"capitalized\"\n\n[Section]\nname = \"different section!!\"\n\"μ\"" +
            " = \"greek small letter mu\"\n\"Μ\" = \"greek capital letter MU\"\nM" +
            " = \"latin letter M\"\n\n",
            "{{\"Section\": {{\"M\": \"latin letter M\", \"name\": \"different secti" +
            "on!!\", \"Μ\": \"greek capital letter MU\", \"μ\": \"greek small let" +
            "ter mu\"}}, \"sectioN\": \"NN\", \"section\": {{\"NAME\": \"upper\", \"Nam" +
            "e\": \"capitalized\", \"name\": \"lower\"}}}}"),
        ("key/dotted-01",
            "name.first = \"Arthur\"\n\"name\".'last' = \"Dent\"\n\nmany.dots.dot." +
            "dot.dot = 42\n",
            "{{\"many\": {{\"dots\": {{\"dot\": {{\"dot\": {{\"dot\": 42}}}}}}}}, \"name\": {{\"" +
            "first\": \"Arthur\", \"last\": \"Dent\"}}}}"),
        ("key/dotted-02",
            "# Note: this file contains literal tab characters.\n\n# Space " +
            "are ignored, and key parts can be quoted.\ncount.a       = 1\n" +
            "count . b     = 2\n\"count\".\"c\"   = 3\n\"count\" . \"d\" = 4\n'count" +
            "'.'e'   = 5\n'count' . 'f' = 6\n\"count\".'g'   = 7\n\"count\" . 'h" +
            "' = 8\ncount.'i'     = 9\ncount \t.\t 'j'\t   = 10\n\"count\".k     " +
            "= 11\n\"count\" . l   = 12\n",
            "{{\"count\": {{\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5, \"f\": 6, \"" +
            "g\": 7, \"h\": 8, \"i\": 9, \"j\": 10, \"k\": 11, \"l\": 12}}}}"),
        ("key/dotted-03",
            "top.key = 1\n\n[tbl]\na.b.c = 42.666\n\n[a.few.dots]\npolka.dot = " +
            "\"again?\"\npolka.dance-with = \"Dot\"\n\n",
            "{{\"a\": {{\"few\": {{\"dots\": {{\"polka\": {{\"dance-with\": \"Dot\", \"dot\"" +
            ": \"again?\"}}}}}}}}, \"tbl\": {{\"a\": {{\"b\": {{\"c\": 4631201522987667816" +
            "}}}}}}, \"top\": {{\"key\": 1}}}}"),
        ("key/dotted-04",
            "top.key = 1\n\n[[arr]]\na.b.c=1\na.b.d=2\n\n[[arr]]\na.b.c=3\na.b.d=" +
            "4\n\n",
            "{{\"arr\": [{{\"a\": {{\"b\": {{\"c\": 1, \"d\": 2}}}}}}, {{\"a\": {{\"b\": {{\"c\": 3" +
            ", \"d\": 4}}}}}}], \"top\": {{\"key\": 1}}}}"),
        ("key/dotted-empty",
            "''.x = \"empty.x\"\nx.\"\" = \"x.empty\"\n[a]\n\"\".'' = \"empty.empty\"\n",
            "{{\"\": {{\"x\": \"empty.x\"}}, \"a\": {{\"\": {{\"\": \"empty.empty\"}}}}, \"x\": " +
            "{{\"\": \"x.empty\"}}}}"),
        ("key/empty-01",
            "\"\" = \"blank\"\n",
            "{{\"\": \"blank\"}}"),
        ("key/empty-02",
            "'' = \"blank\"\n",
            "{{\"\": \"blank\"}}"),
        ("key/empty-03",
            "''=0\n",
            "{{\"\": 0}}"),
        ("key/empty-04",
            "tbl-1     = {{\"\" = 1}}\ntbl-2     = {{\"\" = {{\"\" = 1}}}}\narr-tbl-1 =" +
            " [{{\"\" = 2}}]\narr-tbl-2 = [[{{\"\" = 2}}]]\n",
            "{{\"arr-tbl-1\": [{{\"\": 2}}], \"arr-tbl-2\": [[{{\"\": 2}}]], \"tbl-1\": " +
            "{{\"\": 1}}, \"tbl-2\": {{\"\": {{\"\": 1}}}}}}"),
        ("key/equals-nospace",
            "answer=42\n",
            "{{\"answer\": 42}}"),
        ("key/escapes",
            "\"\\n\" = \"newline\"\n\"\\b\" = \"bell\"\n\"\\u00c0\" = \"latin capital let" +
            "ter A with grave\"\n\"\\\"\" = \"just a quote\"\n\n[\"backsp\\b\\b\"]\n\n[\"\\" +
            "\"quoted\\\"\"]\nquote = true\n\n[\"a.b\".\"\\u00c0\"]\n",
            "{{\"\\u0008\": \"bell\", \"\\u000a\": \"newline\", \"\\\"\": \"just a quote\"" +
            ", \"\\\"quoted\\\"\": {{\"quote\": true}}, \"a.b\": {{\"À\": {{}}}}, \"backsp\\u" +
            "0008\\u0008\": {{}}, \"À\": \"latin capital letter A with grave\"}}"),
        ("key/like-date",
            "# '-' is a valid character in keys: make a key that looks li" +
            "ke a date.\n2001-02-03   = 1\n\"2001-02-04\" = 2\n'2001-02-05' = " +
            "3\n\n# Also include datetime and time for good measure; these " +
            "need to be quoted as\n# ':' isn't a valid bare key.\n\"2001-02-" +
            "06T15:16:17+01:00\" = 4\n\"2001-02-07T15:16:17\"       = 5\n\"15:1" +
            "6:17\"                  = 6\n\n# Dotted keys\na.2001-02-08 = 7\na" +
            ".2001-02-09.2001-02-10 = 8\n2001-02-11.a.2001-02-12 = 9\n\n# Ta" +
            "ble names\n[2002-01-02]\nk = 10\n\n[2002-01-02.2024-01-03]\nk = 1" +
            "1\n\n[[2002-01-04]]\nk = 12\n",
            "{{\"15:16:17\": 6, \"2001-02-03\": 1, \"2001-02-04\": 2, \"2001-02-0" +
            "5\": 3, \"2001-02-06T15:16:17+01:00\": 4, \"2001-02-07T15:16:17\"" +
            ": 5, \"2001-02-11\": {{\"a\": {{\"2001-02-12\": 9}}}}, \"2002-01-02\": {{" +
            "\"2024-01-03\": {{\"k\": 11}}, \"k\": 10}}, \"2002-01-04\": [{{\"k\": 12}}]" +
            ", \"a\": {{\"2001-02-08\": 7, \"2001-02-09\": {{\"2001-02-10\": 8}}}}}}"),
        ("key/numeric-01",
            "1     = true\n",
            "{{\"1\": true}}"),
        ("key/numeric-02",
            "1.2   = true\n",
            "{{\"1\": {{\"2\": true}}}}"),
        ("key/numeric-03",
            "0123  = true\n",
            "{{\"0123\": true}}"),
        ("key/numeric-04",
            "01.23 = true\n",
            "{{\"01\": {{\"23\": true}}}}"),
        ("key/numeric-05",
            "23.01 = true\n",
            "{{\"23\": {{\"01\": true}}}}"),
        ("key/numeric-06",
            "-1    = true\n",
            "{{\"-1\": true}}"),
        ("key/numeric-07",
            "-01   = true\n",
            "{{\"-01\": true}}"),
        ("key/numeric-08",
            "1  = 'one'\n01 = 'zero one'\n",
            "{{\"01\": \"zero one\", \"1\": \"one\"}}"),
        ("key/quoted-dots",
            "plain = 1\n\"with.dot\" = 2\n\n[plain_table]\nplain = 3\n\"with.dot\"" +
            " = 4\n\n[table.withdot]\nplain = 5\n\"key.with.dots\" = 6\n\"escaped" +
            "\\u002edot\" = 7\n",
            "{{\"plain\": 1, \"plain_table\": {{\"plain\": 3, \"with.dot\": 4}}, \"ta" +
            "ble\": {{\"withdot\": {{\"escaped.dot\": 7, \"key.with.dots\": 6, \"pl" +
            "ain\": 5}}}}, \"with.dot\": 2}}"),
        ("key/quoted-unicode",
            "\n\"\\u0000\" = \"null\"\n'\\u0000' = \"different key\"\n\"\\u0008 \\u000c" +
            " \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U0001" +
            "0000 \\U0010ffff\" = \"escaped key\"\n\n\"~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\" = \"basic" +
            " key\"\n'l ~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿' = \"literal key\"\n",
            "{{\"\\u0000\": \"null\", \"\\u0008 \\u000c A \\u007f \u{80} ÿ ퟿  ￿ 𐀀 􏿿\": \"" +
            "escaped key\", \"\\\\u0000\": \"different key\", \"l ~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿" +
            "\": \"literal key\", \"~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\": \"basic key\"}}"),
        ("key/space",
            "# Keep whitespace inside quotes keys at all positions.\n\"a b\"" +
            "   = 1\n\" c d \" = 2\n\"  much \t\t  whitespace  \t\\n  \\r\\n  \" = 3\n" +
            "\n[ \" tbl \" ]\n\"\\ttab\\ttab\\t\" = \"tab\"\n",
            "{{\"  much \\u0009\\u0009  whitespace  \\u0009\\u000a  \\u000d\\u000" +
            "a  \": 3, \" c d \": 2, \" tbl \": {{\"\\u0009tab\\u0009tab\\u0009\": \"" +
            "tab\"}}, \"a b\": 1}}"),
        ("key/special-chars",
            "\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\" = 1\n",
            "{{\"=~!@$^&*()_+-`1234567890[]|/?><.,;:'=\": 1}}"),
        ("key/special-word",
            "false = false\ntrue = 1\ninf = 100000000\nnan = \"ceci n'est pas" +
            " un nombre\"\n\n",
            "{{\"false\": false, \"inf\": 100000000, \"nan\": \"ceci n'est pas un" +
            " nombre\", \"true\": 1}}"),
        ("key/start",
            "# Table and keys can start with any character; there is no r" +
            "equirement for it to\n# start with a letter.\n\n[-key]\n-key = 1" +
            "\n\n[_key]\n_key = 2\n\n[1key]\n1key = 3\n\n[-]\n- = 4\n\n[_]\n_ = 5\n\n[1" +
            "] \n1 = 6\n\n[---] \n--- = 7\n\n[___]\n___ = 8\n\n[111]\n111 = 9\n\n[inl" +
            "ine]\n--- = {{--- = 10, ___ = 11, 111 = 12}}\n",
            "{{\"-\": {{\"-\": 4}}, \"---\": {{\"---\": 7}}, \"-key\": {{\"-key\": 1}}, \"1\":" +
            " {{\"1\": 6}}, \"111\": {{\"111\": 9}}, \"1key\": {{\"1key\": 3}}, \"_\": {{\"_\"" +
            ": 5}}, \"___\": {{\"___\": 8}}, \"_key\": {{\"_key\": 2}}, \"inline\": {{\"--" +
            "-\": {{\"---\": 10, \"111\": 12, \"___\": 11}}}}}}"),
        ("key/zero",
            "0=0\n",
            "{{\"0\": 0}}"),
        ("multibyte",
            "# Test multibyte throughout\n\n# Tèƨƭ ƒïℓè ƒôř TÓM£\n# Óñℓ¥ ƭλï" +
            "ƨ ôñè ƭřïèƨ ƭô è₥úℓáƭè á TÓM£ ƒïℓè ωřïƭƭèñ β¥ á úƨèř ôƒ ƭλè " +
            "ƙïñδ ôƒ ƥářƨèř ωřïƭèřƨ ƥřôβáβℓ¥ λáƭè\n\n['𝐭𝐛𝐥']\nstring = \"𝓼𝓽𝓻𝓲" +
            "𝓷𝓰 - #\"          # \" 𝓼𝓽𝓻𝓲𝓷𝓰\n\t['𝐭𝐛𝐥'.sub]\n\t'𝕒𝕣𝕣𝕒𝕪' = [ \"] \", " +
            "\" # \"]      # ] 𝓪𝓻𝓻𝓪𝔂\n\t'𝕒𝕣𝕣𝕒𝕪𝟚' = [ \"Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ\"," +
            " \"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\" ]\n\t# Ýôú δïδñ'ƭ ƭλïñƙ ïƭ'δ áƨ" +
            " èáƨ¥ áƨ çλúçƙïñϱ ôúƭ ƭλè ℓáƨƭ #, δïδ ¥ôú?\n\tanother_test_str" +
            "ing = \"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\"\n\tescapes = \" Âñδ ωλè" +
            "ñ \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\"   # \"áñδ çô₥₥èñƭƨ" +
            " ářè ƭλèřè ƭôô\"\n\t# Tλïñϱƨ ωïℓℓ ϱèƭ λářδèř\n\t\t['𝐭𝐛𝐥'.sub.\"βïƭ#" +
            "\"]\n\t\t\"ωλáƭ?\" = \"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?\"\n\t\t" +
            "multi_line_array = [\n\t\t\t\"]\",\n\t\t\t# ] Óλ ¥èƨ Ì δïδ\n\t\t\t]\n",
            "{{\"𝐭𝐛𝐥\": {{\"string\": \"𝓼𝓽𝓻𝓲𝓷𝓰 - #\", \"sub\": {{\"another_test_strin" +
            "g\": \"§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #\", \"escapes\": \" Âñδ ωλèñ" +
            " \\\"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \\\"\", \"βïƭ#\": {{\"multi_l" +
            "ine_array\": [\"]\"], \"ωλáƭ?\": \"Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ" +
            " δô ƭλáƭ?\"}}, \"𝕒𝕣𝕣𝕒𝕪\": [\"] \", \" # \"], \"𝕒𝕣𝕣𝕒𝕪𝟚\": [\"Tèƨƭ #11 ]ƥ" +
            "řôƲèδ ƭλáƭ\", \"Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ\"]}}}}}}"),
        ("newline-crlf",
            "os = \"DOS\"\r\nnewline = \"crlf\"\r\n",
            "{{\"newline\": \"crlf\", \"os\": \"DOS\"}}"),
        ("newline-lf",
            "os = \"unix\"\nnewline = \"lf\"\n",
            "{{\"newline\": \"lf\", \"os\": \"unix\"}}"),
        ("spec-1.0.0/array-0",
            "integers = [ 1, 2, 3 ]\ncolors = [ \"red\", \"yellow\", \"green\" ]" +
            "\nnested_arrays_of_ints = [ [ 1, 2 ], [3, 4, 5] ]\nnested_mixe" +
            "d_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\nstring_array = [ \"al" +
            "l\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\n\n# Mixed-typ" +
            "e arrays are allowed\nnumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\nco" +
            "ntributors = [\n  \"Foo Bar <foo@example.com>\",\n  {{ name = \"Ba" +
            "z Qux\", email = \"bazqux@example.com\", url = \"https://example" +
            ".com/bazqux\" }}\n]\n",
            "{{\"colors\": [\"red\", \"yellow\", \"green\"], \"contributors\": [\"Foo" +
            " Bar <foo@example.com>\", {{\"email\": \"bazqux@example.com\", \"na" +
            "me\": \"Baz Qux\", \"url\": \"https://example.com/bazqux\"}}], \"inte" +
            "gers\": [1, 2, 3], \"nested_arrays_of_ints\": [[1, 2], [3, 4, 5" +
            "]], \"nested_mixed_array\": [[1, 2], [\"a\", \"b\", \"c\"]], \"number" +
            "s\": [4591870180066957722, 4596373779694328218, 4602678819172" +
            "646912, 1, 2, 5], \"string_array\": [\"all\", \"strings\", \"are th" +
            "e same\", \"type\"]}}"),
        ("spec-1.0.0/array-1",
            "integers2 = [\n  1, 2, 3\n]\n\nintegers3 = [\n  1,\n  2, # this is" +
            " ok\n]\n",
            "{{\"integers2\": [1, 2, 3], \"integers3\": [1, 2]}}"),
        ("spec-1.0.0/array-of-tables-0",
            "[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]  " +
            "# empty table within the array\n\n[[products]]\nname = \"Nail\"\ns" +
            "ku = 284758393\n\ncolor = \"gray\"\n",
            "{{\"products\": [{{\"name\": \"Hammer\", \"sku\": 738594937}}, {{}}, {{\"co" +
            "lor\": \"gray\", \"name\": \"Nail\", \"sku\": 284758393}}]}}"),
        ("spec-1.0.0/array-of-tables-1",
            "[[fruits]]\nname = \"apple\"\n\n[fruits.physical]  # subtable\ncol" +
            "or = \"red\"\nshape = \"round\"\n\n[[fruits.varieties]]  # nested a" +
            "rray of tables\nname = \"red delicious\"\n\n[[fruits.varieties]]\n" +
            "name = \"granny smith\"\n\n\n[[fruits]]\nname = \"banana\"\n\n[[fruits" +
            ".varieties]]\nname = \"plantain\"\n",
            "{{\"fruits\": [{{\"name\": \"apple\", \"physical\": {{\"color\": \"red\", \"" +
            "shape\": \"round\"}}, \"varieties\": [{{\"name\": \"red delicious\"}}, {{" +
            "\"name\": \"granny smith\"}}]}}, {{\"name\": \"banana\", \"varieties\": [" +
            "{{\"name\": \"plantain\"}}]}}]}}"),
        ("spec-1.0.0/array-of-tables-2",
            "points = [ {{ x = 1, y = 2, z = 3 }},\n           {{ x = 7, y = " +
            "8, z = 9 }},\n           {{ x = 2, y = 4, z = 8 }} ]\n",
            "{{\"points\": [{{\"x\": 1, \"y\": 2, \"z\": 3}}, {{\"x\": 7, \"y\": 8, \"z\": " +
            "9}}, {{\"x\": 2, \"y\": 4, \"z\": 8}}]}}"),
        ("spec-1.0.0/boolean-0",
            "bool1 = true\nbool2 = false\n",
            "{{\"bool1\": true, \"bool2\": false}}"),
        ("spec-1.0.0/comment-0",
            "# This is a full-line comment\nkey = \"value\"  # This is a com" +
            "ment at the end of a line\nanother = \"# This is not a comment" +
            "\"\n",
            "{{\"another\": \"# This is not a comment\", \"key\": \"value\"}}"),
        ("spec-1.0.0/float-0",
            "# fractional\nflt1 = +1.0\nflt2 = 3.1415\nflt3 = -0.01\n\n# expon" +
            "ent\nflt4 = 5e+22\nflt5 = 1e06\nflt6 = -2E-2\n\n# both\nflt7 = 6.6" +
            "26e-34\n",
            "{{\"flt1\": 4607182418800017408, \"flt2\": 4614256447914709615, \"" +
            "flt3\": 13800290266158863483, \"flt4\": 4946409255702973174, \"f" +
            "lt5\": 4696837146684686336, \"flt6\": 13804793865786233979, \"fl" +
            "t7\": 4110526388413685506}}"),
        ("spec-1.0.0/float-1",
            "flt8 = 224_617.445_991_228\n",
            "{{\"flt8\": 4686957809515092309}}"),
        ("spec-1.0.0/float-2",
            "# infinity\nsf1 = inf  # positive infinity\nsf2 = +inf # posit" +
            "ive infinity\nsf3 = -inf # negative infinity\n\n# not a number\n" +
            "sf4 = nan  # actual sNaN/qNaN encoding is implementation-spe" +
            "cific\nsf5 = +nan # same as `nan`\nsf6 = -nan # valid, actual " +
            "encoding is implementation-specific\n",
            "{{\"sf1\": 9218868437227405312, \"sf2\": 9218868437227405312, \"sf" +
            "3\": 18442240474082181120, \"sf4\": nan, \"sf5\": nan, \"sf6\": nan" +
            "}}"),
        ("spec-1.0.0/inline-table-0",
            "name = {{ first = \"Tom\", last = \"Preston-Werner\" }}\npoint = {{ " +
            "x = 1, y = 2 }}\nanimal = {{ type.name = \"pug\" }}\n",
            "{{\"animal\": {{\"type\": {{\"name\": \"pug\"}}}}, \"name\": {{\"first\": \"Tom" +
            "\", \"last\": \"Preston-Werner\"}}, \"point\": {{\"x\": 1, \"y\": 2}}}}"),
        ("spec-1.0.0/inline-table-1",
            "[name]\nfirst = \"Tom\"\nlast = \"Preston-Werner\"\n\n[point]\nx = 1\n" +
            "y = 2\n\n[animal]\ntype.name = \"pug\"\n",
            "{{\"animal\": {{\"type\": {{\"name\": \"pug\"}}}}, \"name\": {{\"first\": \"Tom" +
            "\", \"last\": \"Preston-Werner\"}}, \"point\": {{\"x\": 1, \"y\": 2}}}}"),
        ("spec-1.0.0/inline-table-2",
            "[product]\ntype = {{ name = \"Nail\" }}\n# type.edible = false  # " +
            "INVALID\n",
            "{{\"product\": {{\"type\": {{\"name\": \"Nail\"}}}}}}"),
        ("spec-1.0.0/inline-table-3",
            "[product]\ntype.name = \"Nail\"\n# type = {{ edible = false }}  # " +
            "INVALID\n",
            "{{\"product\": {{\"type\": {{\"name\": \"Nail\"}}}}}}"),
        ("spec-1.0.0/integer-0",
            "int1 = +99\nint2 = 42\nint3 = 0\nint4 = -17\n",
            "{{\"int1\": 99, \"int2\": 42, \"int3\": 0, \"int4\": -17}}"),
        ("spec-1.0.0/integer-1",
            "int5 = 1_000\nint6 = 5_349_221\nint7 = 53_49_221  # Indian num" +
            "ber system grouping\nint8 = 1_2_3_4_5  # VALID but discourage" +
            "d\n",
            "{{\"int5\": 1000, \"int6\": 5349221, \"int7\": 5349221, \"int8\": 123" +
            "45}}"),
        ("spec-1.0.0/integer-2",
            "# hexadecimal with prefix `0x`\nhex1 = 0xDEADBEEF\nhex2 = 0xde" +
            "adbeef\nhex3 = 0xdead_beef\n\n# octal with prefix `0o`\noct1 = 0" +
            "o01234567\noct2 = 0o755 # useful for Unix file permissions\n\n#" +
            " binary with prefix `0b`\nbin1 = 0b11010110\n",
            "{{\"bin1\": 214, \"hex1\": 3735928559, \"hex2\": 3735928559, \"hex3\"" +
            ": 3735928559, \"oct1\": 342391, \"oct2\": 493}}"),
        ("spec-1.0.0/key-value-pair-0",
            "key = \"value\"\n",
            "{{\"key\": \"value\"}}"),
        ("spec-1.0.0/keys-0",
            "key = \"value\"\nbare_key = \"value\"\nbare-key = \"value\"\n1234 = \"" +
            "value\"\n",
            "{{\"1234\": \"value\", \"bare-key\": \"value\", \"bare_key\": \"value\", " +
            "\"key\": \"value\"}}"),
        ("spec-1.0.0/keys-1",
            "\"127.0.0.1\" = \"value\"\n\"character encoding\" = \"value\"\n\"ʎǝʞ\" =" +
            " \"value\"\n'key2' = \"value\"\n'quoted \"value\"' = \"value\"\n",
            "{{\"127.0.0.1\": \"value\", \"character encoding\": \"value\", \"key2\"" +
            ": \"value\", \"quoted \\\"value\\\"\": \"value\", \"ʎǝʞ\": \"value\"}}"),
        ("spec-1.0.0/keys-3",
            "name = \"Orange\"\nphysical.color = \"orange\"\nphysical.shape = \"" +
            "round\"\nsite.\"google.com\" = true\n",
            "{{\"name\": \"Orange\", \"physical\": {{\"color\": \"orange\", \"shape\": " +
            "\"round\"}}, \"site\": {{\"google.com\": true}}}}"),
        ("spec-1.0.0/keys-4",
            "fruit.name = \"banana\"     # this is best practice\nfruit. col" +
            "or = \"yellow\"    # same as fruit.color\nfruit . flavor = \"ban" +
            "ana\"   # same as fruit.flavor\n",
            "{{\"fruit\": {{\"color\": \"yellow\", \"flavor\": \"banana\", \"name\": \"b" +
            "anana\"}}}}"),
        ("spec-1.0.0/keys-5",
            "# VALID BUT DISCOURAGED\n\napple.type = \"fruit\"\norange.type = " +
            "\"fruit\"\n\napple.skin = \"thin\"\norange.skin = \"thick\"\n\napple.co" +
            "lor = \"red\"\norange.color = \"orange\"\n",
            "{{\"apple\": {{\"color\": \"red\", \"skin\": \"thin\", \"type\": \"fruit\"}}," +
            " \"orange\": {{\"color\": \"orange\", \"skin\": \"thick\", \"type\": \"fru" +
            "it\"}}}}"),
        ("spec-1.0.0/keys-6",
            "# RECOMMENDED\n\napple.type = \"fruit\"\napple.skin = \"thin\"\nappl" +
            "e.color = \"red\"\n\norange.type = \"fruit\"\norange.skin = \"thick\"" +
            "\norange.color = \"orange\"\n",
            "{{\"apple\": {{\"color\": \"red\", \"skin\": \"thin\", \"type\": \"fruit\"}}," +
            " \"orange\": {{\"color\": \"orange\", \"skin\": \"thick\", \"type\": \"fru" +
            "it\"}}}}"),
        ("spec-1.0.0/keys-7",
            "3.14159 = \"pi\"\n",
            "{{\"3\": {{\"14159\": \"pi\"}}}}"),
        ("spec-1.0.0/local-date-0",
            "ld1 = 1979-05-27\n",
            "{{\"ld1\": \"1979-05-27\"}}"),
        ("spec-1.0.0/local-date-time-0",
            "ldt1 = 1979-05-27T07:32:00\nldt2 = 1979-05-27T00:32:00.999\n",
            "{{\"ldt1\": \"1979-05-27T07:32:00\", \"ldt2\": \"1979-05-27T00:32:00" +
            ".999\"}}"),
        ("spec-1.0.0/local-time-0",
            "lt1 = 07:32:00\nlt2 = 00:32:00.999\n",
            "{{\"lt1\": \"07:32:00\", \"lt2\": \"00:32:00.999\"}}"),
        ("spec-1.0.0/offset-date-time-0",
            "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00" +
            "\nodt3 = 1979-05-27T00:32:00.999-07:00\n",
            "{{\"odt1\": \"1979-05-27T07:32:00Z\", \"odt2\": \"1979-05-27T00:32:0" +
            "0-07:00\", \"odt3\": \"1979-05-27T00:32:00.999-07:00\"}}"),
        ("spec-1.0.0/offset-date-time-1",
            "odt4 = 1979-05-27 07:32:00Z\n",
            "{{\"odt4\": \"1979-05-27T07:32:00Z\"}}"),
        ("spec-1.0.0/string-0",
            "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\u00E9\\n" +
            "Location\\tSF.\"\n",
            "{{\"str\": \"I'm a string. \\\"You can quote me\\\". Name\\u0009José\\" +
            "u000aLocation\\u0009SF.\"}}"),
        ("spec-1.0.0/string-1",
            "str1 = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n",
            "{{\"str1\": \"Roses are red\\u000aViolets are blue\"}}"),
        ("spec-1.0.0/string-2",
            "# On a Unix system, the above multi-line string will most li" +
            "kely be the same as:\nstr2 = \"Roses are red\\nViolets are blue" +
            "\"\n\n# On a Windows system, it will most likely be equivalent " +
            "to:\nstr3 = \"Roses are red\\r\\nViolets are blue\"\n",
            "{{\"str2\": \"Roses are red\\u000aViolets are blue\", \"str3\": \"Ros" +
            "es are red\\u000d\\u000aViolets are blue\"}}"),
        ("spec-1.0.0/string-3",
            "# The following strings are byte-for-byte equivalent:\nstr1 =" +
            " \"The quick brown fox jumps over the lazy dog.\"\n\nstr2 = \"\"\"\n" +
            "The quick brown \\\n\n\n  fox jumps over \\\n    the lazy dog.\"\"\"\n" +
            "\nstr3 = \"\"\"\\\n       The quick brown \\\n       fox jumps over " +
            "\\\n       the lazy dog.\\\n       \"\"\"\n",
            "{{\"str1\": \"The quick brown fox jumps over the lazy dog.\", \"st" +
            "r2\": \"The quick brown fox jumps over the lazy dog.\", \"str3\":" +
            " \"The quick brown fox jumps over the lazy dog.\"}}"),
        ("spec-1.0.0/string-4",
            "str4 = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"" +
            "\"\n# str5 = \"\"\"Here are three quotation marks: \"\"\".\"\"\"  # INV" +
            "ALID\nstr5 = \"\"\"Here are three quotation marks: \"\"\\\".\"\"\"\nstr6" +
            " = \"\"\"Here are fifteen quotation marks: \"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"\"\"\\\"" +
            ".\"\"\"\n\n# \"This,\" she said, \"is just a pointless statement.\"\ns" +
            "tr7 = \"\"\"\"This,\" she said, \"is just a pointless statement.\"\"" +
            "\"\"\n",
            "{{\"str4\": \"Here are two quotation marks: \\\"\\\". Simple enough." +
            "\", \"str5\": \"Here are three quotation marks: \\\"\\\"\\\".\", \"str6\"" +
            ": \"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\\" +
            "\"\\\"\\\"\\\".\", \"str7\": \"\\\"This,\\\" she said, \\\"is just a pointles" +
            "s statement.\\\"\"}}"),
        ("spec-1.0.0/string-5",
            "# What you see is what you get.\nwinpath  = 'C:\\Users\\nodejs\\" +
            "templates'\nwinpath2 = '\\\\ServerX\\admin$\\system32\\'\nquoted   " +
            "= 'Tom \"Dubs\" Preston-Werner'\nregex    = '<\\i\\c*\\s*>'\n",
            "{{\"quoted\": \"Tom \\\"Dubs\\\" Preston-Werner\", \"regex\": \"<\\\\i\\\\c*" +
            "\\\\s*>\", \"winpath\": \"C:\\\\Users\\\\nodejs\\\\templates\", \"winpath2" +
            "\": \"\\\\\\\\ServerX\\\\admin$\\\\system32\\\\\"}}"),
        ("spec-1.0.0/string-6",
            "regex2 = '''I [dw]on't need \\d{{2}} apples'''\nlines  = '''\nThe" +
            " first newline is\ntrimmed in raw strings.\n   All other white" +
            "space\n   is preserved.\n'''\n",
            "{{\"lines\": \"The first newline is\\u000atrimmed in raw strings." +
            "\\u000a   All other whitespace\\u000a   is preserved.\\u000a\", " +
            "\"regex2\": \"I [dw]on't need \\\\d{{2}} apples\"}}"),
        ("spec-1.0.0/string-7",
            "quot15 = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"" +
            "\"'''\n\n# apos15 = '''Here are fifteen apostrophes: ''''''''''" +
            "''''''''  # INVALID\napos15 = \"Here are fifteen apostrophes: " +
            "'''''''''''''''\"\n\n# 'That,' she said, 'is still pointless.'\n" +
            "str = ''''That,' she said, 'is still pointless.''''\n",
            "{{\"apos15\": \"Here are fifteen apostrophes: '''''''''''''''\", " +
            "\"quot15\": \"Here are fifteen quotation marks: \\\"\\\"\\\"\\\"\\\"\\\"\\\"\\" +
            "\"\\\"\\\"\\\"\\\"\\\"\\\"\\\"\", \"str\": \"'That,' she said, 'is still pointl" +
            "ess.'\"}}"),
        ("spec-1.0.0/table-0",
            "[table]\n",
            "{{\"table\": {{}}}}"),
        ("spec-1.0.0/table-1",
            "[table-1]\nkey1 = \"some string\"\nkey2 = 123\n\n[table-2]\nkey1 = " +
            "\"another string\"\nkey2 = 456\n",
            "{{\"table-1\": {{\"key1\": \"some string\", \"key2\": 123}}, \"table-2\":" +
            " {{\"key1\": \"another string\", \"key2\": 456}}}}"),
        ("spec-1.0.0/table-2",
            "[dog.\"tater.man\"]\ntype.name = \"pug\"\n",
            "{{\"dog\": {{\"tater.man\": {{\"type\": {{\"name\": \"pug\"}}}}}}}}"),
        ("spec-1.0.0/table-3",
            "[a.b.c]            # this is best practice\n[ d.e.f ]        " +
            "  # same as [d.e.f]\n[ g .  h  . i ]    # same as [g.h.i]\n[ j" +
            " . \"ʞ\" . 'l' ]  # same as [j.\"ʞ\".'l']\n",
            "{{\"a\": {{\"b\": {{\"c\": {{}}}}}}, \"d\": {{\"e\": {{\"f\": {{}}}}}}, \"g\": {{\"h\": {{\"" +
            "i\": {{}}}}}}, \"j\": {{\"ʞ\": {{\"l\": {{}}}}}}}}"),
        ("spec-1.0.0/table-4",
            "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for" +
            " this to work\n\n[x] # defining a super-table afterward is ok\n",
            "{{\"x\": {{\"y\": {{\"z\": {{\"w\": {{}}}}}}}}}}"),
        ("spec-1.0.0/table-5",
            "# VALID BUT DISCOURAGED\n[fruit.apple]\n[animal]\n[fruit.orange" +
            "]\n",
            "{{\"animal\": {{}}, \"fruit\": {{\"apple\": {{}}, \"orange\": {{}}}}}}"),
        ("spec-1.0.0/table-6",
            "# RECOMMENDED\n[fruit.apple]\n[fruit.orange]\n[animal]\n",
            "{{\"animal\": {{}}, \"fruit\": {{\"apple\": {{}}, \"orange\": {{}}}}}}"),
        ("spec-1.0.0/table-7",
            "# Top-level table begins.\nname = \"Fido\"\nbreed = \"pug\"\n\n# Top" +
            "-level table ends.\n[owner]\nname = \"Regina Dogman\"\nmember_sin" +
            "ce = 1999-08-04\n",
            "{{\"breed\": \"pug\", \"name\": \"Fido\", \"owner\": {{\"member_since\": \"" +
            "1999-08-04\", \"name\": \"Regina Dogman\"}}}}"),
        ("spec-1.0.0/table-8",
            "fruit.apple.color = \"red\"\n# Defines a table named fruit\n# De" +
            "fines a table named fruit.apple\n\nfruit.apple.taste.sweet = t" +
            "rue\n# Defines a table named fruit.apple.taste\n# fruit and fr" +
            "uit.apple were already created\n",
            "{{\"fruit\": {{\"apple\": {{\"color\": \"red\", \"taste\": {{\"sweet\": true" +
            "}}}}}}}}"),
        ("spec-1.0.0/table-9",
            "[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n# [fru" +
            "it.apple]  # INVALID\n# [fruit.apple.taste]  # INVALID\n\n[frui" +
            "t.apple.texture]  # you can add sub-tables\nsmooth = true\n",
            "{{\"fruit\": {{\"apple\": {{\"color\": \"red\", \"taste\": {{\"sweet\": true" +
            "}}, \"texture\": {{\"smooth\": true}}}}}}}}"),
        ("spec-example-1-compact",
            "#Useless spaces eliminated.\ntitle=\"TOML Example\"\n[owner]\nnam" +
            "e=\"Lance Uppercut\"\ndob=1979-05-27T07:32:00-08:00#First class" +
            " dates\n[database]\nserver=\"192.168.1.1\"\nports=[8001,8001,8002" +
            "]\nconnection_max=5000\nenabled=true\n[servers]\n[servers.alpha]" +
            "\nip=\"10.0.0.1\"\ndc=\"eqdc10\"\n[servers.beta]\nip=\"10.0.0.2\"\ndc=\"" +
            "eqdc10\"\n[clients]\ndata=[[\"gamma\",\"delta\"],[1,2]]\nhosts=[\n\"al" +
            "pha\",\n\"omega\"\n]\n",
            "{{\"clients\": {{\"data\": [[\"gamma\", \"delta\"], [1, 2]], \"hosts\": " +
            "[\"alpha\", \"omega\"]}}, \"database\": {{\"connection_max\": 5000, \"e" +
            "nabled\": true, \"ports\": [8001, 8001, 8002], \"server\": \"192.1" +
            "68.1.1\"}}, \"owner\": {{\"dob\": \"1979-05-27T07:32:00-08:00\", \"nam" +
            "e\": \"Lance Uppercut\"}}, \"servers\": {{\"alpha\": {{\"dc\": \"eqdc10\"," +
            " \"ip\": \"10.0.0.1\"}}, \"beta\": {{\"dc\": \"eqdc10\", \"ip\": \"10.0.0.2" +
            "\"}}}}, \"title\": \"TOML Example\"}}"),
        ("spec-example-1",
            "# This is a TOML document. Boom.\n\ntitle = \"TOML Example\"\n\n[o" +
            "wner]\nname = \"Lance Uppercut\"\ndob = 1979-05-27T07:32:00-08:0" +
            "0 # First class dates? Why not?\n\n[database]\nserver = \"192.16" +
            "8.1.1\"\nports = [ 8001, 8001, 8002 ]\nconnection_max = 5000\nen" +
            "abled = true\n\n[servers]\n\n  # You can indent as you please. T" +
            "abs or spaces. TOML don't care.\n  [servers.alpha]\n  ip = \"10" +
            ".0.0.1\"\n  dc = \"eqdc10\"\n\n  [servers.beta]\n  ip = \"10.0.0.2\"\n" +
            "  dc = \"eqdc10\"\n\n[clients]\ndata = [ [\"gamma\", \"delta\"], [1, " +
            "2] ]\n\n# Line breaks are OK when inside arrays\nhosts = [\n  \"a" +
            "lpha\",\n  \"omega\"\n]\n",
            "{{\"clients\": {{\"data\": [[\"gamma\", \"delta\"], [1, 2]], \"hosts\": " +
            "[\"alpha\", \"omega\"]}}, \"database\": {{\"connection_max\": 5000, \"e" +
            "nabled\": true, \"ports\": [8001, 8001, 8002], \"server\": \"192.1" +
            "68.1.1\"}}, \"owner\": {{\"dob\": \"1979-05-27T07:32:00-08:00\", \"nam" +
            "e\": \"Lance Uppercut\"}}, \"servers\": {{\"alpha\": {{\"dc\": \"eqdc10\"," +
            " \"ip\": \"10.0.0.1\"}}, \"beta\": {{\"dc\": \"eqdc10\", \"ip\": \"10.0.0.2" +
            "\"}}}}, \"title\": \"TOML Example\"}}"),
        ("string/basic-escape-01",
            "# Escape \"\ntest = \"\\\"one\\\"\"\n",
            "{{\"test\": \"\\\"one\\\"\"}}"),
        ("string/basic-escape-02",
            "# Escape \\ and then \"\ntest = \"\\\\\\\"one\"\n",
            "{{\"test\": \"\\\\\\\"one\"}}"),
        ("string/basic-escape-03",
            "# Escape \\ four times and then \"\ntest = \"\\\\\\\\\\\\\\\\\\\"one\"\n",
            "{{\"test\": \"\\\\\\\\\\\\\\\\\\\"one\"}}"),
        ("string/empty",
            "answer = \"\"\n",
            "{{\"answer\": \"\"}}"),
        ("string/ends-in-whitespace-escape",
            "beee = \"\"\"\nheeee\ngeeee\\  \n\n\n      \"\"\"\n",
            "{{\"beee\": \"heeee\\u000ageeee\"}}"),
        ("string/escape-tricky",
            "end_esc = \"String does not end here\\\" but ends here\\\\\"\nlit_e" +
            "nd_esc = 'String ends here\\'\n\nmultiline_unicode = \"\"\"\n\\u00a0" +
            "\"\"\"\n\nmultiline_not_unicode = \"\"\"\n\\\\u0041\"\"\"\n\nmultiline_end_e" +
            "sc = \"\"\"When will it end? \\\"\"\"...\"\"\\\" should be here\\\"\"\"\"\n\nl" +
            "it_multiline_not_unicode = '''\n\\u007f'''\n\nlit_multiline_end " +
            "= '''There is no escape\\'''\n",
            "{{\"end_esc\": \"String does not end here\\\" but ends here\\\\\", \"l" +
            "it_end_esc\": \"String ends here\\\\\", \"lit_multiline_end\": \"The" +
            "re is no escape\\\\\", \"lit_multiline_not_unicode\": \"\\\\u007f\", " +
            "\"multiline_end_esc\": \"When will it end? \\\"\\\"\\\"...\\\"\\\"\\\" shou" +
            "ld be here\\\"\", \"multiline_not_unicode\": \"\\\\u0041\", \"multilin" +
            "e_unicode\": \" \"}}"),
        ("string/escaped-escape",
            "answer = \"\\\\x64\"\n",
            "{{\"answer\": \"\\\\x64\"}}"),
        ("string/escapes",
            "backspace     = \"|\\b.\"\ntab           = \"|\\t.\"\nnewline       " +
            "= \"|\\n.\"\nformfeed      = \"|\\f.\"\ncarriage      = \"|\\r.\"\nquote" +
            "         = \"|\\\".\"\nbackslash     = \"|\\\\.\"\ndelete        = \"|\\" +
            "u007F.\"\nunitseparator = \"|\\u001F.\"\n\n# \\u is escaped, so shou" +
            "ld NOT be interperted as a \\u escape.\nnotunicode1   = \"|\\\\u." +
            "\"\nnotunicode2   = \"|\\u005Cu.\"\nnotunicode3   = \"|\\\\u0075.\"\nno" +
            "tunicode4   = \"|\\\\\\u0075.\"\n",
            "{{\"backslash\": \"|\\\\.\", \"backspace\": \"|\\u0008.\", \"carriage\": \"" +
            "|\\u000d.\", \"delete\": \"|\\u007f.\", \"formfeed\": \"|\\u000c.\", \"ne" +
            "wline\": \"|\\u000a.\", \"notunicode1\": \"|\\\\u.\", \"notunicode2\": \"" +
            "|\\\\u.\", \"notunicode3\": \"|\\\\u0075.\", \"notunicode4\": \"|\\\\u.\", " +
            "\"quote\": \"|\\\".\", \"tab\": \"|\\u0009.\", \"unitseparator\": \"|\\u001" +
            "f.\"}}"),
        ("string/multibyte-escape",
            "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nba" +
            "sic-1    = \"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U00010AF1\"" +
            "\nml-basic-1 = \"\"\"\\u0251 \\u20ac \\U00010AF1 \\u0251\\u20ac\\U0001" +
            "0AF1\"\"\"\n\n# Again, but only using \\U\nbasic-2    = \"\\U00000251" +
            " \\U000020ac \\U00010AF1 \\U00000251\\U000020ac\\U00010AF1\"\nml-ba" +
            "sic-2 = \"\"\"\\U00000251 \\U000020ac \\U00010AF1 \\U00000251\\U0000" +
            "20ac\\U00010AF1\"\"\"\n",
            "{{\"basic-1\": \"ɑ € 𐫱 ɑ€𐫱\", \"basic-2\": \"ɑ € 𐫱 ɑ€𐫱\", \"ml-basic-1" +
            "\": \"ɑ € 𐫱 ɑ€𐫱\", \"ml-basic-2\": \"ɑ € 𐫱 ɑ€𐫱\"}}"),
        ("string/multibyte",
            "# Test each multibyte length: 2, 3, and 4 bytes:\n# ɑ € 𐫱\n\nba" +
            "sic    = \"ɑ € 𐫱 ɑ€𐫱\"\nraw      = 'ɑ € 𐫱 ɑ€𐫱'\nml-basic = \"\"\"ɑ " +
            "€ 𐫱 ɑ€𐫱\"\"\"\nml-raw   = '''ɑ € 𐫱 ɑ€𐫱'''\n",
            "{{\"basic\": \"ɑ € 𐫱 ɑ€𐫱\", \"ml-basic\": \"ɑ € 𐫱 ɑ€𐫱\", \"ml-raw\": \"ɑ" +
            " € 𐫱 ɑ€𐫱\", \"raw\": \"ɑ € 𐫱 ɑ€𐫱\"}}"),
        ("string/multiline-empty",
            "empty-1 = \"\"\"\"\"\"\n\n# A newline immediately following the open" +
            "ing delimiter will be trimmed.\nempty-2 = \"\"\"\n\"\"\"\n\n# \\ at the" +
            " end of line trims newlines as well; note that last \\ is fol" +
            "lowed by\n# two spaces, which are ignored.\nempty-3 = \"\"\"\\\n   " +
            " \"\"\"\nempty-4 = \"\"\"\\\n   \\\n   \\  \n   \"\"\"\n\n",
            "{{\"empty-1\": \"\", \"empty-2\": \"\", \"empty-3\": \"\", \"empty-4\": \"\"}}"),
        ("string/multiline-escaped-crlf",
            "# The following line should be an unescaped backslash follow" +
            "ed by a Windows\r\n# newline sequence (\"\\r\\n\")\r\n0=\"\"\"\\\r\n\"\"\"\r\n",
            "{{\"0\": \"\"}}"),
        ("string/multiline-quotes",
            "# Make sure that quotes inside multiline strings are allowed" +
            ", including right\n# after the opening '''/\"\"\" and before the" +
            " closing '''/\"\"\"\n\nlit_one = ''''one quote''''\nlit_two = ''''" +
            "'two quotes'''''\nlit_one_space = ''' 'one quote' '''\nlit_two" +
            "_space = ''' ''two quotes'' '''\n\none = \"\"\"\"one quote\"\"\"\"\ntwo" +
            " = \"\"\"\"\"two quotes\"\"\"\"\"\none_space = \"\"\" \"one quote\" \"\"\"\ntwo_" +
            "space = \"\"\" \"\"two quotes\"\" \"\"\"\n\nmismatch1 = \"\"\"aaa'''bbb\"\"\"\n" +
            "mismatch2 = '''aaa\"\"\"bbb'''\n\n# Three opening \"\"\", then one e" +
            "scaped \", then two \"\" (allowed), and then three\n# closing \"\"" +
            "\"\nescaped = \"\"\"lol\\\"\"\"\"\"\"\n\nfive-quotes = \"\"\"\nClosing with fi" +
            "ve quotes\n\"\"\"\"\"\nfour-quotes = \"\"\"\nClosing with four quotes\n\"" +
            "\"\"\"\n",
            "{{\"escaped\": \"lol\\\"\\\"\\\"\", \"five-quotes\": \"Closing with five q" +
            "uotes\\u000a\\\"\\\"\", \"four-quotes\": \"Closing with four quotes\\u" +
            "000a\\\"\", \"lit_one\": \"'one quote'\", \"lit_one_space\": \" 'one q" +
            "uote' \", \"lit_two\": \"''two quotes''\", \"lit_two_space\": \" ''t" +
            "wo quotes'' \", \"mismatch1\": \"aaa'''bbb\", \"mismatch2\": \"aaa\\\"" +
            "\\\"\\\"bbb\", \"one\": \"\\\"one quote\\\"\", \"one_space\": \" \\\"one quote" +
            "\\\" \", \"two\": \"\\\"\\\"two quotes\\\"\\\"\", \"two_space\": \" \\\"\\\"two qu" +
            "otes\\\"\\\" \"}}"),
        ("string/multiline",
            "# NOTE: this file includes some literal tab characters.\n\nequ" +
            "ivalent_one = \"The quick brown fox jumps over the lazy dog.\"" +
            "\nequivalent_two = \"\"\"\nThe quick brown \\\n\n\n  fox jumps over \\" +
            "\n    the lazy dog.\"\"\"\n\nequivalent_three = \"\"\"\\\n       The qu" +
            "ick brown \\\n       fox jumps over \\\n       the lazy dog.\\\n  " +
            "     \"\"\"\n\nwhitespace-after-bs = \"\"\"\\\n       The quick brown " +
            "\\\n       fox jumps over \\   \n       the lazy dog.\\\t\n       \"" +
            "\"\"\n\nno-space = \"\"\"a\\\n    b\"\"\"\n\n# Has tab character.\nkeep-ws-" +
            "before = \"\"\"a   \t\\\n   b\"\"\"\n\nescape-bs-1 = \"\"\"a \\\\\nb\"\"\"\n\nesca" +
            "pe-bs-2 = \"\"\"a \\\\\\\nb\"\"\"\n\nescape-bs-3 = \"\"\"a \\\\\\\\\n  b\"\"\"\n",
            "{{\"equivalent_one\": \"The quick brown fox jumps over the lazy " +
            "dog.\", \"equivalent_three\": \"The quick brown fox jumps over t" +
            "he lazy dog.\", \"equivalent_two\": \"The quick brown fox jumps " +
            "over the lazy dog.\", \"escape-bs-1\": \"a \\\\\\u000ab\", \"escape-b" +
            "s-2\": \"a \\\\b\", \"escape-bs-3\": \"a \\\\\\\\\\u000a  b\", \"keep-ws-be" +
            "fore\": \"a   \\u0009b\", \"no-space\": \"ab\", \"whitespace-after-bs" +
            "\": \"The quick brown fox jumps over the lazy dog.\"}}"),
        ("string/nl",
            "nl_mid = \"val\\nue\"\nnl_end = \"\"\"value\\n\"\"\"\n\nlit_nl_end = '''v" +
            "alue\\n'''\nlit_nl_mid = 'val\\nue'\nlit_nl_uni = 'val\\ue'\n",
            "{{\"lit_nl_end\": \"value\\\\n\", \"lit_nl_mid\": \"val\\\\nue\", \"lit_nl" +
            "_uni\": \"val\\\\ue\", \"nl_end\": \"value\\u000a\", \"nl_mid\": \"val\\u0" +
            "00aue\"}}"),
        ("string/quoted-unicode",
            "\nescaped_string = \"\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u" +
            "0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff\"\nnot_" +
            "escaped_string = '\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0" +
            "080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff'\n\nbasi" +
            "c_string = \"~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\"\nliteral_string = '~ \u{80} ÿ ퟿  ￿ 𐀀" +
            " 􏿿'\n",
            "{{\"basic_string\": \"~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\", \"escaped_string\": \"\\u000" +
            "0 \\u0008 \\u000c A \\u007f \u{80} ÿ ퟿  ￿ 𐀀 􏿿\", \"literal_string\": \"" +
            "~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\", \"not_escaped_string\": \"\\\\u0000 \\\\u0008 \\\\u" +
            "000c \\\\U00000041 \\\\u007f \\\\u0080 \\\\u00ff \\\\ud7ff \\\\ue000 \\\\u" +
            "ffff \\\\U00010000 \\\\U0010ffff\"}}"),
        ("string/raw-empty",
            "empty = ''\n",
            "{{\"empty\": \"\"}}"),
        ("string/raw-multiline",
            "# Single ' should be allowed.\noneline = '''This string has a" +
            " ' quote character.'''\n\n# A newline immediately following th" +
            "e opening delimiter will be trimmed.\nfirstnl = '''\nThis stri" +
            "ng has a ' quote character.'''\n\n# All other whitespace and n" +
            "ewline characters remain intact.\nmultiline = '''\nThis string" +
            "\nhas ' a quote character\nand more than\none newline\nin it.'''" +
            "\n\n# Tab character in literal string does not need to be esca" +
            "ped\nmultiline_with_tab = '''First line\n\t Followed by a tab''" +
            "'\n\nthis-str-has-apostrophes='''' there's one already\n'' two " +
            "more\n'''''\n",
            "{{\"firstnl\": \"This string has a ' quote character.\", \"multili" +
            "ne\": \"This string\\u000ahas ' a quote character\\u000aand more" +
            " than\\u000aone newline\\u000ain it.\", \"multiline_with_tab\": \"" +
            "First line\\u000a\\u0009 Followed by a tab\", \"oneline\": \"This " +
            "string has a ' quote character.\", \"this-str-has-apostrophes\"" +
            ": \"' there's one already\\u000a'' two more\\u000a''\"}}"),
        ("string/raw",
            "backspace = 'This string has a \\b backspace character.'\ntab " +
            "= 'This string has a \\t tab character.'\nunescaped_tab = 'Thi" +
            "s string has an \t unescaped tab character.'\nnewline = 'This " +
            "string has a \\n new line character.'\nformfeed = 'This string" +
            " has a \\f form feed character.'\ncarriage = 'This string has " +
            "a \\r carriage return character.'\nslash = 'This string has a " +
            "\\/ slash character.'\nbackslash = 'This string has a \\\\ backs" +
            "lash character.'\n",
            "{{\"backslash\": \"This string has a \\\\\\\\ backslash character.\"," +
            " \"backspace\": \"This string has a \\\\b backspace character.\", " +
            "\"carriage\": \"This string has a \\\\r carriage return character" +
            ".\", \"formfeed\": \"This string has a \\\\f form feed character.\"" +
            ", \"newline\": \"This string has a \\\\n new line character.\", \"s" +
            "lash\": \"This string has a \\\\/ slash character.\", \"tab\": \"Thi" +
            "s string has a \\\\t tab character.\", \"unescaped_tab\": \"This s" +
            "tring has an \\u0009 unescaped tab character.\"}}"),
        ("string/simple",
            "answer = \"You are not drinking enough whisky.\"\n",
            "{{\"answer\": \"You are not drinking enough whisky.\"}}"),
        ("string/start-mb",
            "# Start first line with a multibyte character.\n#\n# https://g" +
            "ithub.com/marzer/tomlplusplus/issues/190\ns1 = \"§\"\ns2 = '§'\ns" +
            "3 = \"\"\"\\\n§\"\"\"\ns4 = \"\"\"\n§\"\"\"\ns5 = \"\"\"§\"\"\"\ns6 = '''\n§'''\ns7 = " +
            "'''§'''\n",
            "{{\"s1\": \"§\", \"s2\": \"§\", \"s3\": \"§\", \"s4\": \"§\", \"s5\": \"§\", \"s6\"" +
            ": \"§\", \"s7\": \"§\"}}"),
        ("string/unicode-escape",
            "delta-1 = \"\\u03B4\"\ndelta-2 = \"\\U000003B4\"\na       = \"\\u0061\"" +
            "\nb       = \"\\u0062\"\nc       = \"\\U00000063\"\nnull-1  = \"\\u0000" +
            "\"\nnull-2  = \"\\U00000000\"\n\nml-delta-1 = \"\"\"\\u03B4\"\"\"\nml-delta" +
            "-2 = \"\"\"\\U000003B4\"\"\"\nml-a       = \"\"\"\\u0061\"\"\"\nml-b       =" +
            " \"\"\"\\u0062\"\"\"\nml-c       = \"\"\"\\U00000063\"\"\"\nml-null-1  = \"\"\"" +
            "\\u0000\"\"\"\nml-null-2  = \"\"\"\\U00000000\"\"\"\n",
            "{{\"a\": \"a\", \"b\": \"b\", \"c\": \"c\", \"delta-1\": \"δ\", \"delta-2\": \"δ" +
            "\", \"ml-a\": \"a\", \"ml-b\": \"b\", \"ml-c\": \"c\", \"ml-delta-1\": \"δ\"," +
            " \"ml-delta-2\": \"δ\", \"ml-null-1\": \"\\u0000\", \"ml-null-2\": \"\\u0" +
            "000\", \"null-1\": \"\\u0000\", \"null-2\": \"\\u0000\"}}"),
        ("string/with-pound",
            "pound = \"We see no # comments here.\"\npoundcomment = \"But the" +
            "re are # some comments here.\" # Did I # mess you up?\n",
            "{{\"pound\": \"We see no # comments here.\", \"poundcomment\": \"But" +
            " there are # some comments here.\"}}"),
        ("table/array-empty-name",
            "# Silly thing to do, but valid.\n\n[['']]\na = 1\n[['']]\na = 2\n",
            "{{\"\": [{{\"a\": 1}}, {{\"a\": 2}}]}}"),
        ("table/array-empty",
            "[[a]]\n",
            "{{\"a\": [{{}}]}}"),
        ("table/array-implicit-and-explicit-after",
            "[[a.b]]\nx = 1\n\n[a]\ny = 2\n",
            "{{\"a\": {{\"b\": [{{\"x\": 1}}], \"y\": 2}}}}"),
        ("table/array-implicit",
            "[[albums.songs]]\nname = \"Glory Days\"\n",
            "{{\"albums\": {{\"songs\": [{{\"name\": \"Glory Days\"}}]}}}}"),
        ("table/array-many",
            "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n\n[" +
            "[people]]\nfirst_name = \"Eric\"\nlast_name = \"Clapton\"\n\n[[peopl" +
            "e]]\nfirst_name = \"Bob\"\nlast_name = \"Seger\"\n",
            "{{\"people\": [{{\"first_name\": \"Bruce\", \"last_name\": \"Springstee" +
            "n\"}}, {{\"first_name\": \"Eric\", \"last_name\": \"Clapton\"}}, {{\"first" +
            "_name\": \"Bob\", \"last_name\": \"Seger\"}}]}}"),
        ("table/array-nest",
            "[[albums]]\nname = \"Born to Run\"\n\n  [[albums.songs]]\n  name =" +
            " \"Jungleland\"\n\n  [[albums.songs]]\n  name = \"Meeting Across t" +
            "he River\"\n\n[[albums]]\nname = \"Born in the USA\"\n  \n  [[albums" +
            ".songs]]\n  name = \"Glory Days\"\n\n  [[albums.songs]]\n  name = " +
            "\"Dancing in the Dark\"\n",
            "{{\"albums\": [{{\"name\": \"Born to Run\", \"songs\": [{{\"name\": \"Jung" +
            "leland\"}}, {{\"name\": \"Meeting Across the River\"}}]}}, {{\"name\": \"" +
            "Born in the USA\", \"songs\": [{{\"name\": \"Glory Days\"}}, {{\"name\":" +
            " \"Dancing in the Dark\"}}]}}]}}"),
        ("table/array-one",
            "[[people]]\nfirst_name = \"Bruce\"\nlast_name = \"Springsteen\"\n",
            "{{\"people\": [{{\"first_name\": \"Bruce\", \"last_name\": \"Springstee" +
            "n\"}}]}}"),
        ("table/array-table-array",
            "[[a]]\n    [[a.b]]\n        [a.b.c]\n            d = \"val0\"\n   " +
            " [[a.b]]\n        [a.b.c]\n            d = \"val1\"\n",
            "{{\"a\": [{{\"b\": [{{\"c\": {{\"d\": \"val0\"}}}}, {{\"c\": {{\"d\": \"val1\"}}}}]}}]}}"),
        ("table/array-within-dotted",
            "[fruit]\napple.color = \"red\"\n\n[[fruit.apple.seeds]]\nsize = 2\n",
            "{{\"fruit\": {{\"apple\": {{\"color\": \"red\", \"seeds\": [{{\"size\": 2}}]}}" +
            "}}}}"),
        ("table/empty-name",
            "['']\nx = 1\n\n[\"\".a]\nx = 2\n\n[a.'']\nx = 3\n",
            "{{\"\": {{\"a\": {{\"x\": 2}}, \"x\": 1}}, \"a\": {{\"\": {{\"x\": 3}}}}}}"),
        ("table/empty",
            "[a]\n",
            "{{\"a\": {{}}}}"),
        ("table/keyword-with-values",
            "[true]\nk = 1\n\n[false]\nk = 2\n\n[inf]\nk = 3\n\n[nan]\nk = 4\n",
            "{{\"false\": {{\"k\": 2}}, \"inf\": {{\"k\": 3}}, \"nan\": {{\"k\": 4}}, \"true\"" +
            ": {{\"k\": 1}}}}"),
        ("table/keyword",
            "[true]\n\n[false]\n\n[inf]\n\n[nan]\n\n\n",
            "{{\"false\": {{}}, \"inf\": {{}}, \"nan\": {{}}, \"true\": {{}}}}"),
        ("table/names-with-values",
            "[a.b.c]\nkey = 1\n\n[a.\"b.c\"]\nkey = 2\n\n[a.'d.e']\nkey = 3\n\n[a.' " +
            "x ']\nkey = 4\n\n[ d.e.f ]\nkey = 5\n\n[ g . h . i ]\nkey = 6\n\n[ j " +
            ". \"ʞ\" . 'l' ]\nkey = 7\n\n[x.1.2]\nkey = 8\n",
            "{{\"a\": {{\" x \": {{\"key\": 4}}, \"b\": {{\"c\": {{\"key\": 1}}}}, \"b.c\": {{\"k" +
            "ey\": 2}}, \"d.e\": {{\"key\": 3}}}}, \"d\": {{\"e\": {{\"f\": {{\"key\": 5}}}}}}, " +
            "\"g\": {{\"h\": {{\"i\": {{\"key\": 6}}}}}}, \"j\": {{\"ʞ\": {{\"l\": {{\"key\": 7}}}}}}" +
            ", \"x\": {{\"1\": {{\"2\": {{\"key\": 8}}}}}}}}"),
        ("table/names",
            "[a.b.c]\n[a.\"b.c\"]\n[a.'d.e']\n[a.' x ']\n[ d.e.f ]\n[ g . h . i " +
            "]\n[ j . \"ʞ\" . 'l' ]\n\n[x.1.2]\n",
            "{{\"a\": {{\" x \": {{}}, \"b\": {{\"c\": {{}}}}, \"b.c\": {{}}, \"d.e\": {{}}}}, \"d\"" +
            ": {{\"e\": {{\"f\": {{}}}}}}, \"g\": {{\"h\": {{\"i\": {{}}}}}}, \"j\": {{\"ʞ\": {{\"l\": " +
            "{{}}}}}}, \"x\": {{\"1\": {{\"2\": {{}}}}}}}}"),
        ("table/no-eol-01",
            "# No newline at end of file.\n[table]",
            "{{\"table\": {{}}}}"),
        ("table/no-eol-02",
            "# No newline at end of file.\n[table]\na=1",
            "{{\"table\": {{\"a\": 1}}}}"),
        ("table/sub-empty",
            "[a]\n[a.b]\n",
            "{{\"a\": {{\"b\": {{}}}}}}"),
        ("table/sub",
            "[a]\nkey = 1\n\n# a.extend is a key inside the \"a\" table.\n[a.ex" +
            "tend]\nkey = 2\n\n[a.extend.more]\nkey = 3\n",
            "{{\"a\": {{\"extend\": {{\"key\": 2, \"more\": {{\"key\": 3}}}}, \"key\": 1}}}}"),
        ("table/whitespace",
            "[\"valid key\"]\n",
            "{{\"valid key\": {{}}}}"),
        ("table/with-literal-string",
            "['a']\n[a.'\"b\"']\n[a.'\"b\"'.c]\nanswer = 42 \n",
            "{{\"a\": {{\"\\\"b\\\"\": {{\"c\": {{\"answer\": 42}}}}}}}}"),
        ("table/with-pound",
            "[\"key#group\"]\nanswer = 42\n",
            "{{\"key#group\": {{\"answer\": 42}}}}"),
        ("table/with-single-quotes",
            "['a']\n[a.'b']\n[a.'b'.c]\nanswer = 42 \n",
            "{{\"a\": {{\"b\": {{\"c\": {{\"answer\": 42}}}}}}}}"),
        ("table/without-super-with-values",
            "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for" +
            " this to work\na = 1\nb = 2\n[x] # defining a super-table after" +
            "wards is ok\nc = 3\nd = 4\n",
            "{{\"x\": {{\"c\": 3, \"d\": 4, \"y\": {{\"z\": {{\"w\": {{\"a\": 1, \"b\": 2}}}}}}}}}}"),
        ("table/without-super",
            "# [x] you\n# [x.y] don't\n# [x.y.z] need these\n[x.y.z.w] # for" +
            " this to work\n[x] # defining a super-table afterwards is ok\n",
            "{{\"x\": {{\"y\": {{\"z\": {{\"w\": {{}}}}}}}}}}")
    ]
End Function

Public Function InvalidCases(): (String, String)[]
    Return [
        ("array/double-comma-01",
            "double-comma-01 = [1,,2]\n"),
        ("array/double-comma-02",
            "double-comma-02 = [1,2,,]\n"),
        ("array/extend-defined-aot",
            "[[tab.arr]]\n[tab]\narr.val1=1\n"),
        ("array/extending-table",
            "a = [{{ b = 1 }}]\n\n# Cannot extend tables within static arrays" +
            "\n# https://github.com/toml-lang/toml/issues/908\n[a.c]\nfoo = " +
            "1\n"),
        ("array/missing-separator-01",
            "arrr = [true false]\n"),
        ("array/missing-separator-02",
            "wrong = [ 1 2 3 ]\n"),
        ("array/no-close-01",
            "no-close-01 = [ 1, 2, 3\n"),
        ("array/no-close-02",
            "no-close-02 = [1,\n"),
        ("array/no-close-03",
            "no-close-03 = [42 #]\n"),
        ("array/no-close-04",
            "no-close-04 = [{{ key = 42\n"),
        ("array/no-close-05",
            "no-close-05 = [{{ key = 42}}\n"),
        ("array/no-close-06",
            "no-close-06 = [{{ key = 42 #}}]\n"),
        ("array/no-close-07",
            "no-close-07 = [{{ key = 42}} #]\n"),
        ("array/no-close-08",
            "no-close-08 = [\n"),
        ("array/no-close-table-01",
            "no-close-table-01 = [{{ key = 42\n"),
        ("array/no-close-table-02",
            "no-close-table-02 = [{{ key = 42 #\n"),
        ("array/no-close-table-03",
            "no-close-table-03 = [1,{{a=1]\n"),
        ("array/no-close-table-04",
            "no-close-table-04 = [1,{{2]\n"),
        ("array/no-comma-01",
            "no-comma-01 = [true false]\n"),
        ("array/no-comma-02",
            "no-comma-02 = [ 1 2 3 ]\n"),
        ("array/no-comma-03",
            "no-comma-03 = [ 1 #,]\n"),
        ("array/only-comma-01",
            "only-comma-01 = [,]\n"),
        ("array/only-comma-02",
            "only-comma-02 = [,,]\n"),
        ("array/tables-01",
            "# INVALID TOML DOC\nfruit = []\n\n[[fruit]] # Not allowed\n"),
        ("array/tables-02",
            "# INVALID TOML DOC\n[[fruit]]\n  name = \"apple\"\n\n  [[fruit.var" +
            "iety]]\n    name = \"red delicious\"\n\n  # This table conflicts " +
            "with the previous table\n  [fruit.variety]\n    name = \"granny" +
            " smith\"\n"),
        ("array/text-after-array-entries",
            "array = [\n  \"Is there life after an array separator?\", No\n  " +
            "\"Entry\"\n]\n"),
        ("array/text-before-array-separator",
            "array = [\n  \"Is there life before an array separator?\" No,\n " +
            " \"Entry\"\n]\n"),
        ("array/text-in-array",
            "array = [\n  \"Entry 1\",\n  I don't belong,\n  \"Entry 2\",\n]\n"),
        ("bool/almost-false-with-extra",
            "almost-false-with-extra = falsify\n"),
        ("bool/almost-false",
            "almost-false            = fals\n"),
        ("bool/almost-true-with-extra",
            "almost-true-with-extra  = truthy\n"),
        ("bool/almost-true",
            "almost-true             = tru\n"),
        ("bool/capitalized-false",
            "capitalized-false        = False\n"),
        ("bool/capitalized-true",
            "capitalized-true         = True\n"),
        ("bool/just-f",
            "just-f                  = f\n"),
        ("bool/just-t",
            "just-t                  = t\n"),
        ("bool/mixed-case-false",
            "mixed-case-false        = falsE\n"),
        ("bool/mixed-case-true",
            "mixed-case-true         = trUe\n"),
        ("bool/mixed-case",
            "mixed-case              = valid   = False\n"),
        ("bool/starting-same-false",
