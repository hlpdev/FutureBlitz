// toml-test's cases for TOML 1.0, which make_data.py wrote from toml-test/: each valid
// case's name, document, and what it holds, as data_toml_suite.fb's Canonical writes it,
// and each invalid case's name and document. Left out, as a String can't hold their
// bytes:
// - invalid/encoding/bad-codepoint
// - invalid/encoding/bad-utf8-at-end
// - invalid/encoding/bad-utf8-in-array
// - invalid/encoding/bad-utf8-in-comment
// - invalid/encoding/bad-utf8-in-multiline-literal
// - invalid/encoding/bad-utf8-in-multiline
// - invalid/encoding/bad-utf8-in-string-literal
// - invalid/encoding/bad-utf8-in-string
// - invalid/encoding/utf16-bom

Import std.core

Public Function ValidCases(): (String, String, String)[]
    Return [
        ("array/array-subtables",
            "[[arr]]\n[arr.subtab]\nval=1\n\n[[arr]]\n[arr.subtab]\nval=2\n",
            "{{\"arr\": [{{\"subtab\": {{\"val\": 1}}}}, {{\"subtab\": {{\"val\": 2}}}}]}}"),
        ("array/array",
            "ints = [1, 2, 3, ]\nfloats = [1.1, 2.1, 3.1]\nstrings = [\"a\", " +
            "\"b\", \"c\"]\ndates = [\n\t1987-07-05T17:45:00Z,\n\t1979-05-27T07:32" +
            ":00,\n\t2006-06-01,\n\t11:00:00,\n]\ncomments = [\n         1,\n    " +
            "     2, #this is ok\n]\n",
            "{{\"comments\": [1, 2], \"dates\": [\"1987-07-05T17:45:00Z\", \"1979" +
            "-05-27T07:32:00\", \"2006-06-01\", \"11:00:00\"], \"floats\": [4607" +
            "632778762754458, 4611911198408756429, 4614162998222441677], " +
            "\"ints\": [1, 2, 3], \"strings\": [\"a\", \"b\", \"c\"]}}"),
        ("array/bool",
            "a = [true, false]\n",
            "{{\"a\": [true, false]}}"),
        ("array/empty",
            "thevoid = [[[[[]]]]]\n",
            "{{\"thevoid\": [[[[[]]]]]}}"),
        ("array/hetergeneous",
            "mixed = [[1, 2], [\"a\", \"b\"], [1.1, 2.1]]\n",
            "{{\"mixed\": [[1, 2], [\"a\", \"b\"], [4607632778762754458, 4611911" +
            "198408756429]]}}"),
        ("array/mixed-int-array",
            "arrays-and-ints =  [1, [\"Arrays are not integers.\"]]\n",
            "{{\"arrays-and-ints\": [1, [\"Arrays are not integers.\"]]}}"),
        ("array/mixed-int-float",
            "ints-and-floats = [1, 1.1]\n",
            "{{\"ints-and-floats\": [1, 4607632778762754458]}}"),
        ("array/mixed-int-string",
            "strings-and-ints = [\"hi\", 42]\n",
            "{{\"strings-and-ints\": [\"hi\", 42]}}"),
        ("array/mixed-string-table",
            "contributors = [\n  \"Foo Bar <foo@example.com>\",\n  {{ name = \"" +
            "Baz Qux\", email = \"bazqux@example.com\", url = \"https://examp" +
            "le.com/bazqux\" }}\n]\n\n# Start with a table as the first elemen" +
            "t. This tests a case that some libraries\n# might have where " +
            "they will check if the first entry is a table/map/hash/assoc" +
            "\n# array and then encode it as a table array. This was a rea" +
            "sonable thing to do\n# before TOML 1.0 since arrays could onl" +
            "y contain one type, but now it's no\n# longer.\nmixed = [{{k=\"a" +
            "\"}}, \"b\", 1]\n",
            "{{\"contributors\": [\"Foo Bar <foo@example.com>\", {{\"email\": \"ba" +
            "zqux@example.com\", \"name\": \"Baz Qux\", \"url\": \"https://exampl" +
            "e.com/bazqux\"}}], \"mixed\": [{{\"k\": \"a\"}}, \"b\", 1]}}"),
        ("array/nested-double",
            "nest = [\n\t[\n\t\t[\"a\"],\n\t\t[1, 2, [3]]\n\t]\n]\n",
            "{{\"nest\": [[[\"a\"], [1, 2, [3]]]]}}"),
        ("array/nested-inline-table",
            "a = [ {{ b = {{}} }} ]\n",
            "{{\"a\": [{{\"b\": {{}}}}]}}"),
        ("array/nested",
            "nest = [[\"a\"], [\"b\"]]\n",
            "{{\"nest\": [[\"a\"], [\"b\"]]}}"),
        ("array/nospaces",
            "ints = [1,2,3]\n",
            "{{\"ints\": [1, 2, 3]}}"),
        ("array/open-parent-table",
            "[[parent-table.arr]]\n[[parent-table.arr]]\n[parent-table]\nnot" +
            "-arr = 1\n",
            "{{\"parent-table\": {{\"arr\": [{{}}, {{}}], \"not-arr\": 1}}}}"),
        ("array/string-quote-comma-01",
            "title = [\n\"Client: \\\"XXXX\\\", Job: XXXX\",\n\"Code: XXXX\"\n]\n",
            "{{\"title\": [\"Client: \\\"XXXX\\\", Job: XXXX\", \"Code: XXXX\"]}}"),
        ("array/string-quote-comma-02",
            "title = [ \" \\\", \",]\n",
            "{{\"title\": [\" \\\", \"]}}"),
        ("array/string-with-comma-01",
            "title = [\n\"Client: XXXX, Job: XXXX\",\n\"Code: XXXX\"\n]\n",
            "{{\"title\": [\"Client: XXXX, Job: XXXX\", \"Code: XXXX\"]}}"),
        ("array/string-with-comma-02",
            "title = [\n\"\"\"Client: XXXX,\nJob: XXXX\"\"\",\n\"Code: XXXX\"\n]\n",
            "{{\"title\": [\"Client: XXXX,\\u000aJob: XXXX\", \"Code: XXXX\"]}}"),
        ("array/strings",
            "string_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''ty" +
            "pe''']\n",
            "{{\"string_array\": [\"all\", \"strings\", \"are the same\", \"type\"]}}"),
        ("array/table-array-string-backslash",
            "foo = [ {{ bar=\"\\\"{{{{baz}}}}\\\"\"}} ]\n",
            "{{\"foo\": [{{\"bar\": \"\\\"{{{{baz}}}}\\\"\"}}]}}"),
        ("array/trailing-comma",
            "arr-1 = [1,]\n\narr-2 = [2,3,]\n\narr-3 = [4,\n]\n\narr-4 = [\n\t5,\n\t" +
            "6,\n]\n",
            "{{\"arr-1\": [1], \"arr-2\": [2, 3], \"arr-3\": [4], \"arr-4\": [5, 6" +
            "]}}"),
        ("bool/bool",
            "t = true\nf = false\n",
            "{{\"f\": false, \"t\": true}}"),
        ("comment/after-literal-no-ws",
            "inf=inf#infinity\nnan=nan#not a number\ntrue=true#true\nfalse=f" +
            "alse#false\n",
            "{{\"false\": false, \"inf\": 9218868437227405312, \"nan\": nan, \"tr" +
            "ue\": true}}"),
        ("comment/at-eof",
            "# This is a full-line comment\nkey = \"value\" # This is a comm" +
            "ent at the end of a line\n",
            "{{\"key\": \"value\"}}"),
        ("comment/at-eof2",
            "# This is a full-line comment\nkey = \"value\" # This is a comm" +
            "ent at the end of a line\n",
            "{{\"key\": \"value\"}}"),
        ("comment/everywhere",
            "# Top comment.\n  # Top comment.\n# Top comment.\n\n# [no-extran" +
            "eous-groups-please]\n\n[group] # Comment\nanswer = 42 # Comment" +
            "\n# no-extraneous-keys-please = 999\n# Inbetween comment.\nmore" +
            " = [ # Comment\n  # What about multiple # comments?\n  # Can y" +
            "ou handle it?\n  #\n          # Evil.\n# Evil.\n  42, 42, # Comm" +
            "ents within arrays are fun.\n  # What about multiple # commen" +
            "ts?\n  # Can you handle it?\n  #\n          # Evil.\n# Evil.\n# ]" +
            " Did I fool you?\n] # Hopefully not.\n\n# Make sure the space b" +
            "etween the datetime and \"#\" isn't lexed.\ndt = 1979-05-27T07:" +
            "32:12-07:00  # c\nd = 1979-05-27 # Comment\n\n[[aot]] # Comment" +
            "\nk = 98 # Comment\n[[aot]]# Comment\nk = 99# Comment\n",
            "{{\"aot\": [{{\"k\": 98}}, {{\"k\": 99}}], \"group\": {{\"answer\": 42, \"d\":" +
            " \"1979-05-27\", \"dt\": \"1979-05-27T07:32:12-07:00\", \"more\": [4" +
            "2, 42]}}}}"),
        ("comment/noeol",
            "# single comment without any eol characters",
            "{{}}"),
        ("comment/nonascii",
            "# ~ \u{80} ÿ ퟿  ￿ 𐀀 􏿿\n",
            "{{}}"),
        ("comment/tricky",
            "[section]#attached comment\n#[notsection]\none = \"11\"#cmt\ntwo " +
            "= \"22#\"\nthree = '#'\n\nfour = \"\"\"# no comment\n# nor this\n#also" +
            " not comment\"\"\"#is_comment\n\nfive = 5.5#66\nsix = 6#7\n8 = \"eig" +
            "ht\"\n#nine = 99\nten = 10e2#1\neleven = 1.11e1#23\n\n[\"hash#tag\"]" +
            "\n\"#!\" = \"hash bang\"\narr3 = [ \"#\", '#', \"\"\"###\"\"\" ]\narr4 = [ " +
            "1,# 9, 9,\n2#,9\n,#9\n3#]\n,4]\narr5 = [[[[#[\"#\"],\n[\"#\"]]]]#]\n]\nt" +
            "bl1 = {{ \"#\" = '}}#'}}#}}}}\n\n\n",
            "{{\"hash#tag\": {{\"#!\": \"hash bang\", \"arr3\": [\"#\", \"#\", \"###\"], " +
            "\"arr4\": [1, 2, 3, 4], \"arr5\": [[[[[\"#\"]]]]], \"tbl1\": {{\"#\": \"" +
            "}}#\"}}}}, \"section\": {{\"8\": \"eight\", \"eleven\": 46224383625377349" +
            "63, \"five\": 4617878467915022336, \"four\": \"# no comment\\u000a" +
            "# nor this\\u000a#also not comment\", \"one\": \"11\", \"six\": 6, \"" +
            "ten\": 4652007308841189376, \"three\": \"#\", \"two\": \"22#\"}}}}"),
        ("datetime/datetime",
            "space = 1987-07-05 17:45:00Z\n\n# ABNF is case-insensitive, bo" +
            "th \"Z\" and \"z\" must be supported.\nlower = 1987-07-05t17:45:0" +
            "0z\n",
            "{{\"lower\": \"1987-07-05T17:45:00Z\", \"space\": \"1987-07-05T17:45" +
            ":00Z\"}}"),
        ("datetime/edge",
            "first-offset = 0001-01-01 00:00:00Z\nfirst-local  = 0001-01-0" +
            "1 00:00:00\nfirst-date   = 0001-01-01\n\nlast-offset = 9999-12-" +
            "31 23:59:59Z\nlast-local  = 9999-12-31 23:59:59\nlast-date   =" +
            " 9999-12-31\n",
            "{{\"first-date\": \"0001-01-01\", \"first-local\": \"0001-01-01T00:0" +
            "0:00\", \"first-offset\": \"0001-01-01T00:00:00Z\", \"last-date\": " +
            "\"9999-12-31\", \"last-local\": \"9999-12-31T23:59:59\", \"last-off" +
            "set\": \"9999-12-31T23:59:59Z\"}}"),
        ("datetime/invalid-date-in-string",
            "s = '2020-01-01x'\n",
            "{{\"s\": \"2020-01-01x\"}}"),
        ("datetime/leap-year",
            "2000-datetime       = 2000-02-29 15:15:15Z\n2000-datetime-loc" +
            "al = 2000-02-29 15:15:15\n2000-date           = 2000-02-29\n\n2" +
            "024-datetime       = 2024-02-29 15:15:15Z\n2024-datetime-loca" +
            "l = 2024-02-29 15:15:15\n2024-date           = 2024-02-29\n",
            "{{\"2000-date\": \"2000-02-29\", \"2000-datetime\": \"2000-02-29T15:" +
            "15:15Z\", \"2000-datetime-local\": \"2000-02-29T15:15:15\", \"2024" +
            "-date\": \"2024-02-29\", \"2024-datetime\": \"2024-02-29T15:15:15Z" +
            "\", \"2024-datetime-local\": \"2024-02-29T15:15:15\"}}"),
        ("datetime/local-date",
            "bestdayever = 1987-07-05\n",
            "{{\"bestdayever\": \"1987-07-05\"}}"),
        ("datetime/local-time",
            "besttimeever = 17:45:00\nmilliseconds = 10:32:00.555\n",
            "{{\"besttimeever\": \"17:45:00\", \"milliseconds\": \"10:32:00.555\"}}"),
        ("datetime/local",
            "local = 1987-07-05T17:45:00\nmilli = 1977-12-21T10:32:00.555\n" +
            "space = 1987-07-05 17:45:00\n",
            "{{\"local\": \"1987-07-05T17:45:00\", \"milli\": \"1977-12-21T10:32:" +
            "00.555\", \"space\": \"1987-07-05T17:45:00\"}}"),
        ("datetime/milliseconds",
            "utc1  = 1987-07-05T17:45:56.123Z\nutc2  = 1987-07-05T17:45:56" +
            ".6Z\nwita1 = 1987-07-05T17:45:56.123+08:00\nwita2 = 1987-07-05" +
            "T17:45:56.6+08:00\n",
            "{{\"utc1\": \"1987-07-05T17:45:56.123Z\", \"utc2\": \"1987-07-05T17:" +
            "45:56.6Z\", \"wita1\": \"1987-07-05T17:45:56.123+08:00\", \"wita2\"" +
            ": \"1987-07-05T17:45:56.6+08:00\"}}"),
        ("datetime/timezone",
            "utc  = 1987-07-05T17:45:56Z\npdt  = 1987-07-05T17:45:56-05:00" +
            "\nnzst = 1987-07-05T17:45:56+12:00\nnzdt = 1987-07-05T17:45:56" +
            "+13:00  # DST\n",
            "{{\"nzdt\": \"1987-07-05T17:45:56+13:00\", \"nzst\": \"1987-07-05T17" +
            ":45:56+12:00\", \"pdt\": \"1987-07-05T17:45:56-05:00\", \"utc\": \"1" +
            "987-07-05T17:45:56Z\"}}"),
        ("empty-crlf",
            "\r\n",
            "{{}}"),
        ("empty-lf",
            "\n",
            "{{}}"),
        ("empty-nothing",
            "",
            "{{}}"),
        ("empty-space",
            " ",
            "{{}}"),
        ("empty-tab",
            "\t",
            "{{}}"),
        ("example",
            "best-day-ever = 1987-07-05T17:45:00Z\n\n[numtheory]\nboring = f" +
            "alse\nperfection = [6, 28, 496]\n",
            "{{\"best-day-ever\": \"1987-07-05T17:45:00Z\", \"numtheory\": {{\"bor" +
            "ing\": false, \"perfection\": [6, 28, 496]}}}}"),
        ("float/exponent-upper",
            "# Both upper- and lower-case \"e\" is valid, so repeat the exp" +
            "onent.toml test with\n# upper-case.\nexp        = 3E2\npos-exp " +
            "   = 3E+2\nneg-exp    = 3E-2\nzero-exp   = 3E0\nfrac       = 3." +
            "1E2\nneg        = -1E-1\nzero       = 0E2\nzero-plus = +0E2\n",
            "{{\"exp\": 4643985272004935680, \"frac\": 4644161193865379840, \"n" +
            "eg\": 13815242216921733530, \"neg-exp\": 4584304132692975288, \"" +
            "pos-exp\": 4643985272004935680, \"zero\": 0, \"zero-exp\": 461393" +
            "7818241073152, \"zero-plus\": 0}}"),
        ("float/exponent",
            "# Please keep exponent-upper.toml in sync with this.\n\nexp   " +
            "    = 3e2\npos-exp   = 3e+2\nneg-exp   = 3e-2\nzero-exp  = 3e0\n" +
            "frac      = 3.1e2\nneg       = -1e-1\nzero      = 0e2\nzero-plu" +
            "s = +0e2\n",
            "{{\"exp\": 4643985272004935680, \"frac\": 4644161193865379840, \"n" +
            "eg\": 13815242216921733530, \"neg-exp\": 4584304132692975288, \"" +
            "pos-exp\": 4643985272004935680, \"zero\": 0, \"zero-exp\": 461393" +
            "7818241073152, \"zero-plus\": 0}}"),
        ("float/float",
            "pi = 3.14\npospi = +3.14\nnegpi = -3.14\nzero-intpart = 0.123\nl" +
            "eading-zero-fractional = 0.0123\n",
            "{{\"leading-zero-fractional\": 4578244089034385549, \"negpi\": 13" +
            "837625107069764895, \"pi\": 4614253070214989087, \"pospi\": 4614" +
            "253070214989087, \"zero-intpart\": 4593527504729830064}}"),
        ("float/inf-and-nan",
            "# We don't encode +nan and -nan back with the signs; many la" +
            "nguages don't\n# support a sign on NaN (it doesn't really mak" +
            "e much sense).\nnan = nan\nnan_neg = -nan\nnan_plus = +nan\ninfi" +
            "nity = inf\ninfinity_neg = -inf\ninfinity_plus = +inf\n",
            "{{\"infinity\": 9218868437227405312, \"infinity_neg\": 1844224047" +
            "4082181120, \"infinity_plus\": 9218868437227405312, \"nan\": nan" +
            ", \"nan_neg\": nan, \"nan_plus\": nan}}"),
        ("float/long",
            "longpi = 3.141592653589793\nneglongpi = -3.141592653589793\n",
            "{{\"longpi\": 4614256656552045848, \"neglongpi\": 138376286934068" +
            "21656}}"),
        ("float/max-int",
            "# Maximum and minimum safe natural numbers.\nmax_float =  9_0" +
            "07_199_254_740_991.0\nmin_float = -9_007_199_254_740_991.0\n",
            "{{\"max_float\": 4845873199050653695, \"min_float\": 140692452359" +
            "05429503}}"),
        ("float/underscore",
            "before = 3_141.5927\nafter = 3141.592_7\nexponent = 3e1_4\n",
            "{{\"after\": 4659126850480494766, \"before\": 4659126850480494766" +
            ", \"exponent\": 4823651601286430720}}"),
        ("float/zero",
            "zero = 0.0\nsigned-pos = +0.0\nsigned-neg = -0.0\nexponent = 0e" +
            "0\nexponent-two-0 = 0e00\nexponent-signed-pos = +0e0\nexponent-" +
            "signed-neg = -0e0\n",
            "{{\"exponent\": 0, \"exponent-signed-neg\": 9223372036854775808, " +
            "\"exponent-signed-pos\": 0, \"exponent-two-0\": 0, \"signed-neg\":" +
            " 9223372036854775808, \"signed-pos\": 0, \"zero\": 0}}"),
        ("implicit-and-explicit-after",
            "[a.b.c]\nanswer = 42\n\n[a]\nbetter = 43\n",
            "{{\"a\": {{\"b\": {{\"c\": {{\"answer\": 42}}}}, \"better\": 43}}}}"),
        ("implicit-and-explicit-before",
            "[a]\nbetter = 43\n\n[a.b.c]\nanswer = 42\n",
            "{{\"a\": {{\"b\": {{\"c\": {{\"answer\": 42}}}}, \"better\": 43}}}}"),
        ("implicit-groups",
            "[a.b.c]\nanswer = 42\n",
            "{{\"a\": {{\"b\": {{\"c\": {{\"answer\": 42}}}}}}}}"),
        ("inline-table/array-01",
            "arr = [ {{'a'= 1}}, {{'a'= 2}} ]\n\npeople = [{{first_name = \"Bruce" +
