        ("inline-table/inline-table",
            "name        = {{ first = \"Tom\", last = \"Preston-Werner\" }}\npoi" +
            "nt       = {{ x = 1, y = 2 }}\nsimple      = {{ a = 1 }}\nstr-key " +
            "    = {{ \"a\" = 1 }}\ntable-array = [{{ \"a\" = 1 }}, {{ \"b\" = 2 }}]\n",
