        ("local-date/mday-over",
            "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 bas" +
            "ed on\n#                           ; month/year\nd = 2006-01-3" +
            "2\n"),
        ("local-date/mday-under",
            "# date-mday       = 2DIGIT  ; 01-28, 01-29, 01-30, 01-31 bas" +
            "ed on\n#                           ; month/year\nd = 2006-01-0" +
            "0\n"),
        ("local-date/month-over",
            "# date-month      = 2DIGIT  ; 01-12\nd = 2006-13-01\n"),
        ("local-date/month-under",
            "# date-month      = 2DIGIT  ; 01-12\nd = 2007-00-01\n"),
        ("local-date/no-leads-with-milli",
            "# Day \"5\" instead of \"05\"; the leading zero is required.\nwit" +
            "h-milli = 1987-07-5\n"),
        ("local-date/no-leads",
            "# Month \"7\" instead of \"07\"; the leading zero is required.\nn" +
            "o-leads = 1987-7-05\n"),
        ("local-date/trailing-t",
            "# Date cannot end with trailing T\nd = 2006-01-30T\n"),
        ("local-date/y10k",
            "# Maximum RFC3399 year is 9999.\nd = 10000-01-01\n"),
        ("local-date/year-3digits",
