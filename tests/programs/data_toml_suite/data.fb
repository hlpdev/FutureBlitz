            "a=1\n[a.b.c.d]\n"),
        ("table/redefine-01",
            "# Define b as int, and try to use it as a table: error\n[a]\nb" +
            " = 1\n\n[a.b]\nc = 2\n"),
        ("table/redefine-02",
            "# Define t2 as a table via dotted key in [t1] block, and the" +
            "n redefine [t1.t2]\n[t1]\nt2.t3.v = 0\n[t1.t2]\n"),
        ("table/redefine-03",
            "# Define t2.t3 as a table via dotted key in [t1] block, and " +
            "then redefine [t1.t2.t3]\n[t1]\nt2.t3.v = 0\n[t1.t2.t3]\n"),
        ("table/rrbrace",
            "[[table] ]\n"),
        ("table/super-twice",
            "[a.b]\n[a]\n[a]\n"),
        ("table/text-after-table",
            "[error] this shouldn't be here\n"),
        ("table/trailing-dot",
            "[a.]\n"),
        ("table/whitespace",
            "[invalid key]\n"),
        ("table/with-pound",
            "[key#group]\nanswer = 42\n")
    ]
End Function
