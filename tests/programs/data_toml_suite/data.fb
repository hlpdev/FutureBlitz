        ("control/bare-null",
            "bare-null         = \"some value\" \u{0}\n"),
        ("control/bare-vertical-tab",
            "bare-vertical-tab = \u{b}\n"),
        ("control/comment-cr",
            "comment-cr   = \"Carriage return in comment\" # \ra=1\n"),
        ("control/comment-del",
            "comment-del  = \"0x7f\"   # \u{7f}\n"),
        ("control/comment-ff",
            "comment-ff   = \"0x7f\"   # \u{c}\n"),
        ("control/comment-lf",
            "comment-lf   = \"ctrl-P\" # \u{10}\n"),
        ("control/comment-null",
            "comment-null = \"null\"   # \u{0}\n"),
        ("control/comment-us",
