        ("bool/starting-same-true",
            "starting-same-true      = truer\n"),
        ("bool/wrong-case-false",
            "wrong-case-false        = FALSE\n"),
        ("bool/wrong-case-true",
            "wrong-case-true         = TRUE\n"),
        ("control/bare-cr",
            "# The following line contains a single carriage return contr" +
            "ol character\r\n\r"),
