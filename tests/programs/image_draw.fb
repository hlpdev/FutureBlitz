// std.image's Canvas draws what image_draw/make_data.py works out apart from the runtime, pixel
// for pixel: rectangles, polygons by the nonzero rule, with a hole and crossing themselves,
// circles and ellipses, lines with each cap, polylines with each join and a miter past its
// limit, closed strokes, a dot, without antialiasing, and translucent colors over each other.

Import std.core
Import std.collections
Import std.math.color
Import std.math.geometry
Import std.math.vector
Import "./image_draw/data"

Import std.image

// How many of two images' bytes differ, and by how much at most, or that they're the same.
Function Compared(image: Image, expected: UInt8[]): String
    Local bytes = image.ToBytes()
    Local differing = 0
    Local most = 0
    For i = 0 Until bytes.Count
        Local difference = (bytes[i] As Int) - (expected[i] As Int)
        If difference != 0
            differing += 1
            most = Max(most, difference < 0 ? -difference : difference)
        End If
    End For
    Return differing == 0 ? "same" : "{differing} bytes differ, by {most} at most"
End Function

// A canvas on a new image, transparent, of the reference's size.
Function Fresh(): Canvas => Canvas(Image(24, 16))

Function Check(name: String, canvas: Canvas, expected: UInt8[])
    Print("{name}: {Compared(canvas.Image, expected)}")
End Function

Local star = [Vec2(12, 1.5), Vec2(15.75, 13), Vec2(5.875, 5.875), Vec2(18.125, 5.875),
              Vec2(8.25, 13)]
Local zigzag = [Vec2(2, 13), Vec2(8, 3), Vec2(14, 13), Vec2(20, 4)]

Local canvas = Fresh()
canvas.FillRect(Rect(2, 3, 10, 5), Color32.Black)
Check("an aligned rectangle", canvas, AlignedRect())

canvas = Fresh()
canvas.FillRect(Rect(1.25, 2.5, 13.375, 7.75), Color32.Black)
Check("a rectangle between pixels", canvas, FractionRect())

canvas = Fresh()
canvas.FillPolygon([Vec2(2.5, 1.25), Vec2(21.75, 6.5), Vec2(7.125, 14.875)], Color32.Black)
Check("a triangle", canvas, Triangle())

canvas = Fresh()
canvas.FillPolygon(star, Color32.Black)
Check("a star, its middle filled", canvas, Star())

canvas = Fresh()
canvas.Antialias = False
canvas.FillPolygon(star, Color32.Black)
Check("a star, not antialiased", canvas, StarAliased())

// A ring the other way around in one is a hole.
canvas = Fresh()
canvas.FillPolygon([[Vec2(2, 2), Vec2(22, 2), Vec2(22, 14), Vec2(2, 14)],
                    [Vec2(6.5, 10.25), Vec2(15.5, 10.25), Vec2(15.5, 5.25), Vec2(6.5, 5.25)]],
                   Color32.Black)
Check("a hole", canvas, Hole())

// Rings the same way around that overlap cover their overlap once.
canvas = Fresh()
canvas.FillPolygon([[Vec2(2, 2), Vec2(14, 2), Vec2(14, 10), Vec2(2, 10)],
                    [Vec2(8.5, 5.5), Vec2(21.5, 5.5), Vec2(21.5, 14.75), Vec2(8.5, 14.75)]],
                   Color32.Black)
Check("two that overlap", canvas, Overlapping())

canvas = Fresh()
canvas.FillCircle(Vec2(11.7, 7.2), 5.3, Color32.Black)
Check("a circle", canvas, Circle())

canvas = Fresh()
canvas.Antialias = False
canvas.FillCircle(Vec2(11.7, 7.2), 5.3, Color32.Black)
Check("a circle, not antialiased", canvas, CircleAliased())

canvas = Fresh()
canvas.FillEllipse(Vec2(12, 8), Vec2(10.5, 4.25), Color32.Black)
Check("an ellipse", canvas, Ellipse())

For cap In [LineCap.BUTT, LineCap.ROUND, LineCap.SQUARE]
    canvas = Fresh()
    canvas.LineWidth = 2.5
    canvas.Cap = cap
    canvas.StrokeLine(Vec2(3, 4), Vec2(20, 11), Color32.Black)
    Local expected = cap == LineCap.BUTT ? LineButt() : (cap == LineCap.ROUND ? LineRound() :
                                                         LineSquare())
    Check("a line, {cap} caps", canvas, expected)
End For

For join In [LineJoin.MITER, LineJoin.ROUND, LineJoin.BEVEL]
    canvas = Fresh()
    canvas.LineWidth = 2
    canvas.Join = join
    canvas.StrokePolyline(zigzag, Color32.Black)
    Local expected = join == LineJoin.MITER ? Miter() : (join == LineJoin.ROUND ? RoundJoin() :
                                                         BevelJoin())
    Check("a polyline, {join} joins", canvas, expected)
End For

// A corner sharper than the miter limit allows is beveled.
canvas = Fresh()
canvas.LineWidth = 3
canvas.MiterLimit = 1.5
canvas.StrokePolyline([Vec2(2, 13), Vec2(12, 2), Vec2(22, 13)], Color32.Black)
Check("a miter past its limit", canvas, MiterLimited())

canvas = Fresh()
canvas.LineWidth = 1.5
canvas.StrokePolygon([Vec2(3, 2), Vec2(21, 4), Vec2(17, 14), Vec2(5, 11)], Color32.Black)
Check("a polygon's edges", canvas, ClosedPolygon())

canvas = Fresh()
canvas.StrokeRect(Rect(3.5, 2.5, 16, 10), Color32.Black)
Check("a rectangle's edges", canvas, StrokeRect())

canvas = Fresh()
canvas.LineWidth = 1.5
canvas.StrokeCircle(Vec2(12, 8), 6, Color32.Black)
Check("a circle's edge", canvas, StrokeCircle())

canvas = Fresh()
canvas.LineWidth = 2
canvas.StrokeEllipse(Vec2(12, 8), Vec2(10, 5), Color32.Black)
Check("an ellipse's edge", canvas, StrokeEllipse())

// A circle's stroke wider than its radius is the polygon of its stroke's outer radius, so it's
// within the tolerance of the disk it covers.
canvas = Fresh()
canvas.LineWidth = 12
canvas.StrokeCircle(Vec2(12, 8), 0.5, Color32.Black)
Check("a thick ring", canvas, ThickRing())

// A line of one point is its round cap's dot.
canvas = Fresh()
canvas.LineWidth = 5
canvas.Cap = LineCap.ROUND
canvas.StrokePolyline([Vec2(12.5, 8.5)], Color32.Black)
Check("a dot", canvas, Dot())

// Each color goes over what's there by its alpha.
canvas = Fresh()
canvas.FillRect(Rect(2, 2, 14, 9), Color32(255, 0, 0))
canvas.FillEllipse(Vec2(14, 9), Vec2(7, 5), Color32(0, 0, 255, 128))
canvas.LineWidth = 3
canvas.Cap = LineCap.ROUND
canvas.StrokeLine(Vec2(1, 14), Vec2(23, 1), Color32(0, 200, 0, 90))
Check("translucent colors", canvas, Translucent())

// What's outside the image is left out, and nothing is drawn of what's empty.
Local small = Image(4, 3)
Local edge = Canvas(small)
edge.FillCircle(Vec2(-1, 1), 3, Color32.Black)
edge.FillRect(Rect(2, 1, 0, 5), Color32.Black)
edge.FillCircle(Vec2(3, 2), 0, Color32.Black)
edge.LineWidth = 0
edge.StrokeLine(Vec2(0, 0), Vec2(4, 3), Color32.Black)
Local alphas: Int[] = []
For y = 0 Until 3
    For x = 0 Until 4
        alphas.Add(small[x, y].a As Int)
    End For
End For
Print("outside and empty:", alphas)
