// std.data's YAML: how the core schema reads plain scalars, the other scalars' styles, block
// scalars' chomping and indentation, flow and block collections, anchors and aliases, tags,
// several documents, where a ParseError says it is and what kind it is, and what Write writes,
// which reads back as the same Value.

Import std.core
Import std.collections
Import std.data.yaml

// Each plain scalar, and the kind and Value the core schema gives it.
Local plains = ["~", "null", "Null", "NULL", "", "true", "True", "FALSE", "yes", "42", "-17", "+5",
                "0o17", "0x1F", "0x", "1.5", "-0.5", ".5", "1.", "1e3", "-1.5E-3", ".inf", "-.Inf",
                "+.INF", ".nan", ".NaN", "0.1.2", "12:30", "9223372036854775807",
                "9223372036854775808", "18446744073709551616", "-9223372036854775808",
                "-9223372036854775809", "0xFFFFFFFFFFFFFFFF", "0x10000000000000000", "text",
                "two words"]
For plain In plains
    Local value = Try Yaml.Read("x: " + plain)
    Local x = value["x"] ?? Value("missing")
    Print("[" + plain + "]", x.Kind, x)
End For

// Quoted, literal, and folded scalars.
Local styles = Try Yaml.Read(r"""
    single: 'it''s ''quoted'' # not a comment'
    double: "tab\tnewline\nunicode \u00E9 \U0001F600 \x41 escaped \
      line"
    folded lines: "one
      two

      three"
    literal: |
      line one
        indented
      line three
    folded: >
      folded
      lines

      paragraph
    strip: |-
      no break
    keep: |+
      kept

    indicated: |2
       one more space
    """)
For key In styles.Keys()
    Print(key, "=", styles[key] ?? Value())
End For

// Collections, block and flow, anchors and aliases, and comments.
Local collections = Try Yaml.Read(r"""
    # a comment
    base: &base {name: base, list: [1, 2, {three: 3}]}
    copy: *base
    nested:
      - a
      - - b
        - c
      - key: value
        other: [x, y]
      -
    empty map: {}
    empty list: []
    "quoted key": 1
    ? explicit key
    : explicit value
    1: integer key
    """)
Print(collections)
Print(collections.Path("copy.list[2].three") ?? Value())

// Tags of the core schema, under their own handle or a %TAG's.
Local tagged = Try Yaml.Read(r"""
    %TAG !core! tag:yaml.org,2002:
    ---
    a: !!str 42
    b: !!int "7"
    c: !!float 1
    d: !core!bool true
    e: !!null ""
    f: ! 12
    g: !<tag:yaml.org,2002:str> 3
    h: !!seq [1]
    i: !!map {k: v}
    """)
Print(tagged)

// Several documents, and markers.
Local stream = Try Yaml.ReadAll("--- a\n--- b\n...\n%YAML 1.2\n--- [c]\n---\n")
Print(stream.Count, stream[0], stream[1], stream[2], stream[3])
Print((Try Yaml.ReadAll("")).Count, (Try Yaml.ReadAll("# only a comment\n")).Count, Try Yaml.Read(""))

// Each mistake throws a ParseError of its kind, at its line and column.
Function Failure(text: String)
    Try
        Yaml.Read(text)
        Print("reads:", text)
    Catch e As ParseError
        Print(e.Kind, e.Line, e.Column, e.Message)
    End Try
End Function

Failure("a: 1\na: 2")
Failure("? [a]\n: b")
Failure("a: !local x")
Failure("a: !!binary YWJj")
Failure("a: !!int abc")
Failure("- a\n- b\n--- c\n--- d")
Failure("key: \"unended")
Failure("a: [1, 2")
Failure("a:\n\t- b")
Failure("a: *missing")
Failure("a: b: c")
Failure("- a\nb: c")
Failure("a: \"\\q\"")
Failure("a: 'x'#comment")
Failure("%YAML 2.0\n--- a")
Failure("%YAML 1.2\n%YAML 1.2\n--- a")
Failure("a: \u{1}")

// Write: block mappings and sequences, flow's empty collections, and plain scalars where the
// core schema reads them back as the same; else double quotes.
Local value = Value.Object()
value["name"] = Value("Ada")
value["number like"] = Value("42")
value["bool like"] = Value("true")
value["null like"] = Value("~")
value["empty"] = Value("")
value["spaces"] = Value(" padded ")
value["quote"] = Value("say \"hi\"\n\ttab é \u{7}")
value["colon"] = Value("a: b")
value["hash"] = Value("a #b")
value["dash"] = Value("- item")
value["marker"] = Value("---")
value["int"] = Value(42 As Int64)
value["float"] = Value(2.0)
value["big"] = Value(1e300)
value["nothing"] = Value()
value["flag"] = Value(False)
Local list = Value.Array()
list.Add(Value(1 As Int64))
Local inner = Value.Object()
inner["k"] = Value("v")
Local letters = Value.Array()
letters.Add(Value("x"))
inner["l"] = letters
list.Add(inner)
Local deeper = Value.Array()
deeper.Add(Value("y"))
list.Add(deeper)
list.Add(Value.Object())
value["list"] = list
Local map = Value.Object()
Local zs = Value.Array()
zs.Add(Value("z"))
map["a"] = zs
value["map"] = map
Local written = Yaml.Write(value)
Print(written)
Print((Try Yaml.Read(written)) == value)
Print(Yaml.Write(Value("top")), Yaml.Write(Value.Array()), Yaml.WriteAll([Value(1 As Int64), list]))
Print((Try Yaml.ReadAll(Yaml.WriteAll([Value(1 As Int64), list]))).Count)

// A byte order mark and comment lines are a document's prefix, which any document of a stream
// can start with, after the "..." that ends the one before; elsewhere a mark is an error.
Print(Try Yaml.Read("\u{FEFF}# settings\nname: app\n"))
Local prefixed = Try Yaml.ReadAll("a: 1\n...\n\u{FEFF}--- b\n...\n# c\n\u{FEFF}# d\n--- e\n")
Print(prefixed.Count, prefixed[1], prefixed[2])
Failure("a: 1\n\u{FEFF}b: 2")
Failure("\u{FEFF}a: 1\n---\n\u{FEFF}b: 2")

// A simple key is up to 1024 characters, not bytes, long; Write writes a longer key explicitly,
// and it reads back.
Local wide = ""
For i = 1 To 600
    wide += "é"
End For
Print((Try Yaml.Read(wide + ": v")).Count)
Local long = ""
For i = 1 To 1100
    long += "k"
End For
For key In [wide, long, long + "\n" + long]
    Local keyed = Value.Object()
    keyed[key] = Value("v")
    Local nested = Value.Object()
    nested["inner"] = Value(1 As Int64)
    keyed[key + "!"] = nested
    Local listed = Value.Array()
    listed.Add(keyed)
    Local text = Yaml.Write(listed)
    Print(text.Bytes.Count, (Try Yaml.Read(text)) == listed)
End For

// Quoted scalars take any character but a C0 control other than a tab, as JSON's strings do.
For json In ["{{\"a\": \"x\u{7F}y\"}}", "{{\"a\": \"x\u{80}y\"}}", "{{\"a\": \"x\u{FEFF}y\"}}",
             "{{\"a\": 'x\u{FFFE}y'}}", "{{\"a\": \"x\ty\"}}"]
    Local read = Try Yaml.Read(json)
    Print(((read["a"] ?? Value()).AsString() ?? "").Bytes.Count)
End For
Failure("a: \"x\u{1}y\"")
Failure("a: x\u{80}y")

// A tag that isn't the core schema's is OTHER on a collection too; a core one on the wrong kind
// is SYNTAX.
Failure("a: !foo [x]")
Failure("a: !!set {{x, y}}")
Failure("a: !!omap\n- x: 1")
Failure("a: !!str [x]")
Failure("a: !!seq {{x: 1}}")

// Text that ends inside a flow collection is UNEXPECTED_END, as inside a quoted scalar.
Failure("a: {{b: 1")
Failure("[1, 2")
Failure("[1, ")
Failure("{{a: ")
Failure("[")

// Integers past a UInt64 are the nearest Double, in hex and octal too; an !!int past a UInt64
// is OUT_OF_RANGE.
Print(Try Yaml.Read("hex: 0x20000000000001800\noctal: 0o40000000000000000140000\nbig: 0x1FFFFFFFFFFFFFFFF"))
Failure("a: !!int 99999999999999999999")
Failure("a: !!int 0x1FFFFFFFFFFFFFFFF")
Failure("a: !!int 1.5")

// A directive YAML 1.2 reserves goes where the others do: before a document's "---", after a
// "..." ends the one before.
Function Documents(text: String)
    Try
        Local documents = Try Yaml.ReadAll(text)
        Print("reads", documents.Count, documents[documents.Count - 1])
    Catch e As ParseError
        Print(e.Kind, e.Line, e.Column, e.Message)
    End Try
End Function

Documents("a: 1\nb: 2\n%include other.yaml\n")
Documents("a: |\n  b\n%c\n")
Documents("%FOO bar\nx\n")
Documents("%FOO bar\n--- x\n")
Documents("--- a\n%FOO bar\n--- b\n")
Documents("a\n...\n%FOO\n--- b\n")

// Each handle's %TAG comes once in a document, '!' and '!!' too.
Failure("%TAG !e! tag:a,2000:\n%TAG !e! tag:b,2000:\n--- x")
Failure("%TAG ! tag:a,2000:\n%TAG ! tag:yaml.org,2002:\n--- !str x")
Failure("%TAG !! tag:a,2000:\n%TAG !! tag:b,2000:\n--- x")
Print(Try Yaml.Read("%TAG !! tag:yaml.org,2002:\n--- !!str 1"))

// A CR alone is a line break, which an error's line counts.
Failure("a: 1\rb: 2\rb: 3\r")
Failure("a: 1\r\nb: 2\r\nb: 3\r\n")
