// Assert panics when its condition is False, with its message, which is only made then.
Import std.core

Function Check(n: Int)
    Assert(n > 0, "{n} isn't positive")
    Print("{n} is fine")
End Function

Function Find(): String? => "x"

// After it, the condition holds.
Local name = Find()
Assert(name != Null)
Print("name is {name}")
Check(1)
Check(-2)
