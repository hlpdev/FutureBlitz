// What Seal seals opens with the same key and associated data, and nothing else does.
Local key = Aes256Gcm.NewKey()
Local sealed = Aes256Gcm.Seal(key, "attack at dawn", "header".Bytes)
Expect("AES-256-GCM size", sealed.Count == 12 + 14 + 16)
Expect("AES-256-GCM opens", Aes256Gcm.Open(key, sealed, "header".Bytes) == "attack at dawn".Bytes)
Expect("AES-256-GCM other data", Aes256Gcm.Open(key, sealed) == Null)
Expect("AES-256-GCM other key", Aes256Gcm.Open(Aes256Gcm.NewKey(), sealed, "header".Bytes) == Null)
Expect("AES-256-GCM other cipher", ChaCha20Poly1305.Open(key, sealed, "header".Bytes) == Null)
Local changed = sealed.Clone()
changed[20] = changed[20] ^ 1
Expect("AES-256-GCM changed", Aes256Gcm.Open(key, changed, "header".Bytes) == Null)
Expect("AES-256-GCM too short", Aes256Gcm.Open(key, sealed[..27], "header".Bytes) == Null)
Expect("AES-256-GCM new nonce", Aes256Gcm.Seal(key, "x") != Aes256Gcm.Seal(key, "x"))
Local empty: UInt8[] = []
Expect("AES-256-GCM nothing", Aes256Gcm.Open(key, Aes256Gcm.Seal(key, empty)) == empty)
Local chacha = ChaCha20Poly1305.NewKey()
Local chachaSealed = ChaCha20Poly1305.Seal(chacha, SecureRandom.Bytes(1000))
Expect("ChaCha20-Poly1305 size", chachaSealed.Count == 1028)
Expect("ChaCha20-Poly1305 opens", ChaCha20Poly1305.Open(chacha, chachaSealed)?.Count == 1000)
Done("Seal and Open")
