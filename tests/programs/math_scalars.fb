// std.math's constants and scalar Functions, each in its arguments' type. What C's libm works out
// beyond IEEE's exact operations differs in its last bits from one OS to another, so those print
// rounded to four places.
Import std.core
Import std.math

// The value to four places, with -0 as 0.
Function Shown(value: Float): Float => Round(value * 10000) / 10000 + 0
Function Shown(value: Double): Double => Round(value * 10000) / 10000 + 0

// The constants, as Floats and as Doubles.
Print(Pi, Tau, E, Epsilon, 1 + Epsilon > 1, 1 + Epsilon / 2 == 1)
Print(Pi64, Tau64, E64, Epsilon64, 1 + Epsilon64 > 1, 1 + Epsilon64 / 2 == 1)
Print(Inf, -Inf, NaN, Inf > MaxValue<Float>(), NaN == NaN)
Local wide: Double = Inf
Print(wide, wide == Inf)

// Every number type's lowest and highest values.
Print(MinValue<Int8>(), MaxValue<Int8>(), MinValue<Int16>(), MaxValue<Int16>())
Print(MinValue<Int>(), MaxValue<Int>(), MinValue<Long>(), MaxValue<Long>())
Print(MinValue<UInt8>(), MaxValue<UInt8>(), MinValue<UInt16>(), MaxValue<UInt16>())
Print(MinValue<UInt32>(), MaxValue<UInt32>(), MinValue<UInt64>(), MaxValue<UInt64>())
Print(MinValue<Float>(), MaxValue<Float>(), MinValue<Double>(), MaxValue<Double>())

// Generic code of its own takes the Interfaces as constraints.
Function Span<T>(): T
    Where T: Bounded & Numeric
    Return T.MaxValue() - T.MinValue()
End Function

Print(Span<UInt8>(), Span<UInt32>(), Span<Float>() == Inf)

// Abs and Sign, on integers, floats, and -0 and NaN.
Local small: Int8 = -5
Print(Abs(-3), Abs(3), Abs(small), Abs(-2.5), Abs(-0.0), Abs(NaN), Abs(-Inf))
Print(Sign(-4), Sign(0), Sign(9), Sign(-2.5), Sign(0.0), Sign(NaN), Sign(Inf))
Print((Abs(-0.0) As Float).ToBits(), Abs(MinValue<Long>() + 1))

// The whole parts: Round goes away from 0 halfway, and Fract is what Floor takes away.
Print(Floor(2.5), Floor(-2.5), Ceil(2.5), Ceil(-2.5), Round(2.5), Round(-2.5), Round(2.4))
Print(Trunc(2.7), Trunc(-2.7), Fract(2.75), Fract(-0.25), Fract(3.0))
Local precise: Double = -2.5
Print(Floor(precise), Ceil(precise), Round(precise), Trunc(precise), Fract(precise))

// Mod has the divisor's sign and Rem the dividend's, for integers and floats alike.
Print(Mod(7, 3), Mod(-7, 3), Mod(7, -3), Mod(-7, -3), Mod(6, 3))
Print(Rem(7, 3), Rem(-7, 3), Rem(7, -3), Rem(-7, -3))
Print(Mod(-1.5, 4.0), Mod(1.5, -4.0), Rem(-1.5, 4.0), Rem(5.5, 2.0), IsNaN(Mod(1.0, 0.0)))
Print(Mod(MinValue<Int>(), -1), Rem(MinValue<Long>(), -1), Mod(MinValue<Int8>(), 3))
Local bytes: UInt8 = 250
Print(Mod(bytes, 7), Rem(bytes, 7))

// Divisors, and the integer square root, up to UInt64's largest.
Print(Gcd(12, 18), Gcd(-12, 18), Gcd(12, -18), Gcd(0, 5), Gcd(5, 0), Gcd(0, 0), Gcd(17, 5))
Print(Gcd(MinValue<Int>(), 6), Gcd(MinValue<Int>(), -1), Lcm(4, 6), Lcm(-4, 6), Lcm(0, 6),
      Lcm(7, 3))
Print(IntSqrt(0), IntSqrt(1), IntSqrt(3), IntSqrt(4), IntSqrt(10), IntSqrt(MaxValue<Int>()))
Print(IntSqrt(MaxValue<UInt64>()), IntSqrt(MaxValue<Long>()), IntSqrt(bytes))

// The steps between two values, in the type of the one that isn't a literal.
Local t: Float = 0.25
Local half: Double = 0.5
Print(Lerp(0, 10, t), Lerp(0, 10, half), Lerp(10.0, 20.0, 1.5), Lerp(10.0, 20.0, -1.0))
Print(InverseLerp(0, 10, 2.5), InverseLerp(10.0, 20.0, 5.0), InverseLerp(3.0, 3.0, 7.0))
Print(Remap(5.0, 0, 10, 100, 200), Remap(15.0, 10, 20, 0, -1))
Print(SmoothStep(0, 1, t), SmoothStep(0.0, 1.0, -1.0), SmoothStep(0.0, 1.0, 2.0),
      SmoothStep(0.0, 1.0, 0.5))
Print(SmoothStep(2.0, 2.0, 1.0), SmoothStep(2.0, 2.0, 2.0), SmoothStep(1.0, 0.0, t))
Print(Wrap(370, 0, 360), Wrap(-10, 0, 360), Wrap(360, 0, 360), Wrap(5, 5, 5), Wrap(3, 10, 5))
Print(Wrap(370.0, 0.0, 360.0), Wrap(-1.0, 0.0, 360.0), Wrap(7.5, 2.0, 2.0), Wrap(Tau + 1, 0, Tau))
// A hair below 0 wraps to low, not to high, which is left out, as Mod gives 0, not b; a 0 has b's
// sign.
Local hair: Float = -0.00001
Print(Wrap(hair, 0.0, 360.0), Wrap(-0.0000001 As Float, 0.0, Tau), Wrap(-1e-20, 0.0, 360.0),
      Mod(hair, 360.0), Mod(0.00001 As Float, -360.0), Wrap(0.00001 As Float, 360.0, 0.0))
Print(Mod(-4.0, 2.0), Mod(4.0, -2.0), Mod(-0.0, 3.0), Wrap(-360.0, 0.0, 360.0))
Print(PingPong(0, 2), PingPong(1, 2), PingPong(2, 2), PingPong(3, 2), PingPong(4, 2),
      PingPong(-1, 2))
Print(PingPong(3.5, 2.0), PingPong(0.5, 2.0), PingPong(5.0, 0.0), PingPong(7, 0))
Print(PingPong(-2, 2), PingPong(-3, 2), PingPong(-4, 2), PingPong(-5, 3), PingPong(8, 3))
// Unsigned types, and ranges wider than half the type, whose distances don't fit in it.
Local one: UInt8 = 1
Local two: UInt8 = 2
Local three: UInt8 = 3
Local five: UInt8 = 5
Local ten: UInt8 = 10
Local big: UInt8 = 250
Print(PingPong(one, two), PingPong(three, two), Wrap(three, five, ten), Wrap(big, five, ten),
      Wrap(three, ten, five), Wrap(big, ten, five))
Local wideLow: Int8 = -100
Local wideHigh: Int8 = 100
Local past: Int8 = 120
Print(Wrap(past, wideLow, wideHigh), Wrap(wideLow, wideLow, wideHigh),
      Wrap(wideHigh, wideLow, wideHigh), Wrap(MinValue<Int8>(), wideLow, wideHigh),
      PingPong(MaxValue<Int8>(), wideHigh), PingPong(MinValue<Int8>(), wideHigh),
      PingPong(MinValue<Int8>(), MaxValue<Int8>()))
Print(Wrap(5, MinValue<Int>(), MaxValue<Int>()),
      Wrap(MaxValue<Int>(), MinValue<Int>(), MaxValue<Int>()),
      Wrap(MinValue<Long>(), MaxValue<Long>(), MinValue<Long>()),
      PingPong(MaxValue<UInt64>(), MaxValue<UInt64>() - 1),
      PingPong(MaxValue<UInt64>(), 1 As UInt64))
Print(MoveTowards(0, 10, t), MoveTowards(9.9, 10.0, 1.0), MoveTowards(5.0, 0.0, 2.0),
      MoveTowards(3.0, 3.0, 1.0))
Print(MoveTowards(5.0, 10.0, -1.0))

// IsClose, within a tolerance, or of rounding: 0.00001 of the larger's size, or of 1 near 0.
Print(IsClose(1.0, 1.1, 0.2), IsClose(1.0, 1.3, 0.2), IsClose(0.1 + 0.2, 0.3), IsClose(1.0, 1.0001))
Print(IsClose(1000000.0, 1000001.0), IsClose(0.0, 0.000001), IsClose(0.0, 0.0001),
      IsClose(Inf, Inf))
Print(IsClose(Inf, MaxValue<Float>()), IsClose(NaN, NaN), IsClose(-Inf, Inf),
      IsClose(half, 0.5000000001))

// Square roots are exact, by IEEE; the rest of libm prints rounded.
Print(Sqrt(4.0), Sqrt(2.0), Sqrt(half), IsNaN(Sqrt(-1.0)), Sqrt(Inf), Sqrt(-0.0))
Print(Shown(Cbrt(27.0)), Shown(Cbrt(-8.0)), Shown(Exp(1.0)), Shown(Exp2(10.0)), Shown(Exp(half)))
Print(Shown(Log(E)), Shown(Log(100.0, 10.0)), Shown(Log2(1024.0)), Shown(Log10(0.001)), Log(0.0),
      IsNaN(Log(-1.0)))
Print(Shown(Sin(Pi / 6)), Shown(Cos(Pi / 3)), Shown(Tan(Pi / 4)), Shown(Sin(half)),
      Shown(Cos(Pi64)))
Print(Shown(Asin(1.0)), Shown(Acos(-1.0)), Shown(Atan(1.0)), IsNaN(Asin(2.0)), Shown(Asin(half)))
Print(Shown(Atan2(1.0, 0.0)), Shown(Atan2(-1.0, -1.0)), Shown(Atan2(0.0, -1.0)), Atan2(0.0, 0.0))
Print(Shown(Sinh(1.0)), Shown(Cosh(1.0)), Shown(Tanh(1.0)), Shown(Asinh(1.0)), Shown(Acosh(2.0)),
      Shown(Atanh(0.5)))
Print(IsNaN(Acosh(0.5)), IsNaN(Atanh(2.0)), Tanh(Inf), Shown(Sinh(half)))

// IEEE's checks and exact operations.
Print(IsNaN(NaN), IsNaN(Inf), IsNaN(1.0), IsNaN(half), IsFinite(1.0), IsFinite(Inf), IsFinite(NaN))
Print(CopySign(2.0, -0.0), CopySign(-3.0, 1.0), CopySign(Inf, -1.0), CopySign(half, -2))
Print(Fma(2.0, 3.0, 4.0), Fma(half, 4, 1))
// Fma rounds once: (1 + e)(1 - e) - 1 is -e², which two roundings would lose.
Local tiny = Epsilon64
Print(Fma(1 + tiny, 1 - tiny, -1) == -tiny * tiny, (1 + tiny) * (1 - tiny) - 1)

// Angles are radians: Deg and ToRadians make them from degrees, and Rad says they are already.
Print(Deg(90) == Pi / 2, Deg(180) == Pi, Deg(360) == Tau, Deg(45.0) == Pi / 4, Deg(-90))
Local degrees: Double = 180
Print(Deg(degrees) == Pi64, ToRadians(90) == Deg(90), ToRadians(degrees) == Pi64)
Print(Rad(2), Rad(1.5), ToDegrees(Pi), ToDegrees(Pi64), ToDegrees(Deg(30)), ToDegrees(-Pi / 2))

// A Float's and a Double's bits, as IEEE 754 lays them out.
Print(1.0.ToBits(), (-0.0).ToBits(), Inf.ToBits(), Float.FromBits(0x40490FDB),
      Float.FromBits(0x3F800000))
Print(half.ToBits(), Double.FromBits(0x3FF0000000000000), Double.FromBits(0x7FF0000000000000))
Print(IsNaN(Float.FromBits(0x7FC00001)), Float.FromBits(1) > 0, Float.FromBits(1) / 2)
