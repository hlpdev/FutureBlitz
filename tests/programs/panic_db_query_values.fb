// Database.Query<T>(sql, values...) binds one value to each of the SQL's parameters, so it panics
// where it's called with another number of values.
Import std.core
Import std.db

Struct Named
    Field Name: String?
End Struct

Try
    Local db = Database.Open(":memory:")
    Print(db.Query<Named>("SELECT ? AS Name", "a")[0].Name ?? "none")
    Print(db.Query<Named>("SELECT ? AS Name, ? AS X", 1).Count)
Catch e As Error
    Print(e.Message)
End Try
