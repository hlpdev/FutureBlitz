Local der8192 = Unhex("")
Local pkcs1Signature8192 = Unhex("")
Local pssSignature8192 = Unhex("")
Expect("8192 RS256", Rsa.Verify(der8192, "hello", pkcs1Signature8192))
Expect("8192 PS256", Rsa.VerifyPss(der8192, "hello", pssSignature8192))
Expect("8192 RS256 of another message", !Rsa.Verify(der8192, "hellO", pkcs1Signature8192))
Expect("8192 PS256 of another message", !Rsa.VerifyPss(der8192, "hellO", pssSignature8192))
Expect("8192 RS256 by PSS", !Rsa.VerifyPss(der8192, "hello", pkcs1Signature8192))
Local public8192Key = Try? Key.FromPem(public8192)
Expect("8192 public key", public8192Key?.Kind == KeyKind.RSA && public8192Key?.IsPrivate == False && public8192Key?.Bytes == der8192)
Expect("8192 PKCS #1 public key", (Try? Key.FromPem(rsaPublic8192))?.Bytes == der8192)
Check("8192 public PEM", public8192Key?.ToPem() ?? "", public8192)
Local private8192Key = Try? Key.FromPem(private8192)
Expect("8192 private key", private8192Key?.Kind == KeyKind.RSA && private8192Key?.IsPrivate == True)
Check("8192 private PEM", private8192Key?.ToPem() ?? "", pkcs1Private8192)
Expect("8192 PKCS #1 private key", (Try? Key.FromPem(pkcs1Private8192))?.Bytes == private8192Key?.Bytes)
Done("8192 bits")

