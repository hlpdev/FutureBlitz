Function Refused(name: String, pem: String)
    Try
        Key.FromPem(pem)
        Expect("{name} read", False)
    Catch e As ParseError
        Expect("{name} refused", e.Kind == ParseErrorKind.WRONG_TYPE)
    End Try
End Function

