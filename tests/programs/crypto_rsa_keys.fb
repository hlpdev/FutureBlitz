    "ZXxuSZllsg6Wjwx/r4hpYNwio1rHbuEzAgMBAAE=\n" +
    "-----END RSA PUBLIC KEY-----\n"
Local der2047 = Unhex("")
Local pkcs1Signature2047 = Unhex("")
Local pssSignature2047 = Unhex("")
Expect("2047 RS256", Rsa.Verify(der2047, "hello", pkcs1Signature2047))
Expect("2047 PS256", Rsa.VerifyPss(der2047, "hello", pssSignature2047))
Expect("2047 RS256 of another message", !Rsa.Verify(der2047, "hellO", pkcs1Signature2047))
Expect("2047 PS256 of another message", !Rsa.VerifyPss(der2047, "hellO", pssSignature2047))
Expect("2047 RS256 by PSS", !Rsa.VerifyPss(der2047, "hello", pkcs1Signature2047))
Local public2047Key = Try? Key.FromPem(public2047)
Expect("2047 public key", public2047Key?.Kind == KeyKind.RSA && public2047Key?.IsPrivate == False && public2047Key?.Bytes == der2047)
Expect("2047 PKCS #1 public key", (Try? Key.FromPem(rsaPublic2047))?.Bytes == der2047)
Check("2047 public PEM", public2047Key?.ToPem() ?? "", public2047)
Local private2047Key = Try? Key.FromPem(private2047)
Expect("2047 private key", private2047Key?.Kind == KeyKind.RSA && private2047Key?.IsPrivate == True)
Check("2047 private PEM", private2047Key?.ToPem() ?? "", pkcs1Private2047)
Expect("2047 PKCS #1 private key", (Try? Key.FromPem(pkcs1Private2047))?.Bytes == private2047Key?.Bytes)
Done("2047 bits")

