// std.crypto's Rsa verifies, and Key reads and writes, RSA keys PSA doesn't take: of 2047 and
// 4104 bits, an odd number and more than 4096, and of 8192, the most std.crypto takes, which
// openssl made, with its RS256 and PS256 signatures of "hello". A larger key, and an encrypted
// one, are of a kind std.crypto doesn't take.
Import std.core
Import std.collections
Import std.crypto

Global checked = 0

// The bytes of hex digits.
Function Unhex(text: String): UInt8[]
    Local bytes: UInt8[] = []
    Local high = -1
    For c In text.Bytes
        Local code = c As Int
        Local digit = code <= 57 ? code - 48 : code - 87
        If high < 0
            high = digit
        Else
            bytes.Add((high * 16 + digit) As UInt8)
            high = -1
        End If
    End For
    Return bytes
End Function

// Counts a check, and says which one failed.
Function Expect(name: String, passed: Bool)
    checked += 1
    If !passed Then Print("{name} failed")
End Function

// Counts a check of text, and says what it was when it's another.
Function Check(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// Prints how many checks a section made, and starts the count again.
Function Done(section: String)
    Print("{section}: {checked} check{checked == 1 ? "" : "s"}")
    checked = 0
End Function

