Local der4104 = Unhex("")
Local pkcs1Signature4104 = Unhex("")
Local pssSignature4104 = Unhex("")
Expect("4104 RS256", Rsa.Verify(der4104, "hello", pkcs1Signature4104))
Expect("4104 PS256", Rsa.VerifyPss(der4104, "hello", pssSignature4104))
Expect("4104 RS256 of another message", !Rsa.Verify(der4104, "hellO", pkcs1Signature4104))
Expect("4104 PS256 of another message", !Rsa.VerifyPss(der4104, "hellO", pssSignature4104))
Expect("4104 RS256 by PSS", !Rsa.VerifyPss(der4104, "hello", pkcs1Signature4104))
Local public4104Key = Try? Key.FromPem(public4104)
Expect("4104 public key", public4104Key?.Kind == KeyKind.RSA && public4104Key?.IsPrivate == False && public4104Key?.Bytes == der4104)
Expect("4104 PKCS #1 public key", (Try? Key.FromPem(rsaPublic4104))?.Bytes == der4104)
Check("4104 public PEM", public4104Key?.ToPem() ?? "", public4104)
Local private4104Key = Try? Key.FromPem(private4104)
Expect("4104 private key", private4104Key?.Kind == KeyKind.RSA && private4104Key?.IsPrivate == True)
Check("4104 private PEM", private4104Key?.ToPem() ?? "", pkcs1Private4104)
Expect("4104 PKCS #1 private key", (Try? Key.FromPem(pkcs1Private4104))?.Bytes == private4104Key?.Bytes)
Done("4104 bits")

