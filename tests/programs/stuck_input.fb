// The program ends while a coroutine waits for what nothing will finish, beside a request the
// I/O thread has under way, which the coroutine doesn't wait for, so it doesn't hold the end up.
// The I/O thread answers it with Null as the program ends.
Import std.core

Class Marker
    Method Destroy()
        Print("globals released")
    End Method
End Class

Global marker = Marker()
Global stalled = Scheduler()

Async Function Inner(): Int
    Await NextTick()
    Return 1
End Function

Async Function Outer(): Int
    Local inner = Inner()
    stalled.Run(inner)
    Return Await inner
End Function

Local pending = InputAsync()
Local outer = Outer()
Print("end of top-level code")
