Expect("9007199254740993 as a Double", R("9007199254740993", "1").ToDouble() == 9007199254740992.0)
Expect("9007199254740995 as a Double", R("9007199254740995", "1").ToDouble() == 9007199254740996.0)
Expect("1/3 as a Double", R("1", "3").ToDouble() == 0.3333333333333333)
Expect("-2/3 as a Double", R("-2", "3").ToDouble() == -0.6666666666666666)
Expect(" as a Double", R("", "1").ToDouble() == Infinity())
Expect(" as a Double", R("", "1").ToDouble() == 1.7976931348623157e+308)
Expect(" as a Double", R("1", "").ToDouble() == 5e-324)
Expect(" as a Double", R("1", "").ToDouble() == 0.0)
Expect(" as a Double", R("3", "").ToDouble() == 5e-324)
Expect(" as a Double", R("4503599627370497", "").ToDouble() == 5e-324)
Expect("1000000000000000000000000000001/1000000000000000 as a Double",
       R("1000000000000000000000000000001", "1000000000000000").ToDouble() == 1000000000000000.0)
Expect("-1152921504606846977/7 as a Double",
       R("-1152921504606846977", "7").ToDouble() == -1.647030720866924e+17)
Done("Doubles")

CheckShown("parse 3/4", Rational.Parse("3/4") ?? Rational(-424242), "3/4")
CheckShown("parse -3/6", Rational.Parse("-3/6") ?? Rational(-424242), "-1/2")
CheckShown("parse +3/4", Rational.Parse("+3/4") ?? Rational(-424242), "3/4")
CheckShown("parse 1e-3", Rational.Parse("1e-3") ?? Rational(-424242), "1/1000")
CheckShown("parse 0.75", Rational.Parse("0.75") ?? Rational(-424242), "3/4")
CheckShown("parse -1.5E+2", Rational.Parse("-1.5E+2") ?? Rational(-424242), "-150")
CheckShown("parse 7", Rational.Parse("7") ?? Rational(-424242), "7")
CheckShown("parse 0/5", Rational.Parse("0/5") ?? Rational(-424242), "0")
CheckShown("parse -0", Rational.Parse("-0") ?? Rational(-424242), "0")
CheckShown("parse 10/4", Rational.Parse("10/4") ?? Rational(-424242), "5/2")
Expect("parse 3/-4", Rational.Parse("3/-4") == Null)
Expect("parse  1/2", Rational.Parse(" 1/2") == Null)
Expect("parse 1/0", Rational.Parse("1/0") == Null)
Expect("parse /2", Rational.Parse("/2") == Null)
Expect("parse 1/", Rational.Parse("1/") == Null)
Expect("parse 1//2", Rational.Parse("1//2") == Null)
Expect("parse ", Rational.Parse("") == Null)
Expect("parse x/2", Rational.Parse("x/2") == Null)
Expect("parse 1.5/2", Rational.Parse("1.5/2") == Null)
Expect("parse -", Rational.Parse("-") == Null)
Expect("parse 1/2/3", Rational.Parse("1/2/3") == Null)
CheckShown("from 0.1", Rational.FromDouble(0.1), "3602879701896397/36028797018963968")
CheckShown("from -2.5", Rational.FromDouble(-2.5), "-5/2")
CheckShown("from 5e-324", Rational.FromDouble(5e-324), "")
CheckShown("from 1e300", Rational.FromDouble(1e300), "")
CheckShown("from 0.0", Rational.FromDouble(0.0), "0")
CheckShown("from -0.0", Rational.FromDouble(-0.0), "0")
CheckShown("from 1.5", Rational.FromDouble(1.5), "3/2")
CheckShown("from Decimal 0.75", Rational.FromDecimal(Decimal.Parse("0.75") ?? Decimal(0)), "3/4")
CheckShown("from Decimal -12.50", Rational.FromDecimal(Decimal.Parse("-12.50") ?? Decimal(0)),
           "-25/2")
CheckShown("from Decimal 1E+3", Rational.FromDecimal(Decimal.Parse("1E+3") ?? Decimal(0)), "1000")
CheckShown("from Decimal 1E-5", Rational.FromDecimal(Decimal.Parse("1E-5") ?? Decimal(0)),
           "1/100000")
CheckShown("from Decimal 0", Rational.FromDecimal(Decimal.Parse("0") ?? Decimal(0)), "0")
CheckShown("from Decimal -0.000", Rational.FromDecimal(Decimal.Parse("-0.000") ?? Decimal(0)), "0")
Expect("hashes",
       R("2", "4").Hash() == R("1", "2").Hash() && R("-3", "-6").Hash() == R("1", "2").Hash())
Expect("zero and one", Rational.Zero() == 0 && Rational.One() == 1)
CheckShown("6+5", q[6] + 5, "920/113")
CheckShown("5-6", 5 - q[6], "210/113")
CheckShown("6*5", q[6] * 5, "1775/113")
CheckShown("5/6", 5 / q[6], "113/71")
CheckShown("6/5", q[6] / 5, "71/113")
Expect("6==5", (q[6] == 5) == False)
Expect("5==6", (5 == q[6]) == False)
Expect("6<5", (q[6] < 5) == True)
Expect("5<6", (5 < q[6]) == False)
Expect("6>5", (q[6] > 5) == False)
Expect("5>6", (5 > q[6]) == True)
Expect("6<=5", (q[6] <= 5) == True)
Expect("5<=6", (5 <= q[6]) == False)
Expect("6>=5", (q[6] >= 5) == False)
Expect("5>=6", (5 >= q[6]) == True)
CheckShown("6+-3", q[6] + -3, "16/113")
CheckShown("-3-6", -3 - q[6], "-694/113")
CheckShown("6*-3", q[6] * -3, "-1065/113")
CheckShown("-3/6", -3 / q[6], "-339/355")
CheckShown("6/-3", q[6] / -3, "-355/339")
Expect("6==-3", (q[6] == -3) == False)
Expect("-3==6", (-3 == q[6]) == False)
Expect("6<-3", (q[6] < -3) == False)
Expect("-3<6", (-3 < q[6]) == True)
Expect("6>-3", (q[6] > -3) == True)
Expect("-3>6", (-3 > q[6]) == False)
Expect("6<=-3", (q[6] <= -3) == False)
Expect("-3<=6", (-3 <= q[6]) == True)
Expect("6>=-3", (q[6] >= -3) == True)
Expect("-3>=6", (-3 >= q[6]) == False)
CheckShown("6+1000000007", q[6] + 1000000007, "113000001146/113")
CheckShown("1000000007-6", 1000000007 - q[6], "113000000436/113")
CheckShown("6*1000000007", q[6] * 1000000007, "355000002485/113")
CheckShown("1000000007/6", 1000000007 / q[6], "113000000791/355")
CheckShown("6/1000000007", q[6] / 1000000007, "355/113000000791")
Expect("6==1000000007", (q[6] == 1000000007) == False)
Expect("1000000007==6", (1000000007 == q[6]) == False)
Expect("6<1000000007", (q[6] < 1000000007) == True)
Expect("1000000007<6", (1000000007 < q[6]) == False)
Expect("6>1000000007", (q[6] > 1000000007) == False)
Expect("1000000007>6", (1000000007 > q[6]) == True)
Expect("6<=1000000007", (q[6] <= 1000000007) == True)
Expect("1000000007<=6", (1000000007 <= q[6]) == False)
Expect("6>=1000000007", (q[6] >= 1000000007) == False)
Expect("1000000007>=6", (1000000007 >= q[6]) == True)
Local total = Rational(1, 2)
total += 5
total *= q[6]
total -= 1
total /= 3
CheckShown("op=", total, "3679/678")
// To the lowest Int64's power, whose -1 times doesn't fit an Int64.
Local lowest: Int64 = -9223372036854775807 - 1
CheckShown("1**lowest", Rational(1) ** lowest, "1")
CheckShown("-1**lowest", Rational(-1) ** lowest, "1")
CheckShown("-1**(lowest+1)", Rational(-1) ** (lowest + 1), "-1")
// A Decimal's text, from its digits and exponent, so a large exponent is quick.
Local large = Rational.Parse("1e999999") ?? Rational(0)
Expect("1e999999", large.Numerator.BitLength == 3321925 && large.Denominator == 1)
Local tiny = Rational.Parse("-1e-999999") ?? Rational(0)
Expect("-1e-999999", tiny.Numerator == -1 && tiny.Denominator.BitLength == 3321925)
CheckShown("1.25E-7", Rational.Parse("1.25E-7") ?? Rational(0), "1/8000000")
CheckShown("-12.50", Rational.Parse("-12.50") ?? Rational(0), "-25/2")
CheckShown("1.5E+3", Rational.Parse("1.5E+3") ?? Rational(0), "1500")
CheckShown("0.75", Rational.FromDecimal(Decimal.Parse("0.75") ?? Decimal(0)), "3/4")
Done("the rest")
