// std.math.big's Rational matches Python's fractions: its arithmetic exact, in lowest terms;
// Floor, Ceiling, Truncate, and Round, half to even, as Python's round does; ToDouble, the
// nearest Double; Parse, FromDouble, and FromDecimal, exactly; and ToDecimal in 28 digits.
Import std.core
Import std.math.big

Global checked = 0
Global zero = 0.0

// An infinity, which a Double divided by 0 is.
Function Infinity(): Double => 1.0 / zero

// Counts a check, and says which one failed.
Function Expect(name: String, passed: Bool)
    checked += 1
    If !passed Then Print("{name} failed")
End Function

// Counts a check of what a value shows as, and says what it was when it's another.
Function Check(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// Says how many checks a section made, and starts counting again.
Function Done(section: String)
    Print("{section}: {checked} check{checked == 1 ? "" : "s"}")
    checked = 0
End Function

// The fraction of the two integers' digits.
Function R(numerator: String, denominator: String): Rational
    Return Rational(BigInt.Parse(numerator) ?? BigInt(0), BigInt.Parse(denominator) ?? BigInt(1))
End Function

// Counts a check of what a value shows as.
Function CheckShown(name: String, actual: Printable, expected: String)
    Check(name, actual.ToString(), expected)
End Function

Local q: Rational[] = []
q.Add(R("0", "1"))
q.Add(R("1", "1"))
q.Add(R("-1", "1"))
q.Add(R("1", "3"))
q.Add(R("-2", "7"))
q.Add(R("22", "7"))
q.Add(R("355", "113"))
q.Add(R("1267650600228229401496703205377", "717897987691852588770249"))
q.Add(R("-1000000000000000000000000000000", "79792266297612001"))
q.Add(R("5", "1"))
q.Add(R("-7", "2"))
q.Add(R("7", "2"))
q.Add(R("5", "2"))
q.Add(R("1", ""))
q.Add(R("", "3"))

CheckShown("0+0", q[0] + q[0], "0")
CheckShown("0-0", q[0] - q[0], "0")
CheckShown("0*0", q[0] * q[0], "0")
Expect("0==0", (q[0] == q[0]) == True)
Expect("0<0", (q[0] < q[0]) == False)
Expect("0>=0", (q[0] >= q[0]) == True)
CheckShown("0+1", q[0] + q[1], "1")
CheckShown("0-1", q[0] - q[1], "-1")
CheckShown("0*1", q[0] * q[1], "0")
CheckShown("0/1", q[0] / q[1], "0")
Expect("0==1", (q[0] == q[1]) == False)
