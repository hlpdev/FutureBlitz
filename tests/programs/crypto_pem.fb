Try
    Local roots = Certificate.AllFromPem(bundle)
    Expect("bundle",
           roots.Count == 2 &&
           roots[0].SerialNumber == "82:10:CF:B0:D2:40:E3:59:44:63:E0:BB:63:82:8B:00" &&
           roots[1].SerialNumber == "41:D2:9D:D1:72:EA:EE:A7:80:C1:2C:6C:E9:2F:87:52")
Catch e As ParseError
