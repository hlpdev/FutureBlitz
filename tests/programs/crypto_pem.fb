// RFC 7748's Alice's X25519 private key (6.1), as RFC 8410's PKCS #8, reads as its bytes,
// which aren't clamped, and writes back as it was.
Local alice = "-----BEGIN PRIVATE KEY-----\n" +
              "MC4CAQAwBQYDK2VuBCIEIHcHbQpzGKV9PBbBclGyZkXfTC+H68CZKrF3+6UduSwq\n" +
              "-----END PRIVATE KEY-----\n"
Local aliceKey = Try? Key.FromPem(alice)
CheckText("Alice bytes", Hex(aliceKey?.Bytes ?? []),
          "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")
CheckText("Alice PEM", aliceKey?.ToPem() ?? "", alice)
Done("RFC 7748")

// A damaged key, of a kind std.crypto takes and not encrypted, is SYNTAX's, as a damaged
// certificate is: RFC 8410's Ed25519 private key cut short, and a P-256 one whose base64 is.
Local cutShort = "-----BEGIN PRIVATE KEY-----\n" +
                 "MC4CAQAwBQYDK2VwBCIEINTuctv5E1hK1bbY8fdp\n" +
                 "-----END PRIVATE KEY-----\n"
Local cutBase64 = "-----BEGIN PRIVATE KEY-----\n" +
                  "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQg+5kwlov2G2geVvtD\n" +
                  "6T5+2FOzjzOnhww0IiXreSqkzpmh\n" +
                  "-----END PRIVATE KEY-----\n"
CheckText("cut short", Shown(cutShort), "SYNTAX: the PEM's key doesn't read")
CheckText("cut base64", Shown(cutBase64), "SYNTAX: the PEM's key doesn't read")
Done("Damaged keys")
