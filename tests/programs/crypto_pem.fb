End Try
Done("Bundle")

// Keys of each kind go to PEM and back: RFC 6979's P-256 key, and new ones.
Local p256 = Unhex("c9afa9d845ba75166b5c215767b1d6934e50c3db36e89b127b8a622b120f6721")
For pair In [(KeyKind.ECDSA_P256, p256), (KeyKind.ECDSA_P256, EcdsaP256.PublicKeyOf(p256)),
             (KeyKind.X25519, X25519.NewPrivateKey())]
    Local kind, bytes = pair
    Local isPrivate = bytes.Count == 32
    Local pem = Key(kind, isPrivate, bytes).ToPem()
    Local back = Try? Key.FromPem(pem)
    Expect("{kind} {isPrivate} PEM",
           back?.Kind == kind && back?.IsPrivate == isPrivate && back?.Bytes == bytes)
End For
Local x25519Public = Key(KeyKind.X25519, False, X25519.PublicKeyOf(X25519.NewPrivateKey()))
Expect("X25519 public PEM", (Try? Key.FromPem(x25519Public.ToPem()))?.Bytes == x25519Public.Bytes)
Done("Keys there and back")

// Text without a key is a ParseError of SYNTAX.
For text In ["", "hello", "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n"]
    Try
        Key.FromPem(text)
        Expect("no key", False)
    Catch e As ParseError
        Expect("no key: {e.Kind}", e.Kind == ParseErrorKind.SYNTAX)
    End Try
End For
Expect("no certificate", Try? Certificate.FromPem("hello") == Null)
Expect("a key isn't a certificate", Try? Certificate.AllFromPem(edPublic) == Null)
Done("Not PEM")

// Counts a check of text, and says what it was when it's another.
Function CheckText(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// What reading a key from the PEM gives.
Function Shown(pem: String): String
    Try
        Local key = Key.FromPem(pem)
        Return "{key.Kind}, private: {key.IsPrivate}"
    Catch e As ParseError
        Return "{e.Kind}: {e.Message}"
    End Try
End Function

// The first key in a PEM of several is the one read, whatever kinds the later ones are.
Local publicThenPrivate = "-----BEGIN PUBLIC KEY-----\n" +
                          "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE7fjQvYW6EbS12khag4DR50TeVGnQ\n" +
                          "shZ9zqOhcohtENjhAtz48fWAh9Vyb70wSGpUU95N77iC16vx+JX6Cq+Wsw==\n" +
                          "-----END PUBLIC KEY-----\n" +
                          "-----BEGIN PRIVATE KEY-----\n" +
