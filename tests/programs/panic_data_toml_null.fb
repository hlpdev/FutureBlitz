// TOML has no null, so Write panics where it's given an Array that holds one.
Import std.core
Import std.data.toml

Local document = Value.Object()
Local list = Value.Array()
list.Add(Value(1 As Int64))
document["list"] = list
Print(Toml.Write(document))
list.Add(Value())
Print(Toml.Write(document))
