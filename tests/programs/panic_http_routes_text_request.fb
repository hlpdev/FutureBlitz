// A routes Class's Method with a route's attribute that takes a String and the request, which Load
// doesn't make from the Object of a request's values, so every request would be a 400, isn't a
// route, so Routes panics where it's called.
Import std.core
Import std.net.http

Class Texts
    @Post("/text")
    Async Method Show(text: String, request: HttpRequest): HttpResponse => HttpResponse.Of(204)
End Class

Local server = HttpServer()
server.Routes(Texts())
