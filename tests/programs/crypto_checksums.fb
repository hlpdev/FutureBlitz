// A Blake3 hasher gives each hash of what was added since the last.
Local blake = Blake3.Keyed(key)
blake.Add(Input(1000))
blake.Add(Input(2000)[1000..])
Check("BLAKE3 keyed in parts", blake.Finish(), Hex(Blake3.KeyedHash(key, Input(2000))))
Check("BLAKE3 keyed after Finish", blake.Finish(), Hex(Blake3.KeyedHash(key, Input(0))))
Done("Blake3")

// CRC-32's check value, of the digits 1 to 9, from the CRC catalogue, and in parts.
Expect("CRC-32 check", Crc32.Hash("123456789") == 0xCBF43926)
Local crc = Crc32()
crc.Add("1234")
crc.Add("56789".Bytes)
Expect("CRC-32 in parts", crc.Finish() == 0xCBF43926)
Expect("CRC-32 of nothing", crc.Finish() == 0)
Done("CRC-32")

// xxHash's sanity buffer: a byte from the top of a number that multiplies by PRIME64 each
// time, from PRIME32.
Function Sanity(length: Int): UInt8[]
    Local bytes: UInt8[] = []
    Local generator: UInt64 = 2654435761
    For i = 0 Until length
        bytes.Add((generator >> 56) As UInt8)
        generator = generator.WrappingMultiply(11400714785074694797)
    End For
    Return bytes
End Function

// xxHash's sanity vectors for XXH3's 64 bits, each length and seed.
Expect("XXH3 0 0000000000000000", XxHash.Hash(Sanity(0), 0x0000000000000000) == 0x2D06800538D394C2)
Expect("XXH3 0 9E3779B185EBCA8D", XxHash.Hash(Sanity(0), 0x9E3779B185EBCA8D) == 0xA8A6B918B2F0364A)
Expect("XXH3 1 0000000000000000", XxHash.Hash(Sanity(1), 0x0000000000000000) == 0xC44BDFF4074EECDB)
Expect("XXH3 1 9E3779B185EBCA8D", XxHash.Hash(Sanity(1), 0x9E3779B185EBCA8D) == 0x032BE332DD766EF8)
Expect("XXH3 2 0000000000000000", XxHash.Hash(Sanity(2), 0x0000000000000000) == 0x7A9978044CB8A8BB)
