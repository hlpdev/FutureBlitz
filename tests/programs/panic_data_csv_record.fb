// Each of CSV's records is an Object, and WriteRecords panics where one isn't.
Import std.core
Import std.data.csv

Local records = Value.Array()
Local record = Value.Object()
record["a"] = Value("1")
records.Add(record)
Print(Csv.WriteRecords(records) == "a\n1\n")
records.Add(Value("loose"))
Print(Csv.WriteRecords(records))
