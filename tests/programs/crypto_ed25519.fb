Expect("Ed25519 149", Ed25519.Verify(key75, Unhex("931bbf9c877a6571cf7d4609fc3eb867edd43f51"), Unhex("6124c206d864507ea5d984b363b4cf583314db6856a45ded5e61eebff4d5e337e0b4c82b445ae2e52d549d2d961eace2ea01f81158e09a9686baa040db65ad08")))
Local key76 = Unhex("ccbe7cb2e4bc215cee2f885e1d22f7e0d582b2bbbd782c104e548b152d26fc69")
Expect("Ed25519 150", Ed25519.Verify(key76, Unhex("44530b0b34f598767a7b875b0caee3c7b9c502d1"), Unhex("cfbd450a2c83cb8436c348822fe3ee347d4ee937b7f2ea11ed755cc52852407c9eec2c1fa30d2f9aef90e89b2cc3bcef2b1b9ca59f712110d19894a9cf6a2802")))
Local key77 = Unhex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
Expect("Ed25519 151", !Ed25519.Verify(key77, Unhex("313233343030"), Unhex("0100000000000000000000000000000000000000000000000000000000000080c803ee1f2342aa96ff698a393d1ab5e66f3eda101d6d120b394c3fd32c117d0a")))
Done("Wycheproof Ed25519")

// A new key signs and verifies, a String is its bytes, and a key or signature of the wrong
// size verifies nothing.
Local signer = Ed25519.NewPrivateKey()
Local signature = Ed25519.Sign(signer, "move 12 to e4")
Expect("new key", signer.Count == 32 && Ed25519.Verify(Ed25519.PublicKeyOf(signer), "move 12 to e4", signature))
Expect("String", signature == Ed25519.Sign(signer, "move 12 to e4".Bytes))
Expect("other key", !Ed25519.Verify(Ed25519.PublicKeyOf(Ed25519.NewPrivateKey()), "move 12 to e4", signature))
Expect("short key", !Ed25519.Verify(Unhex("0102"), "move 12 to e4", signature))
Expect("short signature", !Ed25519.Verify(Ed25519.PublicKeyOf(signer), "move 12 to e4", signature[..63]))
Done("New keys")
