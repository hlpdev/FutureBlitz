// std.text.layout: WordWrap's columns, with wide characters, grapheme clusters, long words, and
// indented lines; Dedent's common indentation and blank lines; Indent's prefix; each keeping its
// line breaks, "\r\n" and "\r" too, which show as "\r" here; and Levenshtein's edits, by code
// point.
Import std.core
Import std.text
Import std.text.layout

Function Shown(text: String): String => text.Replace("\r", "\\r")

Local text = "The quick brown fox jumps over the lazy dog, and then a very-long-word-that-wraps." +
             "\n\n  indented line that goes on and on\r\nend"
Print(Shown(text.WordWrap(20)))
Print("--")
Print("日本語のテキストです 中文 😀😀😀😀".WordWrap(6))
Print("--")
Print("e\u{301}e\u{301}e\u{301}e\u{301}".WordWrap(2))
Print("--")
Print("    deep".WordWrap(3), "|", "a b c".WordWrap(1), "|", "".WordWrap(5) == "")
// A no-break space is no place to break and stays one, and the spaces between words that stay
// on a line stay as they are, while those at a break go.
Print("100\u{A0}km away".WordWrap(80) == "100\u{A0}km away")
Print("[" + "go 100\u{A0}km".WordWrap(7).Replace("\u{A0}", "<nbsp>") + "]")
Print("[" + "a  b   c d".WordWrap(80) + "]", "[" + "a  b   c d".WordWrap(5) + "]")
Print("[" + "\u{202F}x  y\u{2007}z".WordWrap(3).Replace("\u{202F}", "_").Replace("\u{2007}", "_") +
      "]", "[" + "  a   b  ".WordWrap(80) + "]")
// A tab goes on to the next multiple of 8 columns, in a line's indentation or between words.
Print("[" + "\tone two three four".WordWrap(20).Replace("\t", "\\t") + "]",
      "[" + "a\tb c".WordWrap(10).Replace("\t", "\\t") + "]",
      "[" + "ab\tc".WordWrap(9).Replace("\t", "\\t") + "]")
Print("--")
Local code = "    def f():\n        return 1\n\n    x = 2\n"
Print("[" + code.Dedent() + "]")
Print("[" + "  a\n\tb\n".Dedent() + "]")
Print("[" + Shown("\t\tone\r\n\t\t  two\r\t\tthree".Dedent()) + "]")
Print("[" + "a\n  \nb".Indent("> ") + "]")
Print("[" + Shown("one\r\ntwo\n".Indent("  ")) + "]")
Print(Levenshtein("kitten", "sitting"), Levenshtein("", "abc"), Levenshtein("flaw", "lawn"),
      Levenshtein("café", "cafe"), Levenshtein("😀a", "a😀"), Levenshtein("same", "same"),
      Levenshtein("e\u{301}", "é"))
