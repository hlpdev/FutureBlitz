Import std.core

Attribute Get(path: String)
Attribute Post(path: String)

Class Missing Extends Error
End Class

Class Api
    @Get("/users/:id")
    Method Find(id: Int): String Throws Missing
        If id < 0 Then Throw Missing("no user {id}")
        Return "user {id}"
    End Method

    @Post("/users")
    Async Method Save(id: Int): String Throws Missing
        If id < 0 Then Throw Missing("can't save {id}")
        Return "saved {id}"
    End Method

    @Get("/plain")
    Method Plain(id: Int): String => "plain {id}"

    // No attribute, so no Where m Has line picks it.
    Method Helper(id: Int): String => "helper"

    Async Method Later(id: Int): String => "later {id}"
End Class

// Only Methods with Get or Post, which throw an E or don't.
For Method m: M In Api
    Where M: Func(Int): String Throws E
    Where E: Error
    Where m Has Get Or Post
    Try
        Print(m.Call(Api(), 1))
        Print(m.Call(Api(), -1))
    Catch e As Error
        Print("{m.Name} threw: {e.Message}")
    End Try
End For

For Method m: M In Api
    Where M: Func(Int): String
    Where m Has Get Or Post
    Print("{m.Name}: {m.Call(Api(), 2)}")
End For

// An Async Method's errors are in its Task, which Await re-throws.
Async Function Run()
    For Method m: M In Api
        Where M: Func(Int): (Task<String> Throws E)
        Where E: Error
        Try
            Print(Await m.Call(Api(), 3))
            Print(Await m.Call(Api(), -3))
        Catch e As Error
            Print("{m.Name} threw: {e.Message}")
        End Try
    End For
End Function

Await Run()

// A Method that throws and gives nothing, and one whose header's Throws follows a Func result,
// which a loop's Func type writes the same way.
Class Store
    Method Drop(id: Int) Throws Missing
        If id < 0 Then Throw Missing("no {id}")
        Print("dropped {id}")
    End Method

    Method Make(id: Int): Func(): Int Throws Missing
        If id < 0 Then Throw Missing("bad {id}")
        Return Function() => id
    End Method
End Class

For Method m: M In Store
    Where M: Func(Int) Throws E
    Where E: Error
    Try
        m.Call(Store(), 1)
        m.Call(Store(), -1)
    Catch e As Error
        Print("{m.Name} threw: {e.Message}")
    End Try
End For

For Method m: M In Store
    Where M: Func(Int): Func(): Int Throws E
    Where E: Error
    Try
        Print("{m.Name} gives {m.Call(Store(), 5)()}")
    Catch e As Error
        Print("{m.Name} threw")
    End Try
End For

// An Override that doesn't throw takes its base's place only in the loops for Methods that
// don't, and goes by its own attributes.
Class Base
    @Get("/find")
    Method Find(n: Int): Int Throws Missing
        If n < 0 Then Throw Missing("neg")
        Return n
    End Method
End Class

Class Derived Extends Base
    Override Method Find(n: Int): Int => n * 2
End Class

For Method m: M In Derived
    Where M: Func(Int): Int Throws E
    Where E: Error
    Print("throwing {m.Name}")
End For

For Method m: M In Derived
    Where M: Func(Int): Int
    Print("plain {m.Name}: {m.Call(Derived(), 5)}")
End For

// A loop's Where E: Error needs nothing of a caller, since what a Method throws is an error.
Function Throwing<T>()
    For Method m: M In T
        Where M: Func(Int) Throws E
        Where E: Error
        Print("throws: {m.Name}")
    End For
End Function

Function Forward<T>()
    Throwing<T>()
End Function

Forward<Store>()
