// An array goes where an Interface it implements is expected: Iterable<T>, which an Extend of T[]
// gives, and Printable, each through its array type's table. A generic call takes T from it.
Import std.core
Import std.collections

Function Total(values: Iterable<Int>): Int
    Local total = 0
    For value In values
        total += value
    End For
    Return total
End Function

Function Joined<T: Printable>(values: Iterable<T>): String
    Local text = ""
    For value In values
        text += "<{value}>"
    End For
    Return text
End Function

Function Show(value: Printable): String => value.ToString()

Local numbers = [1, 2, 3, 4]
Local empty: Int[] = []
Print(Total(numbers), Total(empty), Joined<String>(["a", "b"]), Joined(numbers))

// What's in an Iterable's value is the array itself, so changes show.
Local kept: Iterable<Int> = numbers
numbers.Add(10)
Print(Total(kept))

// Lazily, without a copy.
Print(numbers.Iterate().Filter(Function(n: Int) => n % 2 == 0).Map(Function(n: Int) => n * 10)
      .ToArray())

// Collections take arrays.
Local set = Set<String>()
set.AddAll(["x", "y", "x"])
Local stack = Stack<Int>()
stack.AddAll(numbers)
Print(set, stack.ToArray())

// Printable, built in.
Local shown: Printable = [[1, 2], [3]]
Print(shown.ToString(), Show(numbers), Show(["a"]))

// A generic call takes T from what a Set or a Stack implements too.
Local stacked = Stack<String>()
stacked.Push("s")
Print(Joined(set), Joined(stacked))

// Arrays of objects keep them alive while an Interface holds the array.
Class Item
    Field Name: String

    New(name: String)
        Name = name
    End New
End Class

Function Names(items: Iterable<Item>): String
    Local text = ""
    For item In items
        text += item.Name
    End For
    Return text
End Function

Local items: Iterable<Item> = [Item("p"), Item("q")]
Print(Names(items))

// An array that may be Null goes where an Iterable that may be is expected.
Function Maybe(values: Iterable<Int>?): Int => values == Null ? -1 : Total(values)
Local none: Int[]? = Null
Local some: Int[]? = [5]
Print(Maybe(none), Maybe(some))

// An Extend of one array type gives it Interfaces, Properties too, through their values.
Interface Summed
    Method Total(): Int
End Interface

Extend Int[] Implements Summed
    Method Total(): Int
        Local sum = 0
        For n In Self
            sum += n
        End For
        Return sum
    End Method
End Extend

Interface Sized
    ReadOnly Property Size: Int
    Property Label: String
End Interface

Global labels = Map<Int, String>()

Extend T[] Implements Sized
    Public Property Size: Int
        Get => Count
    End Property

    Public Property Label: String
        Get => labels.Get(Count, "none")
        Set(value)
            labels[Count] = value
        End Set
    End Property
End Extend

Function SumOf(values: Summed): Int => values.Total()

Function MaybeSummed(values: Int[]): Summed? => values.Count == 0 ? Null : values

Local summed: Summed = [4, 5]
Local maybeSummed = MaybeSummed([1, 2, 3])
Local listed: Iterable<Int> = [7]
Local words: Iterable<String> = ["w"]
Print(summed.Total(), SumOf([10, 20]), maybeSummed?.Total() ?? -1, listed Is Summed,
      words Is Summed)
Local sized: Sized = [1.5, 2.5, 3.5]
sized.Label = "three"
Print(sized.Size, sized.Label, [9.5].AsReadOnly().Count)

// An array where a T?? of an Interface is expected has its tables too.
Function Inside(value: Printable??): String
    If value == Null Then Return "outer null"
    Local inner = value
    If inner == Null Then Return "inner null"
    Return inner.ToString()
End Function

Function Keep<T>(value: T?): T? => value

Print(Inside([True, False]), Keep<Iterable<Bool>?>([False]) == Null)

// An Interface's value tells the type arguments of a generic one it extends.
Interface Sequence<T> Extends Iterable<T>
    Method Length(): Int
End Interface

Extend T[] Implements Sequence<T>
    Public Method Length(): Int => Count
End Extend

Local sequence: Sequence<Int> = [4, 5]
Print(Total(sequence), Joined(sequence), sequence.Length())

// A literal takes its element type from an Iterable<T> expected.
Local wide = Set<Int64>()
wide.AddAll([1, 2])
Local floats = Stack<Float64>()
floats.AddAll([1, 2.5])
Print(wide, floats.ToArray(), Set<Int>().Union([]).Count)
