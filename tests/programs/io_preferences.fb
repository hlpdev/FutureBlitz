// Preferences survive their objects, as they would a run: what one saves the next one for the app
// reads back, values with line breaks, '='s, and names beyond ASCII too, and what one doesn't
// save is gone. They're kept in a temporary folder of the program's
// own, in place of the OS's folder for settings.
Import std.core
Import std.io

Local temp = Try TempDir("fb-preferences-")
Local root = temp.Path

Print("a first run")
Local first = Try Preferences("Größe Game", root)
Print("{first.Count()} {first.Get("volume") ?? "none"} {first.Get("volume", "1.0")} {File.Exists(first.Location)}")
Print("{first.Location.FileName()} {first.Location.Parent().FileName()} {first.App}")
first.Set("volume", "0.8")
first.Set("name", "line one\nline=two \\ back\r")
first.Set("=odd#key", "#value")
first.Set("#hash", "")
first.Set("セーブ", "スロット 1")
Print("{first.IsChanged()} {File.Exists(first.Location)}")
Try first.Save()
Print("{first.IsChanged()} {File.Exists(first.Location)}")
For line In Try File.ReadLines(first.Location)
    Print("  {line}")
End For

Print("a second run")
Local second = Try Preferences("Größe Game", root)
Print("{second.Keys()} {second.Get("name") == first.Get("name")} [{second.Get("#hash") ?? "none"}]")
Print(
    "{second.Get("=odd#key") ?? "none"} {second.Get("セーブ") ?? "none"} {second.Contains("volume")}")
second.Set("volume", "0.5")
Print("{second.Remove("name")} {second.Remove("name")} {second.Count()} {second.IsChanged()}")
Try second.Save()
Local third = Try Preferences("Größe Game", root)
Print("{third.Get("volume") ?? "none"} {third.Contains("name")}")

// A setting taken out and set again goes last.
Local order = Try Preferences("Order", root)
order.Set("a", "1")
order.Set("b", "2")
order.Remove("a")
order.Set("a", "3")
Print("{order.Keys()}")

Print("what isn't saved is gone")
// Setting what's there already changes nothing.
third.Set("volume", "0.5")
Print("{third.IsChanged()}")
third.Set("volume", "0.1")
third = Try Preferences("Größe Game", root)
Print("{third.Get("volume") ?? "none"}")

Print("a file a person changed")
Try Dir.CreateAll(root / "Edited")
Try File.WriteLines(root / "Edited" / "preferences.txt",
                    ["# a comment", "", "no equals here", "spaced = value ", "x=1=2", "tail=\\",
                     "odd=\\q"],
                    LineEnding.CRLF)
Local edited = Try Preferences("Edited", root)
For key In edited.Keys()
    Print("  [{key}] [{edited.Get(key) ?? ""}]")
End For

edited.Clear()
Try edited.Save()
Print("{(Try Preferences("Edited", root)).Count()} {Try File.ReadLines(edited.Location)}")

// An editor's UTF-8 byte order mark before the first line isn't the first key's.
Try Dir.CreateAll(root / "Marked")
Try File.WriteText(root / "Marked" / "preferences.txt", "\u{FEFF}volume=0.8\nname=x\n")
Local marked = Try Preferences("Marked", root)
Print("{marked.Get("volume") ?? "none"} {marked.Keys()[0].Bytes.Count}")

Print("async")
Local opened = Try Await Preferences.OpenAsync("Größe Game", root)
Print("{opened.Get("volume") ?? "none"}")
opened.Set("async", "yes")
Try Await opened.SaveAsync()
Print("{(Try Preferences("Größe Game", root)).Get("async") ?? "none"} {(Try Await Preferences.OpenAsync("New Game", root)).Count()}")

// A setting changed while SaveAsync writes is still to save, unless the file has it, whichever
// way the two take turns.
Async Function Later(p: Preferences, root: Path) Throws IOError
    Try Await Dir.CreateAllAsync(root)
    Try Await Dir.CreateAllAsync(root)
    p.Set("late", "yes")
End Function

Local racing = Try Preferences("Racing", root)
racing.Set("volume", "0.8")
Local saving = racing.SaveAsync()
Local later = Later(racing, root)
Try Await saving
Try Await later
Local raced = Try Preferences("Racing", root)
Print("{racing.Get("late") ?? "none"} {(raced.Get("late") == Null) == racing.IsChanged()}")

Print("typed")
// Numbers and Bools are kept as the text Parse reads back, and read back as the same value.
Local typed = Try Preferences("Typed", root)
typed.SetInt("lives", 3)
typed.SetInt("most", 9223372036854775807)
typed.SetInt("least", -9223372036854775807 - 1)
typed.SetDouble("volume", 0.1)
typed.SetDouble("huge", 1e300)
typed.SetDouble("tiny", 5e-324)
typed.SetDouble("negative zero", -0.0)
Local nothing = 0.0
typed.SetDouble("nan", nothing / nothing)
typed.SetDouble("infinite", -1.0 / nothing)
typed.SetBool("fullscreen", True)
typed.SetBool("muted", False)
Try typed.Save()
typed.SetInt("lives", 3)
Print("{typed.IsChanged()}")
Print(Try File.ReadText(root / "Typed" / "preferences.txt"))
Local reread = Try Preferences("Typed", root)
Print("{reread.GetInt("lives") ?? -1} {reread.GetInt("most") ?? -1} {reread.GetInt("least") ?? -1}")
Print("{reread.GetDouble("volume") ?? -1.0} {reread.GetDouble("huge") ?? -1.0} {reread.GetDouble("tiny") ?? -1.0}")
Local zero = reread.GetDouble("negative zero") ?? 1.0
Local nan = reread.GetDouble("nan") ?? 1.0
Print("{zero} {1.0 / zero} {nan != nan} {reread.GetDouble("infinite") ?? 0.0}")
Print("{reread.GetBool("fullscreen") ?? False} {reread.GetBool("muted") ?? True}")
// One that isn't there, or isn't one of the type, is Null, or the fallback.
reread.Set("name", "Ada")
reread.Set("lower", "true")
Print("{reread.GetInt("name") == Null} {reread.GetInt("volume") == Null} {reread.GetInt("missing", 7)}")
Print("{reread.GetDouble("lives") ?? -1.0} {reread.GetDouble("name", 2.5)} {reread.GetDouble("missing") == Null}")
Print("{reread.GetBool("lower") == Null} {reread.GetBool("lives", True)} {reread.GetBool("missing", False)}")
Print("{reread.Get("lives") ?? "none"} {reread.Get("muted") ?? "none"}")

Print("errors")
// A file where the app's folder goes holds no settings, on every OS, though a save throws.
Try File.WriteText(root / "Blocked", "a file where the app's folder goes")
Local blocked = Try Preferences("Blocked", root)
Print("{blocked.Count()} {(Try Await Preferences.OpenAsync("Blocked", root)).Count()}")
blocked.Set("a", "b")
Try
    blocked.Save()
Catch e As IOError
    Print("{e.Kind}")
End Try

Print("{blocked.Count()} {blocked.IsChanged()}")
Try Dir.CreateAll(root / "Folder" / "preferences.txt")
Try
    Preferences("Folder", root)
Catch e As IOError
    Print("{e.Kind}")
End Try

// The OS's folder, which the test only looks at the path of.
Local folder = Try Preferences.Folder()
Print("{folder.IsAbsolute()} {folder.Text.Bytes.Contains(92)} {folder.FileName() != ""}")

Try temp.Close()
Print("left {Dir.Exists(root)}")
