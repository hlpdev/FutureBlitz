// std.math.big's Complex matches Python's complex and cmath: +, -, *, and /, by Smith's
// division as Python does, and whole powers, by squaring as Python does, to the last bit; and
// Abs, Arg, Exp, Log, Sqrt, Pow, and FromPolar to 12 digits, as each OS's libm differs in the
// last bits. Like a Double's, its arithmetic never panics: dividing by 0 gives NaN parts.
Import std.core
Import std.math.big

Global checked = 0
Global zero = 0.0

// An infinity, which a Double divided by 0 is.
Function Infinity(): Double => 1.0 / zero

// Counts a check, and says which one failed.
Function Expect(name: String, passed: Bool)
    checked += 1
    If !passed Then Print("{name} failed")
End Function

// Counts a check of what a value shows as, and says what it was when it's another.
Function Check(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// Says how many checks a section made, and starts counting again.
Function Done(section: String)
    Print("{section}: {checked} check{checked == 1 ? "" : "s"}")
    checked = 0
End Function

// Counts a check of a Complex against its parts, exactly.
Function CheckExact(name: String, actual: Complex, real: Double, imaginary: Double)
    checked += 1
    If actual.Real != real || actual.Imaginary != imaginary
        Print("{name}: {actual}, not {Complex(real, imaginary)}")
    End If
End Function

// Counts a check of a Complex against its parts, to 12 digits of the larger one's, as libm's
// functions differ in their last bits from one OS to another.
Function CheckClose(name: String, actual: Complex, real: Double, imaginary: Double)
    checked += 1
    Local scale = Max(Magnitude(real), Magnitude(imaginary))
    Local error = Max(Magnitude(actual.Real - real), Magnitude(actual.Imaginary - imaginary))
    If !(error <= scale * 1.0e-12) Then Print("{name}: {actual}, not {Complex(real, imaginary)}")
End Function

Function Magnitude(value: Double): Double => value < 0.0 ? -value : value

// A NaN, which 0 divided by 0 is.
Function NaN(): Double => zero / zero

// Counts a check of a Complex against its parts, where a NaN is the same as a NaN, a 0 as a 0
// of its sign, an infinity as one of its sign, and other parts are to 12 digits.
Function CheckSame(name: String, actual: Complex, real: Double, imaginary: Double)
    checked += 1
    If !Same(actual.Real, real) || !Same(actual.Imaginary, imaginary)
        Print("{name}: {actual}, not {Complex(real, imaginary)}")
    End If
End Function

Function Same(actual: Double, expected: Double): Bool
    If expected != expected Then Return actual != actual
    If expected == 0.0 Then Return actual == 0.0 && 1.0 / actual == 1.0 / expected
    If expected - expected != 0.0 Then Return actual == expected
    Return Magnitude(actual - expected) <= Magnitude(expected) * 1.0e-12
End Function

