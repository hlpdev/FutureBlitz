Check("shown", "{Complex(1, 2)}", "1+2i")
Check("shown, -0", Complex(1, -0.0).ToString(), "1-0i")
Check("shown, below 0", Complex(0, -1.5).ToString(), "0-1.5i")
Check("shown, real", Complex(-3, 0).ToString(), "-3+0i")
Check("shown, large", Complex(1e300, 1e-300).ToString(), "1e300+1e-300i")
Local nothing = Complex(1, 0) / 0.0
Expect("divided by 0", nothing.Real != nothing.Real && nothing.Imaginary != nothing.Imaginary)
Check("NaN shown", nothing.ToString(), "NaN+NaNi")
Expect("0 to a power", Complex(0, 0).Pow(Complex(2, 0)) == 0.0)
Expect("0 to 0", Complex(0, 0).Pow(Complex(0, 0)) == 1.0)
Local zeroPower = Complex(0, 0).Pow(Complex(-1, 0))
Expect("0 to -1", zeroPower.Real != zeroPower.Real)
Expect("equal to a Double", Complex(1, 0) == 1.0 && 2.0 == Complex(2, 0) && Complex(1, 1) != 1.0)
Expect("hashes", Complex(0.0, 0.0).Hash() == Complex(-0.0, 0.0).Hash() &&
       Complex(1, 2).Hash() == Complex(1, 2).Hash())
Expect("zero and one",
       Complex.Zero() == 0.0 && Complex.One() == 1.0 && Complex.DefaultValue() == 0.0)
Expect("a real Complex", Complex(5) == 5.0)
Done("the rest")

// Near the largest Doubles and among the subnormals, scaled as Python's cmath scales them.
