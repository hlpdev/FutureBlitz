// Only one Receive reads a WebSocket at a time, so a second one while the first waits panics
// where it's called.
Import std.core
Import std.net
Import std.net.ws
Import std.text

// The server's side, once a client connects.
Async Function Served(listener: TcpListener): WebSocket Throws NetError, TimeoutError
    Return Try Await WebSocket.AcceptAsync(Try Await listener.AcceptAsync())
End Function

Try
    Local listener = TcpListener.Listen(SocketAddress(IpAddress.Loopback, 0))
    Local accepted = Served(listener)
    Local ws = Await WebSocket.ConnectAsync("ws://127.0.0.1:{listener.LocalAddress.Port}/")
    Local first = ws.ReceiveAsync()
    ws.Receive()
Catch e As Error
    Print("failed: {e.Message}")
End Try
