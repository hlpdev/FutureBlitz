// ProtoWriter's EndLength panics where it's called for a start that isn't where a BeginLength
// left room for a length, instead of writing over a byte.
Import std.core
Import std.data.protobuf

Local writer = ProtoWriter()
writer.WriteTag(10)
Local start = writer.BeginLength()
writer.WriteVarint(300)
writer.EndLength(start)
Print(writer.Finish())
writer.WriteTag(8)
writer.WriteVarint(1)
writer.EndLength(0)
Print("unreachable {writer.Finish()}")
