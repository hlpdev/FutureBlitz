// A type is an Iterable<T> through an Iterate() that gives what implements Iterator<T>: a
// Struct, which an Iterable<T>'s value or generic code gets in a box, an Iterator<T> object, or
// a Class, whose object is one already. A For ... In goes over each the same way.
Import std.core

Struct Counting Implements Iterator<Int>
    Field at: Int
    Field last: Int

    ByRef Method Next(): Int?
        If at > last Then Return Null
        at += 1
        Return at - 1
    End Method
End Struct

Class Span Implements Iterable<Int>
    Field first: Int
    Field last: Int

    New(first: Int, last: Int)
        Self.first = first
        Self.last = last
    End New

    Method Iterate(): Counting => Counting(first, last)
End Class

Class Countdown Implements Iterator<Int>
    Field left: Int

    New(left: Int)
        Self.left = left
    End New

    Method Next(): Int?
        If left == 0 Then Return Null
        left -= 1
        Return left + 1
    End Method
End Class

Class Down Implements Iterable<Int>
    Field from: Int

    New(from: Int)
        Self.from = from
    End New

    Method Iterate(): Countdown => Countdown(from)
End Class

Function Total(items: Iterable<Int>): Int
    Local total = 0
    For n In items
        total += n
    End For

    Return total
End Function

Function Drained<C: Iterable<Int>>(items: C): Int
    Local source = items.Iterate()
    Local total = 0
    Local n = source.Next()
    While n != Null
        total = total * 10 + n
        n = source.Next()
    End While

    Return total
End Function

Local span = Span(1, 4)
Print("total", Total(span), Total(Down(3)))
Print("drained", Drained(span), Drained(Down(3)), Drained<Iterable<Int>>(span))

// On the type itself, Iterate() gives its own Struct, which a loop goes over a copy of.
Local own = span.Iterate()
For n In own
    Write(n, "")
End For

Print("then", own.Next() ?? -1)

// Through the Interface, the Struct is in a box, which the loop uses up.
Local through: Iterable<Int> = span
Local boxed = through.Iterate()
For n In boxed
    Write(n, "")
End For

Print("then", boxed.Next() ?? -1)

For n In through
    Write(n * 2, "")
End For

Print()

// A box's function passes a ByRef on, so the Method changes the caller's variable.
Interface Sized
    Method Iterate(n: Int, ByRef taken: Int): Iterator<Int>
End Interface

Class Upto Implements Sized
    Method Iterate(n: Int, ByRef taken: Int): Counting
        taken += n
        Return Counting(1, n)
    End Method
End Class

Function Taken<S: Sized>(sized: S, n: Int): Int
    Local taken = 0
    Local total = 0
    For v In sized.Iterate(n, ByRef taken)
        total += v
    End For

    Return total * 100 + taken
End Function

Local upto: Sized = Upto()
Local taken = 0
Local made = upto.Iterate(3, ByRef taken)
Print("taken", taken, made.Next() ?? -1, Taken(upto, 4), Taken(Upto(), 2))

// What overrides a Method that throws, or implements another Interface's, gets an error
// variable, which a box's function and generic code pass, though nothing sets it.
Class Source
    Method Iterate(): Counting Throws Error
        Return Counting(0, -1)
    End Method
End Class

Class Fixed Extends Source Implements Iterable<Int>
    Override Method Iterate(): Counting => Counting(1, 3)
End Class

Interface Risky
    Method Iterate(): Counting Throws Error
End Interface

Struct Bag Implements Iterable<Int>, Risky
    Field last: Int

    Method Iterate(): Counting => Counting(1, last)
End Struct

Class Sack Implements Iterable<Int>, Risky
    Method Iterate(): Counting => Counting(4, 5)
End Class

Local fixed: Iterable<Int> = Fixed()
Local sack: Iterable<Int> = Sack()
Print("error variables", Total(fixed), Drained(Fixed()), Total(sack), Drained(Bag(3)))

// A Method that implements one that throws can give what implements its Iterator<T> too, and its
// error goes on through the box's function.
Class LineError Extends Error
End Class

Interface Lines
    Method Iterate(): Iterator<Int> Throws LineError
End Interface

Class Reader Implements Lines
    Field Broken: Bool

    New(broken: Bool)
        Broken = broken
    End New

    Method Iterate(): Counting Throws LineError
        If Broken Then Throw LineError("can't read")
        Return Counting(1, 2)
    End Method
End Class

Class Calm Implements Lines
    Method Iterate(): Countdown => Countdown(2)
End Class

Function Read(lines: Lines): Int
    Local total = 0
    Try
        For n In lines
            total += n
        End For
    Catch e As LineError
        Return -1
    End Try

    Return total
End Function

Function ReadAny<L: Lines>(lines: L): Int
    Local total = 0
    Try
        For n In lines
            total += n
        End For
    Catch e As LineError
        Return -1
    End Try

    Return total
End Function

Print("lines", Read(Reader(False)), Read(Reader(True)), Read(Calm()), ReadAny(Reader(False)),
      ReadAny(Reader(True)), ReadAny(Calm()))
