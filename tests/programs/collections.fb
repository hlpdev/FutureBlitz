// std/collections: what T[] gets, Map and its literal, Set, Stack, Queue, Deque, PriorityQueue,
// and Pool.

Import std.core
Import std.collections

// T[]: Sort is stable, Remove takes the first equal element, and Filter, Map, and Find take
// functions.
Local nums = [5, 3, 8, 1, 9, 2]
nums.Sort()
Print("{nums}")
Print("{nums.Remove(8)} {nums.Remove(7)} {nums}")
Local words = ["pear", "fig", "apple", "kiwi"]
words.Sort(Function(a: String, b: String) => a.Bytes.Count < b.Bytes.Count)
Print("{words}")
Print("{nums.Filter(Function(n: Int) => n % 2 == 1)}")
Print("{nums.Map(Function(n: Int) => n * 10)} {words.Map(Function(w: String) => w.Bytes.Count)}")
Print("{nums.Find(Function(n: Int) => n > 4) ?? -1} {nums.Find(Function(n: Int) => n > 40) ?? -1}")

// Map: Add replaces an existing key's value, and the entries stay in the order they were added
// until one is removed.
Local hp = Map<String, Int>()
hp.Add("grunt", 50)
hp.Add("boss", 500)
hp.Add("grunt", 60)
Print("{hp.Count} {hp.Get("grunt") ?? -1} {hp.Get("nobody") ?? -1} {hp.Contains("boss")} {hp}")
For name, value In hp
    Print("  {name}: {value}")
End For

Local squares = Map<Int, Int>()
For i = 0 Until 100
    squares.Add(i, i * i)
End For
For i = 0 Until 100 Step 3
    squares.Remove(i)
End For
Local sum = 0
For key, value In squares
    If value != key * key Then Print("wrong at {key}")
    sum += value
End For
Print("{squares.Count} {sum} {squares.Get(4) ?? -1} {squares.Get(3) ?? -1}")
Local big = squares.Filter(Function(k: Int, v: Int) => v > 9000)
Print("{big.Keys()} {big.Values()}")
Local copy = hp.Clone()
copy.Add("imp", 5)
hp.Clear()
Print("{hp.Count} {copy}")

// Map literals take the expected type, or their entries' common types.
Local costs = {"sword": 50, "shield": 30}
Local wide: Map<String, Long> = {"a": 1}
Local none: Map<Int, String> = {}
Print("{costs} {wide} {none} {none.Count} { {1: 1.5, 2: 2} }")

Function Total(prices: Map<String, Int>): Int
    Local total = 0
    For name, price In prices
        total += price
    End For
    Return total
End Function

Print("{Total(costs)} {Total({"x": 1, "y": 2, "z": 3})} {Total({})}")
Local nested = {
    "one": {1: [True]},
    "two": {2: [False, True]},
}
Print("{nested} { {3: 4}.Count }")

Function Single<K, V>(key: K, value: V): Map<K, V>
    Where K: Hashable
    Return {key: value}
End Function

Print("{Single("k", 9)}")

// Set
Local seen = Set<Int>()
For n In [3, 1, 3, 2, 1, 5]
    seen.Add(n)
End For
Print("{seen} {seen.Count} {seen.Contains(2)} {seen.Contains(4)}")
Print("{seen.Add(5)} {seen.Remove(3)} {seen.Remove(3)} {seen}")
Local odd = seen.Filter(Function(n: Int) => n % 2 == 1)
Print("{odd} {seen.Find(Function(n: Int) => n > 1) ?? -1} {seen.Clone().Count}")

// Stack
Local stack = Stack<Int>()
For i = 1 To 5
    stack.Push(i * 10)
End For
Print("{stack.Count} {stack.Peek()} {stack.Pop()} {stack.Pop()} {stack.Count}")
stack.Add(99)
For value In stack
    Print("  {value}")
End For
Print("{stack.Contains(20)} {stack.Contains(50)}")
Local stack2 = stack.Clone()
stack.Clear()
Print("{stack.Count} {stack2.Count}")

// Queue
Local queue = Queue<String>()
For word In ["a", "b", "c", "d", "e"]
    queue.Enqueue(word)
End For
Print("{queue.Dequeue()} {queue.Dequeue()} {queue.Dequeue()} {queue.Peek()} {queue.Count}")
queue.Add("f")
Local text = ""
For word In queue
    text = text + word
End For
Print("{text} {queue.Contains("e")} {queue.Contains("a")}")
Local queue2 = queue.Clone()
While queue.Count > 0
    queue.Dequeue()
End While
Print("{queue.Count} {queue2.Count} {queue2.Dequeue()}")

// Deque
Local deque = Deque<Int>()
deque.AddLast(3)
deque.AddLast(4)
deque.AddFirst(2)
deque.AddFirst(1)
deque.Add(5)
Local order = ""
For value In deque
    order = order + "{value}"
End For
Print("{order} {deque.First()} {deque.Last()}")
Print("{deque.RemoveFirst()} {deque.RemoveFirst()} {deque.RemoveFirst()} {deque.RemoveFirst()} {deque.RemoveFirst()} {deque.Count}")
For i = 1 To 6
    deque.AddFirst(i)
End For
Print("{deque.RemoveLast()} {deque.RemoveLast()} {deque.RemoveFirst()} {deque.Count} {deque.Contains(3)}")

// PriorityQueue: the smallest first, or what a before function says.
Local smallest = PriorityQueue<Int>()
For n In [5, 1, 9, 3, 7, 2, 8]
    smallest.Add(n)
End For
Local sorted = ""
While smallest.Count > 0
    sorted = sorted + "{smallest.Pop()} "
End While
Print(sorted)
Local longest = PriorityQueue<String>(Function(a: String, b: String) => a.Bytes.Count > b.Bytes.Count)
For word In ["fig", "banana", "kiwi", "apple"]
    longest.Add(word)
End For
Print("{longest.Peek()} {longest.Count} {longest.Contains("kiwi")}")
Local longest2 = longest.Clone()
longest.Pop()
Print("{longest.Peek()} {longest2.Peek()}")

// Pool: a Handle finds nothing once its value is removed, even when the slot is reused, and
// removing values while going over them is fine.
Class Enemy
    Field Name: String
    Field HP: Int
End Class

Function Spawn(name: String, hp: Int): Enemy
    Local enemy = Enemy()
    enemy.Name = name
    enemy.HP = hp
    Return enemy
End Function

Local enemies = Pool<Enemy>()
Local grunt = enemies.Add(Spawn("grunt", 10))
Local boss = enemies.Add(Spawn("boss", 100))
Local imp = enemies.Add(Spawn("imp", 5))
Print("{enemies.Count} {enemies.Get(boss)?.Name ?? "gone"}")
enemies.Remove(boss)
Print("{enemies.Count} {enemies.Get(boss)?.Name ?? "gone"} {enemies.Contains(boss)} {enemies.Remove(boss)}")
Local bat = enemies.Add(Spawn("bat", 2))
Print("{bat.Index == boss.Index} {enemies.Get(boss)?.Name ?? "gone"} {enemies.Get(bat)?.Name ?? "gone"}")
For enemy In enemies
    If enemy.HP < 6 Then enemies.Remove(imp)
    Print("  {enemy.Name}")
End For
Print("{enemies.Count}")
enemies.Clear()
Print("{enemies.Count} {enemies.Get(grunt)?.Name ?? "gone"}")
Local points = Pool<Int>()
Local point = points.Add(1)
points.Set(point, 2)
Print("{points.Get(point) ?? -1}")

// A Handle's zero names no value: a Pool's generations start at 1.
Class Keeper
    Field h: Handle<String>
End Class

Local named = Pool<String>()
named.Add("first")
Local kept = Keeper()
Local found = named.Get(kept.h) ?? "none"
Print("{named.Contains(kept.h)} {found}")
