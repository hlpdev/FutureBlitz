// Parse reads the numbers and Bools that Format writes, giving Null for text that isn't one or a
// number too big for its type, in any base from 2 to 36. Every Float64's shortest text reads back
// as itself, bit for bit.
Import std.core

Function Shown<T: Printable>(value: T?): String => value == Null ? "-" : "{value}"

Print("{Shown(Int.Parse("42"))} {Shown(Int.Parse("-42"))} {Shown(Int.Parse("+7"))} " +
      "{Shown(Int.Parse("ff", 16))} {Shown(Int.Parse("0xff", 16))} {Shown(Int.Parse("-0b101", 2))} " +
      "{Shown(Int.Parse("zz", 36))} {Shown(Int.Parse("0o17", 8))}")

// Text that isn't an integer, or one that doesn't fit.
Print("{Shown(Int.Parse(""))} {Shown(Int.Parse(" 1"))} {Shown(Int.Parse("1 "))} " +
      "{Shown(Int.Parse("1_000"))} {Shown(Int.Parse("1,000"))} {Shown(Int.Parse("--1"))} " +
      "{Shown(Int.Parse("0x"))} {Shown(Int.Parse("ff"))} {Shown(Int.Parse("2147483648"))} " +
      "{Shown(Int.Parse("-2147483648"))}")
Print("{Shown(Int8.Parse("127"))} {Shown(Int8.Parse("128"))} {Shown(Int8.Parse("-128"))} " +
      "{Shown(Int16.Parse("-32769"))} {Shown(Int64.Parse("-9223372036854775808"))} " +
      "{Shown(Int64.Parse("9223372036854775808"))}")
Print("{Shown(UInt8.Parse("255"))} {Shown(UInt8.Parse("256"))} {Shown(UInt16.Parse("-1"))} " +
      "{Shown(UInt32.Parse("4294967295"))} {Shown(UInt64.Parse("18446744073709551615"))} " +
      "{Shown(UInt64.Parse("18446744073709551616"))} {Shown(UInt64.Parse("FFFFFFFFFFFFFFFF", 16))}")

Print("{Shown(Float64.Parse("0.1"))} {Shown(Float64.Parse("-2.5e-3"))} {Shown(Float64.Parse("1E21"))} " +
      "{Shown(Float64.Parse(".5"))} {Shown(Float64.Parse("NaN"))} {Shown(Float64.Parse("Inf"))} " +
      "{Shown(Float64.Parse("-Inf"))} {Shown(Float64.Parse("+Inf"))} {Shown(Float64.Parse("1e999"))}")
Print(
    "{Shown(Float64.Parse("nan"))} {Shown(Float64.Parse("inf"))} {Shown(Float64.Parse("1.5x"))} " +
    "{Shown(Float64.Parse(""))} {Shown(Float64.Parse("-"))} {Shown(Float64.Parse("+-1"))} " +
    "{Shown(Float64.Parse("-NaN"))} {Shown(Float64.Parse("1,5"))}")
Local tenth = Float.Parse("0.1") ?? 0
Print(
    "{tenth} {Float.Parse("3.4e38") ?? -1} {Float.Parse("3.5e38") ?? -1} {Float.Parse("x") ?? -1}")
Print("{Bool.Parse("True") ?? False} {Bool.Parse("False") ?? True} {Bool.Parse("true") == Null}")

// An integer reads back from each base Format writes it in.
Local trips = 0
For n In [0, 1, -1, 255, -4096, 2147483647, -2147483648]
    Local hex = Int.Parse("{n:x}", 16) ?? 0
    Local prefixed = Int.Parse("{n:#b}", 2) ?? 0
    If hex == n && prefixed == n Then trips += 1
End For

Print("integers {trips}")

// Float64s from random bits, and the edges, read back exactly from their shortest text.
Global state: UInt64 = 88172645463325252

Function NextBits(): UInt64
    state = state ^ (state << 13)
    state = state ^ (state >> 7)
    state = state ^ (state << 17)
    Return state
End Function

Function FloatOf(bits: UInt64): Float64
    Local held = bits
    Unsafe
        Return (AddressOf(held) As Ptr<Float64>).Value
    End Unsafe
End Function

Function BitsOf(value: Float64): UInt64
    Local held = value
    Unsafe
        Return (AddressOf(held) As Ptr<UInt64>).Value
    End Unsafe
End Function

Function ReadsBack(value: Float64): Bool
    Local read = Float64.Parse("{value}")
    If read == Null Then Return False
    If value != value Then Return read != read
    Return BitsOf(read) == BitsOf(value)
End Function

Local edges: Float64[] = [0, -0.0, 0.1, 1 / 3.0, 5e-324, 2.2250738585072014e-308,
                          1.7976931348623157e308, 0.30000000000000004, 1e21, 1e-7,
                          123456789012345680]
Local exact = 0
For value In edges
    If ReadsBack(value) Then exact += 1
End For

Local wrong = 0
For i = 1 To 20000
    If !ReadsBack(FloatOf(NextBits())) Then wrong += 1
End For

Print("edges {exact} of {edges.Count}, random ones wrong {wrong}")

// A float too small for its type reads as 0, the nearest one, and only one too big is Null; -0
// is 0, which an unsigned integer holds.
Print(Shown(Float64.Parse("1e-400")), Shown(Float64.Parse("2e-324")),
      Shown(Float64.Parse("3e-324")),
      Shown(Float64.Parse("1e400")))
Print(Shown(Float32.Parse("1e-50")), Shown(Float32.Parse("1e-46")), Shown(Float32.Parse("1e-45")),
      Shown(Float32.Parse("1e39")))
Print(Shown(UInt64.Parse("-0")), Shown(UInt8.Parse("+0")), Shown(Int.Parse("-0")),
      Shown(UInt8.Parse("-1")))
