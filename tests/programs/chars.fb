// Chars: Unicode scalar values, which character literals and a String's Chars give, compared by
// their codes, shown as themselves, and used as keys and in a Select.
Import std.core
Import std.collections

Local letter = 'a'
Local face = '\u{1F600}'
Print(letter, face, 'é', letter < 'b', letter == 'a', 'z' > letter)
Print("{letter}{face} {letter As Int} {face As UInt32} {98 As Char}")

// A String's Chars are its code points, whatever their UTF-8 bytes.
Local chars = "héllo 😀".Chars
Print(chars, chars.Count, chars[1], "e\u{301}".Chars.Count)

// A Char is Hashable and Comparable.
Local seen = Set<Char>()
For c In "banana".Chars
    seen.Add(c)
End For

Local counts = { 'a': 1 }
counts['b'] = 2
Print(seen.Count, seen.Contains('n'), counts['b'], Max('a', 'c'), Min(face, letter))

Function Kind(c: Char): String
    Select c
        Case 'a' To 'z'
            Return "lower"
        Case '0' To '9'
            Return "digit"
        Case ' '
            Return "space"
        Default
            Return "other"
    End Select
End Function

Print(Kind('q'), Kind('5'), Kind(' '), Kind('Ä'))

// A Char starts at U+0000, and a fixed array of them is a value.
Local blank: Char[2]
Local letters: Char[3] = ['x', 'y', 'z']
Print(blank[0] As Int, letters)

// An Attribute can take a Char, with a default.
Attribute Mark(Sign: Char = '-')

@Mark('✓') Struct Done
End Struct

@Mark Struct Todo
End Struct

Print(Done.Attribute(Mark)?.Sign ?? '?', Todo.Attribute(Mark)?.Sign ?? '?')
