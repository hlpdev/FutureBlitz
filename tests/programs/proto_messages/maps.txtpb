sint64_float { key: -9223372036854775808 value: 0.25 }
fixed32_bytes { key: 7 value: "\377" }
fixed64_mood { key: 8 value: SAD }
sfixed32_leaf { key: -9 value { weight: 4 back { name: "in a map" } } }
sfixed64_sint64 { key: -10 value: -11 }
