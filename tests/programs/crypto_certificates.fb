                  "-----END CERTIFICATE-----\n"
Try
    Local signed = Certificate.FromPem(signedPem)
    Check("RSA-signed subject", signed.Subject, "CN=ed-subject")
    Check("RSA-signed issuer", signed.Issuer, "CN=rsa-ca")
    Expect("RSA-signed key",
           signed.PublicKey?.Kind == KeyKind.ED25519 &&
           signed.PublicKey?.Bytes ==
           Unhex("d764e37538eedbb404f925e07af52b848239fe70c0a45fb27cbaed262a8e0bf8"))
Catch e As ParseError
    Print("RSA-signed: {e.Message}")
End Try
Done("openssl's")

