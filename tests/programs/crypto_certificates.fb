// std.crypto's Certificate reads certificates of Ed25519 keys, which mbedTLS's X.509 doesn't,
// and writes their names as text, as Python's ssl and openssl -nameopt utf8 show them, in the
// certificate's order: UTF8String, T61String as Latin-1, BMPString as UTF-16 (a surrogate pair
// too), UniversalString as UTF-32, values of more than one part, names of any length, RFC 4514's
// escapes, and an attribute std.crypto has no name for as its OID. openssl made the certificates
// but the last two, which are built here as DER, with no signature, which Certificate doesn't
// check.
Import std.core
Import std.collections
Import std.crypto

Global checked = 0

// The bytes of hex digits.
Function Unhex(text: String): UInt8[]
    Local bytes: UInt8[] = []
    Local high = -1
    For c In text.Bytes
        Local code = c As Int
        Local digit = code <= 57 ? code - 48 : code - 87
        If high < 0
            high = digit
        Else
            bytes.Add((high * 16 + digit) As UInt8)
            high = -1
        End If
    End For
    Return bytes
End Function

// Counts a check, and says which one failed.
Function Expect(name: String, passed: Bool)
    checked += 1
    If !passed Then Print("{name} failed")
End Function

// Counts a check of text, and says what it was when it's another.
Function Check(name: String, actual: String, expected: String)
    checked += 1
    If actual != expected Then Print("{name}: {actual}, not {expected}")
End Function

// Prints how many checks a section made, and starts the count again.
Function Done(section: String)
    Print("{section}: {checked} check{checked == 1 ? "" : "s"}")
    checked = 0
End Function

// Counts 8 checks of a certificate: its names, serial number, validity, key, and DER.
Function CheckCertificate(name: String, pem: String, subject: String, issuer: String,
                          serial: String, notBefore: String, notAfter: String, kind: KeyKind?,
                          key: String)
    Try
        Local certificate = Certificate.FromPem(pem)
        Check("{name} subject", certificate.Subject, subject)
        Check("{name} issuer", certificate.Issuer, issuer)
        Check("{name} serial", certificate.SerialNumber, serial)
        Check("{name} not before", certificate.NotBefore, notBefore)
        Check("{name} not after", certificate.NotAfter, notAfter)
        Expect("{name} key kind", certificate.PublicKey?.Kind == kind)
        Expect("{name} key", key == "" || certificate.PublicKey?.Bytes == Unhex(key))
        Expect("{name} DER", certificate.Der.Count > 0)
    Catch e As ParseError
        Print("{name}: {e.Message}")
        checked += 8
    End Try
End Function

