// readings.fb's feed: the readings as a JSON document, served over HTTPS by an HttpServer of its
// own, through ListenTls with the test certificate for 127.0.0.1.

Import std.core
Import std.crypto
Import std.data
Import std.net
Import std.net.http
Import "./certificates"
Import "./source"

// A reading in the document: its hour, and how warm it was.
Public Struct Hourly
    Public Field Hour: Int
    Public Field Celsius: Double
End Struct

// A city's readings in the document.
Public Struct CityFeed
    Public Field Name: String
    Public Field Hours: Hourly[]
End Struct

// The document: each city's readings.
Public Struct Feed
    Public Field Cities: CityFeed[]
End Struct

// The document of readings, each city's in the order they come.
Public Function FeedOf(readings: Reading[]): Feed
    Local cities: CityFeed[] = []
    For reading In readings
        If cities.Count == 0 || cities[cities.Count - 1].Name != reading.City
            cities.Add(CityFeed(reading.City, []))
        End If

        cities[cities.Count - 1].Hours.Add(Hourly(reading.Hour, reading.Celsius))
    End For

    Return Feed(cities)
End Function

// The readings in a document, one after another.
Public Function ReadingsOf(feed: Feed): Reading[]
    Local readings: Reading[] = []
    For city In feed.Cities
        For hourly In city.Hours
            readings.Add(Reading(city.Name, hourly.Hour, hourly.Celsius))
        End For
    End For

    Return readings
End Function

// The test CA's certificate, which a client trusts to fetch the feed.
Public Function TestRoots(): Certificate[]
    Return (Try? Certificate.AllFromPem(ca_pem)).Expect("the test CA's certificate reads")
End Function

// The test certificate for 127.0.0.1 and its key, which the program's servers serve HTTPS with.
Public Function TestServer(): TlsServer
    Local chain = (Try? Certificate.AllFromPem(localhost_pem)).Expect("the certificate reads")
    Local key = (Try? Key.FromPem(localhost_key)).Expect("the test's key reads")
    Return TlsServer(chain, key)
End Function

// How many requests the feed has answered, which its route counts, apart from the server, which
// holds the route.
Class Answered
    Field Value: Int
End Class

// The feed's HTTPS server, at 127.0.0.1, on a port the OS picks, which answers a GET of
// /readings.json with the document.
Public Class FeedServer
    Field Server: HttpServer
    Field Counted: Answered

    New(server: HttpServer, counted: Answered)
        Server = server
        Counted = counted
    End New

    // A server of feed's JSON, listening.
    Public Static Method Start(feed: Feed): FeedServer Throws NetError
        Local document = Json.Write(feed)
        Local counted = Answered()
        Local server = HttpServer()
        server.Get("/readings.json", Function(request: HttpRequest) => Answer(document, counted))
        Try server.ListenTls(SocketAddress(IpAddress.Loopback, 0), TestServer())
        Return FeedServer(server, counted)
    End Method

    // Where the document is.
    Public Property Url: String
        Get => "https://127.0.0.1:{Server.LocalAddress.Port}/readings.json"
    End Property

    // How many requests it's answered.
    Public Property Served: Int
        Get => Counted.Value
    End Property

    // Serves until Stop.
    Public Async Method Serve()
        Await Server.Serve()
    End Method

    // Stops serving.
    Public Method Stop()
        Server.Stop()
    End Method
End Class

// The document's response, counted.
Async Function Answer(document: String, counted: Answered): HttpResponse
    counted.Value += 1
    Return HttpResponse.Of(Body.Json(document))
End Function
