// A :name's name is letters, digits, and '_', so an empty one panics where it's added.
Import std.core
Import std.net
Import std.net.http

Function Ok(request: HttpRequest): Task<HttpResponse> => Done()
Async Function Done(): HttpResponse => HttpResponse.Of(204)

Local server = HttpServer()
server.Get("/users/:", Function(request: HttpRequest) => Ok(request))
