// A routes Class's Method with a route's attribute that takes a Struct and a program's own
// HttpRequest, not std's, isn't a route, though its type has std's name, so Routes panics where
// it's called.
Import std.core
Import std.net.http

Struct Id
    Field Id: Int
End Struct

Struct HttpRequest
    Field Text: String = ""
End Struct

Class Own
    @Get("/own/:id")
    Async Method Show(args: Id, request: HttpRequest): HttpResponse => HttpResponse.Of(204)
End Class

Local server = HttpServer()
server.Routes(Own())
