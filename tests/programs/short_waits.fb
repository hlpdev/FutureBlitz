// A short timed wait lasts about as long as it says, not a tick of Windows's timer, 15.6 ms: of 20
// waits of 1 ms, the fastest is under 8 ms, half a tick, where each was a tick or more, for Sleep
// with a Cancellation, a Selector's Timeout, Timer.After, and ReceiveAsync, so a loaded machine,
// which can make most of them late, can't decide it; and a 50 ms one still waits all of it. On
// Linux and macOS it passed before too, as their waits had no ticks.
Import std.core
Import std.time
Import std.net
Import std.concurrent

Function Waited(begun: Instant): Double => (Instant.Now() - begun).TotalMilliseconds

// Whether the fastest wait took under 8 ms.
Function Quickly(waits: Double[]): Bool
    For wait In waits
        If wait < 8 Then Return True
    End For
    Return False
End Function

Function All(started: Instant, time: Duration): Bool => Instant.Now() - started >= time

Local cancel = Cancellation()
Local slept: Double[] = []
For i = 0 Until 20
    Local begun = Instant.Now()
    Try Sleep(1.Milliseconds, cancel)
    slept.Add(Waited(begun))
End For

Print("Sleep with a Cancellation at 1 ms, 20 times, quickly:", Quickly(slept))
Local started = Instant.Now()
Try Sleep(50.Milliseconds, cancel)
Print("and at 50 ms, all of it:", All(started, 50.Milliseconds))

Local channel = Channel<Int64>(4)
Local timedOut = 0
Local selected: Double[] = []
For i = 0 Until 20
    Local begun = Instant.Now()
    Local _waited = Selector().On(channel, Function(x: Int64)
    End Function).Timeout(1.Milliseconds, Function()
        timedOut += 1
    End Function).Wait()
    selected.Add(Waited(begun))
End For

Print("a Selector's Timeout at 1 ms, 20 times:", timedOut, "timed out, quickly:",
      Quickly(selected))

// Each wait's milliseconds.
Async Function Afters(time: Duration, count: Int): Double[]
    Local waits: Double[] = []
    For i = 0 Until count
        Local begun = Instant.Now()
        Await Timer.After(time)
        waits.Add(Waited(begun))
    End For

    Return waits
End Function

Print("Timer.After at 1 ms, 20 times, quickly:", Quickly(Await Afters(1.Milliseconds, 20)))
Print("and at 50 ms, all of it:", (Await Afters(50.Milliseconds, 1))[0] >= 50)

// Each wait's milliseconds.
Async Function Receives(udp: UdpSocket, time: Duration, count: Int): Double[] Throws NetError
    Local waits: Double[] = []
    For i = 0 Until count
        Local begun = Instant.Now()
        Try
            Local _got = Try Await udp.ReceiveAsync(time)
        Catch e As TimeoutError
        End Try
        waits.Add(Waited(begun))
    End For

    Return waits
End Function

Local udp = Try UdpSocket.Bind(SocketAddress(IpAddress.Loopback, 0))
Print("ReceiveAsync at 1 ms, 20 times, quickly:",
      Quickly(Try Await Receives(udp, 1.Milliseconds, 20)))
Print("and at 50 ms, all of it:", (Try Await Receives(udp, 50.Milliseconds, 1))[0] >= 50)
udp.Close()
