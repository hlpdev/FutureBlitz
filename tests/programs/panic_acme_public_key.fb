// A certificate signing request's key is a private key, which signs it, not a public one. It
// panics where Acme.CertificateRequest is called.
Import std.core
Import std.collections
Import std.crypto
Import std.net.acme
Import std.text

Local bytes: UInt8[] = []
For i = 1 To 32
    bytes.Add(i As UInt8)
End For

Local key = Key(KeyKind.ECDSA_P256, True, bytes)
Print(Acme.CertificateRequest(key, ["example.com"]).Count)
Acme.CertificateRequest(Key(KeyKind.ECDSA_P256, False, EcdsaP256.PublicKeyOf(bytes)),
                        ["example.com"])
Print("unreachable")
