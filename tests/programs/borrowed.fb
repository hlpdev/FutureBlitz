// A call has its own reference to what it's given through a Global, a field, or an element, so
// the callee can replace where that came from and still use it: Self, an argument, a function
// value, and a Scheduler that a coroutine replaces while it ticks.
Import std.core

Class Node
    Field name: String
    Field items: Int[]

    New()
        items = [1, 2, 3]
    End New

    Method Replace()
        current = Node()
        current.name = "new"
        Local junk: String[] = []
        For i = 1 To 100
            junk.Add("junk {i}")
        End For
        items.Add(4)
        Print("still {name} with {items.Count} items")
    End Method

    Method Destroy()
        Print("{name} goes")
    End Method
End Class

Global current = Node()
current.name = "old" + "!"
current.Replace()
Print("after Replace: {current.name}")

// An argument, and a String.
Global title = "old" + " title"

Function Use(n: Node, t: String)
    current = Node()
    current.name = "newer"
    title = "new" + " title"
    Print("still {n.name}, {t}")
End Function

Use(current, title)
Print("after Use: {current.name}, {title}")

// Self through a field, after '?.'.
Class Holder
    Field node: Node?
End Class

Function Run(holder: Holder)
    holder.node?.Replace()
End Function

Local holder = Holder()
holder.node = current
current = Node()
current.name = "held"
Run(holder)

// A function value that replaces the object holding it while it runs.
Class Button
    Field label: String
    Field click: Func(): String

    New(label: String, click: Func(): String)
        Self.label = label
        Self.click = click
    End New
End Class

Function Other(): String => "other"

Function Clicked(): String
    Local was = button.label
    button = Button("second", Other)
    Return "clicked " + was
End Function

Global button = Button("first", Clicked)
Print(button.click())
Print("after click: {button.label}")

// A coroutine replaces the Scheduler ticking it, whose waiting coroutines go with it.
Global gameplay = Scheduler()

Async Function Dropper()
    Await NextFrame()
    Print("dropper replaces the Scheduler")
    gameplay = Scheduler()
    Await NextFrame()
    Print("never: the old Scheduler is gone")
End Function

gameplay.Run(Dropper())
gameplay.Tick(0.1)
gameplay.Tick(0.1)
Print("idle {gameplay.IsIdle()}")

// What a ByRef parameter or a Struct's ByRef Self holds is where the caller keeps it, so passing
// it on, or assigning it, holds a reference of its own too.
Class Named
    Field name: String

    New(name: String)
        Self.name = name
    End New

    Method Destroy()
        Print("{name} goes")
        If name == "swapper" Then shown = Named("replacement")
    End Method
End Class

Global shown = Named("shown")
Global words: String[] = []

Function Show(n: Named, t: String)
    shown = Named("other")
    title = "other" + " title"
    For i = 1 To 50
        words.Add("junk {i}")
    End For
    Print("showing {n.name}, {t}")
End Function

Function PassOn(ByRef n: Named, ByRef t: String)
    Show(n, t)
End Function

PassOn(ByRef shown, ByRef title)

Struct Label
    Field text: String

    ByRef Method Pass()
        Shout(text)
    End Method
End Struct

Global label = Label("first" + " label")

Function Shout(t: String)
    label = Label("second" + " label")
    For i = 1 To 50
        words.Add("junk {i}")
    End For
    Print("{t}!")
End Function

label.Pass()

// Letting go of spare's old value replaces shown, which n is.
Global spare = Named("swapper")

Function Take(ByRef n: Named)
    spare = n
    Print("took {spare.name}")
End Function

shown = Named("taken")
Take(ByRef shown)
Print("now {shown.name} and {spare.name}")
