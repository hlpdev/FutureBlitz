// A routes Class's Method with a route's attribute that takes a number, which Load doesn't make
// from the Object of a request's values, so every request would be a 400, isn't a route, so
// Routes panics where it's called.
Import std.core
Import std.net.http

Class Numbered
    @Get("/int")
    Async Method Show(n: Int): HttpResponse => HttpResponse.Of(204)
End Class

Local server = HttpServer()
server.Routes(Numbered())
