// A millisecond's RealWait, or Sleep, a hundred times over takes about a tenth of a second on
// every OS, though Windows' own sleep waits for its 15.6 ms timer tick, which would make it 1.56 s.

Import std.core
Import std.time

Function Report(name: String, took: Duration)
    If took < 300.Milliseconds
        Print("{name}: under 300 ms")
    Else
        Print("{name}: {took}")
    End If
End Function

Local waits = Stopwatch.StartNew()
For i = 0 Until 100
    Await RealWait(1.Milliseconds)
End For

Report("RealWait", waits.Elapsed)
Local sleeps = Stopwatch.StartNew()
For i = 0 Until 100
    Sleep(1.Milliseconds)
End For

Report("Sleep", sleeps.Elapsed)
