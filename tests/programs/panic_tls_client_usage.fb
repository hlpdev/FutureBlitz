// A TLS client's certificate is for a TLS client, as its usages say, or a server refuses it,
// which net_tls/make_certificates.sh made of the test server's. It panics where Identify is
// called.
Import std.core
Import std.crypto
Import std.net

Const localhost_pem = """
    -----BEGIN CERTIFICATE-----
    MIIB2zCCAYGgAwIBAgIUedQoeu28tAH+KsyVFoglnoyivrAwCgYIKoZIzj0EAwIw
