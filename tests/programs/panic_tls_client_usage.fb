Const localhost_key = """
    -----BEGIN PRIVATE KEY-----
    MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgwSq6ch29gVt0kPGc
    B3MlKevgUpI+uSyrqIVmZX+JjU+hRANCAATvwZ4xcRhsU0HQ1+VmjYBs2N1qXLrT
    U+rn4HapqXi1bDWYPLHzvsrdeqBmCI32pw0ff4u1aU+57H9pFxXwZM8A
    -----END PRIVATE KEY-----
    """

Const client_pem = """
    -----BEGIN CERTIFICATE-----
    MIIBuTCCAV+gAwIBAgIUGr/0bcD9h+3trkbAh9tlX+n60NYwCgYIKoZIzj0EAwIw
    HjEcMBoGA1UEAwwTRnV0dXJlQmxpdHogVGVzdCBDQTAgFw0yMDAxMDEwMDAwMDBa
    GA8yMTIwMDEwMTAwMDAwMFowIjEgMB4GA1UEAwwXRnV0dXJlQmxpdHogVGVzdCBD
    bGllbnQwWTATBgcqhkjOPQIBBggqhkjOPQMBBwNCAATj3/1ZqfFdGzrRCiBNZ5Y1
    8ipbwQETO+/gLHp+eWu7Oq/TtyS47jMm+jC7rHynJqIkJMh1PdADanu6lHEQmgna
    o3UwczAMBgNVHRMBAf8EAjAAMA4GA1UdDwEB/wQEAwIFoDATBgNVHSUEDDAKBggr
    BgEFBQcDAjAdBgNVHQ4EFgQUdUg7P3CkhRBW0FeZtaPf9+kJ6WcwHwYDVR0jBBgw
    FoAU5OOZ+o4p+bby7LPPDTkaoUVF9EQwCgYIKoZIzj0EAwIDSAAwRQIgT6scoH8W
    EcK3Yt4YCMs05IDSiTkRok333lYkM2Pxqj8CIQC2PdoepUp+/YfXIVozLk3nbDv8
    z8CxMAXbfA11A7Li0A==
    -----END CERTIFICATE-----
    """

Const client_key = """
    -----BEGIN PRIVATE KEY-----
    MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgHTTtpF5dmVyApoz6
    7NRooSx8eOWF7gOTtLpLi2QWLjyhRANCAATj3/1ZqfFdGzrRCiBNZ5Y18ipbwQET
    O+/gLHp+eWu7Oq/TtyS47jMm+jC7rHynJqIkJMh1PdADanu6lHEQmgna
    -----END PRIVATE KEY-----
    """

Local client = TlsClient()
client.Identify(Try Certificate.AllFromPem(client_pem), Try Key.FromPem(client_key))
Print("a client's certificate")
client.Identify(Try Certificate.AllFromPem(localhost_pem), Try Key.FromPem(localhost_key))
Print("unreachable")
