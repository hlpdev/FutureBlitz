// A Statement's Bind panics where it's called with a number none of its parameters has.
Import std.core
Import std.db

Try
    Local db = Database.Open(":memory:")
    Local statement = db.Prepare("SELECT ?, ?")
    statement.Bind(2, "two")
    Print(statement.Rows()[0].Text(1) ?? "")
    statement.Bind(3, "three")
Catch e As DatabaseError
    Print(e.Message)
End Try
