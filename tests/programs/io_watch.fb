// FileWatcher, in a temporary folder: making, changing, renaming, and removing a file in a
// watched folder, and changing a watched file, each come as their events. OSes tell of more
// than these, and at their own times, so each check waits, for ten seconds at most, until the
// event it's after comes, and prints only whether it did.
Import std.core
Import std.io
Import std.time

Local temp = Try TempDir("fb-watch-")
Local root = temp.Path

// Whether each of `wanted`'s kinds comes for its file's name, among what `watcher` tells of,
// within ten seconds.
Async Function Saw(watcher: FileWatcher, wanted: (FileEventKind, String)[]): Bool
    Local left = wanted.Clone()
    For tries = 1 To 1000
        Loop
            Local event = watcher.TryNext()
            If event == Null Then Break
            For i = 0 Until left.Count
                If left[i].0 == event.Kind && left[i].1 == event.Path.FileName()
                    left.RemoveAt(i)
                    Break
                End If
            End For

            If left.Count == 0 Then Return True
        End Loop

        Await RealWait(10.Milliseconds)
    End For

    Return False
End Function

// The first event `watcher` tells of for the file `name` within ten seconds, or Null.
Async Function Found(watcher: FileWatcher, name: String): FileEvent?
    For tries = 1 To 1000
        Loop
            Local event = watcher.TryNext()
            If event == Null Then Break
            If event.Path.FileName() == name Then Return event
        End Loop

        Await RealWait(10.Milliseconds)
    End For

    Return Null
End Function

// Takes what's come, so the next check only sees what follows.
Function Drain(watcher: FileWatcher)
    While watcher.TryNext() != Null
    End While
End Function

Local folder = Try FileWatcher(root)
Print("{folder.Path == root} {folder.TryNext() == Null}")
Local save = root / "größe.txt"
Try File.WriteText(save, "one")
Print("created {Await Saw(folder, [(FileEventKind.CREATED, "größe.txt")])}")
Await RealWait(200.Milliseconds)
Drain(folder)
Try File.AppendText(save, " two")
Print("changed {Await Saw(folder, [(FileEventKind.CHANGED, "größe.txt")])}")
Await RealWait(200.Milliseconds)
Drain(folder)
Try File.Move(save, root / "セーブ.txt")
Local renamed = [(FileEventKind.REMOVED, "größe.txt"), (FileEventKind.CREATED, "セーブ.txt")]
Print("renamed {Await Saw(folder, renamed)}")
Drain(folder)
Try File.Delete(root / "セーブ.txt")
Print("removed {Await Saw(folder, [(FileEventKind.REMOVED, "セーブ.txt")])}")

// NextAsync and Next give the next event, whatever it is, and Null once the watcher's closed.
Await RealWait(200.Milliseconds)
Drain(folder)
Try File.WriteText(root / "next.txt", "next")
Local next = Await folder.NextAsync()
Print("next async {next != Null && next.Path.Parent().FileName() == root.FileName()}")
Try File.WriteText(root / "next.txt", "again")
Print("next {folder.Next() != Null}")
folder.Close()
folder.Close()
Print("closed {folder.Next() == Null} {folder.TryNext() == Null} {(Await folder.NextAsync()) == Null}")

// A rename that only changes a name's case is the old spelling's REMOVED and the new one's
// CREATED, on disks that ignore case too.
Try Dir.Create(root / "cases")
Try File.WriteText(root / "cases" / "save.txt", "one")
Local cases = Try FileWatcher(root / "cases")
Try File.Move(root / "cases" / "save.txt", root / "cases" / "SAVE.txt")
Print("case renamed {Await Saw(cases, [(FileEventKind.REMOVED, "save.txt"), (FileEventKind.CREATED, "SAVE.txt")])}")
Drain(cases)
Try File.Delete(root / "cases" / "SAVE.txt")
Print("case removed {Await Saw(cases, [(FileEventKind.REMOVED, "SAVE.txt")])}")
Try File.WriteText(root / "cases" / "save.txt", "two")
Print("case made again {Await Saw(cases, [(FileEventKind.CREATED, "save.txt")])}")
cases.Close()

// A folder watched by a path that ends with a separator gives events whose paths are the
// folder's joined with the names, as Path's Join makes them.
Try Dir.Create(root / "slashed")
Local slashed = Path(root.Text + "/slashed/")
Local endsWithSlash = Try FileWatcher(slashed)
Try File.WriteText(slashed / "a.txt", "a")
Local slashedEvent = Await Found(endsWithSlash, "a.txt")
Print("slashed {slashedEvent != Null && slashedEvent.Path == slashed / "a.txt"}")
endsWithSlash.Close()

// A folder watched by a path from the current folder is still watched once that changes, and
// its events' paths are from the path it was given.
Local before = Try Dir.Current()
Try Dir.CreateAll(root / "one" / "watched")
Try Dir.Create(root / "two")
Try Dir.SetCurrent(root / "one")
Local relative = Try FileWatcher("watched")
Try Dir.SetCurrent(root / "two")
Try File.WriteText(root / "one" / "watched" / "a.txt", "a")
Local relativeEvent = Await Found(relative, "a.txt")
Print("relative {relativeEvent != Null && relativeEvent.Kind == FileEventKind.CREATED} {relativeEvent != Null && relativeEvent.Path.Text == "watched/a.txt"}")
relative.Close()
Try Dir.SetCurrent(before)

// A file's own changes.
Local watched = root / "watched.dat"
Try File.WriteText(watched, "a")
Local one = Try FileWatcher(watched)
Try File.AppendText(watched, "b")
Print("file changed {Await Saw(one, [(FileEventKind.CHANGED, "watched.dat")])}")
one.Close()

// One that's waited for when it's closed gives Null.
Try Dir.Create(root / "quiet")
Local quiet = Try FileWatcher(root / "quiet")
Local waiting = quiet.NextAsync()
quiet.Close()
Print("waiting {(Await waiting) == Null}")

Try
    FileWatcher(root / "missing")
Catch e As IOError
    Print("{e.Kind}")
End Try

// A burst of files, more than the OS keeps room for at once on Windows, still comes as each
// one's CREATED, and then its REMOVED.
Try Dir.Create(root / "burst")
Local burst = Try FileWatcher(root / "burst")
Local made: (FileEventKind, String)[] = []
Local gone: (FileEventKind, String)[] = []
For i = 0 Until 300
    Try File.WriteText(root / "burst" / "file {i}.txt", "x")
    made.Add((FileEventKind.CREATED, "file {i}.txt"))
    gone.Add((FileEventKind.REMOVED, "file {i}.txt"))
End For

Print("burst made {Await Saw(burst, made)}")
For i = 0 Until 300
    Try File.Delete(root / "burst" / "file {i}.txt")
End For

Print("burst gone {Await Saw(burst, gone)}")
burst.Close()

// A watcher the program never closes goes with its last reference, or as the program ends.
Local dropped = Try FileWatcher(root)
dropped = Try FileWatcher(root)
Local kept = Try FileWatcher(root)
Try temp.Close()
Print("left {Dir.Exists(root)}")
