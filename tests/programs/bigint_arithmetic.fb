CheckBig("16+1000000007", n[16] + 1000000007, "933217464696433722066374229221")
CheckBig("1000000007+16", 1000000007 + n[16], "933217464696433722066374229221")
CheckBig("16-1000000007", n[16] - 1000000007, "933217464696433722064374229207")
CheckBig("1000000007-16", 1000000007 - n[16], "-933217464696433722064374229207")
CheckBig("16*1000000007", n[16] * 1000000007, "933217471228955974940410283671619604498")
CheckBig("1000000007*16", 1000000007 * n[16], "933217471228955974940410283671619604498")
CheckBig("16/1000000007", n[16] / 1000000007, "933217458163911514917")
CheckBig("16%1000000007", n[16] % 1000000007, "993624795")
CheckBig("16&1000000007", n[16] & 1000000007, "8389126")
CheckBig("1000000007|16", 1000000007 | n[16], "933217464696433722066365840095")
CheckBig("16^1000000007", n[16] ^ 1000000007, "933217464696433722066357450969")
CheckBig("-7/4", -7 / n[4], "1")
CheckBig("-7%4", -7 % n[4], "0")
Expect("4==-7", (n[4] == -7) == True)
Expect("-7==4", (-7 == n[4]) == True)
Expect("4<-7", (n[4] < -7) == False)
Expect("-7<4", (-7 < n[4]) == False)
Expect("4>-7", (n[4] > -7) == False)
Expect("-7>4", (-7 > n[4]) == False)
Expect("4<=-7", (n[4] <= -7) == True)
Expect("-7<=4", (-7 <= n[4]) == True)
Expect("4>=-7", (n[4] >= -7) == True)
Expect("-7>=4", (-7 >= n[4]) == True)
CheckBig("100/4", 100 / n[4], "-14")
CheckBig("100%4", 100 % n[4], "2")
Expect("4==100", (n[4] == 100) == False)
Expect("100==4", (100 == n[4]) == False)
Expect("4<100", (n[4] < 100) == True)
Expect("100<4", (100 < n[4]) == False)
Expect("4>100", (n[4] > 100) == False)
Expect("100>4", (100 > n[4]) == True)
Expect("4<=100", (n[4] <= 100) == True)
Expect("100<=4", (100 <= n[4]) == False)
Expect("4>=100", (n[4] >= 100) == False)
Expect("100>=4", (100 >= n[4]) == True)
CheckBig("-100/4", -100 / n[4], "14")
CheckBig("-100%4", -100 % n[4], "-2")
Expect("4==-100", (n[4] == -100) == False)
Expect("-100==4", (-100 == n[4]) == False)
Expect("4<-100", (n[4] < -100) == False)
Expect("-100<4", (-100 < n[4]) == True)
Expect("4>-100", (n[4] > -100) == True)
Expect("-100>4", (-100 > n[4]) == False)
Expect("4<=-100", (n[4] <= -100) == False)
Expect("-100<=4", (-100 <= n[4]) == True)
Expect("4>=-100", (n[4] >= -100) == True)
Expect("-100>=4", (-100 >= n[4]) == False)
Expect("-7 != 7", n[4] != 7)
Local total = BigInt(1)
total += 5
total *= n[16]
total -= 1
CheckBig("op=", total, "5599304788178602332392245375283")
Done("with an Int64")

Local factorial = BigInt(1)
For i = 2 To 100
    factorial *= i
End For
CheckBig("100!", factorial, "93326215443944152681699238856266700490715968264381621468592963895217599993229915608941463976156518286253697920827223758251185210916864000000000000000000000000")
Local previous = BigInt(0)
Local current = BigInt(1)
For i = 2 To 1000
    previous, current = (current, previous + current)
End For
CheckBig("F(1000)", current, "43466557686937456435688527675040625802564660517371780402481729089536555417949051890403879840079255169295922593080322634775209689623239873322471161642996440906533187938298969649928516003704476137795166849228875")
CheckBig("2**1000", BigInt(2) ** 1000, "")
CheckBig("3**-0", BigInt(-3) ** 0, "1")
CheckBig("0**0", BigInt(0) ** 0, "1")
CheckBig("-1**big", BigInt(-1) ** 3000000001, "-1")
CheckBig("1**big", BigInt(1) ** 9000000000, "1")
CheckBig("0**big", BigInt(0) ** 9000000000, "0")
CheckBig("0<<big", BigInt(0) << 9000000000, "0")
CheckBig("-5>>big", BigInt(-5) >> 9000000000, "-1")
CheckBig("5>>big", BigInt(5) >> 9000000000, "0")
// A literal expression that only an Int64 holds, beside a BigInt.
CheckBig("10*(1<<40)", BigInt(10) * (1 << 40), "10995116277760")
CheckBig("10*(2e9+2e9)", BigInt(10) * (2_000_000_000 + 2_000_000_000), "40000000000")
Done("known results")
