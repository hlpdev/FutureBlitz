n.Add(B("-"))
n.Add(B("-13639732596332223298"))
n.Add(B("1221031784562967510"))
n.Add(B(""))
n.Add(B("-"))

CheckBig("1+2", n[1] + n[2], "0")
CheckBig("1-2", n[1] - n[2], "2")
CheckBig("1*2", n[1] * n[2], "-1")
CheckBig("1/2", n[1] / n[2], "-1")
CheckBig("1%2", n[1] % n[2], "0")
CheckBig("1&2", n[1] & n[2], "1")
CheckBig("1|2", n[1] | n[2], "-1")
CheckBig("1^2", n[1] ^ n[2], "-2")
Expect("1==2", (n[1] == n[2]) == False)
Expect("1<2", (n[1] < n[2]) == False)
Expect("1>=2", (n[1] >= n[2]) == True)
