// A Class that Load gave up on before it filled every Field is let go of without its Destroy,
// which could read a Field that's still null. One it filled runs its Destroy, as an OnLoaded's
// error lets go of it too.

Import std.core

Class Item
    Field Name: String = "item"
End Class

Class Box
    Field Count: Int
    Field Thing: Item

    New()
        Thing = Item()
    End New

    Method OnLoaded() Throws ParseError
        If Count < 0 Then Throw ParseError(ParseErrorKind.OUT_OF_RANGE, "Count is below 0")
    End Method

    Method Destroy()
        Print("destroying", Count, Thing.Name)
    End Method
End Class

Function Tried(value: Value)
    Try
        Local box = Load<Box>(value)
        Print("loaded", box.Count)
    Catch e As ParseError
        Print(e.Message)
    End Try
End Function

Tried(Value({"Count": Value("x")}))
Tried(Value({"Count": Value(1)}))
Tried(Value({"Count": Value(2), "Thing": Value({"Name": Value("thing")})}))
Tried(Value({"Count": Value(-1), "Thing": Value({"Name": Value("bad")})}))
Print("done")
