        Try h.BindTo(Self, 8)
        Return Try Collect()
    End Method

    // Throws what failed when code isn't 0.
    Method Check(code: Int32) Throws DatabaseError
        If code != 0 Then Throw Failure(Owner.Handle, code)
    End Method

    // Panics when it takes another number of parameters than count.
    @PanicsAtCaller
    Method Expect(count: Int)
        If Parameters != count
            Panic("a value is given for each of the statement's parameters, {Parameters}, not " +
                  "{count}")
        End If
    End Method

    // Runs it to its end, and gets it ready to run again. Panics when its Database is closed.
    @PanicsAtCaller
    Method Run() Throws DatabaseError
        Owner.Connection()
        Defer fb_db_reset(Handle)
        Loop
            Local code = fb_db_step(Handle)
            If code == DONE Then Return
            If code != ROW Then Throw Failure(Owner.Handle, code)
        End Loop
    End Method

    // Runs it to its end, as Run does, and gives each row it read.
    @PanicsAtCaller
    Method Collect(): Row[] Throws DatabaseError
        Owner.Connection()
        Defer fb_db_reset(Handle)
        Local names: String[] = []
        For column = 0 Until fb_db_column_count(Handle)
            names.Add(fb_db_column_name(Handle, column))
        End For
        Local rows: Row[] = []
        Loop
            Local code = fb_db_step(Handle)
            If code == DONE Then Return rows
            If code != ROW Then Throw Failure(Owner.Handle, code)
            Local cells: Cell[] = []
            For column = 0 Until names.Count
                cells.Add(Read(column))
            End For
            rows.Add(Row(names, cells))
        End Loop
    End Method

    // The value of the column at index in the row it's on.
    Method Read(column: Int32): Cell
        Local type = fb_db_column_type(Handle, column)
        Select type
            Case 1
                Return Cell(type, fb_db_column_int(Handle, column), 0, "", Null)
            Case 2
                Return Cell(type, 0, fb_db_column_real(Handle, column), "", Null)
            Case 3
                Return Cell(type, 0, 0, fb_db_column_text(Handle, column), Null)
            Case 4
                Local blob: UInt8[] = []
                fb_db_column_blob(Handle, column, blob)
                Return Cell(type, 0, 0, "", blob)
        End Select
        Return Cell(type, 0, 0, "", Null)
    End Method
End Class

// What Database.Begin gives. What the Database does from then on is kept when it commits, and
// undone when it rolls back, or when it's let go of without a Commit, as when an error leaves the
// code that holds it, so a transaction that fails leaves nothing. One begun while another was
// open is a part of that one: its Commit keeps what it did only as far as that one does, and that
// one's Rollback undoes it too.
Public Class Transaction
    Field Owner: Database
    Field Number: Int64
    Field Level: Int
    // Whether its Commit or Rollback has run.
    Field Ended: Bool

    New(owner: Database, number: Int64, level: Int)
        Owner = owner
        Number = number
        Level = level
    End New

    Method Destroy()
        If IsOpen Then Owner.Undo(Level)
    End Method

    // Whether it's open: not committed or rolled back, by its own Methods, with the Transaction
    // it's a part of, or by SQLite, as some errors do.
    Public Property IsOpen: Bool
        Get
            Owner.Settle()
            Return Owner.Transactions.Count >= Level && Owner.Transactions[Level - 1] == Number
        End Get
    End Property

    // Keeps what it did. Throws a DatabaseError when SQLite can't, and it stays open, as when
    // another connection is reading the database, or when it isn't open. Panics after its Commit
    // or Rollback, or while a Transaction begun inside it is open.
    @PanicsAtCaller
    Public Method Commit() Throws DatabaseError
        If Ended Then Panic("the Transaction has ended already")
        Owner.Connection()
        If !IsOpen
            Throw DatabaseError(DatabaseErrorKind.OTHER, "the transaction was rolled back, by " +
                                "SQLite or with the one it's a part of")
        End If

        If Owner.Transactions.Count > Level
            Panic("a Transaction is committed while one begun inside it is open")
        End If

        Local code = fb_db_run(Owner.Handle, Level == 1 ? "COMMIT" : "RELEASE fb_{Level}")
        If code != 0
            Local failure = Failure(Owner.Handle, code)
            Owner.Settle()
            Throw failure
        End If

        Owner.Transactions.RemoveLast()
        Ended = True
    End Method

    // Undoes what it did, and what each Transaction begun inside it did, or nothing when it isn't
    // open. Panics after its Commit or Rollback.
    @PanicsAtCaller
    Public Method Rollback() Throws DatabaseError
        If Ended Then Panic("the Transaction has ended already")
        Ended = True
        If !IsOpen Then Return
        Local code = Owner.Undo(Level)
        If code != 0 Then Throw Failure(Owner.Handle, code)
    End Method
End Class

// The DatabaseError for SQLite's code, of its kind, with SQLite's message from database.
Function Failure(database: Ptr<Void>, code: Int32): DatabaseError
    If code == HOLDS_NUL
        Return DatabaseError(DatabaseErrorKind.QUERY, "SQL can't hold a NUL, where SQLite stops " +
                             "reading it")
    End If

    Local kind = DatabaseErrorKind.OTHER
    Select code
        Case 19
            kind = DatabaseErrorKind.CONSTRAINT
        Case 5, 6
            kind = DatabaseErrorKind.BUSY
        Case 1, 20, 25
            kind = DatabaseErrorKind.QUERY
        Case 11, 26
            kind = DatabaseErrorKind.CORRUPT
    End Select
    Return DatabaseError(kind, fb_db_message(database))
End Function
