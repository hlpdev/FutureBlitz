//! Text inputs and list views for full-screen terminal apps.
//!
//! std.term's views for full-screen apps, each drawn on a Canvas in a Region, which take the keys
//! and the mouse's events that are theirs: a TextInput, a line of text that's edited as a shell's
//! is, and a ListView, a list of items with one selected, which scrolls to keep it in view.

Import std.core
Import std.text.string
Import std.text.unicode
Import std.term.input
Import std.term.region
Import std.term.screen
Import std.term.style
Import std.term.widgets

/// A line of text being edited, and where its cursor is, a byte position between its grapheme
/// clusters. Prompts' Ask and TextInput edit with it.
Package Class LineEditor
    Package Field Text: String
    Package Field Cursor: Int

    Package New(text: String)
        Text = text
        Cursor = text.Length
    End New

    /// Where each grapheme cluster starts, and the text's end.
    Method Boundaries(): Int[]
        Local boundaries: Int[] = []
        Local at = 0
        For grapheme In Text.Graphemes()
            boundaries.Add(at)
            at += grapheme.Length
        End For

        boundaries.Add(at)
        Return boundaries
    End Method

    /// The boundary before the cursor, or the start.
    Method Before(): Int
        Local found = 0
        For boundary In Boundaries()
            If boundary >= Cursor Then Return found
            found = boundary
        End For

        Return found
    End Method

    /// The boundary after the cursor, or the end.
    Method After(): Int
        For boundary In Boundaries()
            If boundary > Cursor Then Return boundary
        End For

        Return Text.Length
    End Method

    /// Whether the grapheme cluster from start to finish is whitespace.
    Method IsSpace(start: Int, finish: Int): Bool => Text.Slice(start, finish).IsBlank()

    /// The start of the word before the cursor, past the spaces before it.
    Method WordBefore(): Int
        Local boundaries = Boundaries()
        Local i = boundaries.Count - 1
        While i > 0 && boundaries[i] > Cursor
            i -= 1
        End While

        While i > 0 && IsSpace(boundaries[i - 1], boundaries[i])
            i -= 1
        End While

        While i > 0 && !IsSpace(boundaries[i - 1], boundaries[i])
            i -= 1
        End While

        Return boundaries[i]
    End Method

    /// The end of the word after the cursor, past the spaces before it.
    Method WordAfter(): Int
        Local boundaries = Boundaries()
        Local i = 0
        While i < boundaries.Count - 1 && boundaries[i] < Cursor
            i += 1
        End While

        While i < boundaries.Count - 1 && IsSpace(boundaries[i], boundaries[i + 1])
            i += 1
        End While

        While i < boundaries.Count - 1 && !IsSpace(boundaries[i], boundaries[i + 1])
            i += 1
        End While

        Return boundaries[i]
    End Method

    /// Puts text in at the cursor, which goes after it.
    Package Method Insert(text: String)
        Text = Text.Slice(0, Cursor) + text + Text.Slice(Cursor, Text.Length)
        Cursor += text.Length
    End Method

    /// Takes out the text from start to finish, the cursor going to start.
    Method Remove(start: Int, finish: Int)
        Text = Text.Slice(0, start) + Text.Slice(finish, Text.Length)
        Cursor = start
    End Method

    /// Edits as key says, as a shell's line does: Left and Right, by words with Ctrl or Alt;
    /// Home and End, or Ctrl+A and Ctrl+E; Backspace and Delete, a word before with Ctrl+W or
    /// Alt+Backspace; Ctrl+U and Ctrl+K, all before or after the cursor; and a character typed.
    /// Gives whether it was one of those.
    Package Method Handle(key: KeyEvent): Bool
        Local word = key.Modifiers.Has(KeyModifiers.CONTROL) || key.Modifiers.Has(KeyModifiers.ALT)
        Select key.Code
            Case KeyCode.LEFT
                Cursor = word ? WordBefore() : Before()
            Case KeyCode.RIGHT
                Cursor = word ? WordAfter() : After()
            Case KeyCode.HOME
                Cursor = 0
            Case KeyCode.END
                Cursor = Text.Length
            Case KeyCode.BACKSPACE
                Remove(word ? WordBefore() : Before(), Cursor)
            Case KeyCode.DELETE
                Remove(Cursor, After())
            Case KeyCode.CHAR
                If key.IsText
                    Insert("{key.Character}")
                ElseIf key.IsControl('a')
                    Cursor = 0
                ElseIf key.IsControl('e')
                    Cursor = Text.Length
                ElseIf key.IsControl('w')
                    Remove(WordBefore(), Cursor)
                ElseIf key.IsControl('u')
                    Remove(0, Cursor)
                ElseIf key.IsControl('k')
                    Remove(Cursor, Text.Length)
                ElseIf key.Modifiers == KeyModifiers.ALT && key.Character == 'b'
                    Cursor = WordBefore()
                ElseIf key.Modifiers == KeyModifiers.ALT && key.Character == 'f'
                    Cursor = WordAfter()
                Else
                    Return False
                End If
            Default
                Return False
        End Select

        Return True
    End Method

    /// The text before the cursor, to measure where it is.
    Package Method BeforeCursor(): String => Text.Slice(0, Cursor)
End Class

/// A line of text to type in, edited as a shell's line is (see LineEditor's Handle), which Draw
/// shows in a Region's first row, scrolled sideways to keep its cursor in view. A Placeholder
/// shows while it's empty, and a Mask, like "•", in place of each character, as for a password.
///
/// # Examples
///
/// ```
/// Local input = TextInput()
/// input.HandleKey(KeyEvent('h'))
/// input.HandleKey(KeyEvent('i'))
/// input.HandleKey(KeyEvent(KeyCode.BACKSPACE))
/// Expect(input.Text == "h" && input.Cursor == 1)
/// ```
Public Class TextInput
    Field Editor: LineEditor
    /// The first of the text's columns that shows.
    Field Scroll: Int
    /// What shows while it's empty.
    Public Field Placeholder: String
    /// What shows in place of each character, like "•", or "" for the characters themselves.
    Public Field Mask: String
    /// How its text looks, and its placeholder.
    Public Field TextLook: Style
    /// How its placeholder looks.
    Public Field PlaceholderLook: Style

    /// An input holding `text`, its cursor after it.
    Public New(text: String = "")
        Editor = LineEditor(text)
        PlaceholderLook = Style(Attributes: TextAttributes.DIM)
    End New

    /// What's typed; setting it puts the cursor at its end.
    Public Property Text: String
        Get => Editor.Text
        Set(value)
            Editor.Text = value
            Editor.Cursor = value.Length
        End Set
    End Property

    /// Where the cursor is, a byte position in Text.
    Public Property Cursor: Int
        Get => Editor.Cursor
    End Property

    /// Edits it as `key` says, and gives whether the `key` was one it takes.
    Public Method HandleKey(key: KeyEvent): Bool => Editor.Handle(key)

    /// Takes a key, or what's pasted, its line breaks as spaces, and gives whether it took it.
    Public Method HandleEvent(event: InputEvent): Bool
        If event.Kind == InputKind.KEY Then Return Editor.Handle(event.Key)
        If event.Kind != InputKind.PASTE Then Return False
        Editor.Insert(event.Text.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " "))
        Return True
    End Method

    /// Draws it in `area`'s first row, and gives the column its cursor is at, for a Screen's
    /// ShowCursor.
    Public Method Draw(canvas: Canvas, area: Region): Int
        If area.IsEmpty Then Return area.Column
        Local width = area.Width
        canvas.Fill(Region(area.Column, area.Row, width, 1), " ", TextLook)
        If Editor.Text == ""
            Scroll = 0
            canvas.Print(area.Column, area.Row, Truncated(Placeholder, width), PlaceholderLook)
            Return area.Column
        End If

        Local shown = Shown(Editor.Text)
        Local cursor = DisplayWidth(Shown(Editor.BeforeCursor()))
        // The cursor keeps a column for itself at the end, and the text scrolls no further than
        // its end needs, so text that's got shorter shows.
        Scroll = Min(Scroll, Max(DisplayWidth(shown) - width + 1, 0))
        If cursor < Scroll Then Scroll = cursor
        If cursor >= Scroll + width Then Scroll = cursor - width + 1
        Local at = 0
        For grapheme In shown.Graphemes()
            Local columns = DisplayWidth(grapheme)
            If at >= Scroll && at + columns <= Scroll + width
                canvas.Print(area.Column + at - Scroll, area.Row, grapheme, TextLook)
            End If

            at += columns
        End For

        Return area.Column + cursor - Scroll
    End Method

    /// text as it shows: itself, or a Mask for each grapheme cluster.
    Method Shown(text: String): String
        If Mask == "" Then Return text
        Return Mask.Repeated(text.GraphemeCount)
    End Method
End Class

/// A list of Items, one of which is Selected, which Draw shows in a Region, scrolled to keep the
/// selected one in view, with its Marker before it and drawn in SelectedLook, over ItemLook.
/// HandleKey moves the selection with Up, Down, Page Up, Page Down, Home, and End, and
/// HandleMouse with a click or the wheel.
///
/// # Examples
///
/// ```
/// Local list = ListView(["one", "two", "three"])
/// list.HandleKey(KeyEvent(KeyCode.DOWN))
/// Expect(list.Selected == 1 && list.SelectedItem == "two")
/// ```
Public Class ListView
    /// Its items, in order.
    Public Field Items: String[]
    Field Chosen: Int
    /// The first item that shows, and how many rows showed at the last Draw.
    Field Offset: Int
    Field Shown: Int = 1
    /// What's before the selected item, with as many spaces before each other one.
    Public Field Marker: String = "› "
    /// How the items look.
    Public Field ItemLook: Style
    /// How the selected item looks.
    Public Field SelectedLook: Style

    /// A list of `items`, the first selected.
    Public New(items: String[])
        Items = items
        SelectedLook = Style(Attributes: TextAttributes.REVERSE)
    End New

    /// Which item is selected, from 0, or -1 for an empty list. Setting it keeps it in the list.
    Public Property Selected: Int
        Get => Items.Count == 0 ? -1 : Clamp(Chosen, 0, Items.Count - 1)
        Set(value)
            Chosen = Items.Count == 0 ? 0 : Clamp(value, 0, Items.Count - 1)
        End Set
    End Property

    /// The selected item, or Null for an empty list.
    Public Property SelectedItem: String?
        Get => Items.Count == 0 ? Null : Items[Selected]
    End Property

    /// Moves the selection as `key` says, and gives whether it was one of its keys, which an empty
    /// list has none of.
    Public Method HandleKey(key: KeyEvent): Bool
        If key.Modifiers != KeyModifiers.NONE || Items.Count == 0 Then Return False
        Local page = Max(Shown - 1, 1)
        Select key.Code
            Case KeyCode.UP
                Selected = Selected - 1
            Case KeyCode.DOWN
                Selected = Selected + 1
            Case KeyCode.PAGE_UP
                Selected = Selected - page
            Case KeyCode.PAGE_DOWN
                Selected = Selected + page
            Case KeyCode.HOME
                Selected = 0
            Case KeyCode.END
                Selected = Items.Count - 1
            Default
                Return False
        End Select

        Return True
    End Method

    /// Selects the item a press of the left button in `area` is on, or moves the selection three
    /// items for the wheel, and gives whether it did.
    Public Method HandleMouse(mouse: MouseEvent, area: Region): Bool
        If Items.Count == 0 || !area.Contains(mouse.Column, mouse.Row) Then Return False
        Select mouse.Action
            Case MouseAction.PRESS
                If mouse.Button != MouseButton.LEFT Then Return False
                Local index = Offset + mouse.Row - area.Row
                If index >= Items.Count Then Return False
                Selected = index
            Case MouseAction.SCROLL_UP
                Selected = Selected - 3
            Case MouseAction.SCROLL_DOWN
                Selected = Selected + 3
            Default
                Return False
        End Select

        Return True
    End Method

    /// Takes a key or the mouse's `event` in `area`, and gives whether it took it.
    Public Method HandleEvent(event: InputEvent, area: Region): Bool
        If event.Kind == InputKind.KEY Then Return HandleKey(event.Key)
        If event.Kind == InputKind.MOUSE Then Return HandleMouse(event.Mouse, area)
        Return False
    End Method

    /// Draws the items that fit in `area`, one a row, scrolled to keep the selected one in view.
    Public Method Draw(canvas: Canvas, area: Region)
        If area.IsEmpty Then Return
        Shown = area.Height
        Local selected = Selected
        If selected < Offset Then Offset = selected
        If selected >= Offset + area.Height Then Offset = selected - area.Height + 1
        Offset = Clamp(Offset, 0, Max(Items.Count - area.Height, 0))
        Local markerWidth = DisplayWidth(Marker)
        Local blank = " ".Repeated(markerWidth)
        For row = 0 Until area.Height
            Local index = Offset + row
            If index >= Items.Count Then Break
            Local look = index == selected ? SelectedLook.Over(ItemLook) : ItemLook
            Local line = Region(area.Column, area.Row + row, area.Width, 1)
            canvas.Fill(line, " ", look)
            Local text = (index == selected ? Marker : blank) + Items[index]
            canvas.Print(area.Column, area.Row + row, Truncated(text, area.Width), look)
        End For
    End Method
End Class
