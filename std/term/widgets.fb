// std.term's line widgets: a Table and a Box, which give their text, and a ProgressBar and a
// Spinner, which draw themselves on a terminal's line again as they go, where it's interactive,
// and once they're done where it isn't, as for a pipe or a file. Each draws to the console, the
// bars to stderr, or to a Terminal given, and goes by the colors it shows. Widths are in a
// terminal's columns, as VisibleWidth counts them.

Import std.core
Import std.collections.map
Import std.text.string
Import std.text.unicode
Import std.text.layout
Import std.time.duration
Import std.time.clock
Import std.term.console
Import std.term.style
Import std.term.terminal

Extern "runtime"
    Function fb_write(texts: String[], to_error: Int32, line: Int32)
End Extern

// Where text goes in a width wider than it.
Public Enum Alignment
    LEFT, CENTER, RIGHT
End Enum

// The lines a Table, a Box, or a Canvas's box is drawn with: NONE, ASCII's - | +, SINGLE ─ │ ┌,
// ROUNDED's corners ╭, DOUBLE ═ ║ ╔, and HEAVY ━ ┃ ┏.
Public Enum BorderStyle
    NONE, ASCII, SINGLE, ROUNDED, DOUBLE, HEAVY
End Enum

// What a BorderStyle draws with: its lines, its corners, and where lines meet.
Package Struct BorderLines
    Package Field Horizontal: String
    Package Field Vertical: String
    Package Field TopLeft: String
    Package Field TopRight: String
    Package Field BottomLeft: String
    Package Field BottomRight: String
    Package Field Down: String
    Package Field Up: String
    Package Field Right: String
    Package Field Left: String
    Package Field Cross: String
End Struct

// The lines border draws with; NONE's are spaces.
Package Function LinesOf(border: BorderStyle): BorderLines
    Select border
        Case BorderStyle.NONE
            Return BorderLines(" ", " ", " ", " ", " ", " ", " ", " ", " ", " ", " ")
        Case BorderStyle.ASCII
            Return BorderLines("-", "|", "+", "+", "+", "+", "+", "+", "+", "+", "+")
        Case BorderStyle.SINGLE
            Return BorderLines("─", "│", "┌", "┐", "└", "┘", "┬", "┴", "├", "┤", "┼")
        Case BorderStyle.ROUNDED
            Return BorderLines("─", "│", "╭", "╮", "╰", "╯", "┬", "┴", "├", "┤", "┼")
        Case BorderStyle.DOUBLE
            Return BorderLines("═", "║", "╔", "╗", "╚", "╝", "╦", "╩", "╠", "╣", "╬")
        Case BorderStyle.HEAVY
            Return BorderLines("━", "┃", "┏", "┓", "┗", "┛", "┳", "┻", "┣", "┫", "╋")
    End Select
End Function

// text in width columns: padded with spaces as alignment says, or as it is when it's as wide
// or wider.
Public Function Aligned(text: String, width: Int, alignment: Alignment): String
    Local gap = width - VisibleWidth(text)
    If gap <= 0 Then Return text
    Select alignment
        Case Alignment.LEFT
            Return text + " ".Repeated(gap)
        Case Alignment.RIGHT
            Return " ".Repeated(gap) + text
        Case Alignment.CENTER
            Return " ".Repeated(gap / 2) + text + " ".Repeated(gap - gap / 2)
    End Select
End Function

// text cut to width columns, with "…" for what's cut, between grapheme clusters, or as it is
// when it fits. It has no escape codes, which this would cut too.
Public Function Truncated(text: String, width: Int): String
    If DisplayWidth(text) <= width Then Return text
    If width <= 0 Then Return ""
    Local kept = ""
    Local used = 0
    For grapheme In text.Graphemes()
        Local columns = DisplayWidth(grapheme)
        If used + columns > width - 1 Then Break
        kept += grapheme
        used += columns
    End For

    Return kept + "…"
End Function

// A table of text, with a header row or not, its columns as wide as their widest cell, which
// Render draws with a BorderStyle's lines. A cell can have several lines, and each column its
// own Alignment. With a MaxWidth, the widest columns give way first, down to their widest
// character, and their cells wrap.
Public Class Table
    Field Header: String[]
    Field Body: String[][] = []
    // Each column's Alignment that isn't LEFT.
    Field Aligns: Map<Int, Alignment>
    // The lines it's drawn with.
    Public Field Border: BorderStyle = BorderStyle.ROUNDED
    // How the header's cells look: bold, at first.
    Public Field HeaderStyle: Style
    // How the lines look.
    Public Field BorderColor: Style
    // The most columns it takes, lines and all, or 0 for as many as it needs.
    Public Field MaxWidth: Int
    // The spaces on each side of a cell's text.
    Public Field Padding: Int = 1

    // A table whose header row is headers, or that has none, without any.
    Public New(headers: String...)
        Header = headers
        Aligns = Map<Int, Alignment>()
        HeaderStyle = Style(Attributes: TextAttributes.BOLD)
    End New

    // How many rows it has, after its header.
    Public Property RowCount: Int
        Get => Body.Count
    End Property

    // Adds a row of cells, from the first column. A row with fewer cells than another has empty
    // ones after them.
    Public Method AddRow(cells: String...)
        Body.Add(cells)
    End Method

    // Puts the column's cells where alignment says, the header's too. Panics for a column below
    // 0.
    @PanicsAtCaller
    Public Method Align(column: Int, alignment: Alignment)
        If column < 0 Then Panic("a table's columns are from 0, not {column}")
        Aligns[column] = alignment
    End Method

    // Its lines, with a line break between each two, styled as colors shows them, or plain for
    // NONE. A table without a header or a row is "".
    Public Method Render(colors: ColorLevel = ColorLevel.NONE): String
        Local count = Header.Count
        For row In Body
            count = Max(count, row.Count)
        End For

        If count == 0 Then Return ""
        // Each column's width, and the least it can give way to, its widest grapheme cluster's.
        Local widths: Int[] = []
        Local least: Int[] = []
        For column = 0 Until count
            Local cells: String[] = []
            If column < Header.Count Then cells.Add(Header[column])
            For row In Body
                If column < row.Count Then cells.Add(row[column])
            End For

            Local widest = 0
            Local narrowest = 1
            For cell In cells
                widest = Max(widest, VisibleWidth(cell))
                For grapheme In StripStyles(cell).Graphemes()
                    narrowest = Max(narrowest, Min(DisplayWidth(grapheme), 2))
                End For
            End For

            widths.Add(widest)
            least.Add(Min(narrowest, Max(widest, 1)))
        End For

        Local pad = Max(Padding, 0)
        Local framed = Border != BorderStyle.NONE
        Local total = 0
        For width In widths
            total += width + 2 * pad
        End For

        total = framed ? total + count + 1 : total - 2 * pad * count + 2 * (count - 1)
        // The widest columns give way first, down to their widest grapheme cluster each.
        While MaxWidth > 0 && total > MaxWidth
            Local widest = -1
            For column = 0 Until count
                If widths[column] > least[column] && (widest < 0 || widths[column] > widths[widest])
                    widest = column
                End If
            End For

            If widest < 0 Then Break
            widths[widest] -= 1
            total -= 1
        End While

        Local lines = LinesOf(Border)
        Local rows: String[] = []
        If framed Then rows.Add(Rule(lines.TopLeft, lines.Down, lines.TopRight, lines, widths, colors))
        If Header.Count > 0
            For line In RowLines(Header, widths, colors, True)
                rows.Add(line)
            End For

            If framed && Body.Count > 0
                rows.Add(Rule(lines.Right, lines.Cross, lines.Left, lines, widths, colors))
            ElseIf Body.Count > 0
                rows.Add(Rule("", "", "", LinesOf(BorderStyle.SINGLE), widths, colors))
            End If
        End If

        For row In Body
            For line In RowLines(row, widths, colors, False)
                rows.Add(line)
            End For
        End For

        If framed
            rows.Add(Rule(lines.BottomLeft, lines.Up, lines.BottomRight, lines, widths, colors))
        End If

        Return "\n".Join(rows)
    End Method

    // Writes it to stdout, with a line break after, as stdout shows colors.
    Public Method Print()
        fb_write([Render(ConsoleColors(StandardStream.OUTPUT))], 0, 1)
    End Method

    // Writes it to terminal, with a line break after, as it shows colors.
    Public Method Draw(terminal: Terminal)
        terminal.WriteLine(Render(terminal.Colors))
        terminal.Flush()
    End Method

    // A line across, from left to right, with between where columns meet.
    Method Rule(left: String, between: String, right: String, lines: BorderLines, widths: Int[],
                colors: ColorLevel): String
        // Without a border, a column's rule is as wide as its text, with two spaces between.
        Local framed = Border != BorderStyle.NONE
        Local pad = framed ? Max(Padding, 0) : 0
        Local parts: String[] = []
        For width In widths
            parts.Add(lines.Horizontal.Repeated(width + 2 * pad))
        End For

        Return BorderColor.Apply(left + (framed ? between : "  ").Join(parts) + right, colors)
    End Method

    // The lines a row of cells takes, each cell wrapped to its column's width, and as many lines
    // as its tallest cell.
    Method RowLines(cells: String[], widths: Int[], colors: ColorLevel, header: Bool): String[]
        Local wrapped: String[][] = []
        Local height = 1
        For column = 0 Until widths.Count
            Local cell = column < cells.Count ? cells[column] : ""
            Local cellLines: String[] = []
            For line In cell.SplitLines()
                If VisibleWidth(line) <= widths[column]
                    cellLines.Add(line)
                Else
                    For part In line.WordWrap(widths[column]).SplitLines()
                        cellLines.Add(part)
                    End For
                End If
            End For

            If cellLines.Count == 0 Then cellLines.Add("")
            height = Max(height, cellLines.Count)
            wrapped.Add(cellLines)
        End For

        Local lines = LinesOf(Border)
        Local framed = Border != BorderStyle.NONE
        Local space = " ".Repeated(Max(Padding, 0))
        Local edge = framed ? BorderColor.Apply(lines.Vertical, colors) : ""
        Local result: String[] = []
        For i = 0 Until height
            Local parts: String[] = []
            For column = 0 Until widths.Count
                Local cellLines = wrapped[column]
                Local text = i < cellLines.Count ? cellLines[i] : ""
                Local alignment = Aligns.Get(column, Alignment.LEFT)
                Local filled = Aligned(text, widths[column], alignment)
                If header Then filled = HeaderStyle.Apply(filled, colors)
                parts.Add(framed ? space + filled + space : filled)
            End For

            // Without a border, columns have two spaces between them, and none after the last.
            result.Add(framed ? edge + edge.Join(parts) + edge : "  ".Join(parts).TrimEnd())
        End For

        Return result
    End Method
End Class

// Text in a box, with a Title in its top line or not, which Render draws with a BorderStyle's
// lines. It's as wide as its widest line, or Width wide inside its lines, where the lines
// wider than that wrap.
Public Class Box
    Public Field Content: String
    Public Field Title: String
    // The lines it's drawn with.
    Public Field Border: BorderStyle = BorderStyle.ROUNDED
    // How the lines look.
    Public Field BorderColor: Style
    // How the title looks.
    Public Field TitleStyle: Style
    // Where the content's lines go inside it.
    Public Field Align: Alignment = Alignment.LEFT
    // The spaces on each side of the content.
    Public Field Padding: Int = 1
    // The columns inside its lines, padding and all, or 0 for as many as the content needs.
    Public Field Width: Int

    Public New(content: String, title: String = "")
        Content = content
        Title = title
    End New

    // Its lines, with a line break between each two, styled as colors shows them, or plain for
    // NONE.
    Public Method Render(colors: ColorLevel = ColorLevel.NONE): String
        Local pad = Max(Padding, 0)
        // Its content has a column at least.
        Local inner = Max(Width - 2 * pad, 1)
        Local contentLines: String[] = []
        For line In Content.SplitLines()
            If Width > 0 && VisibleWidth(line) > inner
                For part In line.WordWrap(inner).SplitLines()
                    contentLines.Add(part)
                End For
            Else
                contentLines.Add(line)
            End If
        End For

        If contentLines.Count == 0 Then contentLines.Add("")
        // The title takes a line and a space before it, and a space and a line after it.
        If Width <= 0
            inner = Title == "" ? 0 : DisplayWidth(Title) + 4 - 2 * pad
            For line In contentLines
                inner = Max(inner, VisibleWidth(line))
            End For
        End If

        inner = Max(inner, 0)
        Local lines = LinesOf(Border)
        Local across = inner + 2 * pad
        Local top = lines.Horizontal.Repeated(across)
        Local title = Truncated(Title, across - 4)
        If title != ""
            Local rest = across - 3 - DisplayWidth(title)
            top = BorderColor.Apply(lines.TopLeft + lines.Horizontal, colors) + " " +
                  TitleStyle.Apply(title, colors) + " " +
                  BorderColor.Apply(lines.Horizontal.Repeated(rest) + lines.TopRight, colors)
        Else
            top = BorderColor.Apply(lines.TopLeft + top + lines.TopRight, colors)
        End If

        Local rows = [top]
        Local edge = BorderColor.Apply(lines.Vertical, colors)
        Local space = " ".Repeated(pad)
        For line In contentLines
            rows.Add(edge + space + Aligned(line, inner, Align) + space + edge)
        End For

        rows.Add(BorderColor.Apply(lines.BottomLeft + lines.Horizontal.Repeated(across) +
                                   lines.BottomRight, colors))
        Return "\n".Join(rows)
    End Method

    // Writes it to stdout, with a line break after, as stdout shows colors.
    Public Method Print()
        fb_write([Render(ConsoleColors(StandardStream.OUTPUT))], 0, 1)
    End Method

    // Writes it to terminal, with a line break after, as it shows colors.
    Public Method Draw(terminal: Terminal)
        terminal.WriteLine(Render(terminal.Colors))
        terminal.Flush()
    End Method
End Class

// What a ProgressBar shows after its bar: the PERCENT done, the COUNT done of the total, the time
// ELAPSED, the ETA, an estimate of the time left, and the RATE, how many a second.
@Flags
Public Enum ProgressParts
    NONE = 0, PERCENT, COUNT, ELAPSED, ETA, RATE
End Enum

// A bar of how much of a Total is done, on a line of its own, with a Label before it and its
// Parts after it, which it draws again in place as its Value changes, no more often than
// Interval but at its start and its end, on an interactive terminal; on another, it's drawn
// once, at its Finish. It goes to stderr, or to a Terminal given. What reads the clock also
// takes an Instant, so a test gives the time.
Public Class ProgressBar
    // How many make the bar full.
    Public Field Total: Int64
    // What goes before the bar.
    Public Field Label: String
    // The bar's columns, which give way to the rest where the terminal's line is narrower.
    Public Field Width: Int = 30
    // What follows the bar.
    Public Field Parts: ProgressParts
    // The bar's characters: a full column first, an empty one last, and any between, for a
    // column that's partly full, from the fullest down, as "█▉▊▋▌▍▎▏ " or "#>-" has them.
    Public Field Characters: String = "█░"
    // How its full and its empty columns look.
    Public Field FilledStyle: Style
    Public Field EmptyStyle: Style
    // The least time between two draws.
    Public Field Interval: Duration
    Field Term: Terminal
    Field Started: Instant
    Field Drawn: Instant
    Field HasDrawn: Bool
    Field Done: Bool
    Field Current: Int64

    // A bar of total on stderr, from now.
    Public New(total: Int64)
        Term = Terminal.Console(StandardStream.ERROR)
        Start(total, Instant.Now())
    End New

    // A bar of total on terminal, from now.
    Public New(total: Int64, terminal: Terminal)
        Term = terminal
        Start(total, Instant.Now())
    End New

    // A bar of total on terminal, from start.
    Public New(total: Int64, terminal: Terminal, start: Instant)
        Term = terminal
        Start(total, start)
    End New

    // How many are done.
    Public Property Value: Int64
        Get => Current
    End Property

    // Whether Finish has drawn it for the last time.
    Public Property IsFinished: Bool
        Get => Done
    End Property

    // Sets how many are done, and draws it, if it's time to.
    Public Method Set(value: Int64)
        Set(value, Instant.Now())
    End Method

    // Sets how many are done at now, and draws it, if it's time to.
    Public Method Set(value: Int64, now: Instant)
        Current = value
        Draw(now, value >= Total)
    End Method

    // Adds count to how many are done, and draws it, if it's time to.
    Public Method Add(count: Int64 = 1)
        Set(Current + count, Instant.Now())
    End Method

    // Adds count to how many are done at now, and draws it, if it's time to.
    Public Method Add(count: Int64, now: Instant)
        Set(Current + count, now)
    End Method

    // Writes text on a line of its own above the bar, which is drawn again below it.
    Public Method PrintAbove(text: String)
        PrintAbove(text, Instant.Now())
    End Method

    // Writes text on a line of its own above the bar at now.
    Public Method PrintAbove(text: String, now: Instant)
        If Term.IsInteractive && HasDrawn && !Done
            Term.Write("\r\u{1b}[K" + text + "\n")
            Draw(now, True)
        Else
            Term.WriteLine(text)
            Term.Flush()
        End If
    End Method

    // Draws it for the last time, as it is, and ends its line.
    Public Method Finish()
        Finish(Instant.Now())
    End Method

    // Draws it for the last time at now, and ends its line.
    Public Method Finish(now: Instant)
        If Done Then Return
        Local line = Render(now)
        Done = True
        If Term.IsInteractive Then Term.Write("\r" + line + "\u{1b}[K\n") Else Term.WriteLine(line)
        Term.Flush()
    End Method

    // The line it draws at now, as its terminal shows colors, in its columns.
    Public Method Render(now: Instant): String
        Local level = Term.Colors
        Local fraction: Double = 1.0
        If Total > 0 Then fraction = (Current As Double) / (Total As Double)
        If fraction < 0.0 Then fraction = 0.0
        If fraction > 1.0 Then fraction = 1.0
        Local after: String[] = []
        Local elapsed = ((now.Nanoseconds - Started.Nanoseconds) As Double) / 1000000000.0
        If elapsed < 0.0 Then elapsed = 0.0
        If Parts.Has(ProgressParts.PERCENT) Then after.Add("{((fraction * 100.0) As Int):>3}%")
        If Parts.Has(ProgressParts.COUNT) Then after.Add("{Current}/{Total}")
        If Parts.Has(ProgressParts.ELAPSED) Then after.Add(TimeText(elapsed))
        If Parts.Has(ProgressParts.ETA)
            If Current > 0 && Current < Total && elapsed > 0.0
                Local left = elapsed * ((Total - Current) As Double) / (Current As Double)
                after.Add("ETA " + TimeText(left))
            ElseIf Current < Total
                after.Add("ETA -:--")
            End If
        End If

        If Parts.Has(ProgressParts.RATE)
            Local rate = elapsed > 0.0 ? (Max(Current, 0) As Double) / elapsed : 0.0
            after.Add("{rate:.1}/s")
        End If

        // The line stops a column short of the edge, so the terminal doesn't wrap it. The bar keeps
        // 10 columns, or its Width, where the label would leave it fewer, and the label is cut to
        // what's left, or goes, and then the bar does too.
        Local line = Term.Columns - 1
        Local tail = Truncated(" ".Join(after), line)
        Local room = line - DisplayWidth(tail) - (tail == "" ? 0 : 1)
        Local labelWidth = DisplayWidth(Label)
        Local barWidth = Clamp(room - (Label == "" ? 0 : labelWidth + 1), Min(Width, 10), Width)
        barWidth = Min(barWidth, Max(room, 0))
        Local label = Truncated(Label, room - barWidth - 1)
        If label == "" Then barWidth = Min(Width, Max(room, 0))
        Local pieces: String[] = []
        If label != "" Then pieces.Add(label)
        If barWidth > 0 Then pieces.Add(Bar(fraction, barWidth, level))
        If tail != "" Then pieces.Add(tail)
        Return " ".Join(pieces)
    End Method

    // Starts it, as each New does.
    Method Start(total: Int64, start: Instant)
        Total = total
        Started = start
        Parts = ProgressParts.PERCENT | ProgressParts.COUNT | ProgressParts.ETA
        Interval = 100.Milliseconds
        FilledStyle = Style(TermColor.Green)
        EmptyStyle = Style(Attributes: TextAttributes.DIM)
    End Method

    // Draws it again, if it's on an interactive terminal and it's been Interval since it last
    // was, or now must.
    Method Draw(now: Instant, must: Bool)
        If Done || !Term.IsInteractive Then Return
        If HasDrawn && !must && now.Nanoseconds - Drawn.Nanoseconds < Interval.Nanoseconds Then Return
        Term.Write("\r" + Render(now) + "\u{1b}[K")
        Term.Flush()
        HasDrawn = True
        Drawn = now
    End Method

    // The bar, width columns of which fraction are full.
    Method Bar(fraction: Double, width: Int, level: ColorLevel): String
        Local characters: String[] = []
        For grapheme In Characters.Graphemes()
            characters.Add(grapheme)
        End For

        If characters.Count == 0 Then characters = ["#", "-"]
        If characters.Count == 1 Then characters.Add(" ")
        Local partials = characters.Count - 2
        Local cells = fraction * (width As Double)
        Local full = Min(cells As Int, width)
        Local filled = characters[0].Repeated(full)
        Local rest = width - full
        If rest > 0 && partials > 0
            Local step = ((cells - (full As Double)) * ((partials + 1) As Double)) As Int
            If step > 0
                filled += characters[partials + 1 - step]
                rest -= 1
            End If
        End If

        Local empty = characters[characters.Count - 1].Repeated(rest)
        Return FilledStyle.Apply(filled, level) + EmptyStyle.Apply(empty, level)
    End Method
End Class

// A spinner, on a line of its own, whose frame turns each Interval, with its Message after it,
// for work whose end isn't known. Tick draws it again when its frame or message has changed, on
// an interactive terminal; on another, only its Finish's line is written. It goes to stderr, or
// to a Terminal given. What reads the clock also takes an Instant, so a test gives the time.
Public Class Spinner
    // What it shows, one frame after another.
    Public Field Frames: String[] = []
    // What goes after it.
    Public Field Message: String
    // How long each frame shows.
    Public Field Interval: Duration
    // How its frame looks.
    Public Field FrameStyle: Style
    Field Term: Terminal
    Field Started: Instant
    Field Shown: Int = -1
    Field ShownMessage: String
    Field Done: Bool

    // A spinner on stderr, from now.
    Public New(message: String)
        Term = Terminal.Console(StandardStream.ERROR)
        Start(message, Instant.Now())
    End New

    // A spinner on terminal, from now.
    Public New(message: String, terminal: Terminal)
        Term = terminal
        Start(message, Instant.Now())
    End New

    // A spinner on terminal, from start.
    Public New(message: String, terminal: Terminal, start: Instant)
        Term = terminal
        Start(message, start)
    End New

    // Whether a Finish has written its last line.
    Public Property IsFinished: Bool
        Get => Done
    End Property

    // Draws it again, when its frame or its message has changed since it last was.
    Public Method Tick()
        Tick(Instant.Now())
    End Method

    // Draws it again at now, when its frame or its message has changed.
    Public Method Tick(now: Instant)
        If Done || !Term.IsInteractive || Frames.Count == 0 Then Return
        Local frame = FrameAt(now)
        If frame == Shown && Message == ShownMessage Then Return
        Shown = frame
        ShownMessage = Message
        Local text = Term.Paint(Frames[frame], FrameStyle) + (Message == "" ? "" : " " + Message)
        Term.Write("\r" + text + "\u{1b}[K")
        Term.Flush()
    End Method

    // Takes it away, and writes text on its line, which ends.
    Public Method Finish(text: String)
        If Done Then Return
        Done = True
        If Term.IsInteractive Then Term.Write("\r" + text + "\u{1b}[K\n") Else Term.WriteLine(text)
        Term.Flush()
    End Method

    // Finishes it with a green ✔ before text.
    Public Method Succeed(text: String)
        Finish(Term.Paint("✔", Style(TermColor.Green)) + " " + text)
    End Method

    // Finishes it with a red ✖ before text.
    Public Method Fail(text: String)
        Finish(Term.Paint("✖", Style(TermColor.Red)) + " " + text)
    End Method

    // Starts it, as each New does.
    Method Start(message: String, start: Instant)
        Message = message
        Started = start
        Frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        Interval = 80.Milliseconds
        FrameStyle = Style(TermColor.Cyan)
    End Method

    // The frame that shows at now.
    Method FrameAt(now: Instant): Int
        Local interval = Max(Interval.Nanoseconds, 1)
        Local elapsed = Max(now.Nanoseconds - Started.Nanoseconds, 0)
        Return ((elapsed / interval) % Frames.Count) As Int
    End Method
End Class

// A time in seconds as "m:ss", or "h:mm:ss" from an hour.
Function TimeText(seconds: Double): String
    Local whole = seconds As Int64
    Local hours = whole / 3600
    Local minutes = whole / 60 % 60
    Local rest = whole % 60
    If hours > 0 Then Return "{hours}:{minutes:02}:{rest:02}"
    Return "{minutes}:{rest:02}"
End Function
