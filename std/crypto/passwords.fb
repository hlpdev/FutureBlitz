// Argon2id and Bcrypt, for keeping passwords: Hash picks a new random salt and the parameters,
// and gives a String that has them with the hash, which is what to keep; Verify tells whether a
// password is the one a kept hash was made from. Both are slow on purpose, so guessing is too.
// Argon2id, over Argon2's reference code, is the one to choose; Bcrypt, over Solar Designer's
// crypt_blowfish, is for the hashes other systems keep.

Import std.core
Import std.crypto.random

Extern "runtime"
    Function fb_argon2_derive(password: UInt8[], salt: UInt8[], secret: UInt8[],
                              associated: UInt8[], memory: Int64, iterations: Int64,
                              parallelism: Int64, length: Int64, output: UInt8[])
    Function fb_argon2_hash(password: UInt8[], salt: UInt8[], memory: Int64, iterations: Int64,
                            parallelism: Int64): String
    Function fb_argon2_verify(password: UInt8[], hash: String): Int32
    Function fb_bcrypt_hash(password: String, salt: UInt8[], cost: Int32): String
    Function fb_bcrypt_verify(password: String, hash: String): Int32
End Extern

// Argon2id (RFC 9106), a hash that takes memory as well as time.
Public Struct Argon2id
    // Argon2id isn't made: it's only its Static Methods.
    New()
    End New

    // The PHC string of password's hash, "$argon2id$v=19$m=19456,t=2,p=1$<salt>$<hash>", with a
    // new 16-byte salt and OWASP's parameters: 19 MiB of memory, 2 passes, and 1 lane.
    Public Static Method Hash(password: String): String => Hash(password, 19456, 2, 1)

    // The same, with memory KiB, iterations passes, and parallelism lanes. Panics unless
    // parallelism is from 1 to 16777215, memory is at least 8 times parallelism, and iterations
    // is 1 or more.
    @PanicsAtCaller
    Public Static Method Hash(password: String, memory: Int, iterations: Int,
                              parallelism: Int): String
        CheckCosts(memory, iterations, parallelism)
        Return fb_argon2_hash(password.Bytes, SecureRandom.Bytes(16), memory, iterations,
                              parallelism)
    End Method

    // Whether password is the one hash, a PHC string from Hash, was made from. A hash that isn't
    // an Argon2id PHC string is no password's.
    Public Static Method Verify(password: String, hash: String): Bool
        Return fb_argon2_verify(password.Bytes, hash) != 0
    End Method

    // length bytes of key from password and salt, with those costs, and with secret, a key that
    // isn't kept with the hash, and associated data, which can both be empty. Panics as Hash does,
    // or unless salt is 8 bytes or more and length 4 or more.
    @PanicsAtCaller
    Public Static Method Derive(password: UInt8[], salt: UInt8[], memory: Int, iterations: Int,
                                parallelism: Int, length: Int, secret: UInt8[] = [],
                                associated: UInt8[] = []): UInt8[]
        CheckCosts(memory, iterations, parallelism)
        If salt.Count < 8 Then Panic("Argon2id takes a salt of 8 bytes or more, not {salt.Count}")
        If length < 4 Then Panic("Argon2id gives 4 bytes or more, not {length}")
        Local key: UInt8[] = []
        fb_argon2_derive(password, salt, secret, associated, memory, iterations, parallelism,
                         length, key)
        Return key
    End Method
End Struct

// bcrypt, OpenBSD's password hash, 2 to the cost rounds of Blowfish's key setup.
Public Struct Bcrypt
    // Bcrypt isn't made: it's only its Static Methods.
    New()
    End New

    // password's hash, "$2b$<cost>$<salt and hash>", with a new 16-byte salt, and a cost from 4 to
    // 31, 12 unless it's given. bcrypt reads only a password's first 72 bytes, and none past a
    // NUL, so a longer one, or one with a NUL, would share its hash with others; it throws an
    // ArgumentError instead. Panics when cost is outside 4 to 31.
    @PanicsAtCaller
    Public Static Method Hash(password: String, cost: Int = 12): String Throws ArgumentError
        If cost < 4 || cost > 31 Then Panic("Bcrypt takes a cost from 4 to 31, not {cost}")
        Local bytes = password.Bytes
        If bytes.Count > 72
            Throw ArgumentError(ArgumentErrorKind.INVALID,
                                "bcrypt reads only 72 bytes of a password, not {bytes.Count}")
        End If

        If bytes.Contains(0)
            Throw ArgumentError(ArgumentErrorKind.INVALID, "bcrypt can't take a NUL in a password")
        End If

        Return fb_bcrypt_hash(password, SecureRandom.Bytes(16), cost)
    End Method

    // Whether password is the one hash, of any of bcrypt's versions, $2a$, $2b$, or $2y$, was made
    // from, reading its first 72 bytes, as bcrypt does. A password with a NUL, or a hash that
    // isn't bcrypt's, is none, like crypt_blowfish's $2x$, which gives many passwords one hash.
    Public Static Method Verify(password: String, hash: String): Bool
        Return fb_bcrypt_verify(password, hash) != 0
    End Method
End Struct

@PanicsAtCaller
Function CheckCosts(memory: Int, iterations: Int, parallelism: Int)
    If parallelism < 1 || parallelism > 16777215
        Panic("Argon2id takes a parallelism from 1 to 16777215, not {parallelism}")
    End If

    If memory < 8 * parallelism
        Panic("Argon2id takes at least 8 KiB of memory for each lane, not {memory} for " +
              "{parallelism}")
    End If

    If iterations < 1 Then Panic("Argon2id takes 1 iteration or more, not {iterations}")
End Function
