//! Timestamps, points in time in UTC, to the nanosecond.
//!
//! Timestamp: a point in time, in UTC, to the nanosecond, from the year -999999999 to 999999999,
//! as the real clock and Unix times give one. Its zero is 1970-01-01T00:00:00Z. A zone's clocks
//! show it as a ZonedDateTime (in zone.fb). ToString and Parse write and read RFC 3339, ISO
//! 8601's form for one, like "2026-10-23T12:30:00Z".

Import std.core
Import std.time.calendar
Import std.time.duration
Import std.time.format
Import std.time.zone

Extern "runtime"
    Function fb_time_now(): Int64
End Extern

/// A moment in time, as UTC counts it: its seconds since 1970-01-01T00:00:00Z, and the nanoseconds
/// after them.
///
/// # Examples
///
/// ```
/// # Import std.time
/// Local epoch = Timestamp.FromUnixSeconds(0)
/// Expect(epoch == Timestamp.UnixEpoch())
/// Expect("{epoch}" == "1970-01-01T00:00:00Z")
/// Local day = epoch + 1.Days
/// Expect(day.UnixSeconds == 86400)
/// Expect(Timestamp.Parse("1970-01-02T00:00:00Z") == day)
/// Expect(Timestamp.Parse("1970-01-02T02:00:00+02:00") == day)
/// ```
Public Struct Timestamp Implements Comparable, Hashable, Printable, Defaultable
    /// Its seconds since 1970-01-01T00:00:00Z, below 0 before it, and the nanoseconds after
    /// those, from 0 to 999999999.
    Field Seconds: Int64
    Field Nanos: Int

    /// The Timestamp of seconds and nanoseconds already checked.
    Package New(seconds: Int64, nanos: Int)
        Self.Seconds = seconds
        Self.Nanos = nanos
    End New

    /// Now, on the real clock, which the OS can set back or on.
    Public Static Method Now(): Timestamp
        Local nanoseconds = fb_time_now()
        Return Timestamp(FloorDivide(nanoseconds, 1000000000),
                         FloorModulo(nanoseconds, 1000000000) As Int)
    End Method

    /// The Unix epoch, 1970-01-01T00:00:00Z.
    Public Static Method DefaultValue(): Timestamp => Timestamp(0, 0)
    /// 1970-01-01T00:00:00Z, where Unix time starts.
    Public Static Method UnixEpoch(): Timestamp => Timestamp(0, 0)
    /// The earliest Timestamp there is.
    Public Static Method MinValue(): Timestamp => Timestamp(-31557014135596800, 0)
    /// The latest Timestamp there is.
    Public Static Method MaxValue(): Timestamp => Timestamp(31556889832780799, 999999999)

    /// The Timestamp that many `seconds`, and `nanoseconds`, after 1970-01-01T00:00:00Z, or before
    /// it below 0, as Unix time counts them, without leap `seconds`. One past the years a Timestamp
    /// holds panics.
    @PanicsAtCaller
    Public Static Method FromUnixSeconds(seconds: Int64, nanoseconds: Int64 = 0): Timestamp
        Local total = seconds.CheckedAdd(FloorDivide(nanoseconds, 1000000000))
        If total == Null
            Panic("{seconds} seconds and {nanoseconds} nanoseconds is past the years a Timestamp " +
                  "holds")
        End If

        Return Checked(total, FloorModulo(nanoseconds, 1000000000) As Int)
    End Method

    /// The Timestamp that many `milliseconds` after 1970-01-01T00:00:00Z, or before it below 0.
    Public Static Method FromUnixMilliseconds(milliseconds: Int64): Timestamp
        Return Timestamp(FloorDivide(milliseconds, 1000),
                         (FloorModulo(milliseconds, 1000) * 1000000) As Int)
    End Method

    /// The Timestamp that many `nanoseconds` after 1970-01-01T00:00:00Z, or before it below 0.
    Public Static Method FromUnixNanoseconds(nanoseconds: Int64): Timestamp
        Return Timestamp(FloorDivide(nanoseconds, 1000000000),
                         FloorModulo(nanoseconds, 1000000000) As Int)
    End Method

    /// The Timestamp RFC 3339 writes, like "2026-10-23T12:30:00Z" or
    /// "2026-10-23T14:30:00.5+02:00", with "T", "t", or a space before the time, or Null.
    Public Static Method Parse(text: String): Timestamp?
        Local parts = ParseIso(text, IsoForm.TIMESTAMP)
        If parts == Null Then Return Null
        Return MomentOf(parts)
    End Method

    /// The Timestamp the `text` writes as the `pattern` says (see format.fb), or Null. A pattern
    /// without the date, or without an offset or a zone, panics.
    @PanicsAtCaller
    Public Static Method Parse(text: String, pattern: String): Timestamp?
        Local parts = ParsePattern(text, pattern, PartKind.ZONED)
        If parts == Null Then Return Null
        Return MomentOf(parts)
    End Method

    /// Its seconds since 1970-01-01T00:00:00Z, rounded down, so a moment before it has the
    /// second before.
    Public Property UnixSeconds: Int64
        Get => Seconds
    End Property

    /// Its milliseconds and nanoseconds since 1970-01-01T00:00:00Z, rounded down. Those past what
    /// an Int64 holds, from before 1677 or after 2262 for nanoseconds, panic.
    @PanicsAtCaller
    Public Property UnixMilliseconds: Int64
        Get
            Local total = Combined(Seconds, 1000, Nanos / 1000000)
            If total == Null Then Panic("{Self} is past the milliseconds an Int64 holds")
            Return total
        End Get
    End Property

    /// Its nanoseconds since 1970-01-01T00:00:00Z. Panics when they're past what an Int64 holds.
    @PanicsAtCaller
    Public Property UnixNanoseconds: Int64
        Get
            Local total = Combined(Seconds, 1000000000, Nanos)
            If total == Null Then Panic("{Self} is past the nanoseconds an Int64 holds")
            Return total
        End Get
    End Property

    /// Its nanoseconds past the second, from 0 to 999999999.
    Public Property Nanosecond: Int
        Get => Nanos
    End Property

    /// It where the `zone` is.
    Public Method InZone(zone: TimeZone): ZonedDateTime => ZonedDateTime(Self, zone)

    /// Its date and time in UTC.
    Public Method ToUtc(): LocalDateTime => LocalAt(Self, 0)

    /// `b` after `a`. One past the years a Timestamp holds panics.
    @PanicsAtCaller
    Operator +(a: Timestamp, b: Duration): Timestamp => a.Plus(b.Nanoseconds)

    /// `b` before `a`. One past the years a Timestamp holds panics.
    @PanicsAtCaller
    Operator -(a: Timestamp, b: Duration): Timestamp
        If b.Nanoseconds == -9223372036854775807 - 1 Then Return a.Plus(9223372036854775807).Plus(1)
        Return a.Plus(-b.Nanoseconds)
    End Operator

    /// How long it is from `b` to `a`, below 0 when `a` is earlier, which panics past the longest
    /// Duration, about 292 years.
    @PanicsAtCaller
    Operator -(a: Timestamp, b: Timestamp): Duration
        Local total = Combined(a.Seconds - b.Seconds, 1000000000, a.Nanos - b.Nanos)
        If total == Null Then Panic("from {b} to {a} is longer than a Duration holds")
        Return Duration.FromNanoseconds(total)
    End Operator

    /// Whether `a` is before `b`.
    Operator <(a: Timestamp, b: Timestamp): Bool
        Return a.Seconds < b.Seconds || (a.Seconds == b.Seconds && a.Nanos < b.Nanos)
    End Operator

    /// As RFC 3339 writes it in UTC, with a fraction only when there is one, like
    /// "2026-10-23T12:30:00Z" and "2026-10-23T12:30:00.25Z".
    Public Method ToString(): String => "{ToUtc()}Z"

    /// As RFC 2822 writes it, in UTC: "Fri, 23 Oct 2026 12:30:00 +0000".
    Public Method ToRfc2822(): String => Rfc2822Of(ToUtc(), 0)

    /// As the `pattern` says (see format.fb), in UTC.
    @PanicsAtCaller
    Public Method Format(pattern: String): String
        Return FormatPattern(pattern, PartsAt(ToUtc(), 0, "UTC", "UTC"))
    End Method

    @PanicsAtCaller
    Method Plus(nanoseconds: Int64): Timestamp
        Local total = Nanos + nanoseconds % 1000000000
        Local seconds = nanoseconds / 1000000000 + FloorDivide(total, 1000000000)
        Local sum = Self.Seconds.CheckedAdd(seconds)
        If sum == Null
            Local time = Duration.FromNanoseconds(nanoseconds)
            Panic("{Self} plus {time} is past the years a Timestamp holds")
        End If

        Return Checked(sum, FloorModulo(total, 1000000000) As Int)
    End Method
End Struct

/// The Timestamp, which panics past the years one holds.
@PanicsAtCaller
Package Function Checked(seconds: Int64, nanos: Int): Timestamp
    If seconds < -31557014135596800 || seconds > 31556889832780799
        Panic("{seconds} seconds from 1970 is past the years a Timestamp holds")
    End If

    Return Timestamp(seconds, nanos)
End Function

/// The date and time a Timestamp is at an offset of that many seconds from UTC.
Package Function LocalAt(time: Timestamp, offset: Int): LocalDateTime
    Local seconds = time.UnixSeconds + offset
    Return LocalDateTime(DayOf(FloorDivide(seconds, 86400)),
                         ClockOf(FloorModulo(seconds, 86400) * 1000000000 + time.Nanosecond))
End Function

/// The Timestamp a local date and time are at an offset of that many seconds, or Null past the
/// years one holds.
Package Function MomentAt(local: LocalDateTime, offset: Int): Timestamp?
    Local seconds = local.LocalSeconds - offset
    If seconds < -31557014135596800 || seconds > 31556889832780799 Then Return Null
    Return Timestamp(seconds, local.Nanosecond)
End Function
