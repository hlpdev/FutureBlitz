// What a Logger writes, and where: a LogRecord, with its LogFields, for each line, given to each
// sink of a LogOutput whose filter writes it.

Import std.core
Import std.collections
Import std.time.timestamp
Import std.log.level

// One of a line's fields: its name and the text of its value, which a JSON line quotes when it's
// text, and writes as it is when it's a number or a Bool.
Public Struct LogField
    Public ReadOnly Field Name: String
    Public ReadOnly Field Text: String
    Public ReadOnly Field IsText: Bool

    Public New(name: String, text: String, isText: Bool = True)
        Name = name
        Text = text
        IsText = isText
    End New
End Struct

// A line, as a Logger gives it to its output's sinks.
Public Struct LogRecord
    Public ReadOnly Field Time: Timestamp
    Public ReadOnly Field Level: LogLevel
    Public ReadOnly Field Module: String
    Public ReadOnly Field Message: String
    Public ReadOnly Field Fields: ImmutableArray<LogField>

    Public New(time: Timestamp, level: LogLevel, module: String, message: String)
        Time = time
        Level = level
        Module = module
        Message = message
    End New

    Public New(time: Timestamp, level: LogLevel, module: String, message: String,
               fields: ImmutableArray<LogField>)
        Time = time
        Level = level
        Module = module
        Message = message
        Fields = fields
    End New
End Struct

// Where Loggers' lines go: to each of its sinks, in the order they were added, once its filter
// writes the line's level for its module. Each sink gets the lines of every thread that logs, at
// once, so it must take them at once, as the console's does.
Public Shared Class LogOutput
    Field Chosen: Mutex<LogFilter>
    Field Sinks: Mutex<ImmutableArray<Sendable Func(LogRecord)>>

    // An output with no sinks, whose filter is filter.
    Public New(filter: LogFilter)
        Lock Chosen As chosen
            chosen = filter
        End Lock
    End New

    // Adds sink, which each line written after this goes to, after the sinks added before it.
    Public Method Add(sink: Sendable Func(LogRecord))
        Lock Sinks As sinks
            sinks = sinks.Add(sink)
        End Lock
    End Method

    // Takes every sink out, so lines go nowhere until one is added.
    Public Method Clear()
        Lock Sinks As sinks
            sinks = ImmutableArray<Sendable Func(LogRecord)>()
        End Lock
    End Method

    // The filter, which says what's written, or a new one, which the lines logged after it go by.
    Public Property Filter: LogFilter
        Get
            Lock Chosen As chosen
                Return chosen
            End Lock
        End Get
        Set(value)
            Lock Chosen As chosen
                chosen = value
            End Lock
        End Set
    End Property

    // Whether its filter writes a line at level for module.
    Public Method Allows(module: String, level: LogLevel): Bool => Filter.Allows(module, level)

    // Gives record to each sink, if its filter writes it. The sinks are called outside the lock,
    // so one can log, or add a sink, which the next line goes to.
    Public Method Write(record: LogRecord)
        If !Allows(record.Module, record.Level) Then Return
        Local sinks = ImmutableArray<Sendable Func(LogRecord)>()
        Lock Sinks As held
            sinks = held
        End Lock

        For sink In sinks
            sink(record)
        End For
    End Method
End Class
