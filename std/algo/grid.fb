//! Searches on grids of cells, each a Vec2i from (0, 0) to (width - 1, height - 1): the cells next
//! to one, the path between two by A*, and flow fields, which give every cell its way to the
//! nearest goal at once, for many agents going to the same places. A step goes along an axis, or
//! diagonally too, which costs the square root of 2 times as much and doesn't cut a corner a wall
//! is on.

Import std.core
Import std.collections
Import std.math
Import std.algo.search

/// How much more a diagonal step costs than one along an axis: the square root of 2.
Const Diagonal: Double = 1.4142135623730951

/// The steps from a cell: along the axes, right, down, left, and up, then the diagonals.
Function Steps(diagonal: Bool): Vec2i[]
    If !diagonal Then Return [Vec2i(1, 0), Vec2i(0, 1), Vec2i(-1, 0), Vec2i(0, -1)]
    Return [Vec2i(1, 0), Vec2i(0, 1), Vec2i(-1, 0), Vec2i(0, -1), Vec2i(1, 1), Vec2i(-1, 1),
            Vec2i(-1, -1), Vec2i(1, -1)]
End Function

/// Panics when the grid's size is negative, or has more cells than an Int counts.
@PanicsAtCaller
Function CheckSize(width: Int, height: Int)
    If width < 0 || height < 0 Then Panic("a grid can't be {width} by {height}")
    If width.CheckedMultiply(height) == Null
        Panic("a grid {width} by {height} has more cells than an Int counts")
    End If
End Function

/// Whether the cell is on the grid.
Function OnGrid(width: Int, height: Int, cell: Vec2i): Bool
    Return cell.x >= 0 && cell.x < width && cell.y >= 0 && cell.y < height
End Function

/// Panics when the cell is off the grid.
@PanicsAtCaller
Function CheckCell(width: Int, height: Int, cell: Vec2i)
    If !OnGrid(width, height, cell) Then Panic("{cell} is off a grid {width} by {height}")
End Function

/// The cells next to `cell` on a grid of `width` by `height`, those on it only: the four along the
/// axes, right, down, left, and up, then, when `diagonal`, the four corners. A negative size, or a
/// cell off the grid, panics.
@PanicsAtCaller
Public Function GridNeighbors(width: Int, height: Int, cell: Vec2i, diagonal: Bool = False): Vec2i[]
    CheckSize(width, height)
    CheckCell(width, height, cell)
    Local cells: Vec2i[] = []
    For step In Steps(diagonal)
        Local next = cell + step
        If OnGrid(width, height, next) Then cells.Add(next)
    End For
    Return cells
End Function

/// The cells a step from cell goes to, with how many times a step along an axis each step is: those
/// on the grid that cost gives a cost for, and diagonal ones only between two such cells.
Function Moves(width: Int, height: Int, cell: Vec2i, cost: Func(Vec2i): Double?,
               diagonal: Bool): (Vec2i, Double)[]
    Local moves: (Vec2i, Double)[] = []
    For step In Steps(diagonal)
        Local next = cell + step
        If !OnGrid(width, height, next) || cost(next) == Null Then Continue
        If step.x == 0 || step.y == 0
            moves.Add((next, 1))
        ElseIf cost(Vec2i(next.x, cell.y)) != Null && cost(Vec2i(cell.x, next.y)) != Null
            moves.Add((next, Diagonal))
        End If
    End For
    Return moves
End Function

/// The path across a grid of `width` by `height` from `start` to `goal`, by A*, through the cells
/// `passable` says can be walked, with steps along the axes, or diagonal ones too when `diagonal`,
/// and its cost: a step along an axis is 1, and a diagonal one the square root of 2. The `start`
/// needn't be a cell `passable` says can be walked; Null when the `goal` can't be reached. A
/// `start` or `goal` off the grid panics.
@PanicsAtCaller
Public Function GridPath(width: Int, height: Int, start: Vec2i, goal: Vec2i,
                         passable: Func(Vec2i): Bool, diagonal: Bool = False): Path<Vec2i, Double>?
    CheckSize(width, height)
    CheckCell(width, height, start)
    CheckCell(width, height, goal)
    Local cost = Function(cell: Vec2i): Double?
        If passable(cell) Then Return 1
        Return Null
    End Function
    // The octile distance, or the Manhattan one without diagonals: never more than what's left.
    Local guess = Function(cell: Vec2i): Double
        Local across: Double = Abs(goal.x - cell.x)
        Local down: Double = Abs(goal.y - cell.y)
        If !diagonal Then Return across + down
        Return across + down + (Diagonal - 2) * Min(across, down)
    End Function

    // Every cell costs 1 to enter, so a step's weight is how many steps along an axis it is.
    Return AStar(start, Function(cell) => Moves(width, height, cell, cost, diagonal), guess,
                 Function(cell) => cell == goal)
End Function

/// A flow field over a grid: each cell's cheapest way to the nearest of its goals, worked out once
/// from the goals outward, so any number of agents follow it with no search of their own. Entering
/// a cell costs what cost gives for it, and a cell it gives Null for is a wall that no path goes
/// through; a step along an axis costs that, and a diagonal one the square root of 2 times it.
Public Class FlowField
    Field Columns: Int
    Field Rows: Int
    /// Each cell's cost to its nearest goal, row by row, or -1 for one that can't reach any.
    Field Distances: Double[]
    /// The cell each steps to, as an index row by row, or -1 for a goal or one that can't reach
    /// any.
    Field Nexts: Int[]

    /// A flow field over a grid of `width` by `height` to the `goals`, through the cells `cost`
    /// gives a cost for, along the axes, or diagonally too. A goal that `cost` gives Null for
    /// isn't one. A negative size, a goal off the grid, or a cost that's negative or NaN panics.
    @PanicsAtCaller
    Public New(width: Int, height: Int, goals: Vec2i[], cost: Func(Vec2i): Double?,
               diagonal: Bool = False)
        CheckSize(width, height)
        For goal In goals
            CheckCell(width, height, goal)
        End For

        Columns = width
        Rows = height
        Distances = []
        Distances.Resize(width * height, -1)
        Nexts = []
        Nexts.Resize(width * height, -1)
        // Each cell's cost, asked once.
        Local costs: Double?[] = []
        costs.Reserve(width * height)
        For y = 0 Until height
            For x = 0 Until width
                Local entering = cost(Vec2i(x, y))
                If entering != Null
                    If !(entering >= 0)
                        Panic("({x}, {y}) costs {entering}, but a cost can't be negative or NaN")
                    End If
                End If
                costs.Add(entering)
            End For
        End For
        Local costAt = Function(cell: Vec2i): Double? => costs[cell.y * width + cell.x]

        // From every goal at once, outward, through one start before them all: a cell's way to a
        // goal is the reverse of the goal's way to it, so each step costs entering the cell it came
        // from, the one nearer the goals, and that cell is where the cell steps to.
        Local goalsOnly: (Vec2i, Double)[] = []
        For goal In goals
            If costAt(goal) != Null Then goalsOnly.Add((goal, 0))
        End For
        Local before = Vec2i(-1, -1)
        Local backward = Function(cell: Vec2i): (Vec2i, Double)[]
            If cell == before Then Return goalsOnly
            Local entering = costAt(cell) ?? 0
            Local steps: (Vec2i, Double)[] = []
            For move In Moves(width, height, cell, costAt, diagonal)
                steps.Add((move.0, entering * move.1))
            End For
            Return steps
        End Function

        Local paths = DijkstraAll(before, backward)
        For cell In paths.Nodes
            If cell == before Then Continue
            Local at = cell.y * width + cell.x
            Distances[at] = paths.CostTo(cell) ?? -1
            Local next = paths.Parent(cell) ?? before
            If next != before Then Nexts[at] = next.y * width + next.x
        End For
    End New

    /// How many cells wide its grid is.
    Public Property Width: Int
        Get => Columns
    End Property

    /// How many cells high its grid is.
    Public Property Height: Int
        Get => Rows
    End Property

    /// Whether the `cell` has a way to a goal, the goals included. A cell off the grid panics.
    @PanicsAtCaller
    Public Method Reaches(cell: Vec2i): Bool => DistanceAt(cell) >= 0

    /// The cost from the `cell` to its nearest goal, 0 at a goal, or Null where it has no way to
    /// one. A cell off the grid panics.
    @PanicsAtCaller
    Public Method Distance(cell: Vec2i): Double?
        Local distance = DistanceAt(cell)
        If distance < 0 Then Return Null
        Return distance
    End Method

    /// The `cell` to step to from this one on its cheapest way to a goal, or Null at a goal or
    /// where there's no way to one. A cell off the grid panics.
    @PanicsAtCaller
    Public Method Next(cell: Vec2i): Vec2i?
        CheckCell(Columns, Rows, cell)
        Local next = Nexts[cell.y * Columns + cell.x]
        If next < 0 Then Return Null
        Return Vec2i(next % Columns, next / Columns)
    End Method

    /// Which way to go from the `cell`, of length 1, toward its next cell: the zero vector at a
    /// goal or where there's no way to one. A cell off the grid panics.
    @PanicsAtCaller
    Public Method Direction(cell: Vec2i): Vec2
        Local next = Next(cell)
        If next == Null Then Return Vec2.Zero()
        Return Normalize((next - cell).ToVec2())
    End Method

    @PanicsAtCaller
    Method DistanceAt(cell: Vec2i): Double
        CheckCell(Columns, Rows, cell)
        Return Distances[cell.y * Columns + cell.x]
    End Method
End Class
