//! Permutations and Combinations: every order, or every choice, of an array's elements, made one
//! at a time as a For ... In or an adapter asks, each a new array, in the order of the elements'
//! positions, as Python's itertools gives them; and Factorial and Binomial, which count them. The
//! elements are taken by position, so equal ones still make orders and choices of their own.

Import std.core
Import std.math

/// Gives every order of count elements of an array, from the first order by position.
Public Class PermutationIterator<T> Implements Iterator<T[]>
    Field Items: T[]
    /// How many elements each gives.
    Field Size: Int
    /// Which element is at each place, and how many turns each place has left, as itertools has
    /// them.
    Field Indices: Int[] = []
    Field Turns: Int[] = []
    Field Started: Bool
    Field Done: Bool

    New(items: T[], count: Int)
        Items = items
        Size = count
        // More than there are gives none, which needs nothing kept.
        Done = count > items.Count
        If Done Then Return
        For i = 0 Until items.Count
            Indices.Add(i)
        End For
        For i = 0 Until count
            Turns.Add(items.Count - i)
        End For
    End New

    Public Method Next(): T[]?
        If Done Then Return Null
        If !Started
            Started = True
            Return Current()
        End If

        Local n = Items.Count
        Local i = Size - 1
        While i >= 0
            Turns[i]--
            If Turns[i] == 0
                // This place has had every element after it: they go round, and the place before
                // takes its turn.
                Local first = Indices[i]
                For j = i Until n - 1
                    Indices[j] = Indices[j + 1]
                End For
                Indices[n - 1] = first
                Turns[i] = n - i
            Else
                Local j = n - Turns[i]
                Local held = Indices[i]
                Indices[i] = Indices[j]
                Indices[j] = held
                Return Current()
            End If
            i--
        End While
        Done = True
        Return Null
    End Method

    /// The elements at the first Size places.
    Method Current(): T[]
        Local order: T[] = []
        order.Reserve(Size)
        For i = 0 Until Size
            order.Add(Items[Indices[i]])
        End For
        Return order
    End Method
End Class

/// Gives every choice of count elements of an array, each in the array's order, from the first
/// elements on.
Public Class CombinationIterator<T> Implements Iterator<T[]>
    Field Items: T[]
    /// How many elements each gives.
    Field Size: Int
    /// Which elements the choice has, in order.
    Field Indices: Int[] = []
    Field Started: Bool
    Field Done: Bool

    New(items: T[], count: Int)
        Items = items
        Size = count
        // More than there are gives none, which needs nothing kept.
        Done = count > items.Count
        If Done Then Return
        For i = 0 Until count
            Indices.Add(i)
        End For
    End New

    Public Method Next(): T[]?
        If Done Then Return Null
        If !Started
            Started = True
            Return Current()
        End If

        // The last place that can still move up, then each after it just after the one before.
        Local n = Items.Count
        Local i = Size - 1
        While i >= 0 && Indices[i] == i + n - Size
            i--
        End While
        If i < 0
            Done = True
            Return Null
        End If

        Indices[i]++
        For j = i + 1 Until Size
            Indices[j] = Indices[j - 1] + 1
        End For
        Return Current()
    End Method

    /// The chosen elements.
    Method Current(): T[]
        Local choice: T[] = []
        choice.Reserve(Size)
        For at In Indices
            choice.Add(Items[at])
        End For
        Return choice
    End Method
End Class

/// Every order of the array's elements: n! of them, from the array's own order. The array is
/// copied, so changing it doesn't change them.
Public Function Permutations<T>(items: T[]): PermutationIterator<T>
    Return PermutationIterator<T>(items.Clone(), items.Count)
End Function

/// Every order of count of the array's elements: n! / (n - count)! of them, none when count is more
/// than n, and one empty one for 0. The array is copied. A negative count panics.
@PanicsAtCaller
Public Function Permutations<T>(items: T[], count: Int): PermutationIterator<T>
    If count < 0 Then Panic("Permutations takes a count that isn't negative, not {count}")
    Return PermutationIterator<T>(items.Clone(), count)
End Function

/// Every choice of count of the array's elements, each in the array's order: Binomial(n, count) of
/// them, none when count is more than n, and one empty one for 0. The array is copied. A negative
/// count panics.
@PanicsAtCaller
Public Function Combinations<T>(items: T[], count: Int): CombinationIterator<T>
    If count < 0 Then Panic("Combinations takes a count that isn't negative, not {count}")
    Return CombinationIterator<T>(items.Clone(), count)
End Function

/// n!, the number of orders of n things, from 0! = 1 to 20!, the most a Long holds. Any other n
/// panics.
@PanicsAtCaller
Public Function Factorial(n: Int): Long
    If n < 0 || n > 20 Then Panic("Factorial takes an n from 0 to 20, not {n}")
    Local product: Long = 1
    For i = 2 To n
        product *= i
    End For
    Return product
End Function

/// The number of ways to choose k of n things, "n choose k": 0 for a k below 0 or above n. A
/// negative n panics, and so does a count too large for a Long.
@PanicsAtCaller
Public Function Binomial(n: Int, k: Int): Long
    If n < 0 Then Panic("Binomial takes an n that isn't negative, not {n}")
    If k < 0 || k > n Then Return 0
    // Each step is a binomial itself, n - k + i choose i, so none is larger than the answer.
    Local fewer = Min(k, n - k)
    Local count: Long = 1
    For i = 1 To fewer
        Local step: Long = i
        Local common = Gcd(count, step)
        Local next = (count / common).CheckedMultiply((n - fewer + i) / (step / common))
        If next == Null Then Panic("{n} choose {k} is too large for a Long")
        count = next
    End For
    Return count
End Function
