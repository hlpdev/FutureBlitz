// Delaunay triangulation and Voronoi diagrams of points in 2D, and Lloyd relaxation, which moves
// points apart until they're evenly spread, for maps, meshes, and placing things. The Delaunay
// triangles are those whose circumcircles hold none of the points, which keeps them as near
// equilateral as the points allow; a point's Voronoi cell is where's nearer it than any other.
// The math is in Doubles, with Shewchuk's exact predicates, so points however near each other
// give a triangulation. The triangulation is Bowyer and Watson's, a point at a time in order of x
// then y, with a point at infinity whose triangles are the hull's outside, so the hull comes out
// whole; points on one circle are triangulated by the order they come in.

Import std.core
Import std.collections
Import std.math

// The predicates, after Jonathan Shewchuk's robust ones: worked out in Doubles first, whose error
// bound says when the sign is sure, and when it isn't, exactly, in expansions, sums of Doubles
// that don't overlap, smallest first. Every product a Float's coordinates make fits a Double
// without overflowing or underflowing, so the signs are exact for any points a Vec2 holds.

// a + b as the Double nearest and what rounding left off.
Function TwoSum(a: Double, b: Double): (Double, Double)
    Local sum = a + b
    Local partB = sum - a
    Local partA = sum - partB
    Return (sum, (a - partA) + (b - partB))
End Function

// a + b, where a's magnitude isn't below b's, as TwoSum gives it.
Function FastTwoSum(a: Double, b: Double): (Double, Double)
    Local sum = a + b
    Return (sum, b - (sum - a))
End Function

// The Double's high 26 bits and the rest, by Veltkamp's splitting.
Function Halves(a: Double): (Double, Double)
    Local scaled = 134217729.0 * a
    Local high = scaled - (scaled - a)
    Return (high, a - high)
End Function

// a * b as the Double nearest and what rounding left off, by Dekker's product.
Function TwoProduct(a: Double, b: Double): (Double, Double)
    Local product = a * b
    Local aHigh, aLow = Halves(a)
    Local bHigh, bLow = Halves(b)
    Local error = product - aHigh * bHigh - aLow * bHigh - aHigh * bLow
    Return (product, aLow * bLow - error)
End Function

// a * b, exactly, as an expansion.
Function Exactly(a: Double, b: Double): Double[]
    Local high, low = TwoProduct(a, b)
    Return low == 0 ? [high] : [low, high]
End Function

// The expansion plus the Double, exactly, without zeros: Shewchuk's grow_expansion_zeroelim.
Function Grown(e: Double[], b: Double): Double[]
    Local grown: Double[] = []
    Local carry = b
    For component In e
        Local sum, rest = TwoSum(carry, component)
        carry = sum
        If rest != 0 Then grown.Add(rest)
    End For
    If carry != 0 || grown.Count == 0 Then grown.Add(carry)
    Return grown
End Function

// The sum of two expansions, exactly, a Double of f's at a time.
Function Plus(e: Double[], f: Double[]): Double[]
    Local sum = e
    For component In f
        sum = Grown(sum, component)
    End For
    Return sum
End Function

// e - f, exactly.
Function Minus(e: Double[], f: Double[]): Double[]
    Local negated: Double[] = []
    For component In f
        negated.Add(-component)
    End For
    Return Plus(e, negated)
End Function

// The expansion times the Double, exactly, without zeros: Shewchuk's scale_expansion_zeroelim.
Function Scaled(e: Double[], b: Double): Double[]
    Local scaled: Double[] = []
    Local carry, low = TwoProduct(e[0], b)
    If low != 0 Then scaled.Add(low)
    For i = 1 Until e.Count
        Local high, part = TwoProduct(e[i], b)
        Local sum, rest = TwoSum(carry, part)
        If rest != 0 Then scaled.Add(rest)
        Local next, left = FastTwoSum(high, sum)
        carry = next
        If left != 0 Then scaled.Add(left)
    End For
    If carry != 0 || scaled.Count == 0 Then scaled.Add(carry)
    Return scaled
End Function

// The expansion's sign, its largest component's.
Function SignOf(e: Double[]): Double => e[e.Count - 1]

// The 2 by 2 cross term a.x * b.y - b.x * a.y, exactly.
Function CrossTerm(ax: Double, ay: Double, bx: Double, by: Double): Double[]
    Return Minus(Exactly(ax, by), Exactly(bx, ay))
End Function

// Above 0 when a, b, and c go counterclockwise, below when clockwise, and 0 on a line, as twice
// their triangle's area, whose sign is exact.
Function Orient(ax: Double, ay: Double, bx: Double, by: Double, cx: Double, cy: Double): Double
    Local left = (ax - cx) * (by - cy)
    Local right = (ay - cy) * (bx - cx)
    Local determinant = left - right
    // Of opposite signs, or one 0, the terms can't cancel.
    If (left > 0 && right <= 0) || (left < 0 && right >= 0) || left == 0 Then Return determinant
    Local bound = 3.3306690738754716e-16 * (Abs(left) + Abs(right))
    If determinant >= bound || -determinant >= bound Then Return determinant
    // ax * by - ax * cy + bx * cy - bx * ay + cx * ay - cx * by, exactly.
    Local terms = Plus(Plus(Minus(Exactly(ax, by), Exactly(ax, cy)),
                          Minus(Exactly(bx, cy), Exactly(bx, ay))),
                      Minus(Exactly(cx, ay), Exactly(cx, by)))
    Return SignOf(terms)
End Function

// Above 0 when d is inside the circle through a, b, and c, counterclockwise, below when it's
// outside, and 0 on it, with an exact sign.
Function InCircle(ax: Double, ay: Double, bx: Double, by: Double, cx: Double, cy: Double,
                  dx: Double, dy: Double): Double
    Local adx = ax - dx
    Local ady = ay - dy
    Local bdx = bx - dx
    Local bdy = by - dy
    Local cdx = cx - dx
    Local cdy = cy - dy
    Local bc = bdx * cdy
    Local cb = cdx * bdy
    Local ca = cdx * ady
    Local ac = adx * cdy
    Local ab = adx * bdy
    Local ba = bdx * ady
    Local liftA = adx * adx + ady * ady
    Local liftB = bdx * bdx + bdy * bdy
    Local liftC = cdx * cdx + cdy * cdy
    Local determinant = liftA * (bc - cb) + liftB * (ca - ac) + liftC * (ab - ba)
    Local permanent = (Abs(bc) + Abs(cb)) * liftA + (Abs(ca) + Abs(ac)) * liftB +
                      (Abs(ab) + Abs(ba)) * liftC
    Local bound = 1.1102230246251577e-15 * permanent
    If determinant > bound || -determinant > bound Then Return determinant
    Return ExactInCircle(ax, ay, bx, by, cx, cy, dx, dy)
End Function

// InCircle's sign, exactly: the 4 by 4 determinant of each point's x, y, x^2 + y^2, and 1,
// expanded by the lifts, each times the other three points' orientation, from cross terms.
Function ExactInCircle(ax: Double, ay: Double, bx: Double, by: Double, cx: Double, cy: Double,
                       dx: Double, dy: Double): Double
    Local ab = CrossTerm(ax, ay, bx, by)
    Local bc = CrossTerm(bx, by, cx, cy)
    Local cd = CrossTerm(cx, cy, dx, dy)
    Local da = CrossTerm(dx, dy, ax, ay)
    Local ac = CrossTerm(ax, ay, cx, cy)
    Local bd = CrossTerm(bx, by, dx, dy)
    Local bcd = Minus(Plus(bc, cd), bd)
    Local cda = Plus(Plus(cd, da), ac)
    Local dab = Plus(Plus(da, ab), bd)
    Local abc = Minus(Plus(ab, bc), ac)
    Local terms = Minus(Lifted(bcd, ax, ay), Lifted(cda, bx, by))
    terms = Plus(terms, Lifted(dab, cx, cy))
    terms = Minus(terms, Lifted(abc, dx, dy))
    Return SignOf(terms)
End Function

// The expansion times x^2 + y^2, exactly.
Function Lifted(e: Double[], x: Double, y: Double): Double[]
    Return Plus(Scaled(Scaled(e, x), x), Scaled(Scaled(e, y), y))
End Function

// A triangulation as it's built: three corners to a triangle, counterclockwise, -1 for the point at
// infinity, and across each edge, from corner k to the next, the triangle there.
Class Mesh
    Field X: Double[] = []
    Field Y: Double[] = []
    Field Corners: Int[] = []
    Field Across: Int[] = []
    Field Alive: Bool[] = []
    // When each triangle was last found in a cavity, so no marks need clearing.
    Field Marks: Int[] = []
    Field Mark: Int
    // Each corner's new triangle as a point goes in, by corner, the point at infinity last.
    Field Starts: Int[] = []
    // A triangle made last, where a search for the next point starts.
    Field Last: Int

    New(points: Vec2[])
        For point In points
            X.Add(point.x)
            Y.Add(point.y)
        End For
        Starts.Resize(points.Count + 1, -1)
    End New

    // Adds a triangle with no neighbors yet, and gives it.
    Method AddTriangle(a: Int, b: Int, c: Int): Int
        Local triangle = Alive.Count
        Corners.Add(a)
        Corners.Add(b)
        Corners.Add(c)
        Across.AddAll([-1, -1, -1])
        Alive.Add(True)
        Marks.Add(0)
        Return triangle
    End Method

    // Sets which triangles are across each other's edges: a's edge i and b's edge j.
    Method Link(a: Int, i: Int, b: Int, j: Int)
        Across[a * 3 + i] = b
        Across[b * 3 + j] = a
    End Method

    // The triangle's first real corner past the point at infinity, or -1 for a real triangle.
    Method InfiniteAt(triangle: Int): Int
        For k = 0 Until 3
            If Corners[triangle * 3 + k] < 0 Then Return k
        End For
        Return -1
    End Method

    // Whether a point going in breaks the triangle: it's inside the triangle's circumcircle, or for
    // one with the point at infinity, outside the hull's edge, or on it between its ends.
    Method Conflicts(triangle: Int, point: Int): Bool
        Local px = X[point]
        Local py = Y[point]
        Local infinite = InfiniteAt(triangle)
        If infinite < 0
            Local a = Corners[triangle * 3]
            Local b = Corners[triangle * 3 + 1]
            Local c = Corners[triangle * 3 + 2]
            Return InCircle(X[a], Y[a], X[b], Y[b], X[c], Y[c], px, py) > 0
        End If

        Local u = Corners[triangle * 3 + (infinite + 1) % 3]
        Local v = Corners[triangle * 3 + (infinite + 2) % 3]
        Local side = Orient(X[u], Y[u], X[v], Y[v], px, py)
        If side != 0 Then Return side > 0
        // On the edge's line, it's between the ends where it's between them by x, or by y for an
        // edge straight up, which compares exactly.
        If X[u] != X[v] Then Return (px > X[u]) == (px < X[v]) && px != X[u] && px != X[v]
        Return (py > Y[u]) == (py < Y[v]) && py != Y[u] && py != Y[v]
    End Method

    // A triangle the point breaks: found by walking from the last triangle made toward the point,
    // or, should the walk go round, by looking at every triangle.
    Method Locate(point: Int): Int
        Local px = X[point]
        Local py = Y[point]
        Local triangle = Last
        Local steps = 0
        While steps <= Alive.Count
            steps++
            Local infinite = InfiniteAt(triangle)
            If infinite >= 0
                If Conflicts(triangle, point) Then Return triangle
                triangle = Across[triangle * 3 + (infinite + 1) % 3]
                Continue
            End If

            Local moved = False
            For k = 0 Until 3
                Local a = Corners[triangle * 3 + k]
                Local b = Corners[triangle * 3 + (k + 1) % 3]
                If Orient(X[a], Y[a], X[b], Y[b], px, py) < 0
                    triangle = Across[triangle * 3 + k]
                    moved = True
                    Break
                End If
            End For
            If !moved Then Return triangle
        End While

        For t = 0 Until Alive.Count
            If Alive[t] && Conflicts(t, point) Then Return t
        End For
        Return -1
    End Method

    // Puts the point in: the triangles it breaks go, and new ones join it to the cavity's edges.
    Method Insert(point: Int)
        Local first = Locate(point)
        If first < 0 Then Return
        Mark++
        Marks[first] = Mark
        Local cavity = [first]
        // The cavity's edges: each from corner a to b, with the triangle across and its edge.
        Local edgeA: Int[] = []
        Local edgeB: Int[] = []
        Local outside: Int[] = []
        Local outsideEdge: Int[] = []
        Local next = 0
        While next < cavity.Count
            Local triangle = cavity[next]
            next++
            For k = 0 Until 3
                Local neighbor = Across[triangle * 3 + k]
                If Marks[neighbor] == Mark Then Continue
                If Conflicts(neighbor, point)
                    Marks[neighbor] = Mark
                    cavity.Add(neighbor)
                    Continue
                End If

                edgeA.Add(Corners[triangle * 3 + k])
                edgeB.Add(Corners[triangle * 3 + (k + 1) % 3])
                outside.Add(neighbor)
                For j = 0 Until 3
                    If Across[neighbor * 3 + j] == triangle
                        outsideEdge.Add(j)
                        Break
                    End If
                End For
            End For
        End While

        For triangle In cavity
            Alive[triangle] = False
        End For

        // A triangle on each edge, then each linked to the ones beside it, by where they start.
        Local made: Int[] = []
        For i = 0 Until edgeA.Count
            Local triangle = AddTriangle(edgeA[i], edgeB[i], point)
            Link(triangle, 0, outside[i], outsideEdge[i])
            Starts[StartOf(edgeA[i])] = triangle
            made.Add(triangle)
        End For
        For i = 0 Until made.Count
            Link(made[i], 1, Starts[StartOf(edgeB[i])], 2)
        End For

        Last = made[0]
        For triangle In made
            If InfiniteAt(triangle) < 0 Then Last = triangle
        End For
    End Method

    // Where a corner's new triangle is in Starts: the point at infinity's is last.
    Method StartOf(corner: Int): Int => corner < 0 ? Starts.Count - 1 : corner
End Class

// The points' indices by x, then y, without repeats: what Delaunay puts in, and, for each point,
// the first index of a point equal to it. A coordinate that's infinite or NaN panics.
@PanicsAtCaller
Function Ordered(points: Vec2[]): (Int[], Int[])
    Local order: Int[] = []
    For i = 0 Until points.Count
        Local point = points[i]
        If !IsFinite(point.x) || !IsFinite(point.y)
            Panic("a point's coordinates are finite, not {point}")
        End If
        order.Add(i)
    End For
    order.Sort(Function(a: Int, b: Int): Bool
        Local p = points[a]
        Local q = points[b]
        If p.x != q.x Then Return p.x < q.x
        If p.y != q.y Then Return p.y < q.y
        Return a < b
    End Function)

    Local same: Int[] = []
    same.Resize(points.Count, -1)
    Local distinct: Int[] = []
    For i In order
        If distinct.Count > 0 && points[distinct[distinct.Count - 1]] == points[i]
            same[i] = distinct[distinct.Count - 1]
        Else
            same[i] = i
            distinct.Add(i)
        End If
    End For
    Return (distinct, same)
End Function

// The triangulation of points that sees each repeat once, its triangles' corners as indices into
// points, counterclockwise.
Function Triangulate(points: Vec2[], order: Int[]): (Int, Int, Int)[]
    Local none: (Int, Int, Int)[] = []
    If order.Count < 3 Then Return none
    Local mesh = Mesh(points)
    // The first triangle: the first two points, and the first after them not on their line.
    Local a = order[0]
    Local b = order[1]
    Local third = -1
    For i = 2 Until order.Count
        Local c = order[i]
        If Orient(mesh.X[a], mesh.Y[a], mesh.X[b], mesh.Y[b], mesh.X[c], mesh.Y[c]) != 0
            third = i
            Break
        End If
    End For
    If third < 0 Then Return none

    Local c = order[third]
    If Orient(mesh.X[a], mesh.Y[a], mesh.X[b], mesh.Y[b], mesh.X[c], mesh.Y[c]) < 0
        Swap(ByRef a, ByRef b)
    End If
    Local inner = mesh.AddTriangle(a, b, c)
    // Outside each of its edges, a triangle with the point at infinity, each beside the next.
    Local outerAB = mesh.AddTriangle(b, a, -1)
    Local outerBC = mesh.AddTriangle(c, b, -1)
    Local outerCA = mesh.AddTriangle(a, c, -1)
    mesh.Link(inner, 0, outerAB, 0)
    mesh.Link(inner, 1, outerBC, 0)
    mesh.Link(inner, 2, outerCA, 0)
    mesh.Link(outerAB, 1, outerCA, 2)
    mesh.Link(outerBC, 1, outerAB, 2)
    mesh.Link(outerCA, 1, outerBC, 2)
    mesh.Last = inner

    For i = 2 Until order.Count
        If i != third Then mesh.Insert(order[i])
    End For

    Local triangles: (Int, Int, Int)[] = []
    For t = 0 Until mesh.Alive.Count
        If mesh.Alive[t] && mesh.InfiniteAt(t) < 0
            triangles.Add((mesh.Corners[t * 3], mesh.Corners[t * 3 + 1], mesh.Corners[t * 3 + 2]))
        End If
    End For
    Return triangles
End Function

// The Delaunay triangulation of the points: triangles whose circumcircles hold none of the points,
// each as the indices of its corners in points, counterclockwise. Fewer than three points, or
// points all on a line, have none, and of points that are equal, only the first is a corner. A
// coordinate that's infinite or NaN panics.
@PanicsAtCaller
Public Function Delaunay(points: Vec2[]): (Int, Int, Int)[]
    Local order, _ = Ordered(points)
    Return Triangulate(points, order)
End Function

// The polygon, counterclockwise, cut down to the side of the line from a to b's middle, at right
// angles to it, that a is on: Sutherland and Hodgman's clipping, by one edge.
Function KeepNearer(polygon: (Double, Double)[], ax: Double, ay: Double, bx: Double,
                    by: Double): (Double, Double)[]
    // A point is on a's side where (p - middle) . (b - a) is below 0.
    Local nx = bx - ax
    Local ny = by - ay
    Local mx = (ax + bx) / 2
    Local my = (ay + by) / 2
    Local kept: (Double, Double)[] = []
    For i = 0 Until polygon.Count
        Local p = polygon[i]
        Local q = polygon[(i + 1) % polygon.Count]
        Local sideP = (p.0 - mx) * nx + (p.1 - my) * ny
        Local sideQ = (q.0 - mx) * nx + (q.1 - my) * ny
        If sideP <= 0 Then kept.Add(p)
        If (sideP < 0 && sideQ > 0) || (sideP > 0 && sideQ < 0)
            Local t = sideP / (sideP - sideQ)
            kept.Add((p.0 + (q.0 - p.0) * t, p.1 + (q.1 - p.1) * t))
        End If
    End For
    Return kept
End Function

// Panics unless bounds is somewhere, with a size that isn't negative.
@PanicsAtCaller
Function CheckBounds(bounds: Rect)
    If !IsFinite(bounds.X) || !IsFinite(bounds.Y) || !(bounds.Width >= 0) ||
       !(bounds.Height >= 0) || !IsFinite(bounds.Width) || !IsFinite(bounds.Height)
        Panic("bounds are finite, with a size that isn't negative, not {bounds}")
    End If
End Function

// Each point's Voronoi cell inside bounds: the polygon, counterclockwise, of where in bounds is no
// nearer another point, empty for a point whose cell is outside bounds. Points that are equal share
// a cell, and fewer than two points have bounds' whole rectangle for theirs. A coordinate that's
// infinite or NaN, or bounds that aren't finite or have a negative size, panic.
@PanicsAtCaller
Public Function Voronoi(points: Vec2[], bounds: Rect): Vec2[][]
    CheckBounds(bounds)
    Local order, same = Ordered(points)
    // Each point's neighbors: those it shares a Delaunay edge with, which are the only ones whose
    // cells can touch its own, or every other point when there are no triangles.
    Local neighbors: Int[][] = []
    For i = 0 Until points.Count
        neighbors.Add([])
    End For
    Local triangles = Triangulate(points, order)
    If triangles.Count == 0
        For i In order
            For j In order
                If i != j Then neighbors[i].Add(j)
            End For
        End For
    End If

    // Each once, though an edge inside the hull is in two triangles: a second clip by the same
    // bisector could only add a corner along an edge, by rounding.
    Local meet = Function(i: Int, j: Int)
        If !neighbors[i].Contains(j) Then neighbors[i].Add(j)
    End Function
    For triangle In triangles
        Local a, b, c = triangle
        meet(a, b)
        meet(a, c)
        meet(b, c)
        meet(b, a)
        meet(c, a)
        meet(c, b)
    End For

    Local left: Double = bounds.X
    Local bottom: Double = bounds.Y
    Local right: Double = left + bounds.Width
    Local top: Double = bottom + bounds.Height
    Local cells: Vec2[][] = []
    For i = 0 Until points.Count
        Local site = same[i]
        If site != i
            cells.Add(cells[site].Clone())
            Continue
        End If

        Local polygon: (Double, Double)[] = [(left, bottom), (right, bottom), (right, top),
                                             (left, top)]
        Local x: Double = points[i].x
        Local y: Double = points[i].y
        For j In neighbors[i]
            If polygon.Count == 0 Then Break
            polygon = KeepNearer(polygon, x, y, points[j].x, points[j].y)
        End For

        Local cell: Vec2[] = []
        For corner In polygon
            cell.Add(Vec2(corner.0 As Float, corner.1 As Float))
        End For
        cells.Add(cell)
    End For
    Return cells
End Function

// The points moved, iterations times, each to the middle of its Voronoi cell in bounds, which
// spreads them evenly: Lloyd's relaxation. A point whose cell is empty stays. A negative number of
// iterations, a coordinate that's infinite or NaN, or bounds that aren't finite or have a negative
// size, panics.
@PanicsAtCaller
Public Function LloydRelax(points: Vec2[], bounds: Rect, iterations: Int = 1): Vec2[]
    If iterations < 0
        Panic("LloydRelax takes a count of iterations that isn't negative, not {iterations}")
    End If
    CheckBounds(bounds)
    Local moved = points.Clone()
    For pass = 1 To iterations
        Local cells = Voronoi(moved, bounds)
        For i = 0 Until moved.Count
            Local centroid = Centroid(cells[i])
            If centroid != Null Then moved[i] = centroid
        End For
    End For
    Return moved
End Function

// The polygon's centroid, the middle of its area, or Null for one with none.
Function Centroid(polygon: Vec2[]): Vec2?
    Local area: Double = 0
    Local x: Double = 0
    Local y: Double = 0
    For i = 0 Until polygon.Count
        Local p = polygon[i]
        Local q = polygon[(i + 1) % polygon.Count]
        Local cross: Double = (p.x As Double) * q.y - (q.x As Double) * p.y
        area += cross
        x += ((p.x As Double) + q.x) * cross
        y += ((p.y As Double) + q.y) * cross
    End For
    If area == 0 Then Return Null
    Return Vec2((x / (3 * area)) As Float, (y / (3 * area)) As Float)
End Function
