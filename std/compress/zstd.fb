//! Zstd (RFC 8878), over zstd. Its Compress and Decompress work at once, and its Compressor and
//! Decompressor take bytes in turn and give what came out of them so far, for data that comes in
//! parts. Levels go from 1, the fastest, to 22, the smallest, and are 3 by default, as zstd's;
//! those past 19 take much more memory. Each frame has its content's checksum, and a Compress's
//! says its size. A Decompress reads frames one after another, as zstd does, skipping skippable
//! ones.

Import std.core
Import std.compress.codec

Extern "runtime"
    Function fb_zstd_encoder_new(level: Int32): Ptr<Void>
    Function fb_zstd_encoder_add(encoder: Ptr<Void>, data: UInt8[], output: UInt8[])
    Function fb_zstd_encoder_finish(encoder: Ptr<Void>, data: UInt8[], output: UInt8[])
    Function fb_zstd_encoder_free(encoder: Ptr<Void>)
    Function fb_zstd_decoder_new(limit: Int64): Ptr<Void>
    Function fb_zstd_decoder_add(decoder: Ptr<Void>, data: UInt8[], output: UInt8[]): Int32
    Function fb_zstd_decoder_finish(decoder: Ptr<Void>, data: UInt8[], output: UInt8[]): Int32
    Function fb_zstd_decoder_message(decoder: Ptr<Void>): String
    Function fb_zstd_decoder_free(decoder: Ptr<Void>)
End Extern

/// Zstd's frames, of .zst files.
Public Struct Zstd
    /// Zstd isn't made: it's only its Static Methods.
    New()
    End New

    /// The `data`, compressed at the `level`. Panics when the `level` isn't from 1 to 22.
    @PanicsAtCaller
    Public Static Method Compress(data: UInt8[], level: Int = 3): UInt8[]
        Local encoder = Encoder(level)
        Local output: UInt8[] = []
        fb_zstd_encoder_finish(encoder, data, output)
        fb_zstd_encoder_free(encoder)
        Return output
    End Method

    /// The bytes the `data` is compressed from, each frame's after the last's, or an IOError when
    /// it isn't Zstd's, ends too soon, or would come to more than `limit` bytes. Panics when the
    /// `limit` is negative.
    @PanicsAtCaller
    Public Static Method Decompress(data: UInt8[],
                                    limit: Int = MOST_BYTES): UInt8[] Throws IOError
        CheckLimit(limit)
        Local decoder = fb_zstd_decoder_new(limit)
        Defer fb_zstd_decoder_free(decoder)
        Return Try Ended(decoder, data, limit)
    End Method
End Struct

/// Zstd's bytes made in turn: Add gives what compressing the bytes it takes has made so far, and
/// Finish what's left, which ends a frame, and starts again.
Public Class ZstdCompressor Implements Coder
    Field State: Ptr<Void>

    /// Panics when the `level` isn't from 1 to 22.
    @PanicsAtCaller
    Public New(level: Int = 3)
        State = Encoder(level)
    End New

    Public Method Add(data: UInt8[]): UInt8[]
        Local output: UInt8[] = []
        fb_zstd_encoder_add(State, data, output)
        Return output
    End Method

    Public Method Finish(): UInt8[]
        Local output: UInt8[] = []
        fb_zstd_encoder_finish(State, [], output)
        Return output
    End Method

    Method Destroy()
        fb_zstd_encoder_free(State)
    End Method
End Class

/// Zstd's bytes taken in turn, a frame after another: Add gives what the bytes it takes decompress
/// to so far, and Finish what's left once they've all been added, and starts again. Each throws
/// an IOError when the bytes aren't Zstd's or would come to more than the limit, and Finish when
/// they end too soon.
Public Class ZstdDecompressor Implements Coder
    Field State: Ptr<Void>
    Field Limit: Int

    /// Panics when the `limit` is negative.
    @PanicsAtCaller
    Public New(limit: Int = MOST_BYTES)
        CheckLimit(limit)
        State = fb_zstd_decoder_new(limit)
        Limit = limit
    End New

    Public Method Add(data: UInt8[]): UInt8[] Throws IOError
        Local output: UInt8[] = []
        Local result = fb_zstd_decoder_add(State, data, output)
        If result != 0 Then Try Failed(result, "Zstd", Limit, fb_zstd_decoder_message(State))
        Return output
    End Method

    Public Method Finish(): UInt8[] Throws IOError => Try Ended(State, [], Limit)

    Method Destroy()
        fb_zstd_decoder_free(State)
    End Method
End Class

/// A new encoder at the level.
@PanicsAtCaller
Function Encoder(level: Int): Ptr<Void>
    CheckLevel(level, 1, 22, "Zstd")
    Return fb_zstd_encoder_new(level)
End Function

/// What the decoder gives for data, the last there is, or the IOError its result means.
Function Ended(decoder: Ptr<Void>, data: UInt8[], limit: Int): UInt8[] Throws IOError
    Local output: UInt8[] = []
    Local result = fb_zstd_decoder_finish(decoder, data, output)
    If result != 0 Then Try Failed(result, "Zstd", limit, fb_zstd_decoder_message(decoder))
    Return output
End Function
