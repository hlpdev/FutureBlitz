//! Reading and writing zip archives.
//!
//! Zip's archives, over minizip-ng: Zip.Read gives a ZipReader of a zip's entries, and a ZipWriter
//! makes a new zip of entries stored or compressed by Deflate, LZMA, XZ, or Zstd; every zip tool
//! reads Deflate's, and newer ones the rest. Zip64 comes in where sizes need it. Names are UTF-8:
//! a zip's that don't say so, and aren't, are read as code page 437, as MS-DOS wrote them. A zip's
//! encryption isn't supported. An entry's time is its extra fields', which say it in UTC, or else
//! its DOS date's, read as UTC, as nothing says its zone; what a ZipWriter makes was last changed
//! on 1980-01-01 unless it's told otherwise, so every program and OS makes the same bytes.
//!
//! # Examples
//!
//! ```
//! Local writer = ZipWriter()
//! writer.Add("small.txt", "x".Bytes, ZipMethod.STORE)
//! writer.AddFolder("empty")
//! Local reader = Try Zip.Read(writer.Finish())
//! Expect(reader.Count == 2 && reader.Entries[0].Size == 1)
//! Local small = Try reader.ReadAt(0)
//! Expect(small == "x".Bytes)
//! ```

Import std.core
Import std.collections.view
Import std.time.timestamp
Import std.compress.archive
Import std.compress.codec

Extern "runtime"
    Function fb_zip_reader_new(data: UInt8[]): Ptr<Void>
    Function fb_zip_reader_result(reader: Ptr<Void>): Int32
    Function fb_zip_reader_count(reader: Ptr<Void>): Int64
    Function fb_zip_reader_name(reader: Ptr<Void>, index: Int64): String
    Function fb_zip_reader_size(reader: Ptr<Void>, index: Int64): Int64
    Function fb_zip_reader_kind(reader: Ptr<Void>, index: Int64): Int32
    Function fb_zip_reader_target(reader: Ptr<Void>, index: Int64): String
    Function fb_zip_reader_seconds(reader: Ptr<Void>, index: Int64): Int64
    Function fb_zip_reader_nanos(reader: Ptr<Void>, index: Int64): Int32
    Function fb_zip_reader_mode(reader: Ptr<Void>, index: Int64): Int32
    Function fb_zip_reader_read(reader: Ptr<Void>, index: Int64, output: UInt8[]): Int32
    Function fb_zip_reader_message(reader: Ptr<Void>): String
    Function fb_zip_reader_free(reader: Ptr<Void>)
    Function fb_zip_writer_new(): Ptr<Void>
    Function fb_zip_writer_add(writer: Ptr<Void>, name: String, data: UInt8[], method: Int32,
                               level: Int32, folder: Int32, timed: Int32, seconds: Int64,
                               mode: Int32)
    Function fb_zip_writer_finish(writer: Ptr<Void>, output: UInt8[], limit: Int64): Int32
    Function fb_zip_writer_free(writer: Ptr<Void>)
End Extern

/// What makes and reads zip archives, in its Static Methods.
///
/// # Examples
///
/// ```
/// Local writer = ZipWriter()
/// writer.Add("notes.txt", "a note, a note, a note".Bytes)
/// writer.Add("raw.bin", "stored as it is".Bytes, ZipMethod.STORE)
/// Local zip = Try Zip.Read(writer.Finish())
/// Expect(zip.Count == 2)
/// Local raw = Try zip.Read("raw.bin")
/// Expect(raw == "stored as it is".Bytes)
/// Local missing = Try zip.Read("missing.txt")
/// Expect(missing == Null)
/// ```
Public Struct Zip
    /// Zip isn't made: it's only its Static Methods.
    New()
    End New

    /// A reader of the zip in `data`, which it copies, or an IOError of INVALID_DATA when the
    /// `data` isn't a zip.
    Public Static Method Read(data: UInt8[]): ZipReader Throws IOError => Try Opened(data)
End Struct

/// How a ZipWriter compresses an entry.
Public Enum ZipMethod
    /// Stored as it is, not compressed.
    STORE
    /// Deflate, which every zip reader reads.
    DEFLATE
    /// LZMA.
    LZMA
    /// XZ.
    XZ
    /// Zstandard.
    ZSTD
End Enum

/// A new zip, an entry at a time: Add puts in a file, AddFolder a folder, and Finish gives the zip
/// and starts again, empty.
Public Class ZipWriter
    Field State: Ptr<Void>

    /// A new ZipWriter, with no entries.
    Public New()
        State = fb_zip_writer_new()
    End New

    /// Adds a file named `name` of `data`, compressed by `method`, at `level`, or its default when
    /// `level` is Null: 6 for DEFLATE, from 0 to 9, and for LZMA and XZ, which a zip has from 1 to
    /// 9, as minizip-ng stores an entry at 0, and 3 for ZSTD, from 1 to 22. It was last changed at
    /// `modified`, or on 1980-01-01 when that's Null, a DOS date of an even second from 1980 to
    /// 2107, which one from 1970 to 2106 is exact to the second beside, and its mode is `mode`, or
    /// 644 when that's Null. Panics when the `level` isn't one of `method`'s, when the `mode` isn't
    /// from 0 to 0o7777, or when the `name` is "", holds a NUL or a '\', ends with '/', as a
    /// folder's does, or is longer than 65535 bytes.
    @PanicsAtCaller
    Public Method Add(name: String, data: UInt8[], method: ZipMethod = ZipMethod.DEFLATE,
                      level: Int? = Null, modified: Timestamp? = Null, mode: Int? = Null)
        CheckFileName(name, 65535, "zip")
        CheckSlashes(name)
        CheckMode(mode, "zip")
        Local used = level ?? (method == ZipMethod.ZSTD ? 3 : 6)
        If method == ZipMethod.ZSTD
            CheckLevel(used, 1, 22, "Zstd")
        ElseIf method == ZipMethod.DEFLATE
            CheckLevel(used, 0, 9, "{method}")
        ElseIf method != ZipMethod.STORE
            CheckLevel(used, 1, 9, "a zip's {method}")
        End If

        fb_zip_writer_add(State, name, data, MethodNumber(method), used, 0,
                          modified == Null ? 0 : 1,
                          modified?.UnixSeconds ?? 0, (mode ?? -1) As Int32)
    End Method

    /// Adds a folder named `name`, with '/' after it unless it has one, which takes 1 of a name's
    /// 65535 bytes, last changed at `modified`, as Add's are, with `mode`, or 755 when that's Null.
    /// Panics when the `mode` isn't from 0 to 0o7777, or when the `name` is "", holds a NUL or a
    /// '\', or is longer than 65534 bytes.
    @PanicsAtCaller
    Public Method AddFolder(name: String, modified: Timestamp? = Null, mode: Int? = Null)
        CheckName(name, 65534, "zip")
        CheckSlashes(name)
        CheckMode(mode, "zip")
        fb_zip_writer_add(State, name, [], 0, 0, 1, modified == Null ? 0 : 1,
                          modified?.UnixSeconds ?? 0, (mode ?? -1) As Int32)
    End Method

    /// The zip, of the entries added since it started, and then it starts again, empty. Panics
    /// when it's more bytes than a UInt8[] holds.
    @PanicsAtCaller
    Public Method Finish(): UInt8[] => FinishedWithin(MOST_BYTES)

    /// The zip, as Finish gives it, but panicking when it's more than `limit` bytes.
    @PanicsAtCaller
    Package Method FinishedWithin(limit: Int): UInt8[]
        Local output: UInt8[] = []
        If fb_zip_writer_finish(State, output, limit) != 0
            Panic("the zip's bytes are more than a UInt8[] holds")
        End If
        Return output
    End Method

    Method Destroy()
        fb_zip_writer_free(State)
    End Method
End Class

/// Panics when a zip's name holds a '\': zip's names have '/' between folders, readers take a
/// '\' for one, and minizip-ng writes one as '/' on Windows alone.
@PanicsAtCaller
Function CheckSlashes(name: String)
    For byte In name.Bytes
        If byte == 0x5c Then Panic("a zip's names have '/' between folders, not '\\'")
    End For
End Function

/// The runtime's number for a method.
Function MethodNumber(method: ZipMethod): Int32
    Select method
        Case ZipMethod.STORE
            Return 0
        Case ZipMethod.DEFLATE
            Return 1
        Case ZipMethod.LZMA
            Return 2
        Case ZipMethod.XZ
            Return 3
        Default
            Return 4
    End Select
End Function

/// A zip's entries, which Read gives the bytes of, from a copy of the zip's bytes.
Public Class ZipReader
    Field State: Ptr<Void>
    Field List: ArchiveEntry[]

    New(state: Ptr<Void>)
        State = state
        List = []
        Local count = fb_zip_reader_count(state) As Int
        List.Reserve(count)
        For i = 0 Until count
            List.Add(ArchiveEntry(fb_zip_reader_name(state, i), fb_zip_reader_kind(state, i),
                                  fb_zip_reader_size(state, i), fb_zip_reader_target(state, i),
                                  fb_zip_reader_seconds(state, i), fb_zip_reader_nanos(state, i),
                                  fb_zip_reader_mode(state, i)))
        End For
    End New

    /// Its entries, in the order the zip has them.
    Public Property Entries: ReadOnlyArray<ArchiveEntry>
        Get => List.AsReadOnly()
    End Property

    /// How many entries it has.
    Public Property Count: Int
        Get => List.Count
    End Property

    /// The entry named `name`, the last of them when there are several, or Null when there's none.
    Public Method Find(name: String): ArchiveEntry?
        Local index = LastNamed(List, name)
        If index < 0 Then Return Null
        Return List[index]
    End Method

    /// Whether it has an entry named `name`.
    Public Method Contains(name: String): Bool => LastNamed(List, name) >= 0

    /// The bytes of the entry named `name`, the last of them when there are several, or Null when
    /// there's none, as ReadAt gives them.
    Public Method Read(name: String): UInt8[]? Throws IOError
        Local index = LastNamed(List, name)
        If index < 0 Then Return Null
        Return Try ReadAt(index)
    End Method

    /// The bytes of the entry at `index`, which are none for a folder or a link, or an IOError when
    /// they're broken, encrypted, or compressed by a method that isn't supported. Panics when the
    /// `index` is out of range.
    @PanicsAtCaller
    Public Method ReadAt(index: Int): UInt8[] Throws IOError
        If index < 0 || index >= List.Count
            Panic("index {index} is out of range for {List.Count} " +
                  (List.Count == 1 ? "entry" : "entries"))
        End If

        Local output: UInt8[] = []
        If List[index].Kind != ArchiveEntryKind.FILE Then Return output
        Local result = fb_zip_reader_read(State, index, output)
        If result != 0
            Try Failed(result, "zip", MOST_BYTES, fb_zip_reader_message(State))
        End If

        Return output
    End Method

    Method Destroy()
        fb_zip_reader_free(State)
    End Method
End Class

/// A reader of the zip in data, or an IOError when the data isn't a zip, or ends early.
Function Opened(data: UInt8[]): ZipReader Throws IOError
    Local state = fb_zip_reader_new(data)
    Local result = fb_zip_reader_result(state)
    If result != 0
        Local message = fb_zip_reader_message(state)
        fb_zip_reader_free(state)
        Try Failed(result, "zip", MOST_BYTES, message)
    End If

    Return ZipReader(state)
End Function
