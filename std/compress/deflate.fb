//! Deflate, Zlib, and Gzip compression.
//!
//! Deflate (RFC 1951), Zlib (RFC 1950), and Gzip (RFC 1952), over zlib-ng. Each one's Compress and
//! Decompress work at once, and its Compressor and Decompressor take bytes in turn and give what
//! came out of them so far, for data that comes in parts. Levels go from 0, stored as it is, to 9,
//! the smallest, and are 6 by default. A Gzip Decompress reads members one after another, as
//! gunzip does, and a Gzip Compress writes one member, with no name, time, or OS in its header.
//!
//! # Examples
//!
//! ```
//! # Import std.text
//! # Import std.collections
//! // Each format's Compressor and Decompressor take bytes in turn.
//! Local compressor = ZlibCompressor(9)
//! Local packed = compressor.Add("a part, and ".Bytes)
//! packed.AddAll(compressor.Add("the rest".Bytes))
//! packed.AddAll(compressor.Finish())
//! Local decompressor = ZlibDecompressor()
//! Local text = Try decompressor.Add(packed)
//! text.AddAll(Try decompressor.Finish())
//! Expect(String.FromUtf8(text) == "a part, and the rest")
//! Local raw = DeflateCompressor()
//! Local deflated = raw.Add("raw".Bytes)
//! deflated.AddAll(raw.Finish())
//! Local inflate = DeflateDecompressor()
//! Local back = Try inflate.Add(deflated)
//! back.AddAll(Try inflate.Finish())
//! Expect(back == "raw".Bytes)
//! ```

Import std.core
Import std.compress.codec

Extern "runtime"
    Function fb_zlib_encoder_new(format: Int32, level: Int32): Ptr<Void>
    Function fb_zlib_encoder_add(encoder: Ptr<Void>, data: UInt8[], output: UInt8[])
    Function fb_zlib_encoder_finish(encoder: Ptr<Void>, data: UInt8[], output: UInt8[])
    Function fb_zlib_encoder_free(encoder: Ptr<Void>)
    Function fb_zlib_decoder_new(format: Int32, limit: Int64): Ptr<Void>
    Function fb_zlib_decoder_add(decoder: Ptr<Void>, data: UInt8[], output: UInt8[]): Int32
    Function fb_zlib_decoder_finish(decoder: Ptr<Void>, data: UInt8[], output: UInt8[]): Int32
    Function fb_zlib_decoder_message(decoder: Ptr<Void>): String
    Function fb_zlib_decoder_free(decoder: Ptr<Void>)
End Extern

/// The runtime's numbers for the formats.
Const DEFLATE = 1
Const ZLIB = 2
Const GZIP = 3

/// Deflate's raw bytes, which zip entries and PNG's data are in.
///
/// # Examples
///
/// ```
/// # Import std.text
/// Local data = "hello, hello, hello, hello".Repeated(100).Bytes
/// Local packed = Deflate.Compress(data)
/// Expect(packed.Count < data.Count)
/// Local unpacked = Try Deflate.Decompress(packed)
/// Expect(unpacked == data)
/// ```
Public Struct Deflate
    /// Deflate isn't made: it's only its Static Methods.
    New()
    End New

    /// The `data`, compressed at the `level`. Panics when the `level` isn't from 0 to 9.
    @PanicsAtCaller
    Public Static Method Compress(data: UInt8[], level: Int = 6): UInt8[]
        Return Compressed(DEFLATE, data, level)
    End Method

    /// The bytes the `data` is compressed from, or an IOError when it isn't Deflate's, ends early,
    /// or would come to more than `limit` bytes. Panics when the `limit` is negative.
    @PanicsAtCaller
    Public Static Method Decompress(data: UInt8[],
                                    limit: Int = MOST_BYTES): UInt8[] Throws IOError
        Return Try Decompressed(DEFLATE, data, limit)
    End Method
End Struct

/// Zlib's bytes: Deflate's, with a header and an Adler-32 checksum.
///
/// # Examples
///
/// ```
/// # Import std.text
/// Local data = "hello, hello, hello, hello".Repeated(100).Bytes
/// Local packed = Zlib.Compress(data)
/// Expect(packed.Count < data.Count)
/// Local unpacked = Try Zlib.Decompress(packed)
/// Expect(unpacked == data)
/// ```
Public Struct Zlib
    /// Zlib isn't made: it's only its Static Methods.
    New()
    End New

    /// The `data`, compressed at the `level`. Panics when the `level` isn't from 0 to 9.
    @PanicsAtCaller
    Public Static Method Compress(data: UInt8[], level: Int = 6): UInt8[]
        Return Compressed(ZLIB, data, level)
    End Method

    /// The bytes the `data` is compressed from, or an IOError when it isn't Zlib's, ends early,
    /// or would come to more than `limit` bytes. Panics when the `limit` is negative.
    @PanicsAtCaller
    Public Static Method Decompress(data: UInt8[],
                                    limit: Int = MOST_BYTES): UInt8[] Throws IOError
        Return Try Decompressed(ZLIB, data, limit)
    End Method
End Struct

/// Gzip's bytes, of .gz files and HTTP's gzip: Deflate's, with a header and a CRC-32 checksum.
///
/// # Examples
///
/// ```
/// Local data = "the same words, the same words, the same words".Bytes
/// Local gz = Gzip.Compress(data, 9)
/// Expect(gz[0] == 0x1F && gz[1] == 0x8B)
/// Local unpacked = Try Gzip.Decompress(gz)
/// Expect(unpacked == data)
/// ```
Public Struct Gzip
    /// Gzip isn't made: it's only its Static Methods.
    New()
    End New

    /// The `data`, compressed at the `level`, as one member. Panics when the `level` isn't from 0
    /// to 9.
    @PanicsAtCaller
    Public Static Method Compress(data: UInt8[], level: Int = 6): UInt8[]
        Return Compressed(GZIP, data, level)
    End Method

    /// The bytes the `data` is compressed from, each member's after the last's, or an IOError when
    /// it isn't Gzip's, ends early, or would come to more than `limit` bytes. Panics when the
    /// `limit` is negative.
    @PanicsAtCaller
    Public Static Method Decompress(data: UInt8[],
                                    limit: Int = MOST_BYTES): UInt8[] Throws IOError
        Return Try Decompressed(GZIP, data, limit)
    End Method
End Struct

/// Deflate's bytes made in turn: Add gives what compressing the bytes it takes has made so far,
/// and Finish what's left, which ends them, and starts again.
Public Class DeflateCompressor Implements Coder
    Field State: Ptr<Void>

    /// A new DeflateCompressor at the `level`. Panics when it isn't from 0 to 9.
    @PanicsAtCaller
    Public New(level: Int = 6)
        State = Encoder(DEFLATE, level)
    End New

    /// Compresses `data`, and gives the Deflate bytes it has made so far, which can be none, as it
    /// holds some back to compress with what comes next.
    Public Method Add(data: UInt8[]): UInt8[] => Added(State, data)
    /// The rest of the bytes, which end the stream, and starts again, for another.
    Public Method Finish(): UInt8[] => Finished(State)

    Method Destroy()
        fb_zlib_encoder_free(State)
    End Method
End Class

/// Zlib's bytes made in turn, as DeflateCompressor makes Deflate's.
Public Class ZlibCompressor Implements Coder
    Field State: Ptr<Void>

    /// A new ZlibCompressor at the `level`. Panics when it isn't from 0 to 9.
    @PanicsAtCaller
    Public New(level: Int = 6)
        State = Encoder(ZLIB, level)
    End New

    /// Compresses `data`, and gives the Zlib bytes it has made so far, which can be none, as it
    /// holds some back to compress with what comes next.
    Public Method Add(data: UInt8[]): UInt8[] => Added(State, data)
    /// The rest of the bytes, which end the stream, and starts again, for another.
    Public Method Finish(): UInt8[] => Finished(State)

    Method Destroy()
        fb_zlib_encoder_free(State)
    End Method
End Class

/// Gzip's bytes made in turn, as DeflateCompressor makes Deflate's, each Finish ending a member.
///
/// # Examples
///
/// ```
/// # Import std.text
/// # Import std.collections
/// Local compressor = GzipCompressor()
/// Local gz = compressor.Add("first part, ".Bytes)
/// gz.AddAll(compressor.Add("second part".Bytes))
/// gz.AddAll(compressor.Finish())
/// Expect(String.FromUtf8(Try Gzip.Decompress(gz)) == "first part, second part")
/// ```
Public Class GzipCompressor Implements Coder
    Field State: Ptr<Void>

    /// A new GzipCompressor at the `level`. Panics when it isn't from 0 to 9.
    @PanicsAtCaller
    Public New(level: Int = 6)
        State = Encoder(GZIP, level)
    End New

    /// Compresses `data`, and gives the Gzip bytes it has made so far, which can be none, as it
    /// holds some back to compress with what comes next.
    Public Method Add(data: UInt8[]): UInt8[] => Added(State, data)
    /// The rest of the bytes, which end the member, and starts again, for another.
    Public Method Finish(): UInt8[] => Finished(State)

    Method Destroy()
        fb_zlib_encoder_free(State)
    End Method
End Class

/// Deflate's bytes taken in turn: Add gives what the bytes it takes decompress to so far, and
/// Finish what's left once they've all been added, and starts again. Each throws an IOError
/// when the bytes aren't Deflate's or would come to more than the limit, and Finish when they end
/// early. Bytes after the end are an IOError too.
Public Class DeflateDecompressor Implements Coder
    Field State: Ptr<Void>
    Field Limit: Int

    /// A new DeflateDecompressor that gives at most `limit` bytes. Panics when the `limit` is
    /// negative.
    @PanicsAtCaller
    Public New(limit: Int = MOST_BYTES)
        CheckLimit(limit)
        State = fb_zlib_decoder_new(DEFLATE, limit)
        Limit = limit
    End New

    /// Decompresses `data`, and gives the bytes it comes to so far. Throws an IOError when the
    /// bytes aren't Deflate's, or would come to more than the limit.
    Public Method Add(data: UInt8[]): UInt8[] Throws IOError
        Return Try Taken(State, data, Limit, "Deflate")
    End Method

    /// The rest of the bytes, once every one is added, and starts again. Throws an IOError when the
    /// stream ended early.
    Public Method Finish(): UInt8[] Throws IOError
        Return Try Ended(State, [], Limit, "Deflate")
    End Method

    Method Destroy()
        fb_zlib_decoder_free(State)
    End Method
End Class

/// Zlib's bytes taken in turn, as DeflateDecompressor takes Deflate's.
Public Class ZlibDecompressor Implements Coder
    Field State: Ptr<Void>
    Field Limit: Int

    /// A new ZlibDecompressor that gives at most `limit` bytes. Panics when the `limit` is
    /// negative.
    @PanicsAtCaller
    Public New(limit: Int = MOST_BYTES)
        CheckLimit(limit)
        State = fb_zlib_decoder_new(ZLIB, limit)
        Limit = limit
    End New

    /// Decompresses `data`, and gives the bytes it comes to so far. Throws an IOError when the
    /// bytes aren't Zlib's, or would come to more than the limit.
    Public Method Add(data: UInt8[]): UInt8[] Throws IOError
        Return Try Taken(State, data, Limit, "Zlib")
    End Method

    /// The rest of the bytes, once every one is added, and starts again. Throws an IOError when the
    /// stream ended early.
    Public Method Finish(): UInt8[] Throws IOError
        Return Try Ended(State, [], Limit, "Zlib")
    End Method

    Method Destroy()
        fb_zlib_decoder_free(State)
    End Method
End Class

/// Gzip's bytes taken in turn, as DeflateDecompressor takes Deflate's, a member after another.
///
/// # Examples
///
/// ```
/// # Import std.text
/// # Import std.collections
/// Local gz = Gzip.Compress("in two halves".Bytes)
/// Local decompressor = GzipDecompressor()
/// Local half = gz.Count / 2
/// Local text = Try decompressor.Add(gz[0..half])
/// text.AddAll(Try decompressor.Add(gz[half..gz.Count]))
/// text.AddAll(Try decompressor.Finish())
/// Expect(String.FromUtf8(text) == "in two halves")
/// ```
Public Class GzipDecompressor Implements Coder
    Field State: Ptr<Void>
    Field Limit: Int

    /// A new GzipDecompressor that gives at most `limit` bytes. Panics when the `limit` is
    /// negative.
    @PanicsAtCaller
    Public New(limit: Int = MOST_BYTES)
        CheckLimit(limit)
        State = fb_zlib_decoder_new(GZIP, limit)
        Limit = limit
    End New

    /// Decompresses `data`, and gives the bytes it comes to so far. Throws an IOError when the
    /// bytes aren't Gzip's, or would come to more than the limit.
    Public Method Add(data: UInt8[]): UInt8[] Throws IOError
        Return Try Taken(State, data, Limit, "Gzip")
    End Method

    /// The rest of the bytes, once every one is added, and starts again. Throws an IOError when the
    /// stream ended early.
    Public Method Finish(): UInt8[] Throws IOError
        Return Try Ended(State, [], Limit, "Gzip")
    End Method

    Method Destroy()
        fb_zlib_decoder_free(State)
    End Method
End Class

/// A new encoder of the format, at the level.
@PanicsAtCaller
Function Encoder(format: Int32, level: Int): Ptr<Void>
    CheckLevel(level, 0, 9, NameOf(format))
    Return fb_zlib_encoder_new(format, level)
End Function

Function Added(encoder: Ptr<Void>, data: UInt8[]): UInt8[]
    Local output: UInt8[] = []
    fb_zlib_encoder_add(encoder, data, output)
    Return output
End Function

Function Finished(encoder: Ptr<Void>): UInt8[]
    Local output: UInt8[] = []
    fb_zlib_encoder_finish(encoder, [], output)
    Return output
End Function

@PanicsAtCaller
Function Compressed(format: Int32, data: UInt8[], level: Int): UInt8[]
    Local encoder = Encoder(format, level)
    Local output: UInt8[] = []
    fb_zlib_encoder_finish(encoder, data, output)
    fb_zlib_encoder_free(encoder)
    Return output
End Function

@PanicsAtCaller
Function Decompressed(format: Int32, data: UInt8[], limit: Int): UInt8[] Throws IOError
    CheckLimit(limit)
    Local decoder = fb_zlib_decoder_new(format, limit)
    Defer fb_zlib_decoder_free(decoder)
    Return Try Ended(decoder, data, limit, NameOf(format))
End Function

/// What the decoder gives for data, or the IOError its result means.
Function Taken(decoder: Ptr<Void>, data: UInt8[], limit: Int,
               format: String): UInt8[] Throws IOError
    Local output: UInt8[] = []
    Local result = fb_zlib_decoder_add(decoder, data, output)
    If result != 0 Then Try Failed(result, format, limit, fb_zlib_decoder_message(decoder))
    Return output
End Function

/// What the decoder gives for data, the last there is, or the IOError its result means.
Function Ended(decoder: Ptr<Void>, data: UInt8[], limit: Int,
               format: String): UInt8[] Throws IOError
    Local output: UInt8[] = []
    Local result = fb_zlib_decoder_finish(decoder, data, output)
    If result != 0 Then Try Failed(result, format, limit, fb_zlib_decoder_message(decoder))
    Return output
End Function

Function NameOf(format: Int32): String
    If format == DEFLATE Then Return "Deflate"
    Return format == ZLIB ? "Zlib" : "Gzip"
End Function
