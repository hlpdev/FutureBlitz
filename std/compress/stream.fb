//! Compressing and decompressing streams as they're written and read.
//!
//! std.compress over std.io's streams: a CoderWriter writes what's written to it through a Coder,
//! like a GzipCompressor, to another Writer, and a CoderReader reads what another Reader gives
//! through one, like a GzipDecompressor, so a file or a socket compresses and decompresses as it
//! goes, a part at a time.

Import std.core
Import std.ffi
Import std.io.streams
Import std.compress.codec

/// How many bytes a CoderReader reads from its Reader at a time.
Const CHUNK = 65536

/// A Writer whose bytes go through a Coder to another Writer: Write adds them to the Coder and
/// writes what comes of them, and Finish writes the rest, which ends what the Coder makes, as
/// `CoderWriter(file, GzipCompressor())` ends a gzip member. A Coder holds on to what it hasn't
/// coded yet, so Flush flushes only the other Writer, and the Coder's rest comes with Finish. Each
/// throws the IOError the Coder or the Writer does.
///
/// # Examples
///
/// ```
/// # Import std.text
/// # Import std.io
/// Local memory = MemoryStream()
/// Local writer = CoderWriter(memory, GzipCompressor())
/// Try writer.WriteText("written a part at a time")
/// Try writer.Finish()
/// Expect(String.FromUtf8(Try Gzip.Decompress(memory.ToArray())) == "written a part at a time")
/// ```
Public Class CoderWriter Implements Writer
    Field Inner: Writer
    Field Through: Coder

    /// A CoderWriter that writes to `inner` what `through` makes of the bytes it's given.
    Public New(inner: Writer, through: Coder)
        Inner = inner
        Through = through
    End New

    /// Puts the bytes through the Coder, and writes what comes of them so far to the other Writer.
    Public Method Write(from: Buffer<UInt8>) Throws IOError
        Local coded = Try Through.Add(from.ToArray())
        If coded.Count > 0 Then Try Inner.WriteBytes(coded)
    End Method

    /// Flushes the other Writer, but not the Coder, whose rest comes with Finish.
    Public Method Flush() Throws IOError
        Try Inner.Flush()
    End Method

    /// Writes what the Coder has left, and flushes the other Writer. The Coder starts again, so
    /// what's written next is coded on its own, as a gzip's next member is.
    Public Method Finish() Throws IOError
        Local coded = Try Through.Finish()
        If coded.Count > 0 Then Try Inner.WriteBytes(coded)
        Try Inner.Flush()
    End Method
End Class

/// A Reader whose bytes are what another Reader's come to through a Coder, as
/// `CoderReader(file, GzipDecompressor())` reads a .gz file's: it reads the other Reader a chunk at
/// a time, and once that ends, gives what the Coder has left, and then ends. Read throws the
/// IOError the Coder or the Reader does, like a Decompressor's for bytes that aren't its format,
/// or that end too soon, and a Read after that throws again, or ends.
///
/// # Examples
///
/// ```
/// # Import std.io
/// Local gz = Gzip.Compress("read back".Bytes)
/// Local reader = CoderReader(MemoryStream(gz), GzipDecompressor())
/// Expect(Try ReadAllText(reader) == "read back")
/// ```
Public Class CoderReader Implements Reader
    Field Inner: Reader
    Field Through: Coder
    /// What the Coder gave that Read hasn't, from At on.
    Field Coded: UInt8[] = []
    Field At: Int = 0
    /// Whether the other Reader has ended, and the Coder given its rest.
    Field Ended: Bool = False
    /// What it reads the other Reader into.
    Field Chunk: Buffer<UInt8>

    /// A CoderReader that reads what `through` makes of what `inner` gives.
    Public New(inner: Reader, through: Coder)
        Inner = inner
        Through = through
        Chunk = Buffer<UInt8>(CHUNK)
    End New

    /// Reads what the other Reader's bytes come to through the Coder into `into`, and gives how
    /// many it read, or 0 once both have ended. Throws the IOError the Coder or the other Reader
    /// does.
    Public Method Read(into: Buffer<UInt8>): Int64 Throws IOError
        If into.Count == 0 Then Return 0
        // What the Coder gives replaces what Read gave only once it gives it: one that throws
        // leaves nothing to give again, and throws again for the next Read, as a Decompressor
        // does once its bytes are wrong.
        While At == Coded.Count && !Ended
            Local count = Try Inner.Read(Chunk)
            If count == 0
                Coded = Try Through.Finish()
                Ended = True
            Else
                Coded = Try Through.Add(Chunk.Slice(0, count).ToArray())
            End If

            At = 0
        End While

        Local count = Min(into.Count, (Coded.Count - At) As Int64)
        If count > 0
            Unsafe
                Mem.Copy(into.Pointer(), AddressOf(Coded[At]), count)
            End Unsafe

            At += count As Int
        End If

        Return count
    End Method
End Class
