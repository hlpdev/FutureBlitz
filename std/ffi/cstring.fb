//! What a CString does besides ToString, which is built in: a copy of a String that C code can
//! keep, its length, and giving the copy back. The copy is the runtime's, like the one an Extern
//! Function's call makes of a String argument, so leak reports count one that's never freed.

Extern "runtime"
    Function fb_cstring_new(text: String): CString
    Function fb_cstring_free_known(text: CString): Int32
    Function fb_cstring_length(text: CString): UInt64
End Extern

Extend CString
    /// A CString of `text`'s UTF-8 bytes and a NUL, in memory of its own, which C code can keep
    /// until Free gives it back. C reads it up to its first NUL, so a NUL in `text` ends it
    /// there.
    Public Static Method From(text: String): CString
        Return fb_cstring_new(text)
    End Method

    /// How many bytes it has before its first NUL. Panics when it's Null.
    @PanicsAtCaller
    Public Unsafe Method Length(): Int64
        If Self == Null Then Panic("the CString is Null, so it has no length")
        Return fb_cstring_length(Self) As Int64
    End Method

    /// Gives back what From made, and nothing else, which panics. Null is nothing to give back.
    @PanicsAtCaller
    Public Unsafe Method Free()
        If Self == Null Then Return
        If fb_cstring_free_known(Self) == 0
            Panic("Free gives back a CString that CString.From made, and this one isn't, or " +
                  "it was given back already")
        End If
    End Method
End Extend
