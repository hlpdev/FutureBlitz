//! Value, data of any shape, as the data formats read and write it.
//!
//! Value: data of any shape, as the data formats have it: Null, a Bool, an integer, a Double, a
//! String, bytes, an Array of Values, or an Object of Values by their keys, in the order they were
//! added. Each format reads its text into one and writes one out. A Value is an object, so a
//! change to an Array's or Object's shows through every reference to it, and Clone() copies one
//! whole. None holds itself, inside it however deep, though one can sit in several places, where
//! a change to it shows in each; ToString, ==, Hash, and Clone go through each place, however
//! deep, without recursing.

Import std.core.error
Import std.core.interfaces
Import std.core.values
Import std.collections.map

Extern "runtime"
    Function fb_value_quoted(text: String): String
    Function fb_value_hex(bytes: UInt8[]): String
    Function fb_value_joined(parts: String[]): String
    Function fb_value_path(path: String, keys: String[], indices: Int64[]): Int32
End Extern

/// What a Value holds.
Public Enum ValueKind
    /// Nothing: a null.
    NULL
    /// A Bool.
    BOOL
    /// An integer, as an Int64.
    INT
    /// An integer past an Int64's largest, as a UInt64.
    UINT
    /// A Double.
    DOUBLE
    /// A String.
    STRING
    /// Bytes, as a UInt8[].
    BYTES
    /// An Array of Values.
    ARRAY
    /// An Object, of keys and their Values.
    OBJECT
End Enum

/// A value of JSON, MessagePack, TOML, and the other formats, which Load reads types from and Save
/// writes them to: Null, a Bool, an integer, a Double, a String, bytes, an Array, or an Object of
/// keys.
///
/// # Examples
///
/// ```
/// Local player = Value.Object()
/// player["name"] = Value("Ada")
/// player["scores"] = Value([Value(3), Value(5)])
/// Expect(player.Keys() == ["name", "scores"])
/// Expect(player["name"]?.AsString() == "Ada")
/// Expect(player.Path("scores[1]")?.AsInt() == 5)
/// Expect(player.Path("scores[2]") == Null)
/// ```
Public Class Value Implements Equatable, Hashable, Printable, Cloneable
    Field Shape: ValueKind
    /// A Bool's or integer's bits, and a Double.
    Field Bits: UInt64
    Field Real: Double
    Field Text: String = ""
    Field Data: UInt8[]?
    Field Elements: Value[]?
    Field Entries: Map<String, Value>?
    /// The last of Holds' walks that went through it.
    Field Walked: Walk?

    /// A Value that holds Null.
    Public New()
    End New

    /// A Bool's Value.
    Public New(value: Bool)
        Shape = ValueKind.BOOL
        Bits = value ? 1 : 0
    End New

    /// An integer of any size, which each type has a New of its own for, so none is ambiguous.
    Public New(value: Int8)
        SetInteger(value As Int64)
    End New

    /// An integer's Value.
    Public New(value: Int16)
        SetInteger(value As Int64)
    End New

    /// An integer's Value.
    Public New(value: Int32)
        SetInteger(value As Int64)
    End New

    /// An integer's Value.
    Public New(value: Int64)
        SetInteger(value)
    End New

    /// An integer's Value.
    Public New(value: UInt8)
        SetInteger(value As Int64)
    End New

    /// An integer's Value.
    Public New(value: UInt16)
        SetInteger(value As Int64)
    End New

    /// An integer's Value.
    Public New(value: UInt32)
        SetInteger(value As Int64)
    End New

    /// An integer's Value, which is a UInt when it's too large for an Int64.
    Public New(value: UInt64)
        If value > 9223372036854775807
            Shape = ValueKind.UINT
            Bits = value
        Else
            SetInteger(value As Int64)
        End If
    End New

    /// A Double. A Float converts to one, and a decimal literal is read as one.
    Public New(value: Double)
        Shape = ValueKind.DOUBLE
        Real = value
    End New

    /// A String's Value.
    Public New(value: String)
        Shape = ValueKind.STRING
        Text = value
    End New

    /// Bytes, a copy of them.
    Public New(bytes: UInt8[])
        Shape = ValueKind.BYTES
        Data = bytes.Clone()
    End New

    /// An Array of the Values, in a new array of its own.
    Public New(elements: Value[])
        Shape = ValueKind.ARRAY
        Elements = elements.Clone()
    End New

    /// An Object of the Map's keys and Values, in its order, in a new Map of its own.
    Public New(entries: Map<String, Value>)
        Shape = ValueKind.OBJECT
        Entries = entries.Clone()
    End New

    /// A new, empty Array, to add to.
    Public Static Method Array(): Value
        Local made = Value()
        made.Shape = ValueKind.ARRAY
        made.Elements = []
        Return made
    End Method

    /// A new, empty Object.
    Public Static Method Object(): Value
        Local made = Value()
        made.Shape = ValueKind.OBJECT
        made.Entries = Map<String, Value>()
        Return made
    End Method

    /// Which of the kinds it is.
    Public Property Kind: ValueKind
        Get => Shape
    End Property

    /// Whether it's Null.
    Public Property IsNull: Bool
        Get => Shape == ValueKind.NULL
    End Property

    /// Whether it's a Bool.
    Public Property IsBool: Bool
        Get => Shape == ValueKind.BOOL
    End Property

    /// An INT or UINT, and a number, those or a DOUBLE.
    Public Property IsInteger: Bool
        Get => Shape == ValueKind.INT || Shape == ValueKind.UINT
    End Property

    /// Whether it's a number: an integer or a Double.
    Public Property IsNumber: Bool
        Get => IsInteger || Shape == ValueKind.DOUBLE
    End Property

    /// Whether it's a String.
    Public Property IsString: Bool
        Get => Shape == ValueKind.STRING
    End Property

    /// Whether it's bytes.
    Public Property IsBytes: Bool
        Get => Shape == ValueKind.BYTES
    End Property

    /// Whether it's an Array.
    Public Property IsArray: Bool
        Get => Shape == ValueKind.ARRAY
    End Property

    /// Whether it's an Object.
    Public Property IsObject: Bool
        Get => Shape == ValueKind.OBJECT
    End Property

    /// How many elements an Array has, entries an Object has, or bytes it holds; 0 for the rest.
    Public Property Count: Int
        Get
            If Shape == ValueKind.ARRAY Then Return Elements.Expect("an Array's").Count
            If Shape == ValueKind.OBJECT Then Return Entries.Expect("an Object's").Count
            If Shape == ValueKind.BYTES Then Return Data.Expect("bytes").Count
            Return 0
        End Get
    End Property

    /// What it holds as each type, or Null when it holds another kind. An integer is a Double
    /// too, the nearest there is, and an Int32 or Int64 when it fits.
    Public Method AsBool(): Bool? => Shape == ValueKind.BOOL ? Bits != 0 : Null

    /// An integer that fits in an Int, or Null for anything else.
    Public Method AsInt(): Int?
        If Shape != ValueKind.INT Then Return Null
        Local value = Bits As Int64
        If value < -2147483648 || value > 2147483647 Then Return Null
        Return value As Int
    End Method

    /// An integer that fits in an Int64, or Null for anything else.
    Public Method AsInt64(): Int64? => Shape == ValueKind.INT ? Bits As Int64 : Null

    /// An integer that fits in a UInt64, or Null for anything else.
    Public Method AsUInt64(): UInt64?
        If Shape == ValueKind.UINT || (Shape == ValueKind.INT && (Bits As Int64) >= 0)
            Return Bits
        End If

        Return Null
    End Method

    /// A number as a Double, or Null for anything else.
    Public Method AsDouble(): Double?
        If Shape == ValueKind.DOUBLE Then Return Real
        If Shape == ValueKind.INT Then Return (Bits As Int64) As Double
        If Shape == ValueKind.UINT Then Return Bits As Double
        Return Null
    End Method

    /// A String's text, or Null for anything else.
    Public Method AsString(): String? => Shape == ValueKind.STRING ? Text : Null

    /// The bytes, in a copy, or an Array's elements, in a new array of the Value's own elements:
    /// adding to it or taking from it doesn't change the Value, but a change to an element does.
    Public Method AsBytes(): UInt8[]? => Shape == ValueKind.BYTES ? Data?.Clone() : Null
    /// An Array's elements, in a new array of the Value's own elements, or Null for anything else.
    Public Method AsArray(): Value[]? => Shape == ValueKind.ARRAY ? Elements?.Clone() : Null

    /// An Object's keys, in order, in a new array; none for the rest.
    Public Method Keys(): String[]
        Local entries = Entries
        Return Shape == ValueKind.OBJECT && entries != Null ? entries.Keys() : []
    End Method

    /// Whether an Object has the `key`.
    Public Method Contains(key: String): Bool
        Local entries = Entries
        Return Shape == ValueKind.OBJECT && entries != Null && entries.Contains(key)
    End Method

    /// An Object's Value for the `key`, or Null where it has none.
    Operator [](key: String): Value?
        Local entries = Entries
        Return Shape == ValueKind.OBJECT && entries != Null ? entries.Get(key) : Null
    End Operator

    /// An Array's Value at the `index`, or Null where it has none.
    Operator [](index: Int): Value?
        Local elements = Elements
        If Shape != ValueKind.ARRAY || elements == Null Then Return Null
        Return index >= 0 && index < elements.Count ? elements[index] : Null
    End Operator

    /// The Value a path names, like "server.ports[0].name": keys after dots and indices in
    /// brackets, each step into what the last gave, or Null where one has nothing. "" is the
    /// Value itself. Panics for text that isn't a path, like "a..b" or "a[x]".
    @PanicsAtCaller
    Public Method Path(path: String): Value?
        Local keys: String[] = []
        Local indices: Int64[] = []
        If fb_value_path(path, keys, indices) == 0
            Panic("a Value's path is keys after dots and indices in brackets, like \"a.b[0]\", " +
                  "not \"{path}\"")
        End If

        Local at: Value? = Self
        For i = 0 Until keys.Count
            Local here = at
            If here == Null Then Return Null
            If indices[i] < 0
                at = here[keys[i]]
            Else
                at = indices[i] > 2147483647 ? Null : here[indices[i] As Int]
            End If
        End For

        Return at
    End Method

    /// Gives an Object's `key` the `value`, adding the key when it isn't there. Panics on another
    /// kind, or for a `value` that is this one or holds it.
    @PanicsAtCaller
    Operator []=(key: String, value: Value)
        Local entries = ObjectEntries("a Value's [key] =")
        CheckHeld(value)
        entries[key] = value
    End Operator

    /// Replaces an Array's element at the `index` with `value`. Panics on another kind, at an index
    /// past the Array's, or for a `value` that is this one or holds it.
    @PanicsAtCaller
    Operator []=(index: Int, value: Value)
        Local elements = ArrayElements("a Value's [index] =")
        CheckHeld(value)
        elements[index] = value
    End Operator

    /// Adds a Value at an Array's end, or at index, moving those from there up. Panics on
    /// another kind, and for a value that is this one or holds it, as []= does.
    @PanicsAtCaller
    Public Method Add(value: Value)
        Local elements = ArrayElements("Value.Add")
        CheckHeld(value)
        elements.Add(value)
    End Method

    /// Puts `value` in an Array at `index`, moving the ones from there on up. Panics on another
    /// kind, at an index past its end, and for a value that is this one or holds it.
    @PanicsAtCaller
    Public Method Insert(index: Int, value: Value)
        Local elements = ArrayElements("Value.Insert")
        CheckHeld(value)
        elements.Insert(index, value)
    End Method

    /// Takes the element at `index` out of an Array. Panics on another kind, and at an index that
    /// isn't in it.
    @PanicsAtCaller
    Public Method RemoveAt(index: Int)
        ArrayElements("Value.RemoveAt").RemoveAt(index)
    End Method

    /// Removes an Object's `key`, and tells whether it had one. Panics on another kind.
    @PanicsAtCaller
    Public Method Remove(key: String): Bool => ObjectEntries("Value.Remove").Remove(key)

    /// Adds an Array's element, or an Object's entry, without the check Add and []= make, for
    /// the new Values that Save makes, none of which can hold another.
    Package Method Append(value: Value)
        ArrayElements("Value.Append").Add(value)
    End Method

    Package Method Put(key: String, value: Value)
        ObjectEntries("Value.Put")[key] = value
    End Method

    /// Copies it, and its elements and entries, whole. A Value held in several places is copied
    /// once for each place.
    Public Method Clone(): Value
        Local copy = Shallow()
        Local pending = [(Self, copy)]
        While pending.Count > 0
            Local pair = pending[pending.Count - 1]
            pending.RemoveAt(pending.Count - 1)
            Local elements = pair.0.Elements
            Local into = pair.1.Elements
            If elements != Null && into != Null
                into.Reserve(elements.Count)
                For element In elements
                    Local made = element.Shallow()
                    into.Add(made)
                    If element.IsArray || element.IsObject Then pending.Add((element, made))
                End For
            End If

            Local entries = pair.0.Entries
            Local intoEntries = pair.1.Entries
            If entries != Null && intoEntries != Null
                For key, value In entries
                    Local made = value.Shallow()
                    intoEntries[key] = made
                    If value.IsArray || value.IsObject Then pending.Add((value, made))
                End For
            End If
        End While

        Return copy
    End Method

    /// Two Values are equal when they're the same kind and hold the same: an Object the same keys
    /// with equal Values, in any order. A Double compares as Doubles do, so NaN isn't equal to
    /// itself and 0.0 is -0.0.
    Operator ==(a: Value, b: Value): Bool
        Local pending = [(a, b)]
        While pending.Count > 0
            Local pair = pending[pending.Count - 1]
            pending.RemoveAt(pending.Count - 1)
            Local left = pair.0
            Local right = pair.1
            If !left.SameAlone(right) Then Return False
            Local elements = left.Elements
            Local others = right.Elements
            If elements != Null && others != Null
                For i = 0 Until elements.Count
                    pending.Add((elements[i], others[i]))
                End For
            End If

            Local entries = left.Entries
            Local otherEntries = right.Entries
            If entries != Null && otherEntries != Null
                For key, value In entries
                    Local other = otherEntries.Get(key)
                    If other == Null Then Return False
                    pending.Add((value, other))
                End For
            End If
        End While

        Return True
    End Operator

    /// The same for equal Values, an Object's in any order. Each Array or Object on the way down
    /// keeps what it's added up so far, and adds what each element or entry comes to.
    Public Method Hash(): UInt64
        If !IsArray && !IsObject Then Return HashAlone()
        Local steps = [Step(Self)]
        Loop
            Local last = steps.Count - 1
            Local step = steps[last]
            If step.At < step.Item.Count
                Local child = step.Next()
                steps[last] = step
                If child.IsArray || child.IsObject
                    steps.Add(Step(child))
                Else
                    step.Add(child.HashAlone())
                    steps[last] = step
                End If

                Continue
            End If

            Local finished = step.Finished()
            steps.RemoveAt(last)
            If steps.Count == 0 Then Return finished
            Local parent = steps[last - 1]
            parent.Add(finished)
            steps[last - 1] = parent
        End Loop
    End Method

    /// As JSON writes it, on one line: null, true, 42, 1.5, "text" with JSON's escapes, [1, 2],
    /// and {"key": 1}; a Double always with a point or an exponent, as 1.0; and, as JSON has no
    /// bytes, bytes in hex between angle brackets, as <0a1b>. A Value held in several places is
    /// written in each.
    Public Method ToString(): String
        If !IsArray && !IsObject Then Return TextAlone()
        Local parts: String[] = [IsArray ? "[" : "{{"]
        Local steps = [Step(Self)]
        While steps.Count > 0
            Local last = steps.Count - 1
            Local step = steps[last]
            If step.At >= step.Item.Count
                parts.Add(step.Item.IsArray ? "]" : "}}")
                steps.RemoveAt(last)
                Continue
            End If

            If step.At > 0 Then parts.Add(", ")
            If step.Item.IsObject Then parts.Add(fb_value_quoted(step.Keys[step.At]) + ": ")
            Local child = step.Next()
            steps[last] = step
            If child.IsArray || child.IsObject
                parts.Add(child.IsArray ? "[" : "{{")
                steps.Add(Step(child))
            Else
                parts.Add(child.TextAlone())
            End If
        End While

        Return fb_value_joined(parts)
    End Method

    /// Panics when value is this Value or holds it, which would make it hold itself.
    @PanicsAtCaller
    Method CheckHeld(value: Value)
        If value.Holds(Self) Then Panic("a Value can't hold itself, inside it or as it is")
    End Method

    /// Whether it's target, or holds it, however deep. Each Value it looks through is marked with
    /// this walk, so one held in several places is looked through once.
    Method Holds(target: Value): Bool
        Local walk = Walk()
        Local pending = [Self]
        While pending.Count > 0
            Local here = pending[pending.Count - 1]
            pending.RemoveAt(pending.Count - 1)
            If RefEquals(here, target) Then Return True
            If walk.Marked(here) Then Continue
            here.Walked = walk
            Local elements = here.Elements
            If elements != Null
                For element In elements
                    If !walk.Marked(element) Then pending.Add(element)
                End For
            End If

            Local entries = here.Entries
            If entries != Null
                For key, value In entries
                    If !walk.Marked(value) Then pending.Add(value)
                End For
            End If
        End While

        Return False
    End Method

    /// A copy of it alone: its bytes, but an Array or Object empty, for Clone to fill.
    Method Shallow(): Value
        Local copy = Value()
        copy.Shape = Shape
        copy.Bits = Bits
        copy.Real = Real
        copy.Text = Text
        copy.Data = Data?.Clone()
        If Shape == ValueKind.ARRAY Then copy.Elements = []
        If Shape == ValueKind.OBJECT Then copy.Entries = Map<String, Value>()
        Return copy
    End Method

    /// Whether it and other are equal but for what an Array's elements or an Object's entries
    /// hold: the same kind, the same scalar, and as many elements or entries.
    Method SameAlone(other: Value): Bool
        If Shape != other.Shape Then Return False
        Select Shape
            Case ValueKind.NULL
                Return True
            Case ValueKind.DOUBLE
                Return Real == other.Real
            Case ValueKind.STRING
                Return Text == other.Text
            Case ValueKind.BYTES
                Return Data == other.Data
            Case ValueKind.ARRAY, ValueKind.OBJECT
                Return Count == other.Count
            Default
                Return Bits == other.Bits
        End Select
    End Method

    /// A scalar's hash and text.
    Method HashAlone(): UInt64
        Local seed = Shape As UInt64
        Select Shape
            Case ValueKind.DOUBLE
                // 0.0 and -0.0 are equal, so they hash alike.
                Return HashCombine(seed, Real == 0.0 ? 0 : Real.Hash())
            Case ValueKind.STRING
                Return HashCombine(seed, Text.Hash())
            Case ValueKind.BYTES
                Return HashCombine(seed, Data.Expect("bytes").Hash())
            Default
                Return HashCombine(seed, Bits)
        End Select
    End Method

    Method TextAlone(): String
        Select Shape
            Case ValueKind.NULL
                Return "null"
            Case ValueKind.BOOL
                Return Bits != 0 ? "true" : "false"
            Case ValueKind.INT
                Return "{Bits As Int64}"
            Case ValueKind.UINT
                Return "{Bits}"
            Case ValueKind.DOUBLE
                Return DoubleText(Real)
            Case ValueKind.STRING
                Return fb_value_quoted(Text)
            Default
                Return "<{fb_value_hex(Data.Expect("bytes"))}>"
        End Select
    End Method

    /// An integer's bits, as an INT.
    Method SetInteger(value: Int64)
        Shape = ValueKind.INT
        Bits = value As UInt64
    End Method

    /// An Array's elements or an Object's entries, for what changes them, which panic on another
    /// kind.
    @PanicsAtCaller
    Method ArrayElements(what: String): Value[]
        Local elements = Elements
        If Shape != ValueKind.ARRAY || elements == Null
            Panic("{what} works on an Array, not {Article(Shape)}")
        End If

        Return elements
    End Method

    @PanicsAtCaller
    Method ObjectEntries(what: String): Map<String, Value>
        Local entries = Entries
        If Shape != ValueKind.OBJECT || entries == Null
            Panic("{what} works on an Object, not {Article(Shape)}")
        End If

        Return entries
    End Method
End Class

/// One of Holds' walks, which marks the Values it looks through with itself.
Class Walk
    Method Marked(value: Value): Bool
        Local walked = value.Walked
        Return walked != Null && RefEquals(walked, Self)
    End Method
End Class

/// Where Hash and ToString are in an Array or Object, on their way through it without recursing:
/// the next element or entry, and for Hash, what's added up so far.
Struct Step
    Field Item: Value
    Field At: Int
    /// An Object's keys, in order; none for an Array.
    Field Keys: String[]
    Field Total: UInt64
    /// The hash of the key of the entry being added, for an Object.
    Field KeyHash: UInt64

    New(item: Value)
        Item = item
        Keys = item.Keys()
        Local count = item.Count As UInt64
        Total = item.IsArray ? HashCombine(item.Shape As UInt64, count) : count
    End New

    /// The next element or entry's Value, which it goes past.
    ByRef Method Next(): Value
        Local at = At
        At += 1
        If Item.IsArray Then Return Item.Elements.Expect("an Array's")[at]
        KeyHash = Keys[at].Hash()
        Return Item.Entries.Expect("an Object's")[Keys[at]]
    End Method

    /// Adds the hash of the element or entry it went past: in order for an Array, and for an
    /// Object's, in any order.
    ByRef Method Add(hash: UInt64)
        If Item.IsArray
            Total = HashCombine(Total, hash)
        Else
            Total = Total.WrappingAdd(HashCombine(KeyHash, hash))
        End If
    End Method

    Method Finished(): UInt64 => Item.IsArray ? Total : HashCombine(Item.Shape As UInt64, Total)
End Struct

/// "a Bool", "an INT", and the rest, for what a panic says.
Function Article(kind: ValueKind): String
    Select kind
        Case ValueKind.NULL
            Return "Null"
        Case ValueKind.BOOL
            Return "a Bool"
        Case ValueKind.INT, ValueKind.UINT
            Return "an integer"
        Case ValueKind.DOUBLE
            Return "a Double"
        Case ValueKind.STRING
            Return "a String"
        Case ValueKind.BYTES
            Return "bytes"
        Case ValueKind.ARRAY
            Return "an Array"
        Default
            Return "an Object"
    End Select
End Function

/// A Double's shortest text, with ".0" when it would read as an integer.
Function DoubleText(value: Double): String
    Local text = "{value}"
    For code In text.Chars
        If code == '.' || code == 'e' || code == 'E' || code == 'n' || code == 'N' ||
           code == 'i' || code == 'I'
            Return text
        End If
    End For

    Return text + ".0"
End Function
