// The Interfaces that the language's operators and strings work through. The built-in types
// implement the ones that fit them, and a Struct or Class implements one by listing it.

// What == says, and != is always its opposite. A Struct that lists Equatable without an
// Operator == of its own compares its fields, and a Class compares whether two are the same
// object.
Public Interface Equatable
    Operator ==(a: Self, b: Self): Bool
End Interface

// An order: what < says, which the other comparisons follow unless a type gives its own.
Public Interface Comparable Extends Equatable
    Operator <(a: Self, b: Self): Bool

    Operator >(a: Self, b: Self): Bool => b < a
    Operator <=(a: Self, b: Self): Bool => !(b < a)
    Operator >=(a: Self, b: Self): Bool => !(a < b)
End Interface

// A number for Maps and Sets to find a value by, the same for values that are equal. A Struct
// that lists Hashable without a Hash of its own combines its fields', and a Class's comes from
// its object.
Public Interface Hashable Extends Equatable
    Method Hash(): UInt64
End Interface

// What a value shows in a string, like "{point}".
Public Interface Printable
    Method ToString(): String
End Interface

// What arithmetic needs, so generic code like a Sum works on any number.
Public Interface Numeric
    Static Method Zero(): Self
    Static Method One(): Self
    Operator +(a: Self, b: Self): Self
    Operator -(a: Self, b: Self): Self
    Operator *(a: Self, b: Self): Self
    Operator /(a: Self, b: Self): Self
End Interface

// What makes a copy of itself, which changing one doesn't change the other: arrays and std's
// collections are Cloneable.
Public Interface Cloneable
    Method Clone(): Self
End Interface

// What has a value to start from, for generic code that needs one: the numbers' is 0, Bool's
// False, String's "", an Enum's its zero, its first value or a @Flags Enum's no flags, and std's
// collections' is empty. It's DefaultValue, since Default is Select's keyword.
Public Interface Defaultable
    Static Method DefaultValue(): Self
End Interface

// What can go to another thread, which the compiler decides: numbers, Bools, Strings, Enums,
// Callbacks, Channels, Mutexes, Atomics, and a Shared Class's objects and Weaks of them, and the
// Structs, tuples, and fixed arrays whose fields and elements all are, with a T? of any of them. A type can list
// it, or an Interface that extends it, to have that checked.
Public Interface Sendable
End Interface
