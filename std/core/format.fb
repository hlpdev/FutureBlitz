//! Formatting by a template the program has only when it runs, and the debug form.
//!
//! Formatting by a template that the program has only when it runs: Format, whose fields take
//! interpolation's specs, which the runtime splits; and the debug form, "{x:?}", which the compiler
//! makes for every type, and Dump.

Import std.core.error
Import std.core.interfaces
Import std.core.iterator

Extern "runtime"
    Function fb_format_split(template: String, texts: String[], indexes: Int32[],
                             specs: String[]): Int32
    Function fb_format_debug(spec: String): Int32
    Function fb_format_text(text: String, spec: String, string: Int32): String?
End Extern

/// A value that isn't an object, in one, for what takes Formattable values, like Format's.
Package Final Class Formatted<T: Formattable> Implements Formattable
    ReadOnly Field Value: T

    New(value: T)
        Value = value
    End New

    Method ToString(): String => "{Value}"

    Method Format(spec: String): String? => Value.Format(spec)
End Class

/// `template` with its fields filled: "{}" is the next value, "{0}" the first, and either can
/// take a format spec after a ':', as "{0:>8}" or "{:.2}" does, or else shows its value as "{x}"
/// does; "{{" and "}}" are braces. In source, a template is a raw string, r"{} of {}", whose
/// braces aren't interpolations. Throws a FormatError for a template that isn't one, a field
/// whose value isn't given, or a spec that its value doesn't take.
///
/// # Examples
///
/// ```
/// Local line = Try Format(r"{} has {} points", "Ada", 36)
/// Expect(line == "Ada has 36 points")
/// Local swapped = Try Format(r"{1}, {0}", "a", "b")
/// Expect(swapped == "b, a")
/// Local padded = Try Format(r"[{0:>5}]", 42)
/// Expect(padded == "[   42]")
/// ```
Public Function Format(template: String, values: Formattable...): String Throws FormatError
    Local texts: String[] = []
    Local indexes: Int32[] = []
    Local specs: String[] = []
    Select fb_format_split(template, texts, indexes, specs)
        Case 1
            Throw FormatError(FormatErrorKind.BAD_TEMPLATE, "a '{{' in the template isn't closed")
        Case 2
            Throw FormatError(FormatErrorKind.BAD_TEMPLATE,
                              "a '}}' in the template must be written '}}}}'")
        Case 3
            Throw FormatError(FormatErrorKind.BAD_TEMPLATE,
                              "a field in the template is a value's number, like {{0}}, or " +
                              "{{}} for the next one")
        Case 4
            Throw FormatError(FormatErrorKind.BAD_TEMPLATE, "a format spec can't hold a brace")
    End Select

    Local text = texts[0]
    Local next = 0
    For i, index In indexes
        Local at = index
        If at < 0
            at = next
            next += 1
        End If

        If at >= values.Count
            Throw FormatError(FormatErrorKind.MISSING_VALUE,
                              "the template's field {i + 1} is value {at}, but there " +
                              (values.Count == 1 ? "is 1 value" : "are {values.Count} values"))
        End If

        // A field without a spec shows its value as "{x}" does.
        // A field without a spec shows its value as "{x}" does. One that asks for the debug form,
        // which the built-in types' Format gives, padded as they pad, a number to the right,
        // gets it as an interpolation writes it where the value's own Format doesn't take it.
        Local value = values[at]
        Local shown: String? = specs[i] == "" ? "{value}" : value.Format(specs[i])
        Local debug = fb_format_debug(specs[i])
        If shown == Null && debug != 0
            shown = fb_format_text(debug == 2 ? "{value:#?}" : "{value:?}", specs[i], 0)
        End If

        If shown == Null
            Throw FormatError(FormatErrorKind.BAD_VALUE,
                              "value {at}, {value}, doesn't take the format spec '{specs[i]}'")
        End If

        text += shown + texts[i + 1]
    End For

    Return text
End Function

/// The debug form of `value`, with each part on a line of its own, as "{value:#?}" gives it.
Public Function Dump<T>(value: T): String => "{value:#?}"

/// On an Iterable type, makes its debug form show its elements in place of its Fields, as
/// "`Stack<Int32>` [1, 2]".
Public Attribute DebugElements

/// On an Iterable type of (key, value) tuples, makes its debug form show them as a Map's, as
/// "`Map<String, Int32>` {"a": 1}".
Public Attribute DebugEntries

/// The elements a debug form shows for a type with DebugElements or DebugEntries.
Package Function ElementsOf<C, T>(values: C): T[]
    Where C: Iterable<T>
    Return values.Iterate().ToArray()
End Function
