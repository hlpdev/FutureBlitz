//! Min, Max, Clamp, Swap, and HashCombine, for any values.
//!
//! # Examples
//!
//! ```
//! Expect(Max(3, 7) == 7 && Min(3, 7) == 3)
//! Local a = 1
//! Local b = 2
//! Swap(ByRef a, ByRef b)
//! Expect(a == 2 && b == 1)
//! // Its order counts, as a Hash of several values needs.
//! Expect(HashCombine(1, 2) != HashCombine(2, 1))
//! ```

Import std.core.interfaces

// fb_hash_combine mixes a hash into a seed, as a Struct's built-in Hash does its fields'.
Extern "runtime"
    Function fb_hash_combine(seed: UInt64, hash: UInt64): UInt64
End Extern

/// The smaller of the two, or the first when neither is.
///
/// # Examples
///
/// ```
/// Expect(Min(3, 7) == 3)
/// Expect(Min("b", "a") == "a")
/// ```
Public Function Min<T: Comparable>(a: T, b: T): T => b < a ? b : a

/// The larger of the two, or the first when neither is.
Public Function Max<T: Comparable>(a: T, b: T): T => a < b ? b : a

/// The `value`, or `low` when it's below `low`, or `high` when it's above `high`. A high below
/// `low` panics.
///
/// # Examples
///
/// ```
/// Expect(Clamp(15, 0, 10) == 10)
/// Expect(Clamp(-0.5, 0.0, 1.0) == 0.0)
/// Expect(Clamp("m", "a", "z") == "m")
/// ```
@PanicsAtCaller
Public Function Clamp<T: Comparable>(value: T, low: T, high: T): T
    If high < low Then Panic("Clamp takes a low end that isn't above its high end")
    If value < low Then Return low
    If high < value Then Return high
    Return value
End Function

/// Gives each of the two variables the other's value.
///
/// # Examples
///
/// ```
/// Local a = 1
/// Local b = 2
/// Swap(ByRef a, ByRef b)
/// Expect(a == 2 && b == 1)
/// ```
Public Function Swap<T>(ByRef a: T, ByRef b: T)
    Local held = a
    a = b
    b = held
End Function

/// A hash of the two hashes together, which depends on their order, for a Hash of several values.
Public Function HashCombine(first: UInt64, second: UInt64): UInt64 => fb_hash_combine(first, second)
