// Deque<T>: values added and taken at either end. Front holds the first values backwards, so
// both ends are at the end of an array, and when one side runs out as values are taken, it takes
// half of the other.

Import std.core
Import std.collections.array

Public Class Deque<T> Implements Iterable<T>, Cloneable, Defaultable
    Field Front: T[] = []
    Field Back: T[] = []
    // How many times the values changed, so a For ... In over them can tell.
    Field Changes: Int64

    Public Property Count: Int
        Get => Front.Count + Back.Count
    End Property

    Public Method AddFirst(value: T)
        Front.Add(value)
        Changes += 1
    End Method

    Public Method AddLast(value: T)
        Back.Add(value)
        Changes += 1
    End Method

    // The same as AddLast.
    Public Method Add(value: T)
        AddLast(value)
    End Method

    // Adds each of the values last, in order.
    Public Method AddAll(values: Iterable<T>)
        For value In values.Iterate().ToArray()
            AddLast(value)
        End For
    End Method

    // Takes the first value off and gives it. Panics when the Deque is empty.
    @PanicsAtCaller
    Public Method RemoveFirst(): T
        If Front.Count == 0 Then Balance(Back, Front)
        Local value = Front[Front.Count - 1]
        Front.RemoveAt(Front.Count - 1)
        Changes += 1
        Return value
    End Method

    // Takes the last value off and gives it. Panics when the Deque is empty.
    @PanicsAtCaller
    Public Method RemoveLast(): T
        If Back.Count == 0 Then Balance(Front, Back)
        Local value = Back[Back.Count - 1]
        Back.RemoveAt(Back.Count - 1)
        Changes += 1
        Return value
    End Method

    // The first value, which stays, as everything else does. Panics when the Deque is empty.
    @PanicsAtCaller
    Public Method First(): T
        If Front.Count > 0 Then Return Front[Front.Count - 1]
        If Back.Count == 0 Then Panic("the Deque is empty")
        Return Back[0]
    End Method

    // The last value, which stays, as everything else does. Panics when the Deque is empty.
    @PanicsAtCaller
    Public Method Last(): T
        If Back.Count > 0 Then Return Back[Back.Count - 1]
        If Front.Count == 0 Then Panic("the Deque is empty")
        Return Front[0]
    End Method

    // Takes the first value off and gives it, or Null when the Deque is empty.
    Public Method TryRemoveFirst(): T?
        If Count == 0 Then Return Null
        Return RemoveFirst()
    End Method

    // Takes the last value off and gives it, or Null when the Deque is empty.
    Public Method TryRemoveLast(): T?
        If Count == 0 Then Return Null
        Return RemoveLast()
    End Method

    // The first value, which stays, or Null when the Deque is empty.
    Public Method TryFirst(): T?
        If Count == 0 Then Return Null
        Return First()
    End Method

    // The last value, which stays, or Null when the Deque is empty.
    Public Method TryLast(): T?
        If Count == 0 Then Return Null
        Return Last()
    End Method

    // The value at index, counting from the first, which is 0. Panics unless index is from 0
    // to Count minus 1.
    @PanicsAtCaller
    Operator [](index: Int): T
        If index < 0 || index >= Count Then OutOfRange(index)
        If index < Front.Count Then Return Front[Front.Count - 1 - index]
        Return Back[index - Front.Count]
    End Operator

    // Gives the value at index, counting from the first, a new value. Panics unless index is
    // from 0 to Count minus 1.
    @PanicsAtCaller
    Operator []=(index: Int, value: T)
        If index < 0 || index >= Count Then OutOfRange(index)
        If index < Front.Count
            Front[Front.Count - 1 - index] = value
        Else
            Back[index - Front.Count] = value
        End If
    End Operator

    Public Method Contains(value: T): Bool
        Where T: Equatable
        Return Front.Contains(value) || Back.Contains(value)
    End Method

    // The values from first to last, in a new array.
    Public Method ToArray(): T[]
        Local values = Front.Clone()
        values.Reverse()
        values.AddAll(Back)
        Return values
    End Method

    Public Method Clear()
        Front.Clear()
        Back.Clear()
        Changes += 1
    End Method

    // A new, empty Deque.
    Public Static Method DefaultValue(): Deque<T> => Deque<T>()

    // A new Deque with the same values.
    Public Method Clone(): Deque<T>
        Local copy = Deque<T>()
        copy.Front = Front.Clone()
        copy.Back = Back.Clone()
        Return copy
    End Method

    // The values from first to last. Changing the Deque while going over them panics.
    Public Method Iterate(): DequeIterator<T> => DequeIterator<T>(Self, Front.Count, 0, Changes)

    @PanicsAtCaller
    Method OutOfRange(index: Int)
        Panic("index {index} is out of range for {Count} element{Count == 1 ? "" : "s"}")
    End Method

    // Moves the half of from that's nearest the middle into to, which is empty, so that from's
    // start is to's end.
    @PanicsAtCaller
    Method Balance(from: T[], to: T[])
        If from.Count == 0 Then Panic("the Deque is empty")
        Local moved = (from.Count + 1) / 2
        For i = moved - 1 To 0 Step -1
            to.Add(from[i])
        End For

        Local kept = from[moved..]
        from.Clear()
        For value In kept
            from.Add(value)
        End For
    End Method
End Class

// Front's values backwards from FrontLeft, then Back's from BackAt on.
Public Struct DequeIterator<T> Implements Iterator<T>
    Field Owner: Deque<T>
    Field FrontLeft: Int
    Field BackAt: Int
    Field Changes: Int64

    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Owner.Changes != Changes Then Panic("the Deque changed while a For ... In went over it")
        If FrontLeft > 0
            FrontLeft -= 1
            Return Owner.Front[FrontLeft]
        End If

        If BackAt >= Owner.Back.Count Then Return Null
        BackAt += 1
        Return Owner.Back[BackAt - 1]
    End Method
End Struct
