//! A priority queue, whose Pop gives the value that comes first.
//!
//! `PriorityQueue<T>`: Pop gives the value that comes first, the smallest unless a before function
//! says what comes first. The values are a binary heap: each one comes before its two children,
//! at 2i + 1 and 2i + 2. In the smallest-first order, a value that isn't equal to itself, like
//! NaN, panics where it's added, as with SortedSet, since the order can't place it.

Import std.core
Import std.collections.array

/// A heap that gives its values out first by a priority: the smallest first, or what a Function
/// says comes first.
///
/// # Examples
///
/// ```
/// Local smallest = PriorityQueue<Int>()
/// smallest.AddAll([5, 1, 4])
/// Expect(smallest.Pop() == 1)
/// Expect(smallest.Peek() == 4)
/// Local largest = PriorityQueue<Int>(Function(a: Int, b: Int) => a > b)
/// largest.AddAll([5, 1, 4])
/// Expect(largest.Drain() == [5, 4, 1])
/// ```
@DebugElements
Public Class PriorityQueue<T> Implements Iterable<T>, Cloneable
    Field Items: T[] = []
    Field Before: Func(T, T): Bool
    /// In the smallest-first order, what tells a value that isn't equal to itself.
    Field Unplaced: (Func(T): Bool)? = Null
    /// How many times values were added or removed, so a For ... In over them can tell.
    Field Changes: Int64

    /// A new, empty PriorityQueue that gives its smallest value first.
    Public New()
        Where T: Comparable
        Before = Function(a: T, b: T) => a < b
        Unplaced = Function(value: T) => value != value
    End New

    /// A new, empty PriorityQueue that gives first the value `before` says comes before the
    /// others.
    Public New(before: Func(T, T): Bool)
        Before = before
    End New

    /// How many values it holds.
    Public Property Count: Int
        Get => Items.Count
    End Property

    /// Puts `value` in.
    @PanicsAtCaller
    Public Method Add(value: T)
        CheckPlace(value)
        Items.Add(value)
        Local at = Items.Count - 1
        While at > 0
            Local parent = (at - 1) / 2
            If !Before(Items[at], Items[parent]) Then Break
            Swap(at, parent)
            at = parent
        End While

        Changes += 1
    End Method

    /// Adds each of the `values`, putting the heap in order once, in time that grows with the
    /// count.
    @PanicsAtCaller
    Public Method AddAll(values: Iterable<T>)
        Local added = values.Iterate().ToArray()
        If added.Count == 0 Then Return
        For value In added
            CheckPlace(value)
        End For

        Items.AddAll(added)
        For at = Items.Count / 2 - 1 To 0 Step -1
            SiftDown(at)
        End For
        Changes += 1
    End Method

    /// Takes the first value off and gives it. Panics when the PriorityQueue is empty.
    @PanicsAtCaller
    Public Method Pop(): T
        Local first = Peek()
        Local last = Items.Count - 1
        Items[0] = Items[last]
        Items.RemoveAt(last)
        SiftDown(0)
        Changes += 1
        Return first
    End Method

    /// Takes the first value off and gives it, or Null when the PriorityQueue is empty.
    Public Method TryPop(): T?
        If Items.Count == 0 Then Return Null
        Return Pop()
    End Method

    /// The first value, which stays, or Null when the PriorityQueue is empty.
    Public Method TryPeek(): T?
        If Items.Count == 0 Then Return Null
        Return Items[0]
    End Method

    /// Takes every value off, and gives them in the order Pop would.
    Public Method Drain(): T[]
        Local drained: T[] = []
        drained.Reserve(Items.Count)
        While Items.Count > 0
            drained.Add(Pop())
        End While
        Return drained
    End Method

    /// The values, in no particular order, in a new array.
    Public Method ToArray(): T[] => Items.Clone()

    /// The first value, which stays. Panics when the PriorityQueue is empty.
    @PanicsAtCaller
    Public Method Peek(): T
        If Items.Count == 0 Then Panic("the PriorityQueue is empty")
        Return Items[0]
    End Method

    /// Whether it holds `value`.
    Public Method Contains(value: T): Bool
        Where T: Equatable
        Return Items.Contains(value)
    End Method

    /// Takes every value out.
    Public Method Clear()
        Items.Clear()
        Changes += 1
    End Method

    /// A new PriorityQueue with the same values and order.
    Public Method Clone(): PriorityQueue<T>
        Local copy = PriorityQueue<T>(Before)
        copy.Unplaced = Unplaced
        copy.Items = Items.Clone()
        Return copy
    End Method

    /// The values, in no particular order: Pop gives them in order. Changing the PriorityQueue
    /// while going over them panics.
    Public Method Iterate(): PriorityQueueIterator<T> => PriorityQueueIterator<T>(Self, 0, Changes)

    /// Panics at a value the smallest-first order can't place.
    @PanicsAtCaller
    Method CheckPlace(value: T)
        Local unplaced = Unplaced
        If unplaced != Null && unplaced(value)
            Panic("a PriorityQueue's value can't be NaN, or anything else that isn't equal to " +
                  "itself")
        End If
    End Method

    /// Moves the value at at down the heap while a child comes before it.
    Method SiftDown(at: Int)
        Local parent = at
        Loop
            Local first = HeapChild(parent, Items.Count)
            If first == Null Then Break
            Local child = first
            If child + 1 < Items.Count && Before(Items[child + 1], Items[child]) Then child += 1
            If !Before(Items[child], Items[parent]) Then Break
            Swap(parent, child)
            parent = child
        End Loop
    End Method

    Method Swap(a: Int, b: Int)
        Local value = Items[a]
        Items[a] = Items[b]
        Items[b] = value
    End Method
End Class

// A new, empty PriorityQueue, which gives the smallest value first, where the values have an
// order.
Extend PriorityQueue<T> Implements Defaultable
    Where T: Comparable

    /// A new, empty PriorityQueue that gives its smallest value first.
    Public Static Method DefaultValue(): PriorityQueue<T> => PriorityQueue<T>()
End Extend

/// The values of a PriorityQueue, in no order to count on, which For ... In goes over.
Public Struct PriorityQueueIterator<T> Implements Iterator<T>
    Field Owner: PriorityQueue<T>
    Field Index: Int
    Field Changes: Int64

    /// The next value, in no order to count on, or Null after the last. Panics when the
    /// PriorityQueue changed since the loop began.
    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Owner.Changes != Changes
            Panic("the PriorityQueue changed while a For ... In went over it")
        End If

        If Index >= Owner.Items.Count Then Return Null
        Index += 1
        Return Owner.Items[Index - 1]
    End Method
End Struct
