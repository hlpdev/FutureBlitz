// Queue<T>: first in, first out. Enqueue puts a value at the back, and Dequeue takes the one at
// the front. The values start at Head, and the ones before it are dropped once they're half.

Import std.core

Public Class Queue<T> Implements Iterable<T>, Cloneable, Defaultable
    Field Items: T[] = []
    Field Head: Int
    // How many times the values changed, so a For ... In over them can tell.
    Field Changes: Int64

    Public Property Count: Int
        Get => Items.Count - Head
    End Property

    Public Method Enqueue(value: T)
        Items.Add(value)
        Changes += 1
    End Method

    // The same as Enqueue.
    Public Method Add(value: T)
        Enqueue(value)
    End Method

    // Enqueues each of the values, in order.
    Public Method AddAll(values: Iterable<T>)
        For value In values.Iterate().ToArray()
            Enqueue(value)
        End For
    End Method

    // Takes the front value off and gives it. Panics when the Queue is empty.
    @PanicsAtCaller
    Public Method Dequeue(): T
        Local front = Peek()
        Head += 1
        If Head * 2 >= Items.Count
            Items = Items[Head..]
            Head = 0
        End If

        Changes += 1
        Return front
    End Method

    // The front value, which stays. Panics when the Queue is empty.
    @PanicsAtCaller
    Public Method Peek(): T
        If Head == Items.Count Then Panic("the Queue is empty")
        Return Items[Head]
    End Method

    // Takes the front value off and gives it, or Null when the Queue is empty.
    Public Method TryDequeue(): T?
        If Head == Items.Count Then Return Null
        Return Dequeue()
    End Method

    // The front value, which stays, or Null when the Queue is empty.
    Public Method TryPeek(): T?
        If Head == Items.Count Then Return Null
        Return Items[Head]
    End Method

    // The values from the front, the order Dequeue gives them, in a new array.
    Public Method ToArray(): T[] => Items[Head..]

    Public Method Contains(value: T): Bool
        Where T: Equatable
        For i = Head Until Items.Count
            If Items[i] == value Then Return True
        End For
        Return False
    End Method

    Public Method Clear()
        Items.Clear()
        Head = 0
        Changes += 1
    End Method

    // A new, empty Queue.
    Public Static Method DefaultValue(): Queue<T> => Queue<T>()

    // A new Queue with the same values.
    Public Method Clone(): Queue<T>
        Local copy = Queue<T>()
        copy.Items = Items[Head..]
        Return copy
    End Method

    // The values from the front, the order Dequeue gives them. Changing the Queue while going
    // over them panics.
    Public Method Iterate(): QueueIterator<T> => QueueIterator<T>(Self, Head, Changes)
End Class

Public Struct QueueIterator<T> Implements Iterator<T>
    Field Owner: Queue<T>
    Field Index: Int
    Field Changes: Int64

    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Owner.Changes != Changes Then Panic("the Queue changed while a For ... In went over it")
        If Index >= Owner.Items.Count Then Return Null
        Index += 1
        Return Owner.Items[Index - 1]
    End Method
End Struct
