// Set<T>: values without repeats, which a Map holds as its keys.

Class Set<T>
    Where T: Hashable

    Field Items: Map<T, Bool>

    New()
        Items = Map<T, Bool>()
    End New

    Property Count: Int
        Get => Items.Count
    End Property

    // Adds the value, and tells whether it's new.
    Method Add(value: T): Bool
        If Items.Contains(value) Then Return False
        Items.Add(value, True)
        Return True
    End Method

    // Removes the value, and tells whether it was there.
    Method Remove(value: T): Bool => Items.Remove(value)

    Method Contains(value: T): Bool => Items.Contains(value)

    Method Clear()
        Items.Clear()
    End Method

    Method Clone(): Set<T>
        Local copy = Set<T>()
        copy.Items = Items.Clone()
        Return copy
    End Method

    // A new Set of the values that keep says to keep.
    Method Filter(keep: Func(T): Bool): Set<T>
        Local kept = Set<T>()
        For value In Items.Keys()
            If keep(value) Then kept.Add(value)
        End For
        Return kept
    End Method

    // The first value that test says is the one, or Null.
    Method Find(test: Func(T): Bool): T?
        Return Items.Keys().Find(test)
    End Method

    // The values, in the order they were added.
    Method Iterate(): SetIterator<T> => SetIterator<T>(Items.Iterate())
End Class

Struct SetIterator<T> Implements Iterator<T>
    Field Entries: MapIterator<T, Bool>

    ByRef Method Next(): T?
        Local entry = Entries.Next()
        If entry == Null Then Return Null
        Return entry.0
    End Method
End Struct

// "{1, 2, 3}", when the values can be shown.
Extend Set<T> Implements Printable
    Where T: Printable

    Method ToString(): String
        Local text = ""
        For value In Self
            text = text + (text == "" ? "" : ", ") + "{value}"
        End For
        Return "{{" + text + "}}"
    End Method
End Extend
