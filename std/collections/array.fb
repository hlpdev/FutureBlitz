//! Searching, sorting, reshaping, and the other Methods every array has.
//!
//! What every collection has, on T[], besides the built-in Add, Insert, RemoveAt, Clear, Contains,
//! Clone, Reserve, TrimExcess, Count, and Capacity: searching, the ends, many elements at once,
//! order, and shape. A lookup gives a T?, or a T?? where the elements can be Null, and what's
//! wrong with its arguments panics where it's called. A function given to one that changes the
//! array changes what's left to go over, as in a For ... In, and an element it takes away panics
//! where the Method was called.

Import std.core
Import std.collections.map

/// What every array has besides the built-in Add, Insert, RemoveAt, Clear, Contains, Clone,
/// Reserve, TrimExcess, Count, and Capacity: searching, its ends, many elements at once, sorting,
/// and reshaping.
Extend T[]
    /// Removes the first element equal to `value`, and tells whether there was one.
    Public Method Remove(value: T): Bool
        Where T: Equatable
        For i, element In Self
            If element == value
                RemoveAt(i)
                Return True
            End If
        End For
        Return False
    End Method

    /// Sorts the elements in place, smallest first. Equal elements keep their order.
    ///
    /// # Examples
    ///
    /// ```
    /// Local numbers = [3, 1, 2]
    /// numbers.Sort()
    /// Expect(numbers == [1, 2, 3])
    /// ```
    @PanicsAtCaller
    Public Method Sort()
        Where T: Comparable
        Sort(Function(a: T, b: T) => a < b)
    End Method

    /// Sorts the elements in place, by what `before` says comes first. It's a merge sort, so equal
    /// elements keep their order.
    ///
    /// # Examples
    ///
    /// ```
    /// Local numbers = [3, 1, 2]
    /// numbers.Sort(Function(a: Int, b: Int) => a > b)
    /// Expect(numbers == [3, 2, 1])
    /// ```
    @PanicsAtCaller
    Public Method Sort(before: Func(T, T): Bool)
        If Count < 2 Then Return
        Local from = Clone()
        MergeSort(from, Self, 0, Count, before)
    End Method

    /// Each element that `keep` says to keep, in a new array.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 3, 4].Filter(Function(n: Int) => n % 2 == 0) == [2, 4])
    /// ```
    Public Method Filter(keep: Func(T): Bool): T[]
        Local kept: T[] = []
        For element In Self
            If keep(element) Then kept.Add(element)
        End For
        Return kept
    End Method

    /// What `change` gives for each element, in a new array.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 3].Map(Function(n: Int) => n * 10) == [10, 20, 30])
    /// Expect([1, 2].Map(Function(n: Int) => "#{n}") == ["#1", "#2"])
    /// ```
    Public Method Map<U>(change: Func(T): U): U[]
        Local changed: U[] = []
        For element In Self
            changed.Add(change(element))
        End For
        Return changed
    End Method

    /// The first element that `test` says is the one, or Null.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([5, 8, 12].Find(Function(n: Int) => n > 6) == 8)
    /// Expect([5, 8, 12].Find(Function(n: Int) => n > 20) == Null)
    /// ```
    Public Method Find(test: Func(T): Bool): T?
        For element In Self
            If test(element) Then Return element
        End For
        Return Null
    End Method

    /// The last element that `test` says is the one, or Null.
    Public Method FindLast(test: Func(T): Bool): T?
        Local i = Count - 1
        While i >= 0
            Local element = Self[i]
            If test(element) Then Return element
            i = Min(i, Count) - 1
        End While
        Return Null
    End Method

    /// Where the first element that `test` says is the one is, or Null.
    Public Method FindIndex(test: Func(T): Bool): Int?
        For i, element In Self
            If test(element) Then Return i
        End For
        Return Null
    End Method

    /// Where the first element equal to `value` is, or Null.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect(["a", "b", "a"].IndexOf("a") == 0)
    /// Expect(["a", "b", "a"].IndexOf("c") == Null)
    /// ```
    Public Method IndexOf(value: T): Int?
        Where T: Equatable
        For i, element In Self
            If element == value Then Return i
        End For
        Return Null
    End Method

    /// Where the last element equal to `value` is, or Null.
    Public Method LastIndexOf(value: T): Int?
        Where T: Equatable
        For i = Count - 1 To 0 Step -1
            If Self[i] == value Then Return i
        End For
        Return Null
    End Method

    /// Where an element equal to `value` is in an array sorted smallest first, or Null, looking at
    /// about log2(Count) of them.
    ///
    /// # Examples
    ///
    /// ```
    /// Local sorted = [1, 3, 5, 7]
    /// Expect(sorted.BinarySearch(5) == 2)
    /// Expect(sorted.BinarySearch(4) == Null)
    /// ```
    Public Method BinarySearch(value: T): Int?
        Where T: Comparable
        Local low = 0
        Local high = Count
        While low < high
            Local middle = low + (high - low) / 2
            If Self[middle] < value
                low = middle + 1
            ElseIf value < Self[middle]
                high = middle
            Else
                Return middle
            End If
        End While
        Return Null
    End Method

    /// Whether `test` says yes for any element, going no further than the first.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 3].Any(Function(n: Int) => n > 2))
    /// Expect(![1, 2, 3].All(Function(n: Int) => n > 2))
    /// ```
    Public Method Any(test: Func(T): Bool): Bool
        For element In Self
            If test(element) Then Return True
        End For
        Return False
    End Method

    /// Whether `test` says yes for every element, going no further than the first it doesn't.
    Public Method All(test: Func(T): Bool): Bool
        For element In Self
            If !test(element) Then Return False
        End For
        Return True
    End Method

    /// The first element, or Null when there's none.
    Public Method First(): T?
        If Count == 0 Then Return Null
        Return Self[0]
    End Method

    /// The last element, or Null when there's none.
    Public Method Last(): T?
        If Count == 0 Then Return Null
        Return Self[Count - 1]
    End Method

    /// Takes the last element off, and gives it. The array can't be empty.
    @PanicsAtCaller
    Public Method RemoveLast(): T
        If Count == 0 Then Panic("RemoveLast takes the last element, but the array is empty")
        Local last = Self[Count - 1]
        RemoveAt(Count - 1)
        Return last
    End Method

    /// Takes the last element off, and gives it, or Null when there's none.
    Public Method TryRemoveLast(): T?
        If Count == 0 Then Return Null
        Local last = Self[Count - 1]
        RemoveAt(Count - 1)
        Return last
    End Method

    /// Adds each of the `values` at the end, in order.
    Public Method AddAll(values: T[])
        // A copy first, so adding an array to itself adds what it had.
        For value In values.Clone()
            Add(value)
        End For
    End Method

    /// The same, from any `Iterable<T>`, all of which is read first.
    Public Method AddAll(values: Iterable<T>)
        AddAll(values.Iterate().ToArray())
    End Method

    /// Puts the `values` in, in order, from `index` on, which can be from 0 to Count.
    @PanicsAtCaller
    Public Method InsertAll(index: Int, values: T[])
        If index < 0 || index > Count
            Panic("InsertAll takes an index from 0 to {Count}, not {index}")
        End If

        Local added = values.Clone()
        For i, value In added
            Insert(index + i, value)
        End For
    End Method

    /// The same, from any `Iterable<T>`, all of which is read first.
    @PanicsAtCaller
    Public Method InsertAll(index: Int, values: Iterable<T>)
        InsertAll(index, values.Iterate().ToArray())
    End Method

    /// Takes out `count` elements, from `start` on, which must all be in the array.
    @PanicsAtCaller
    Public Method RemoveRange(start: Int, count: Int)
        If start < 0 || count < 0 || start > Count - count
            Panic("RemoveRange takes elements in the array, from 0 to {Count}, not {count} from " +
                  "{start}")
        End If

        For i = start Until Count - count
            Self[i] = Self[i + count]
        End For
        For i = 1 To count
            RemoveAt(Count - 1)
        End For
    End Method

    /// Takes out each element that `test` says to, keeping the others in order, and tells how many
    /// went. An element `test` adds is tested too.
    ///
    /// # Examples
    ///
    /// ```
    /// Local numbers = [1, 2, 3, 4, 5]
    /// Expect(numbers.RemoveAll(Function(n: Int) => n % 2 == 1) == 3)
    /// Expect(numbers == [2, 4])
    /// ```
    Public Method RemoveAll(test: Func(T): Bool): Int
        Local kept = 0
        Local i = 0
        While i < Count
            Local going = test(Self[i])
            // What test did may have shortened the array.
            If i >= Count Then Break
            If !going
                Self[kept] = Self[i]
                kept += 1
            End If

            i += 1
        End While

        Local removed = Count - kept
        For n = 1 To removed
            RemoveAt(Count - 1)
        End For
        Return removed
    End Method

    /// Makes the array `count` elements long, taking elements off the end or adding `fill`.
    @PanicsAtCaller
    Public Method Resize(count: Int, fill: T)
        If count < 0 Then Panic("Resize takes a count that isn't negative, not {count}")
        While Count > count
            RemoveAt(Count - 1)
        End While
        While Count < count
            Add(fill)
        End While
    End Method

    /// Gives every element the `value`.
    Public Method Fill(value: T)
        For i = 0 Until Count
            Self[i] = value
        End For
    End Method

    /// Puts the elements in the opposite order, in place.
    Public Method Reverse()
        For i = 0 Until Count / 2
            Swap(i, Count - 1 - i)
        End For
    End Method

    /// Gives each of the two elements the other's place.
    @PanicsAtCaller
    Public Method Swap(a: Int, b: Int)
        Local held = Self[a]
        Self[a] = Self[b]
        Self[b] = held
    End Method

    /// Sorts the elements in place by what `key` gives for each, smallest first. Equal keys keep
    /// their elements' order, and ThenBy on what it gives breaks their ties.
    ///
    /// # Examples
    ///
    /// ```
    /// Local people = [("Grace", 36), ("Alan", 41), ("Ada", 36)]
    /// people.SortBy(Function(p: (String, Int)) => p.1).ThenBy(Function(p: (String, Int)) => p.0)
    /// Expect(people == [("Ada", 36), ("Grace", 36), ("Alan", 41)])
    /// ```
    @PanicsAtCaller
    Public Method SortBy<K: Comparable>(key: Func(T): K): Sorting<T>
        Local before = Function(a: T, b: T) => key(a) < key(b)
        Sort(before)
        Return Sorting<T>(Self, before)
    End Method

    /// The same, largest `key` first.
    @PanicsAtCaller
    Public Method SortByDescending<K: Comparable>(key: Func(T): K): Sorting<T>
        Local before = Function(a: T, b: T) => key(b) < key(a)
        Sort(before)
        Return Sorting<T>(Self, before)
    End Method

    /// Sorts the elements in place, smallest first, without making another array: a heap sort,
    /// so equal elements may change places.
    @PanicsAtCaller
    Public Method SortUnstable()
        Where T: Comparable
        SortUnstable(Function(a: T, b: T) => a < b)
    End Method

    /// Sorts the elements in place, by what `before` says comes first, without making another
    /// array: a heap sort, so equal elements may change places.
    @PanicsAtCaller
    Public Method SortUnstable(before: Func(T, T): Bool)
        For start = Count / 2 - 1 To 0 Step -1
            SiftDown(start, Count, before)
        End For
        For last = Count - 1 To 1 Step -1
            Swap(0, last)
            SiftDown(0, last, before)
        End For
    End Method

    /// Moves the element at index down the heap in the first count elements, where each comes
    /// after its two children, by before.
    @PanicsAtCaller
    Method SiftDown(index: Int, count: Int, before: Func(T, T): Bool)
        Local at = index
        Loop
            Local left = HeapChild(at, count)
            If left == Null Then Return
            Local largest = at
            Local right = left + 1
            If before(Self[largest], Self[left]) Then largest = left
            If right < count && before(Self[largest], Self[right]) Then largest = right
            If largest == at Then Return
            Swap(at, largest)
            at = largest
        End Loop
    End Method

    /// The elements, each only the first time it comes, in a new array.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 1, 3, 2].Distinct() == [1, 2, 3])
    /// ```
    Public Method Distinct(): T[]
        Where T: Hashable
        Local seen = map.Map<T, Bool>()
        Local kept: T[] = []
        For element In Self
            If !seen.Contains(element)
                seen.Add(element, True)
                kept.Add(element)
            End If
        End For
        Return kept
    End Method

    /// The elements' text, as "{x}" shows each, with `separator` between each two.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 3].Join(", ") == "1, 2, 3")
    /// ```
    Public Method Join(separator: String): String
        Where T: Printable
        Local parts: String[] = []
        For element In Self
            parts.Add("{element}")
        End For
        Return Joined(parts, separator)
    End Method

    /// What `combine` gives for each element in turn, starting from `start`.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([1, 2, 3].Fold(0, Function(sum: Int, n: Int) => sum + n) == 6)
    /// Expect([1, 2, 3].Fold("", Function(text: String, n: Int) => text + "{n}") == "123")
    /// ```
    Public Method Fold<A>(start: A, combine: Func(A, T): A): A
        Local total = start
        For element In Self
            total = combine(total, element)
        End For
        Return total
    End Method

    /// What `combine` gives for each element in turn, starting from the first, or Null when there's
    /// none.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect([3, 7, 5].Reduce(Function(a: Int, b: Int) => Max(a, b)) == 7)
    /// Local none: Int[] = []
    /// Expect(none.Reduce(Function(a: Int, b: Int) => a + b) == Null)
    /// ```
    Public Method Reduce(combine: Func(T, T): T): T?
        If Count == 0 Then Return Null
        Local total = Self[0]
        Local i = 1
        While i < Count
            total = combine(total, Self[i])
            i += 1
        End While
        Return total
    End Method
End Extend

// An array's elements for code that takes any Iterable<T>, or for lazy adapters, as in
// "items.Iterate().Filter(keep)". For ... In goes over an array itself.
/// Makes every array an `Iterable<T>`, so code that takes any collection takes one.
Extend T[] Implements Iterable<T>
    /// Its elements, in order, which a loop over the array goes through.
    Public Method Iterate(): ArrayIterator<T> => ArrayIterator<T>(Self, 0)
End Extend

/// An array's elements, in order, as far as its Count when each is read.
Public Struct ArrayIterator<T> Implements Iterator<T>
    Field Items: T[]
    Field Index: Int

    /// The next element, in order, or Null after the last.
    Public ByRef Method Next(): T?
        If Index >= Items.Count Then Return Null
        Index += 1
        Return Items[Index - 1]
    End Method
End Struct

/// An array SortBy or SortByDescending sorted, whose ThenBy and ThenByDescending sort it again
/// where the keys so far tie, in place.
///
/// # Examples
///
/// ```
/// # Import std.text
/// Local words = ["bb", "a", "ccc", "dd"]
/// words.SortBy(Function(w: String) => w.Length).ThenByDescending(Function(w: String) => w)
/// Expect(words == ["a", "dd", "bb", "ccc"])
/// ```
Public Struct Sorting<T>
    Field Items: T[]
    Field Before: Func(T, T): Bool

    /// Sorts the array again by what `key` gives, smallest first, where the keys so far tie.
    @PanicsAtCaller
    Public Method ThenBy<K: Comparable>(key: Func(T): K): Sorting<T>
        Local first = Before
        Return Again(Function(a: T, b: T) => first(a, b) || (!first(b, a) && key(a) < key(b)))
    End Method

    /// The same, largest `key` first.
    @PanicsAtCaller
    Public Method ThenByDescending<K: Comparable>(key: Func(T): K): Sorting<T>
        Local first = Before
        Return Again(Function(a: T, b: T) => first(a, b) || (!first(b, a) && key(b) < key(a)))
    End Method

    @PanicsAtCaller
    Method Again(before: Func(T, T): Bool): Sorting<T>
        Items.Sort(before)
        Return Sorting<T>(Items, before)
    End Method
End Struct

/// The first of the two children of the value at index at in a binary heap of count values, at
/// 2 * at + 1, or Null when it has none. Only a value before count / 2 has one, so working it out
/// never overflows.
Package Function HeapChild(at: Int, count: Int): Int?
    If at >= count / 2 Then Return Null
    Return 2 * at + 1
End Function

/// The parts with separator between them, joined in pairs, then pairs of those, and so on, so the
/// time grows with their length times its logarithm, not with its square.
Function Joined(parts: String[], separator: String): String
    If parts.Count == 0 Then Return ""
    Local joined = parts
    While joined.Count > 1
        Local pairs: String[] = []
        For i = 0 Until joined.Count Step 2
            If i + 1 < joined.Count
                pairs.Add(joined[i] + separator + joined[i + 1])
            Else
                pairs.Add(joined[i])
            End If
        End For
        joined = pairs
    End While
    Return joined[0]
End Function
