// What every collection has, on T[]: Remove, Sort, Filter, Map, and Find, besides the built-in
// Add, Insert, RemoveAt, Clear, Contains, Clone, and Count.

Import std.core

Extend T[]
    // Removes the first element equal to value, and tells whether there was one.
    Public Method Remove(value: T): Bool
        Where T: Equatable
        For i, element In Self
            If element == value
                RemoveAt(i)
                Return True
            End If
        End For
        Return False
    End Method

    // Sorts the elements in place, smallest first. Equal elements keep their order.
    Public Method Sort()
        Where T: Comparable
        Sort(Function(a: T, b: T) => a < b)
    End Method

    // Sorts the elements in place, by what before says comes first. It's a merge sort, so equal
    // elements keep their order.
    Public Method Sort(before: Func(T, T): Bool)
        If Count < 2 Then Return
        Local from = Clone()
        MergeSort(from, Self, 0, Count, before)
    End Method

    // Each element that keep says to keep, in a new array.
    Public Method Filter(keep: Func(T): Bool): T[]
        Local kept: T[] = []
        For element In Self
            If keep(element) Then kept.Add(element)
        End For
        Return kept
    End Method

    // What change gives for each element, in a new array.
    Public Method Map<U>(change: Func(T): U): U[]
        Local changed: U[] = []
        For element In Self
            changed.Add(change(element))
        End For
        Return changed
    End Method

    // The first element that test says is the one, or Null.
    Public Method Find(test: Func(T): Bool): T?
        For element In Self
            If test(element) Then Return element
        End For
        Return Null
    End Method
End Extend
