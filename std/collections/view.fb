//! Views of arrays, maps, and sets, which show them without copying.
//!
//! Views that don't copy what they show: part of an array, which reads and sets it in place, and
//! an array, Map, or Set to read but not change, to hand out. Each keeps what it shows alive and
//! sees its changes. A slice, items[a..b], is still a copy.
//!
//! # Examples
//!
//! ```
//! Local numbers = [1, 2, 3, 4]
//! Expect(numbers.View(1, 3).ToArray() == [2, 3])
//! Local ages = {"Ada": 36}
//! Local shown = ages.AsReadOnly()
//! ages["Alan"] = 41
//! Expect(shown.Count == 2 && shown.Get("Alan") == 41)
//! Local seen = Set<Int>()
//! seen.Add(1)
//! Expect(seen.AsReadOnly().Contains(1))
//! ```

Import std.core
Import std.collections.array
Import std.collections.map
Import std.collections.set

/// Views of every array: part of it, read and set in place, and the whole, to read but not change.
Extend T[]
    /// The elements from `start` up to `finish`, without the one at `finish`, as a view of them in
    /// the array. They have to be in the array.
    ///
    /// # Examples
    ///
    /// ```
    /// Local numbers = [1, 2, 3, 4, 5]
    /// Local middle = numbers.View(1, 4)
    /// middle[0] = 20
    /// Expect(numbers == [1, 20, 3, 4, 5])
    /// Expect(middle.Count == 3 && middle.ToArray() == [20, 3, 4])
    /// ```
    @PanicsAtCaller
    Public Method View(start: Int, finish: Int): ArrayView<T>
        If start < 0 || finish < start || finish > Count
            Panic("view {start}..{finish} is out of range for {Count} element" +
                  "{Count == 1 ? "" : "s"}")
        End If

        Return ArrayView<T>(Self, start, finish - start)
    End Method

    /// The array, to read but not change.
    ///
    /// # Examples
    ///
    /// ```
    /// Local scores = [1, 2, 3]
    /// Local shown = scores.AsReadOnly()
    /// scores.Add(4)
    /// Expect(shown.Count == 4 && shown[3] == 4)
    /// ```
    Public Method AsReadOnly(): ReadOnlyArray<T> => ReadOnlyArray<T>(Self)
End Extend

/// A view of every Map, to read but not change.
Extend Map<K, V>
    /// The Map, to read but not change.
    Public Method AsReadOnly(): ReadOnlyMap<K, V> => ReadOnlyMap<K, V>(Self)
End Extend

/// A view of every Set, to read but not change.
Extend Set<T>
    /// The Set, to read but not change.
    Public Method AsReadOnly(): ReadOnlySet<T> => ReadOnlySet<T>(Self)
End Extend

/// Part of an array, whose elements it reads and sets in place, counting from its own start. Its
/// Count is the part's own, which stays as the array changes, and an element the array no longer
/// has panics.
@DebugElements
Public Class ArrayView<T> Implements Iterable<T>
    Field Items: T[]
    Field Start: Int
    Field Length: Int

    New(items: T[], start: Int, length: Int)
        Items = items
        Start = start
        Length = length
    End New

    /// How many elements it shows.
    Public Property Count: Int
        Get => Length
    End Property

    /// The element at index, from 0 to Count minus 1.
    @PanicsAtCaller
    Operator [](index: Int): T => Items[Place(index)]

    /// Gives the element at index, from 0 to Count minus 1, a new value, in the array.
    @PanicsAtCaller
    Operator []=(index: Int, value: T)
        Items[Place(index)] = value
    End Operator

    /// Part of this view, from `start` up to `finish`, without the one at `finish`.
    @PanicsAtCaller
    Public Method View(start: Int, finish: Int): ArrayView<T>
        If start < 0 || finish < start || finish > Length
            Panic("view {start}..{finish} is out of range for {Length} element" +
                  "{Length == 1 ? "" : "s"}")
        End If

        Return ArrayView<T>(Items, Start + start, finish - start)
    End Method

    /// The elements, in a new array.
    @PanicsAtCaller
    Public Method ToArray(): T[]
        Local copy: T[] = []
        copy.Reserve(Length)
        For i = 0 Until Length
            copy.Add(Self[i])
        End For
        Return copy
    End Method

    /// The elements, in order.
    Public Method Iterate(): ArrayViewIterator<T> => ArrayViewIterator<T>(Self, 0)

    /// Where the element at index of the view is in its array, which still has to have it.
    @PanicsAtCaller
    Method Place(index: Int): Int
        Local s = Length == 1 ? "" : "s"
        If index < 0 || index >= Length
            Panic("index {index} is out of range for a view of {Length} element{s}")
        End If

        If Start + index >= Items.Count
            Panic("index {index} of a view of {Length} element{s} is past its array's end, at " +
                  "{Items.Count} element{Items.Count == 1 ? "" : "s"}")
        End If

        Return Start + index
    End Method
End Class

/// The elements of an ArrayView, in order, which a For loop goes over.
Public Struct ArrayViewIterator<T> Implements Iterator<T>
    Field View: ArrayView<T>
    Field Index: Int

    /// The next element, in order, or Null after the last.
    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Index >= View.Count Then Return Null
        Index += 1
        Return View[Index - 1]
    End Method
End Struct

/// An array to read but not change, which AsReadOnly gives.
@DebugElements
Public Class ReadOnlyArray<T> Implements Iterable<T>
    Field Items: T[]

    New(items: T[])
        Items = items
    End New

    /// How many elements it holds.
    Public Property Count: Int
        Get => Items.Count
    End Property

    /// The value at `index`, which panics outside it.
    @PanicsAtCaller
    Operator [](index: Int): T => Items[index]

    /// Whether it holds `value`.
    Public Method Contains(value: T): Bool
        Where T: Equatable
        Return Items.Contains(value)
    End Method

    /// The elements, in a new array, which can change.
    Public Method ToArray(): T[] => Items.Clone()

    /// The array's elements, in order.
    Public Method Iterate(): ArrayIterator<T> => Items.Iterate()
End Class

/// A Map to read but not change, which AsReadOnly gives.
@DebugEntries
Public Class ReadOnlyMap<K: Hashable, V> Implements Iterable<(K, V)>
    Field Items: Map<K, V>

    New(items: Map<K, V>)
        Items = items
    End New

    /// How many entries it holds.
    Public Property Count: Int
        Get => Items.Count
    End Property

    /// The key's value, or the Map's default when it isn't there, or a panic when it has none.
    @PanicsAtCaller
    Operator [](key: K): V => Items[key]

    /// The value of `key`, or Null when it has none.
    Public Method Get(key: K): V? => Items.Get(key)

    /// The value of `key`, or `fallback` when it has none.
    Public Method Get(key: K, fallback: V): V => Items.Get(key, fallback)

    /// Whether `key` has an entry.
    Public Method Contains(key: K): Bool => Items.Contains(key)

    /// Its keys, in order, in a new array.
    Public Method Keys(): K[] => Items.Keys()

    /// Its values, in order, in a new array.
    Public Method Values(): V[] => Items.Values()

    /// The entries, in a new Map, which can change.
    Public Method ToMap(): Map<K, V> => Items.Clone()

    /// The Map's entries, in order.
    Public Method Iterate(): MapIterator<K, V> => Items.Iterate()
End Class

/// A Set to read but not change, which AsReadOnly gives.
@DebugElements
Public Class ReadOnlySet<T: Hashable> Implements Iterable<T>
    Field Items: Set<T>

    New(items: Set<T>)
        Items = items
    End New

    /// How many values it holds.
    Public Property Count: Int
        Get => Items.Count
    End Property

    /// Whether it holds `value`.
    Public Method Contains(value: T): Bool => Items.Contains(value)

    /// The values, in a new array.
    Public Method ToArray(): T[] => Items.ToArray()

    /// The values, in a new Set, which can change.
    Public Method ToSet(): Set<T> => Items.Clone()

    /// The Set's values, in order.
    Public Method Iterate(): SetIterator<T> => Items.Iterate()
End Class

// "[1, 2, 3]", as an array of the view's elements would show them.
/// Shows an ArrayView in a string, as its ToString writes it.
Extend ArrayView<T> Implements Printable
    Where T: Printable

    /// The elements it shows, as an array shows them: "[1, 2, 3]".
    @PanicsAtCaller
    Public Method ToString(): String => "{ToArray()}"
End Extend

/// Shows a ReadOnlyArray in a string, as its ToString writes it.
Extend ReadOnlyArray<T> Implements Printable
    Where T: Printable

    /// The array, as it shows itself: "[1, 2, 3]".
    Public Method ToString(): String => "{Items}"
End Extend

/// Shows a ReadOnlyMap in a string, as its ToString writes it.
Extend ReadOnlyMap<K, V> Implements Printable
    Where K: Printable
    Where V: Printable

    /// The Map, as it shows itself: "{a: 1, b: 2}".
    Public Method ToString(): String => "{Items}"
End Extend

/// Shows a ReadOnlySet in a string, as its ToString writes it.
Extend ReadOnlySet<T> Implements Printable
    Where T: Printable

    /// The Set, as it shows itself: "{1, 2, 3}".
    Public Method ToString(): String => "{Items}"
End Extend
