// Stack<T>: last in, first out. Push puts a value on top, and Pop takes the top one off.

Class Stack<T>
    Field Items: T[] = []

    Property Count: Int
        Get => Items.Count
    End Property

    Method Push(value: T)
        Items.Add(value)
    End Method

    // The same as Push.
    Method Add(value: T)
        Items.Add(value)
    End Method

    // Takes the top value off and gives it. Panics when the Stack is empty.
    Method Pop(): T
        Local top = Peek()
        Items.RemoveAt(Items.Count - 1)
        Return top
    End Method

    // The top value, which stays. Panics when the Stack is empty.
    Method Peek(): T
        If Items.Count == 0 Then Panic("the Stack is empty")
        Return Items[Items.Count - 1]
    End Method

    Method Contains(value: T): Bool
        Where T: Equatable
        Return Items.Contains(value)
    End Method

    Method Clear()
        Items.Clear()
    End Method

    Method Clone(): Stack<T>
        Local copy = Stack<T>()
        copy.Items = Items.Clone()
        Return copy
    End Method

    // The values from the top down, the order Pop gives them.
    Method Iterate(): StackIterator<T> => StackIterator<T>(Items, Items.Count)
End Class

Struct StackIterator<T> Implements Iterator<T>
    Field Items: T[]
    Field Index: Int

    ByRef Method Next(): T?
        If Index == 0 Then Return Null
        Index -= 1
        Return Items[Index]
    End Method
End Struct
