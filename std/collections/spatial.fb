//! `SpatialHash<T>`, `QuadTree<T>`, and `Octree<T>`: values at points, found by where they are, the
//! ones in a box or near a point, without going over the others. A SpatialHash keeps the points in
//! square cells of a size, for things spread over a world of any size; a QuadTree splits its bounds
//! in four where points crowd, and an Octree, in 3D, in eight. A box holds the points on its edges,
//! a point near another is no more than the radius from it, so a negative or NaN radius finds
//! nothing and an infinite one finds everything, and what's found comes in no order to count on. A
//! coordinate that's NaN panics. Distances and boxes are worked out in Doubles, so no Float
//! overflows on the way.

Import std.core
Import std.collections.array
Import std.collections.map

/// A value and where it is. A 2D one's Z is 0.
Struct PlacedValue<T>
    Field Value: T
    Field X: Float
    Field Y: Float
    Field Z: Float
End Struct

/// A box, its edges included. A 2D one's Zs are 0.
Struct Bounds
    Field MinX: Double
    Field MinY: Double
    Field MinZ: Double
    Field MaxX: Double
    Field MaxY: Double
    Field MaxZ: Double

    Method Holds(x: Float, y: Float, z: Float): Bool
        Return x >= MinX && x <= MaxX && y >= MinY && y <= MaxY && z >= MinZ && z <= MaxZ
    End Method

    /// Whether the two have a point in common.
    Method Meets(other: Bounds): Bool
        Return other.MinX <= MaxX && other.MaxX >= MinX && other.MinY <= MaxY &&
               other.MaxY >= MinY && other.MinZ <= MaxZ && other.MaxZ >= MinZ
    End Method
End Struct

/// Panics when a coordinate is NaN.
@PanicsAtCaller
Function CheckPoint(x: Float, y: Float, z: Float)
    If x != x || y != y || z != z Then Panic("a point's coordinates can't be NaN")
End Function

/// The box from (minX, minY, minZ) to (maxX, maxY, maxZ). A coordinate that's NaN panics.
@PanicsAtCaller
Function BoxOf(minX: Float, minY: Float, minZ: Float, maxX: Float, maxY: Float,
               maxZ: Float): Bounds
    CheckPoint(minX, minY, minZ)
    CheckPoint(maxX, maxY, maxZ)
    Return Bounds(minX, minY, minZ, maxX, maxY, maxZ)
End Function

/// The coordinates no more than radius from center, which a radius that isn't negative or NaN
/// gives. An infinite radius gives every coordinate, an infinite center's too.
Function Around(center: Float, radius: Float): (Double, Double)
    Local wide: Double = radius
    Local low = center - wide
    Local high = center + wide
    // Only an infinite center and radius come out NaN.
    If low != low Then low = -wide
    If high != high Then high = wide
    Return (low, high)
End Function

/// The box no more than radius from (x, y, z) along each axis. A 2D one's Z is 0.
Function BoxAround(x: Float, y: Float, z: Float, radius: Float): Bounds
    Local across = Around(x, radius)
    Local down = Around(y, radius)
    Local deep = Around(z, radius)
    Return Bounds(across.0, down.0, deep.0, across.1, down.1, deep.1)
End Function

/// The values that were placed.
Function ValuesOf<T>(placed: PlacedValue<T>[]): T[]
    Local values: T[] = []
    values.Reserve(placed.Count)
    For held In placed
        values.Add(held.Value)
    End For
    Return values
End Function

/// The values placed no more than radius from (x, y, z), each placed coordinate taken from the
/// center's in Doubles. An infinite radius takes them all, a point at the same infinity as the
/// center too, whose distance is NaN.
Function Within<T>(placed: PlacedValue<T>[], x: Double, y: Double, z: Double,
                   radius: Double): T[]
    If radius > 0 && radius * 0 != 0 Then Return ValuesOf(placed)
    Local values: T[] = []
    For held In placed
        Local dx = held.X - x
        Local dy = held.Y - y
        Local dz = held.Z - z
        If dx * dx + dy * dy + dz * dz <= radius * radius Then values.Add(held.Value)
    End For
    Return values
End Function

/// Values at 2D points, kept in square cells of a size, for things spread over a world of any size.
@DebugElements
Public Class SpatialHash<T> Implements Iterable<T>, Cloneable
    Field Cells: Map<(Int64, Int64), PlacedValue<T>[]>
    Field CellSize: Float
    Field Size: Int
    /// How many times values were added or removed, so a For ... In over them can tell.
    Field Changes: Int64

    /// An empty SpatialHash whose cells are size across, which has to be above 0 and finite.
    @PanicsAtCaller
    Public New(size: Float)
        If !(size > 0) || size * 0 != 0
            Panic("a SpatialHash's cells are a finite size above 0, not {size}")
        End If

        Cells = Map<(Int64, Int64), PlacedValue<T>[]>()
        CellSize = size
    End New

    /// How many values it holds.
    Public Property Count: Int
        Get => Size
    End Property

    /// Adds the value at (x, y).
    @PanicsAtCaller
    Public Method Add(value: T, x: Float, y: Float)
        CheckPoint(x, y, 0)
        Local placed = Cells.GetOrAdd(CellOf(x, y), Function(): PlacedValue<T>[] => [])
        placed.Add(PlacedValue<T>(value, x, y, 0))
        Size += 1
        Changes += 1
    End Method

    /// Removes the first value equal to value at (x, y), and tells whether there was one.
    @PanicsAtCaller
    Public Method Remove(value: T, x: Float, y: Float): Bool
        Where T: Equatable
        CheckPoint(x, y, 0)
        Local cell = CellOf(x, y)
        Local placed = Cells.Get(cell)
        If placed == Null Then Return False
        For i, held In placed
            If held.X == x && held.Y == y && held.Value == value
                placed.RemoveAt(i)
                If placed.Count == 0 Then Cells.Remove(cell)
                Size -= 1
                Changes += 1
                Return True
            End If
        End For
        Return False
    End Method

    /// Whether a value equal to value is at (x, y).
    @PanicsAtCaller
    Public Method Contains(value: T, x: Float, y: Float): Bool
        Where T: Equatable
        CheckPoint(x, y, 0)
        Local placed = Cells.Get(CellOf(x, y))
        If placed == Null Then Return False
        For held In placed
            If held.X == x && held.Y == y && held.Value == value Then Return True
        End For
        Return False
    End Method

    /// Moves the first value equal to value at (x, y) to (toX, toY), and tells whether there was
    /// one.
    @PanicsAtCaller
    Public Method Move(value: T, x: Float, y: Float, toX: Float, toY: Float): Bool
        Where T: Equatable
        CheckPoint(toX, toY, 0)
        If !Remove(value, x, y) Then Return False
        Add(value, toX, toY)
        Return True
    End Method

    /// Takes every value out.
    Public Method Clear()
        Cells.Clear()
        Size = 0
        Changes += 1
    End Method

    /// The values in the box from (minX, minY) to (maxX, maxY), in a new array.
    @PanicsAtCaller
    Public Method Query(minX: Float, minY: Float, maxX: Float, maxY: Float): T[]
        Return ValuesOf(Placed(BoxOf(minX, minY, 0, maxX, maxY, 0)))
    End Method

    /// The values no more than radius from (x, y), in a new array.
    @PanicsAtCaller
    Public Method Near(x: Float, y: Float, radius: Float): T[]
        CheckPoint(x, y, 0)
        If !(radius >= 0) Then Return []
        Return Within(Placed(BoxAround(x, y, 0, radius)), x, y, 0, radius)
    End Method

    /// Every value, in a new array.
    Public Method ToArray(): T[]
        Local values: T[] = []
        values.Reserve(Size)
        For cell, placed In Cells
            For held In placed
                values.Add(held.Value)
            End For
        End For
        Return values
    End Method

    /// A new SpatialHash with the same cells and values at the same points.
    Public Method Clone(): SpatialHash<T>
        Local copy = SpatialHash<T>(CellSize)
        For cell, placed In Cells
            copy.Cells.Add(cell, placed.Clone())
        End For
        copy.Size = Size
        Return copy
    End Method

    /// Every value. Adding or removing one while going over them panics.
    Public Method Iterate(): SpatialIterator<T>
        Return SpatialIterator<T>(ToArray(), 0, Changes, Function() => Changes, "SpatialHash")
    End Method

    /// The values placed in the box.
    Method Placed(box: Bounds): PlacedValue<T>[]
        Local found: PlacedValue<T>[] = []
        Local first = (Along(box.MinX), Along(box.MinY))
        Local last = (Along(box.MaxX), Along(box.MaxY))
        If last.0 < first.0 || last.1 < first.1 Then Return found
        Local across = last.0 - first.0 + 1
        Local down = last.1 - first.1 + 1
        If across > Cells.Count || down > Cells.Count || across * down > Cells.Count
            // Fewer cells hold values than the box covers, so it goes over those.
            For cell, placed In Cells
                If cell.0 >= first.0 && cell.0 <= last.0 && cell.1 >= first.1 && cell.1 <= last.1
                    Gather(placed, box, found)
                End If
            End For
            Return found
        End If

        For cy = first.1 To last.1
            For cx = first.0 To last.0
                Local placed = Cells.Get((cx, cy))
                If placed != Null Then Gather(placed, box, found)
            End For
        End For
        Return found
    End Method

    /// The cell (x, y) is in.
    Method CellOf(x: Float, y: Float): (Int64, Int64) => (Along(x), Along(y))

    /// Which cell a coordinate that isn't NaN is in, along one axis. Far enough out, it's the last
    /// cell.
    Method Along(coordinate: Double): Int64
        Local cell = coordinate / CellSize
        If cell >= 4.0e18 Then Return 4000000000000000000
        If cell <= -4.0e18 Then Return -4000000000000000000
        Local whole = cell As Int64
        If (whole As Double) > cell Then whole -= 1
        Return whole
    End Method

    /// Adds the values among placed that are in the box.
    Static Method Gather(placed: PlacedValue<T>[], box: Bounds, found: PlacedValue<T>[])
        For held In placed
            If box.Holds(held.X, held.Y, held.Z) Then found.Add(held)
        End For
    End Method
End Class

/// The values of a SpatialHash, a QuadTree, or an Octree, from a copy made when the loop began,
/// with what the collection has changed by, which a change that panics is the only one to reach.
Public Struct SpatialIterator<T> Implements Iterator<T>
    Field Values: T[]
    Field Index: Int
    Field Changes: Int64
    Field Current: Func(): Int64
    /// What the loop goes over: "SpatialHash", "QuadTree", or "Octree".
    Field Name: String

    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Current() != Changes Then Panic("the {Name} changed while a For ... In went over it")
        If Index >= Values.Count Then Return Null
        Index += 1
        Return Values[Index - 1]
    End Method
End Struct

/// How many points a node holds before it splits, and how many times nodes split, at most, on the
/// way down: past it, a node holds any number, as points at one place need.
Const Crowd = 8
Const Deepest = 16

/// A QuadTree's or an Octree's part of its bounds: a leaf with points, or a node split in four or
/// eight.
Class SpaceNode<T>
    Field Area: Bounds
    Field Placed: PlacedValue<T>[] = []
    Field Children: SpaceNode<T>[] = []
    Field Depth: Int
    /// How many points it has, and the nodes under it.
    Field Size: Int

    New(area: Bounds, depth: Int)
        Area = area
        Depth = depth
    End New

    /// A copy of the node and what's under it.
    Method Clone(): SpaceNode<T>
        Local copy = SpaceNode<T>(Area, Depth)
        copy.Placed = Placed.Clone()
        copy.Size = Size
        For child In Children
            copy.Children.Add(child.Clone())
        End For
        Return copy
    End Method
End Class

/// What a QuadTree and an Octree are: one in 2D, with Axes 2, splits in four, and one in 3D, with
/// Axes 3, in eight.
Class SpaceTree<T>
    Field Root: SpaceNode<T>
    Field Axes: Int
    /// "QuadTree" or "Octree", for messages.
    Field Name: String
    /// How many times values were added or removed, so a For ... In over them can tell.
    Field Changes: Int64

    /// A tree for the points in area, which has to be finite and have its maxes no smaller than its
    /// mins.
    @PanicsAtCaller
    New(area: Bounds, axes: Int, name: String)
        Local finite = (area.MinX + area.MinY + area.MinZ + area.MaxX + area.MaxY + area.MaxZ) * 0
        Local called = axes == 3 ? "an Octree" : "a QuadTree"
        If finite != 0 Then Panic("{called}'s box has to be finite")
        If area.MaxX < area.MinX || area.MaxY < area.MinY || area.MaxZ < area.MinZ
            Panic("{called}'s box has its max below its min")
        End If

        Root = SpaceNode<T>(area, 0)
        Axes = axes
        Name = name
    End New

    @PanicsAtCaller
    Method Add(held: PlacedValue<T>)
        CheckPoint(held.X, held.Y, held.Z)
        If !Root.Area.Holds(held.X, held.Y, held.Z)
            Panic("{PointText(held.X, held.Y, held.Z)} is outside the {Name}'s bounds")
        End If

        Local node = Root
        Loop
            node.Size += 1
            If node.Children.Count == 0 Then Break
            node = node.Children[ChildOf(node, held.X, held.Y, held.Z)]
        End Loop

        node.Placed.Add(held)
        If node.Placed.Count > Crowd && node.Depth < Deepest Then Split(node)
        Changes += 1
    End Method

    @PanicsAtCaller
    Method Remove(value: T, x: Float, y: Float, z: Float): Bool
        Where T: Equatable
        CheckPoint(x, y, z)
        If !Root.Area.Holds(x, y, z) Then Return False
        Local path = [Root]
        While path[path.Count - 1].Children.Count > 0
            Local node = path[path.Count - 1]
            path.Add(node.Children[ChildOf(node, x, y, z)])
        End While

        Local leaf = path[path.Count - 1]
        For i, held In leaf.Placed
            If held.X == x && held.Y == y && held.Z == z && held.Value == value
                leaf.Placed.RemoveAt(i)
                For node In path
                    node.Size -= 1
                End For

                // The highest node that no longer needs its children takes their points.
                For node In path
                    If node.Children.Count > 0 && node.Size <= Crowd
                        node.Placed = Under(node)
                        node.Children = []
                        Break
                    End If
                End For

                Changes += 1
                Return True
            End If
        End For
        Return False
    End Method

    @PanicsAtCaller
    Method Contains(value: T, x: Float, y: Float, z: Float): Bool
        Where T: Equatable
        CheckPoint(x, y, z)
        If !Root.Area.Holds(x, y, z) Then Return False
        Local node = Root
        While node.Children.Count > 0
            node = node.Children[ChildOf(node, x, y, z)]
        End While

        For held In node.Placed
            If held.X == x && held.Y == y && held.Z == z && held.Value == value Then Return True
        End For
        Return False
    End Method

    /// Moves the first value equal to value at (x, y, z) to (toX, toY, toZ), and tells whether
    /// there was one. A point outside the tree's box panics.
    @PanicsAtCaller
    Method Move(value: T, x: Float, y: Float, z: Float, toX: Float, toY: Float, toZ: Float): Bool
        Where T: Equatable
        CheckPoint(toX, toY, toZ)
        If !Root.Area.Holds(toX, toY, toZ)
            Panic("{PointText(toX, toY, toZ)} is outside the {Name}'s bounds")
        End If

        If !Remove(value, x, y, z) Then Return False
        Add(PlacedValue<T>(value, toX, toY, toZ))
        Return True
    End Method

    Method Clear()
        Root = SpaceNode<T>(Root.Area, 0)
        Changes += 1
    End Method

    /// The values placed in the box.
    Method Placed(box: Bounds): PlacedValue<T>[]
        Local found: PlacedValue<T>[] = []
        Local nodes = [Root]
        While nodes.Count > 0
            Local node = nodes.RemoveLast()
            If node.Area.Meets(box)
                nodes.AddAll(node.Children)
                For held In node.Placed
                    If box.Holds(held.X, held.Y, held.Z) Then found.Add(held)
                End For
            End If
        End While
        Return found
    End Method

    /// A new tree with the same box and values at the same points.
    Method Clone(): SpaceTree<T>
        Local copy = SpaceTree<T>(Root.Area, Axes, Name)
        copy.Root = Root.Clone()
        Return copy
    End Method

    /// Every value. Adding or removing one while going over them panics.
    Method Iterate(): SpatialIterator<T>
        Return SpatialIterator<T>(ValuesOf(Under(Root)), 0, Changes, Function() => Changes, Name)
    End Method

    /// Which of node's children (x, y, z) is in, a point on a middle line going to the one after.
    Method ChildOf(node: SpaceNode<T>, x: Float, y: Float, z: Float): Int
        Local area = node.Area
        Local child = 0
        If x >= area.MinX + (area.MaxX - area.MinX) / 2 Then child += 1
        If y >= area.MinY + (area.MaxY - area.MinY) / 2 Then child += 2
        If Axes == 3 && z >= area.MinZ + (area.MaxZ - area.MinZ) / 2 Then child += 4
        Return child
    End Method

    /// Gives a leaf its children, with its points in them.
    Method Split(node: SpaceNode<T>)
        Local area = node.Area
        Local middleX = area.MinX + (area.MaxX - area.MinX) / 2
        Local middleY = area.MinY + (area.MaxY - area.MinY) / 2
        Local middleZ = area.MinZ + (area.MaxZ - area.MinZ) / 2
        For child = 0 Until (Axes == 3 ? 8 : 4)
            Local part = area
            If (child & 1) == 0 Then part.MaxX = middleX Else part.MinX = middleX
            If (child & 2) == 0 Then part.MaxY = middleY Else part.MinY = middleY
            If Axes == 3
                If (child & 4) == 0 Then part.MaxZ = middleZ Else part.MinZ = middleZ
            End If

            node.Children.Add(SpaceNode<T>(part, node.Depth + 1))
        End For

        For held In node.Placed
            Local child = node.Children[ChildOf(node, held.X, held.Y, held.Z)]
            child.Placed.Add(held)
            child.Size += 1
        End For

        node.Placed = []
        // A child can be as crowded as its parent was.
        For child In node.Children
            If child.Placed.Count > Crowd && child.Depth < Deepest Then Split(child)
        End For
    End Method

    /// The points in the leaves under node.
    Static Method Under(node: SpaceNode<T>): PlacedValue<T>[]
        Local found: PlacedValue<T>[] = []
        Local nodes = [node]
        While nodes.Count > 0
            Local next = nodes.RemoveLast()
            nodes.AddAll(next.Children)
            found.AddAll(next.Placed)
        End While
        Return found
    End Method

    Method PointText(x: Float, y: Float, z: Float): String
        If Axes == 3 Then Return "({x}, {y}, {z})"
        Return "({x}, {y})"
    End Method
End Class

/// Values at 2D points, in bounds it splits in four where points crowd.
@DebugElements
Public Class QuadTree<T> Implements Iterable<T>, Cloneable
    Field Tree: SpaceTree<T>

    /// An empty QuadTree for the points in the box from (minX, minY) to (maxX, maxY), which has to
    /// be finite. A box whose max is below its min along an axis panics.
    @PanicsAtCaller
    Public New(minX: Float, minY: Float, maxX: Float, maxY: Float)
        Tree = SpaceTree<T>(BoxOf(minX, minY, 0, maxX, maxY, 0), 2, "QuadTree")
    End New

    /// One that holds tree, for Clone.
    New(tree: SpaceTree<T>)
        Tree = tree
    End New

    /// How many values it holds.
    Public Property Count: Int
        Get => Tree.Root.Size
    End Property

    /// Adds the value at (x, y). A point outside the QuadTree's box panics.
    @PanicsAtCaller
    Public Method Add(value: T, x: Float, y: Float)
        Tree.Add(PlacedValue<T>(value, x, y, 0))
    End Method

    /// Removes the first value equal to value at (x, y), and tells whether there was one.
    @PanicsAtCaller
    Public Method Remove(value: T, x: Float, y: Float): Bool
        Where T: Equatable
        Return Tree.Remove(value, x, y, 0)
    End Method

    /// Whether a value equal to value is at (x, y).
    @PanicsAtCaller
    Public Method Contains(value: T, x: Float, y: Float): Bool
        Where T: Equatable
        Return Tree.Contains(value, x, y, 0)
    End Method

    /// Moves the first value equal to value at (x, y) to (toX, toY), and tells whether there was
    /// one. A point outside the QuadTree's box panics.
    @PanicsAtCaller
    Public Method Move(value: T, x: Float, y: Float, toX: Float, toY: Float): Bool
        Where T: Equatable
        Return Tree.Move(value, x, y, 0, toX, toY, 0)
    End Method

    /// Takes every value out.
    Public Method Clear()
        Tree.Clear()
    End Method

    /// The values in the box from (minX, minY) to (maxX, maxY), in a new array.
    @PanicsAtCaller
    Public Method Query(minX: Float, minY: Float, maxX: Float, maxY: Float): T[]
        Return ValuesOf(Tree.Placed(BoxOf(minX, minY, 0, maxX, maxY, 0)))
    End Method

    /// The values no more than radius from (x, y), in a new array.
    @PanicsAtCaller
    Public Method Near(x: Float, y: Float, radius: Float): T[]
        CheckPoint(x, y, 0)
        If !(radius >= 0) Then Return []
        Return Within(Tree.Placed(BoxAround(x, y, 0, radius)), x, y, 0, radius)
    End Method

    /// Every value, in a new array.
    Public Method ToArray(): T[] => ValuesOf(SpaceTree<T>.Under(Tree.Root))

    /// A new QuadTree with the same box and values at the same points.
    Public Method Clone(): QuadTree<T> => QuadTree<T>(Tree.Clone())

    /// Every value. Adding or removing one while going over them panics.
    Public Method Iterate(): SpatialIterator<T> => Tree.Iterate()
End Class

/// Values at 3D points, in bounds it splits in eight where points crowd.
@DebugElements
Public Class Octree<T> Implements Iterable<T>, Cloneable
    Field Tree: SpaceTree<T>

    /// An empty Octree for the points in the box from (minX, minY, minZ) to (maxX, maxY, maxZ),
    /// which has to be finite. A box whose max is below its min along an axis panics.
    @PanicsAtCaller
    Public New(minX: Float, minY: Float, minZ: Float, maxX: Float, maxY: Float, maxZ: Float)
        Tree = SpaceTree<T>(BoxOf(minX, minY, minZ, maxX, maxY, maxZ), 3, "Octree")
    End New

    /// One that holds tree, for Clone.
    New(tree: SpaceTree<T>)
        Tree = tree
    End New

    /// How many values it holds.
    Public Property Count: Int
        Get => Tree.Root.Size
    End Property

    /// Adds the value at (x, y, z). A point outside the Octree's box panics.
    @PanicsAtCaller
    Public Method Add(value: T, x: Float, y: Float, z: Float)
        Tree.Add(PlacedValue<T>(value, x, y, z))
    End Method

    /// Removes the first value equal to value at (x, y, z), and tells whether there was one.
    @PanicsAtCaller
    Public Method Remove(value: T, x: Float, y: Float, z: Float): Bool
        Where T: Equatable
        Return Tree.Remove(value, x, y, z)
    End Method

    /// Whether a value equal to value is at (x, y, z).
    @PanicsAtCaller
    Public Method Contains(value: T, x: Float, y: Float, z: Float): Bool
        Where T: Equatable
        Return Tree.Contains(value, x, y, z)
    End Method

    /// Moves the first value equal to value at (x, y, z) to (toX, toY, toZ), and tells whether
    /// there was one. A point outside the Octree's box panics.
    @PanicsAtCaller
    Public Method Move(value: T, x: Float, y: Float, z: Float, toX: Float, toY: Float,
                       toZ: Float): Bool
        Where T: Equatable
        Return Tree.Move(value, x, y, z, toX, toY, toZ)
    End Method

    /// Takes every value out.
    Public Method Clear()
        Tree.Clear()
    End Method

    /// The values in the box from (minX, minY, minZ) to (maxX, maxY, maxZ), in a new array.
    @PanicsAtCaller
    Public Method Query(minX: Float, minY: Float, minZ: Float, maxX: Float, maxY: Float,
                        maxZ: Float): T[]
        Return ValuesOf(Tree.Placed(BoxOf(minX, minY, minZ, maxX, maxY, maxZ)))
    End Method

    /// The values no more than radius from (x, y, z), in a new array.
    @PanicsAtCaller
    Public Method Near(x: Float, y: Float, z: Float, radius: Float): T[]
        CheckPoint(x, y, z)
        If !(radius >= 0) Then Return []
        Return Within(Tree.Placed(BoxAround(x, y, z, radius)), x, y, z, radius)
    End Method

    /// Every value, in a new array.
    Public Method ToArray(): T[] => ValuesOf(SpaceTree<T>.Under(Tree.Root))

    /// A new Octree with the same box and values at the same points.
    Public Method Clone(): Octree<T> => Octree<T>(Tree.Clone())

    /// Every value. Adding or removing one while going over them panics.
    Public Method Iterate(): SpatialIterator<T> => Tree.Iterate()
End Class
