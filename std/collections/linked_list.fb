//! A doubly linked list, which adds and removes values beside a node in constant time.
//!
//! `LinkedList<T>`: values in a chain of nodes, each linked to the ones before and after it, so
//! adding or removing one beside a node takes the same time however many there are. A node is the
//! same object for as long as it's in the list, so code can keep one to add beside or remove
//! later. Each node holds the one after it and, weakly, the one before, so the list makes no
//! cycles, and Clear and the list's end unlink every node, so a node kept elsewhere holds none of
//! the others.

Import std.core
Import std.collections.array

/// One value of a LinkedList, with the ones before and after it, which inserting and removing next
/// to it go through.
Public Class LinkedListNode<T>
    /// Its value.
    Public Field Value: T
    Field After: LinkedListNode<T>?
    Field Before: Weak<LinkedListNode<T>>
    /// The list it's in, or Null once it's removed.
    Field Owner: Weak<LinkedList<T>>

    New(value: T, owner: LinkedList<T>)
        Value = value
        Owner = owner
    End New

    /// The node after this one, or Null when it's the last or not in a list.
    Public Property Next: LinkedListNode<T>?
        Get => After
    End Property

    /// The node before this one, or Null when it's the first or not in a list.
    Public Property Previous: LinkedListNode<T>?
        Get => Before
    End Property

    /// The list it's in, or Null once it's removed.
    Public Property List: LinkedList<T>?
        Get => Owner
    End Property
End Class

/// A doubly linked list, which inserts and removes anywhere it has a node without moving the rest.
///
/// # Examples
///
/// ```
/// Local list = LinkedList<String>()
/// Local b = list.Add("b")
/// list.AddFirst("a")
/// list.AddAfter(b, "c")
/// Expect(list.ToArray() == ["a", "b", "c"])
/// list.RemoveNode(b)
/// Expect(list.ToArray() == ["a", "c"])
/// Expect(b.List == Null)
/// ```
@DebugElements
Public Class LinkedList<T> Implements Iterable<T>, Cloneable, Defaultable
    Field Head: LinkedListNode<T>?
    Field Tail: LinkedListNode<T>?
    Field Size: Int
    /// How many times values were added or removed, so a For ... In over them can tell.
    Field Changes: Int64

    /// How many values it holds.
    Public Property Count: Int
        Get => Size
    End Property

    /// The first node, or Null when the list is empty.
    Public Property FirstNode: LinkedListNode<T>?
        Get => Head
    End Property

    /// The last node, or Null when the list is empty.
    Public Property LastNode: LinkedListNode<T>?
        Get => Tail
    End Property

    /// The first value. Panics when the list is empty.
    @PanicsAtCaller
    Public Method First(): T
        Local first = Head
        If first == Null Then Panic("the LinkedList is empty")
        Return first.Value
    End Method

    /// The last value. Panics when the list is empty.
    @PanicsAtCaller
    Public Method Last(): T
        Local last = Tail
        If last == Null Then Panic("the LinkedList is empty")
        Return last.Value
    End Method

    /// The first value, or Null when the list is empty.
    Public Method TryFirst(): T?
        If Size == 0 Then Return Null
        Return First()
    End Method

    /// The last value, or Null when the list is empty.
    Public Method TryLast(): T?
        If Size == 0 Then Return Null
        Return Last()
    End Method

    /// Adds the `value` at the start, and gives its node.
    Public Method AddFirst(value: T): LinkedListNode<T>
        Local node = LinkedListNode<T>(value, Self)
        Local first = Head
        If first == Null
            Tail = node
        Else
            first.Before = node
            node.After = first
        End If

        Head = node
        Added()
        Return node
    End Method

    /// Adds the `value` at the end, and gives its node.
    Public Method AddLast(value: T): LinkedListNode<T>
        Local node = LinkedListNode<T>(value, Self)
        Local last = Tail
        If last == Null
            Head = node
        Else
            last.After = node
            node.Before = last
        End If

        Tail = node
        Added()
        Return node
    End Method

    /// The same as AddLast.
    Public Method Add(value: T): LinkedListNode<T> => AddLast(value)

    /// Adds each of the `values` at the end, in order, all read first.
    Public Method AddAll(values: Iterable<T>)
        For value In values.Iterate().ToArray()
            AddLast(value)
        End For
    End Method

    /// Adds the `value` just before `node`, which has to be in this list, and gives its node.
    @PanicsAtCaller
    Public Method AddBefore(node: LinkedListNode<T>, value: T): LinkedListNode<T>
        Check(node)
        Local before = node.Previous
        If before == Null Then Return AddFirst(value)
        Return AddAfter(before, value)
    End Method

    /// Adds the `value` just after `node`, which has to be in this list, and gives its node.
    @PanicsAtCaller
    Public Method AddAfter(node: LinkedListNode<T>, value: T): LinkedListNode<T>
        Check(node)
        Local after = node.After
        If after == Null Then Return AddLast(value)
        Local added = LinkedListNode<T>(value, Self)
        added.Before = node
        added.After = after
        after.Before = added
        node.After = added
        Added()
        Return added
    End Method

    /// Takes `node`, which has to be in this list, out of it.
    @PanicsAtCaller
    Public Method RemoveNode(node: LinkedListNode<T>)
        Check(node)
        Local before = node.Previous
        Local after = node.After
        If before == Null
            Head = after
        Else
            before.After = after
        End If

        If after == Null
            Tail = before
        Else
            after.Before = before
        End If

        node.After = Null
        node.Before = Null
        node.Owner = Null
        Size -= 1
        Changes += 1
    End Method

    /// Takes out the first `value` equal to `value`, and tells whether there was one.
    Public Method Remove(value: T): Bool
        Where T: Equatable
        Local found = NodeOf(value)
        If found == Null Then Return False
        RemoveNode(found)
        Return True
    End Method

    /// Takes the first value out and gives it. Panics when the list is empty.
    @PanicsAtCaller
    Public Method RemoveFirst(): T
        Local first = Head
        If first == Null Then Panic("the LinkedList is empty")
        RemoveNode(first)
        Return first.Value
    End Method

    /// Takes the last value out and gives it. Panics when the list is empty.
    @PanicsAtCaller
    Public Method RemoveLast(): T
        Local last = Tail
        If last == Null Then Panic("the LinkedList is empty")
        RemoveNode(last)
        Return last.Value
    End Method

    /// Takes the first value out and gives it, or Null when the list is empty.
    Public Method TryRemoveFirst(): T?
        If Size == 0 Then Return Null
        Return RemoveFirst()
    End Method

    /// Takes the last value out and gives it, or Null when the list is empty.
    Public Method TryRemoveLast(): T?
        If Size == 0 Then Return Null
        Return RemoveLast()
    End Method

    /// The first node whose value is equal to `value`, or Null.
    Public Method NodeOf(value: T): LinkedListNode<T>?
        Where T: Equatable
        Local node = Head
        While node != Null
            If node.Value == value Then Return node
            node = node.After
        End While
        Return Null
    End Method

    /// The last node whose value is equal to `value`, or Null.
    Public Method LastNodeOf(value: T): LinkedListNode<T>?
        Where T: Equatable
        Local node = Tail
        While node != Null
            If node.Value == value Then Return node
            node = node.Previous
        End While
        Return Null
    End Method

    /// Whether it holds `value`.
    Public Method Contains(value: T): Bool
        Where T: Equatable
        Return NodeOf(value) != Null
    End Method

    /// The first value that `test` says is the one, or Null.
    Public Method Find(test: Func(T): Bool): T?
        Local node = Head
        While node != Null
            If test(node.Value) Then Return node.Value
            node = node.After
        End While
        Return Null
    End Method

    /// The last value that `test` says is the one, or Null.
    Public Method FindLast(test: Func(T): Bool): T?
        Local node = Tail
        While node != Null
            If test(node.Value) Then Return node.Value
            node = node.Previous
        End While
        Return Null
    End Method

    /// Takes every value out. Their nodes are no longer in a list.
    Public Method Clear()
        LetGo()
        Changes += 1
    End Method

    /// The values, first to last, in a new array.
    Public Method ToArray(): T[]
        Local values: T[] = []
        values.Reserve(Size)
        For value In Self
            values.Add(value)
        End For
        Return values
    End Method

    /// A new, empty LinkedList.
    Public Static Method DefaultValue(): LinkedList<T> => LinkedList<T>()

    /// A new LinkedList with the same values, in nodes of its own.
    Public Method Clone(): LinkedList<T>
        Local copy = LinkedList<T>()
        For value In Self
            copy.AddLast(value)
        End For
        Return copy
    End Method

    /// The values, first to last. Setting a node's Value while going over them is fine, but adding
    /// or removing one panics.
    Public Method Iterate(): LinkedListIterator<T> => LinkedListIterator<T>(Self, Head, Changes)

    /// Panics unless node is in this list.
    @PanicsAtCaller
    Method Check(node: LinkedListNode<T>)
        Local owner = node.Owner
        If owner == Null || !RefEquals(owner, Self) Then Panic("the node isn't in this LinkedList")
    End Method

    Method Added()
        Size += 1
        Changes += 1
    End Method

    /// Unlinks every node.
    Method LetGo()
        Local node = Head
        Head = Null
        Tail = Null
        Size = 0
        While node != Null
            Local after = node.After
            node.After = Null
            node.Before = Null
            node.Owner = Null
            node = after
        End While
    End Method

    Method Destroy()
        LetGo()
    End Method
End Class

/// The values of a LinkedList, first to last, which a For loop goes over.
Public Struct LinkedListIterator<T> Implements Iterator<T>
    Field Owner: LinkedList<T>
    Field Node: LinkedListNode<T>?
    Field Changes: Int64

    /// The next value, from the first node to the last, or Null after it. Panics when the
    /// LinkedList changed since the loop began.
    @PanicsAtCaller
    Public ByRef Method Next(): T?
        If Owner.Changes != Changes
            Panic("the LinkedList changed while a For ... In went over it")
        End If

        Local node = Node
        If node == Null Then Return Null
        Node = node.After
        Return node.Value
    End Method
End Struct

// Two LinkedLists are equal when they have equal values in the same order.
Extend LinkedList<T> Implements Equatable
    Where T: Equatable

    /// Whether the two have equal values in the same order.
    Operator ==(a: LinkedList<T>, b: LinkedList<T>): Bool
        If a.Count != b.Count Then Return False
        Local mine = a.Head
        Local others = b.Head
        While mine != Null && others != Null
            If mine.Value != others.Value Then Return False
            mine = mine.After
            others = others.After
        End While
        Return True
    End Operator
End Extend

// "[1, 2, 3]", first to last, when the values can be shown.
Extend LinkedList<T> Implements Printable
    Where T: Printable

    /// Its values, first to last, as an array shows them: "[1, 2, 3]".
    Public Method ToString(): String => "{ToArray()}"
End Extend
