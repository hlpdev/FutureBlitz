//! A count of how many times each value was added.
//!
//! `Counter<T>`: how many times each value was added, in the order the values were added. A value's
//! count is never 0: one whose count goes down to 0 goes, so it comes back last, and counter[value]
//! of one that isn't there is 0.

Import std.core
Import std.collections.array
Import std.collections.map

/// How many times each value was added, for tallies and histograms.
///
/// # Examples
///
/// ```
/// Local words = Counter<String>()
/// words.AddAll(["the", "cat", "the", "hat", "the"])
/// Expect(words["the"] == 3)
/// Expect(words["dog"] == 0)
/// Expect(words.Count == 3)
/// Expect(words.Total == 5)
/// ```
@DebugEntries
Public Class Counter<T: Hashable> Implements Iterable<(T, Int)>, Cloneable, Defaultable, Hashable
    Field Counts: Map<T, Int>
    Field Sum: Int64

    /// A new, empty Counter.
    Public New()
        Counts = Map<T, Int>()
    End New

    /// How many values it counts, each once.
    Public Property Count: Int
        Get => Counts.Count
    End Property

    /// All the counts added up, which can be more than an Int holds.
    Public Property Total: Int64
        Get => Sum
    End Property

    /// Counts the `value` once more.
    @PanicsAtCaller
    Public Method Add(value: T)
        Add(value, 1)
    End Method

    /// Counts the `value` `times` more times. A negative `times` panics, and so does a count past
    /// what an Int holds, which only Total can be.
    @PanicsAtCaller
    Public Method Add(value: T, times: Int)
        If times < 0 Then Panic("Add takes a count that isn't negative, not {times}")
        If times == 0 Then Return
        Local had = Self[value]
        Local count = had.CheckedAdd(times)
        If count == Null
            Panic("a Counter's count can't be more than an Int holds, but this one would be " +
                  "{(had As Int64) + times}")
        End If

        Self[value] = count
    End Method

    /// Counts each of the `values` once more, all read first.
    @PanicsAtCaller
    Public Method AddAll(values: Iterable<T>)
        For value In values.Iterate().ToArray()
            Add(value)
        End For
    End Method

    /// Counts the `value` once less, and tells whether it was there.
    Public Method Remove(value: T): Bool => Remove(value, 1) > 0

    /// Counts the `value` up to `times` less, and gives how many it took away. A negative `times`
    /// panics.
    @PanicsAtCaller
    Public Method Remove(value: T, times: Int): Int
        If times < 0 Then Panic("Remove takes a count that isn't negative, not {times}")
        Local had = Self[value]
        Local taken = Min(had, times)
        Self[value] = had - taken
        Return taken
    End Method

    /// How many times the value was counted, or 0.
    Operator [](value: T): Int => Counts.Get(value, 0)

    /// Gives the value a count, and a count of 0 removes it. A negative count panics.
    @PanicsAtCaller
    Operator []=(value: T, count: Int)
        If count < 0 Then Panic("a Counter's count isn't negative, but this one is {count}")
        Local had = Counts.Get(value, 0)
        If count == 0
            Counts.Remove(value)
        Else
            Counts.Add(value, count)
        End If

        Sum = Sum - had + count
    End Operator

    /// Whether `value` has a count.
    Public Method Contains(value: T): Bool => Counts.Contains(value)

    /// Takes every count out.
    Public Method Clear()
        Counts.Clear()
        Sum = 0
    End Method

    /// The `count` most counted values and their counts, most first, and values counted the same
    /// number of times in the Counter's order. A negative `count` panics.
    ///
    /// # Examples
    ///
    /// ```
    /// Local letters = Counter<String>()
    /// letters.AddAll(["b", "a", "b", "c", "a", "b"])
    /// Expect(letters.MostCommon(2) == [("b", 3), ("a", 2)])
    /// ```
    @PanicsAtCaller
    Public Method MostCommon(count: Int): (T, Int)[]
        If count < 0 Then Panic("MostCommon takes a count that isn't negative, not {count}")
        Local entries: (T, Int)[] = []
        entries.Reserve(Counts.Count)
        For entry In Counts
            entries.Add(entry)
        End For

        entries.SortByDescending(Function(entry: (T, Int)) => entry.1)
        If entries.Count > count Then entries.RemoveRange(count, entries.Count - count)
        Return entries
    End Method

    /// The values, each once, in the order they were added, one that came back last.
    Public Method Values(): T[] => Counts.Keys()

    /// A new, empty Counter.
    Public Static Method DefaultValue(): Counter<T> => Counter<T>()

    /// A new Counter with the same counts.
    Public Method Clone(): Counter<T>
        Local copy = Counter<T>()
        copy.Counts = Counts.Clone()
        copy.Sum = Sum
        Return copy
    End Method

    /// Two Counters are equal when they count the same values the same number of times, in any
    /// order.
    Operator ==(a: Counter<T>, b: Counter<T>): Bool => a.Counts == b.Counts

    /// A hash of its values and their counts, which Counters that are equal share.
    Public Method Hash(): UInt64 => Counts.Hash()

    /// Each value and its count, for 'For value, count In counter'. Changing a count while going
    /// over them is fine, but adding or removing a value panics.
    Public Method Iterate(): MapIterator<T, Int> => Counts.IterateAs("Counter")
End Class

// "{a: 2, b: 1}", in the order the values were added, one that came back last, when they can be
// shown.
Extend Counter<T> Implements Printable
    Where T: Printable

    /// Each value and its count, in the order the values were added, as "{the: 2, cat: 1}".
    Public Method ToString(): String => "{Counts}"
End Extend
