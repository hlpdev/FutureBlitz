//! What Unicode says of characters: categories, normal forms, case folding, and widths.
//!
//! What Unicode's data says about characters and text, through the runtime's fb_unicode_ functions
//! over utf8proc: each character's general category, normal forms, case folding, and the columns
//! text takes in a terminal.
//!
//! # Examples
//!
//! ```
//! Expect(Category('a') == UnicodeCategory.LOWERCASE_LETTER)
//! Expect(IsNormalized("\u{E9}") && !IsNormalized("e\u{301}"))
//! Expect(DisplayWidth("日本") == 4 && DisplayWidth('a') == 1)
//! ```

Import std.core

Extern "runtime"
    Function fb_unicode_category(code: UInt32): Int32
    Function fb_unicode_case_fold(text: String): String?
    Function fb_unicode_normalize(text: String, form: Int32): String?
    Function fb_unicode_char_width(code: UInt32): Int32
    Function fb_unicode_display_width(text: String): Int64
End Extern

/// A character's general category, in Unicode's order, as Category gives it.
Public Enum UnicodeCategory
    /// Cn, a code point with no character.
    UNASSIGNED
    /// Lu, an uppercase letter.
    UPPERCASE_LETTER
    /// Ll, a lowercase letter.
    LOWERCASE_LETTER
    /// Lt, a digraph whose first part is uppercase.
    TITLECASE_LETTER
    /// Lm, a modifier letter.
    MODIFIER_LETTER
    /// Lo, another letter, like an ideograph.
    OTHER_LETTER
    /// Mn, a mark that takes no space.
    NONSPACING_MARK
    /// Mc, a mark that takes space.
    SPACING_MARK
    /// Me, a mark that encloses its base character.
    ENCLOSING_MARK
    /// Nd, a decimal digit.
    DECIMAL_NUMBER
    /// Nl, a number of letters, like a Roman numeral.
    LETTER_NUMBER
    /// No, another number, like a fraction or a superscript.
    OTHER_NUMBER
    /// Pc, a connector, like '_'.
    CONNECTOR_PUNCTUATION
    /// Pd, a dash or a hyphen.
    DASH_PUNCTUATION
    /// Ps, an opening bracket.
    OPEN_PUNCTUATION
    /// Pe, a closing bracket.
    CLOSE_PUNCTUATION
    /// Pi, an opening quotation mark.
    INITIAL_PUNCTUATION
    /// Pf, a closing quotation mark.
    FINAL_PUNCTUATION
    /// Po, other punctuation.
    OTHER_PUNCTUATION
    /// Sm, a math symbol.
    MATH_SYMBOL
    /// Sc, a currency symbol.
    CURRENCY_SYMBOL
    /// Sk, a modifier symbol, like an accent on its own.
    MODIFIER_SYMBOL
    /// So, another symbol.
    OTHER_SYMBOL
    /// Zs, a space.
    SPACE_SEPARATOR
    /// Zl, U+2028, the line separator.
    LINE_SEPARATOR
    /// Zp, U+2029, the paragraph separator.
    PARAGRAPH_SEPARATOR
    /// Cc, a control character.
    CONTROL
    /// Cf, a format character, like a zero-width joiner.
    FORMAT
    /// Cs, a UTF-16 surrogate.
    SURROGATE
    /// Co, a private use character.
    PRIVATE_USE
End Enum

/// The ways Normalize can write the same text.
Public Enum NormalForm
    /// Composed.
    NFC
    /// Decomposed.
    NFD
    /// Composed, with compatibility characters, like "ﬁ" or "²", as their plain ones.
    NFKC
    /// Decomposed, with compatibility characters, like "ﬁ" or "²", as their plain ones.
    NFKD
End Enum

/// `c`'s general category: a letter of some case, a mark, a number, punctuation, a symbol, a
/// separator, or another kind.
Public Function Category(c: Char): UnicodeCategory
    Return fb_unicode_category(c As UInt32) As UnicodeCategory
End Function

/// `text` in the normal form `form`, so `text` that looks the same is the same: "é" as one
/// character in NFC, and as "e" and its accent in NFD. Panics past the most a String holds.
///
/// # Examples
///
/// ```
/// Local composed = "\u{E9}"
/// Local decomposed = "e\u{301}"
/// Expect(composed != decomposed)
/// Expect(Normalize(decomposed) == composed)
/// Expect(Normalize(composed, NormalForm.NFD) == decomposed)
/// ```
@PanicsAtCaller
Public Function Normalize(text: String, form: NormalForm = NormalForm.NFC): String
    Local normal = fb_unicode_normalize(text, form As Int32)
    If normal == Null Then Panic("a String holds at most 2147483647 bytes")
    Return normal
End Function

/// Whether `text` is in the normal form `form` already. One past the most a String holds isn't.
Public Function IsNormalized(text: String, form: NormalForm = NormalForm.NFC): Bool
    Return fb_unicode_normalize(text, form As Int32) == text
End Function

/// `text` case-folded, as Unicode has it, so two texts that differ only by case fold to the same:
/// "Straße" and "STRASSE" both to "strasse". Panics past the most a String holds.
///
/// # Examples
///
/// ```
/// Expect(CaseFold("Straße") == CaseFold("STRASSE"))
/// Expect(Category('A') == UnicodeCategory.UPPERCASE_LETTER)
/// ```
@PanicsAtCaller
Public Function CaseFold(text: String): String
    Local folded = fb_unicode_case_fold(text)
    If folded == Null Then Panic("a String holds at most 2147483647 bytes")
    Return folded
End Function

/// The columns `c` takes in a terminal: 2 for a wide one, like "中" or most emoji, 0 for a mark or a
/// control character, and 1 for the rest.
Public Function DisplayWidth(c: Char): Int => fb_unicode_char_width(c As UInt32)

/// The columns `text` takes in a terminal, each grapheme cluster as many as its widest character,
/// so "e" with its accent is 1, and an emoji made of several is 2. A flag is 2, and so is a
/// character that U+FE0F asks to be drawn as emoji, like "\u{2764}\u{FE0F}", though it's 1 alone.
Public Function DisplayWidth(text: String): Int => fb_unicode_display_width(text) As Int
