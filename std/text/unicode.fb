// std.text.unicode: what Unicode's data says about characters and text, through the runtime's
// fb_unicode_ functions over utf8proc: each character's general category, normal forms, case
// folding, and the columns text takes in a terminal.

Import std.core

Extern "runtime"
    Function fb_unicode_category(code: UInt32): Int32
    Function fb_unicode_case_fold(text: String): String
    Function fb_unicode_normalize(text: String, form: Int32): String
    Function fb_unicode_char_width(code: UInt32): Int32
    Function fb_unicode_display_width(text: String): Int64
End Extern

// A character's general category, in Unicode's order, as Category gives it.
Public Enum UnicodeCategory
    UNASSIGNED,
    UPPERCASE_LETTER, LOWERCASE_LETTER, TITLECASE_LETTER, MODIFIER_LETTER, OTHER_LETTER,
    NONSPACING_MARK, SPACING_MARK, ENCLOSING_MARK,
    DECIMAL_NUMBER, LETTER_NUMBER, OTHER_NUMBER,
    CONNECTOR_PUNCTUATION, DASH_PUNCTUATION, OPEN_PUNCTUATION, CLOSE_PUNCTUATION,
    INITIAL_PUNCTUATION, FINAL_PUNCTUATION, OTHER_PUNCTUATION,
    MATH_SYMBOL, CURRENCY_SYMBOL, MODIFIER_SYMBOL, OTHER_SYMBOL,
    SPACE_SEPARATOR, LINE_SEPARATOR, PARAGRAPH_SEPARATOR,
    CONTROL, FORMAT, SURROGATE, PRIVATE_USE
End Enum

// The ways Normalize can write the same text: composed (NFC) or decomposed (NFD), and with
// compatibility characters, like "ﬁ" or "²", as their plain ones (NFKC and NFKD).
Public Enum NormalForm
    NFC, NFD, NFKC, NFKD
End Enum

// c's general category: a letter of some case, a mark, a number, punctuation, a symbol, a
// separator, or another kind.
Public Function Category(c: Char): UnicodeCategory
    Return fb_unicode_category(c As UInt32) As UnicodeCategory
End Function

// text in the normal form form, so text that looks the same is the same: "é" as one character
// in NFC, and as "e" and its accent in NFD.
Public Function Normalize(text: String, form: NormalForm = NormalForm.NFC): String
    Return fb_unicode_normalize(text, form As Int32)
End Function

// Whether text is in the normal form form already.
Public Function IsNormalized(text: String, form: NormalForm = NormalForm.NFC): Bool
    Return Normalize(text, form) == text
End Function

// text case-folded, as Unicode has it, so two texts that differ only by case fold to the same:
// "Straße" and "STRASSE" both to "strasse".
Public Function CaseFold(text: String): String => fb_unicode_case_fold(text)

// The columns c takes in a terminal: 2 for a wide one, like "中" or most emoji, 0 for a mark or a
// control character, and 1 for the rest.
Public Function DisplayWidth(c: Char): Int => fb_unicode_char_width(c As UInt32)

// The columns text takes in a terminal, each grapheme cluster as many as its widest character,
// so "e" with its accent is 1, and an emoji made of several is 2.
Public Function DisplayWidth(text: String): Int => fb_unicode_display_width(text) As Int
