//! The differences between two texts, by lines or characters, and three-way merges.
//!
//! std.text.diff: what changed between two texts, by Myers' algorithm, which finds the fewest
//! lines, or characters, to delete and insert. Diff.Lines and Diff.Chars give the runs of what's
//! the same, deleted, and inserted; Diff.Unified the text that diff -u and git diff show; and
//! Diff.Merge a three-way merge, as git merge-file makes it, with conflict markers where both
//! sides changed the same lines differently. A line keeps its line break, "\n", "\r\n", or "\r",
//! and a text's last line can have none.

Import std.core
Import std.collections.array
Import std.collections.map
Import std.text.char
Import std.text.string

Extern "runtime"
    Function fb_text_byte(text: String, at: Int64): UInt8
End Extern

/// What a run of a diff is.
Public Enum DiffKind
    /// The same in both texts.
    SAME
    /// Deleted from the first.
    DELETED
    /// Inserted for the second.
    INSERTED
End Enum

/// A run of a diff: what kind it is, and its text, whole lines for Diff.Lines.
Public Struct DiffRun
    /// What kind of run it is.
    Public ReadOnly Field Kind: DiffKind
    /// Its text, whole lines for Diff.Lines.
    Public ReadOnly Field Text: String
End Struct

/// A three-way merge: its text, and how many conflicts in it are marked.
Public Struct Merged
    /// The merged text.
    Public ReadOnly Field Text: String
    /// How many conflicts in it are marked.
    Public ReadOnly Field Conflicts: Int
End Struct

/// A change from a base: its lines from Start up to Finish are replaced by the other text's from
/// OtherStart up to OtherFinish.
Struct Change
    Field Start: Int
    Field Finish: Int
    Field OtherStart: Int
    Field OtherFinish: Int
End Struct

/// Diffing's operations.
///
/// # Examples
///
/// ```
/// # Import std.collections
/// Local runs = Diff.Lines("a\nb\nc\n", "a\nc\nd\n")
/// Expect(runs.Map(Function(run: DiffRun) => run.Kind) ==
///        [DiffKind.SAME, DiffKind.DELETED, DiffKind.SAME, DiffKind.INSERTED])
/// Local patch = Diff.Unified("a\nb\n", "a\nc\n")
/// Expect(patch.Contains("-b\n") && patch.Contains("+c\n"))
/// ```
Public Class Diff
    /// The runs of lines that are the same in `a` and `b`, deleted from `a`, and inserted for `b`,
    /// in order, as few lines as can be deleted and inserted. Where lines are replaced, the deleted
    /// ones come before the inserted ones.
    Public Static Method Lines(a: String, b: String): DiffRun[]
        Local from = LinesOf(a)
        Local to = LinesOf(b)
        Return Runs(Script(from, to), from, to)
    End Method

    /// The runs of characters that are the same in `a` and `b`, deleted from `a`, and inserted for
    /// `b`.
    Public Static Method Chars(a: String, b: String): DiffRun[]
        Local from: String[] = []
        For c In a.Chars
            from.Add("{c}")
        End For

        Local to: String[] = []
        For c In b.Chars
            to.Add("{c}")
        End For

        Return Runs(Script(from, to), from, to)
    End Method

    /// The unified diff of `a` and `b`, as diff -u and git diff write it, with `context` lines of
    /// each change's around it, and `fromName` and `toName` in its first two lines. "" when they're
    /// the same. Panics when `context` is negative.
    @PanicsAtCaller
    Public Static Method Unified(a: String, b: String, fromName: String = "a",
                                 toName: String = "b", context: Int = 3): String
        If context < 0 Then Panic("Unified takes a context of at least 0 lines, not {context}")
        Local from = LinesOf(a)
        Local to = LinesOf(b)
        Local changes = ChangesOf(Script(from, to))
        If changes.Count == 0 Then Return ""
        // A context of more lines than a has shows no more of them, so it counts as that many,
        // which keeps the sums below within an Int.
        Local reach = Min(context, from.Count)
        Local text = "--- {fromName}\n+++ {toName}\n"
        Local first = 0
        While first < changes.Count
            // A hunk takes each change whose context touches the one before's.
            Local last = first
            While last + 1 < changes.Count &&
                  changes[last + 1].Start - changes[last].Finish - reach <= reach
                last += 1
            End While

            Local start = Max(changes[first].Start - reach, 0)
            Local finish = changes[last].Finish + Min(reach, from.Count - changes[last].Finish)
            Local otherStart = changes[first].OtherStart - (changes[first].Start - start)
            Local otherFinish = changes[last].OtherFinish + (finish - changes[last].Finish)
            text += "@@ -{Range(start, finish)} +{Range(otherStart, otherFinish)} @@\n"
            Local at = start
            For index = first To last
                Local change = changes[index]
                For line = at Until change.Start
                    text += Shown(" ", from[line])
                End For

                For line = change.Start Until change.Finish
                    text += Shown("-", from[line])
                End For

                For line = change.OtherStart Until change.OtherFinish
                    text += Shown("+", to[line])
                End For

                at = change.Finish
            End For

            For line = at Until finish
                text += Shown(" ", from[line])
            End For

            first = last + 1
        End While

        Return text
    End Method

    /// `ours` and `theirs`, both changed from `base`, merged as git merge-file merges them: what
    /// each changed, and where both changed the same lines, or lines that touch, what they both
    /// made of them, or else a conflict, marked "<<<<<<< ours", `ours`' lines, "=======",
    /// `theirs`', and ">>>>>>> theirs", with `oursName` and `theirsName`, on lines that end in
    /// "\r\n" where the texts' lines do. A conflict holds only the lines that differ between the
    /// two, and two conflicts with at most 3 lines between them, or lines without an ASCII letter
    /// or digit, are one.
    ///
    /// # Examples
    ///
    /// ```
    /// Local merged = Diff.Merge("a\nb\nc\n", "A\nb\nc\n", "a\nb\nC\n")
    /// Expect(merged.Conflicts == 0 && merged.Text == "A\nb\nC\n")
    /// ```
    Public Static Method Merge(base: String, ours: String, theirs: String,
                               oursName: String = "ours", theirsName: String = "theirs"): Merged
        Local lines = LinesOf(base)
        Local mine = LinesOf(ours)
        Local others = LinesOf(theirs)
        Local left = ChangesOf(Script(lines, mine))
        Local right = ChangesOf(Script(lines, others))
        Local chunks: Chunk[] = []
        Local at = 0
        // Where the chunks so far end in ours and in theirs.
        Local mineAt = 0
        Local othersAt = 0
        Local l = 0
        Local r = 0
        While l < left.Count || r < right.Count
            // The next region of base that changes: from the first change left on either side,
            // taking in each change that overlaps or touches it.
            Local start = l < left.Count ? left[l].Start : lines.Count
            If r < right.Count && right[r].Start < start Then start = right[r].Start
            Local finish = start
            Local fromLeft = l
            Local fromRight = r
            Local grew = True
            While grew
                grew = False
                If l < left.Count && left[l].Start <= finish
                    finish = Max(finish, left[l].Finish)
                    l += 1
                    grew = True
                End If

                If r < right.Count && right[r].Start <= finish
                    finish = Max(finish, right[r].Finish)
                    r += 1
                    grew = True
                End If
            End While

            Local kept = Part(lines, at, start)
            chunks.Add(Chunk(ChunkKind.SAME, kept, []))
            mineAt += kept.Count
            othersAt += kept.Count
            Local mineLines = Mapped(left, fromLeft, l, start, finish, mine)
            Local otherLines = Mapped(right, fromRight, r, start, finish, others)
            If l == fromLeft
                chunks.Add(Chunk(ChunkKind.TAKEN, otherLines, []))
            ElseIf r == fromRight
                chunks.Add(Chunk(ChunkKind.TAKEN, mineLines, []))
            Else
                Refine(chunks, mineLines, otherLines, mineAt, othersAt)
            End If

            mineAt += mineLines.Count
            othersAt += otherLines.Count
            at = finish
        End While

        chunks.Add(Chunk(ChunkKind.SAME, Part(lines, at, lines.Count), []))
        Local text = ""
        Local conflicts = 0
        For chunk In Simplified(chunks)
            If chunk.Kind != ChunkKind.CONFLICT
                text += "".Join(chunk.Lines)
                Continue
            End If

            conflicts += 1
            Local ending = MarkerBreak(mine, chunk.Mine, others, chunk.Theirs, lines)
            text += "<<<<<<< {oursName}{ending}" + Ended("".Join(chunk.Lines), ending) +
                    "======={ending}" + Ended("".Join(chunk.Other), ending) +
                    ">>>>>>> {theirsName}{ending}"
        End For

        Return Merged(text, conflicts)
    End Method
End Class

/// text's lines, each with its line break.
Function LinesOf(text: String): String[]
    Local lines: String[] = []
    Local start = 0
    Local bytes = text.Length
    Local at = 0
    While at < bytes
        Local byte = fb_text_byte(text, at)
        If byte == 10 || byte == 13
            Local finish = at + 1
            If byte == 13 && finish < bytes && fb_text_byte(text, finish) == 10 Then finish += 1
            lines.Add(text.Slice(start, finish))
            start = finish
            at = finish
        Else
            at += 1
        End If
    End While

    If start < bytes Then lines.Add(text.Slice(start, bytes))
    Return lines
End Function

/// The fewest deletions from a and insertions from b that turn a into b, as what each step does,
/// in order, with the deletions before the insertions where lines are replaced. It goes as git's
/// xdiff does, without the shortcuts that let a diff of many lines be longer than the fewest:
/// past the lines both start and end with, a line with no equal in the other text is changed
/// without a search, Myers' search in linear space marks the rest, and each run of changes then
/// slides as git's does, so the diff is the one git and diff -u give.
Function Script(a: String[], b: String[]): DiffKind[]
    // Each line as its class, which equal lines share, and how many of each class each text has.
    Local classes = Map<String, Int>()
    Local left = ClassesOf(a, classes)
    Local right = ClassesOf(b, classes)
    Local inLeft: Int[] = []
    inLeft.Resize(classes.Count, 0)
    For line In left
        inLeft[line] += 1
    End For

    Local inRight: Int[] = []
    inRight.Resize(classes.Count, 0)
    For line In right
        inRight[line] += 1
    End For

    Local n = a.Count
    Local m = b.Count
    Local first = 0
    While first < n && first < m && left[first] == right[first]
        first += 1
    End While

    Local last = 0
    While last < n - first && last < m - first && left[n - 1 - last] == right[m - 1 - last]
        last += 1
    End While

    Local deleted: Bool[] = []
    deleted.Resize(n, False)
    Local inserted: Bool[] = []
    inserted.Resize(m, False)
    Local searchedLeft: Int[] = []
    For i = first Until n - last
        If inRight[left[i]] == 0 Then deleted[i] = True Else searchedLeft.Add(i)
    End For

    Local searchedRight: Int[] = []
    For j = first Until m - last
        If inLeft[right[j]] == 0 Then inserted[j] = True Else searchedRight.Add(j)
    End For

    Local search = Myers(Picked(left, searchedLeft), Picked(right, searchedRight))
    search.Compare(0, searchedLeft.Count, 0, searchedRight.Count)
    For i = 0 Until searchedLeft.Count
        If search.Deleted[i] Then deleted[searchedLeft[i]] = True
    End For

    For j = 0 Until searchedRight.Count
        If search.Inserted[j] Then inserted[searchedRight[j]] = True
    End For

    Compact(left, deleted, right, inserted)
    Compact(right, inserted, left, deleted)
    Local steps: DiffKind[] = []
    Local x = 0
    Local y = 0
    While x < n || y < m
        If x < n && deleted[x]
            steps.Add(DiffKind.DELETED)
            x += 1
        ElseIf y < m && inserted[y]
            steps.Add(DiffKind.INSERTED)
            y += 1
        Else
            steps.Add(DiffKind.SAME)
            x += 1
            y += 1
        End If
    End While

    Return steps
End Function

/// Each of lines' class, which equal lines share, adding a class to classes for each line that
/// has none.
Function ClassesOf(lines: String[], classes: Map<String, Int>): Int[]
    Local found: Int[] = []
    For line In lines
        Local known = classes.Get(line, -1)
        If known < 0
            known = classes.Count
            classes.Add(line, known)
        End If

        found.Add(known)
    End For

    Return found
End Function

/// The values at each of indexes.
Function Picked(values: Int[], indexes: Int[]): Int[]
    Local picked: Int[] = []
    For index In indexes
        picked.Add(values[index])
    End For

    Return picked
End Function

/// Myers' search for the fewest changes between two texts' lines, as their classes, in linear
/// space, as git's xdl_recs_cmp and xdl_split search with XDF_NEED_MINIMAL: it marks which of A's
/// lines are Deleted and which of B's are Inserted.
Class Myers
    Field A: Int[]
    Field B: Int[]
    Field Deleted: Bool[] = []
    Field Inserted: Bool[] = []
    /// How far along A the path on each diagonal, a line of A less a line of B, reaches forward
    /// and backward. A diagonal's place is it plus Offset.
    Field Forward: Int[] = []
    Field Backward: Int[] = []
    Field Offset: Int

    New(a: Int[], b: Int[])
        A = a
        B = b
        Deleted.Resize(a.Count, False)
        Inserted.Resize(b.Count, False)
        Forward.Resize(a.Count + b.Count + 3, 0)
        Backward.Resize(a.Count + b.Count + 3, 0)
        Offset = b.Count + 1
    End New

    /// Marks the changes between A's lines from aStart up to aEnd and B's from bStart up to bEnd:
    /// past the lines they start and end with alike, every line of one when the other has none
    /// left, or else the changes on each side of where a path of the fewest crosses its middle.
    Method Compare(aStart: Int, aEnd: Int, bStart: Int, bEnd: Int)
        Local x = aStart
        Local y = bStart
        Local xEnd = aEnd
        Local yEnd = bEnd
        While x < xEnd && y < yEnd && A[x] == B[y]
            x += 1
            y += 1
        End While

        While x < xEnd && y < yEnd && A[xEnd - 1] == B[yEnd - 1]
            xEnd -= 1
            yEnd -= 1
        End While

        If x == xEnd
            For j = y Until yEnd
                Inserted[j] = True
            End For
        ElseIf y == yEnd
            For i = x Until xEnd
                Deleted[i] = True
            End For
        Else
            Local middleX, middleY = Middle(x, xEnd, y, yEnd)
            Compare(x, middleX, y, middleY)
            Compare(middleX, xEnd, middleY, yEnd)
        End If
    End Method

    /// Where a path of the fewest changes from (aStart, bStart) to (aEnd, bEnd) crosses its
    /// middle, as xdl_split finds it: paths go forward from the start and back from the end, a
    /// change at a time on each diagonal, until one reaches the other's on the same diagonal.
    Method Middle(aStart: Int, aEnd: Int, bStart: Int, bEnd: Int): (Int, Int)
        Local lowest = aStart - bEnd
        Local highest = aEnd - bStart
        Local forwardMiddle = aStart - bStart
        Local backwardMiddle = aEnd - bEnd
        Local odd = (forwardMiddle - backwardMiddle) % 2 != 0
        Local forwardLow = forwardMiddle
        Local forwardHigh = forwardMiddle
        Local backwardLow = backwardMiddle
        Local backwardHigh = backwardMiddle
        Forward[Offset + forwardMiddle] = aStart
        Backward[Offset + backwardMiddle] = aEnd
        Loop
            // Each round reaches one diagonal further each way, or one less where the next is
            // past the box's edge, and marks the diagonal past it as not reached yet.
            If forwardLow > lowest
                forwardLow -= 1
                Forward[Offset + forwardLow - 1] = -1
            Else
                forwardLow += 1
            End If

            If forwardHigh < highest
                forwardHigh += 1
                Forward[Offset + forwardHigh + 1] = -1
            Else
                forwardHigh -= 1
            End If

            For d = forwardHigh To forwardLow Step -2
                Local x = Forward[Offset + d + 1]
                If Forward[Offset + d - 1] >= x Then x = Forward[Offset + d - 1] + 1
                Local y = x - d
                While x < aEnd && y < bEnd && A[x] == B[y]
                    x += 1
                    y += 1
                End While

                Forward[Offset + d] = x
                If odd && backwardLow <= d && d <= backwardHigh && Backward[Offset + d] <= x
                    Return (x, y)
                End If
            End For

            If backwardLow > lowest
                backwardLow -= 1
                Backward[Offset + backwardLow - 1] = 2147483647
            Else
                backwardLow += 1
            End If

            If backwardHigh < highest
                backwardHigh += 1
                Backward[Offset + backwardHigh + 1] = 2147483647
            Else
                backwardHigh -= 1
            End If

            For d = backwardHigh To backwardLow Step -2
                Local x = Backward[Offset + d + 1] - 1
                If Backward[Offset + d - 1] < Backward[Offset + d + 1]
                    x = Backward[Offset + d - 1]
                End If

                Local y = x - d
                While x > aStart && y > bStart && A[x - 1] == B[y - 1]
                    x -= 1
                    y -= 1
                End While

                Backward[Offset + d] = x
                If !odd && forwardLow <= d && d <= forwardHigh && x <= Forward[Offset + d]
                    Return (x, y)
                End If
            End For
        End Loop
    End Method
End Class

/// A run of a text's changed lines, from Start up to Finish, which is empty between two lines
/// that aren't changed, as git's xdlgroup is: it moves to the next run, or the one before, and
/// slides over the lines around it. Lines are the text's lines' classes.
Class Run
    Field Lines: Int[]
    Field Changed: Bool[]
    Field Start: Int = 0
    Field Finish: Int = 0

    New(lines: Int[], changed: Bool[])
        Lines = lines
        Changed = changed
        While IsChanged(Finish)
            Finish += 1
        End While
    End New

    Method IsChanged(line: Int): Bool => line >= 0 && line < Changed.Count && Changed[line]

    /// Moves to the next run, or tells that there's none.
    Method Next(): Bool
        If Finish == Changed.Count Then Return False
        Start = Finish + 1
        Finish = Start
        While IsChanged(Finish)
            Finish += 1
        End While

        Return True
    End Method

    /// Moves to the run before, or tells that there's none.
    Method Previous(): Bool
        If Start == 0 Then Return False
        Finish = Start - 1
        Start = Finish
        While IsChanged(Start - 1)
            Start -= 1
        End While

        Return True
    End Method

    /// Slides the run a line down, where the line after it is the same as its first, taking in
    /// the run it then touches, or tells that it can't.
    Method SlideDown(): Bool
        If Finish >= Changed.Count || Lines[Start] != Lines[Finish] Then Return False
        Changed[Start] = False
        Start += 1
        Changed[Finish] = True
        Finish += 1
        While IsChanged(Finish)
            Finish += 1
        End While

        Return True
    End Method

    /// Slides the run a line up, where the line before it is the same as its last, taking in the
    /// run it then touches, or tells that it can't.
    Method SlideUp(): Bool
        If Start == 0 || Lines[Start - 1] != Lines[Finish - 1] Then Return False
        Start -= 1
        Changed[Start] = True
        Finish -= 1
        Changed[Finish] = False
        While IsChanged(Start - 1)
            Start -= 1
        End While

        Return True
    End Method
End Class

/// Slides each run of a text's changed lines as git's xdl_change_compact does without its indent
/// heuristic: as far up as its lines allow, then as far down, taking in the runs it meets, and
/// then back up to the last place where it lines up with a run of the other text's changes, if
/// it passed one. lines and changed are the text's, and others and otherChanged the other's.
Function Compact(lines: Int[], changed: Bool[], others: Int[], otherChanged: Bool[])
    Local run = Run(lines, changed)
    Local other = Run(others, otherChanged)
    Loop
        If run.Finish > run.Start
            Local earliest = 0
            Local matching = -1
            Local size = 0
            Repeat
                size = run.Finish - run.Start
                matching = -1
                While run.SlideUp()
                    other.Previous()
                End While

                earliest = run.Finish
                If other.Finish > other.Start Then matching = run.Finish
                While run.SlideDown()
                    other.Next()
                    If other.Finish > other.Start Then matching = run.Finish
                End While
            Until size == run.Finish - run.Start

            If run.Finish != earliest && matching >= 0
                While other.Finish == other.Start
                    run.SlideUp()
                    other.Previous()
                End While
            End If
        End If

        If !run.Next() Then Return
        other.Next()
    End Loop
End Function

/// The runs that steps make of a and b.
Function Runs(steps: DiffKind[], a: String[], b: String[]): DiffRun[]
    Local runs: DiffRun[] = []
    Local x = 0
    Local y = 0
    Local i = 0
    While i < steps.Count
        Local kind = steps[i]
        Local text = ""
        While i < steps.Count && steps[i] == kind
            If kind == DiffKind.INSERTED
                text += b[y]
                y += 1
            Else
                text += a[x]
                x += 1
                If kind == DiffKind.SAME Then y += 1
            End If

            i += 1
        End While

        runs.Add(DiffRun(kind, text))
    End While

    Return runs
End Function

/// The changes that steps make: each run of deletions and insertions, as the lines of a it
/// replaces and the lines of b it puts there.
Function ChangesOf(steps: DiffKind[]): Change[]
    Local changes: Change[] = []
    Local x = 0
    Local y = 0
    Local i = 0
    While i < steps.Count
        If steps[i] == DiffKind.SAME
            x += 1
            y += 1
            i += 1
            Continue
        End If

        Local start = x
        Local otherStart = y
        While i < steps.Count && steps[i] != DiffKind.SAME
            If steps[i] == DiffKind.DELETED Then x += 1 Else y += 1
            i += 1
        End While

        changes.Add(Change(start, x, otherStart, y))
    End While

    Return changes
End Function

/// What a chunk of a merge is: lines both sides have, lines one side changed, or a conflict.
Enum ChunkKind
    SAME, TAKEN, CONFLICT
End Enum

/// A chunk of a merge: its Lines, ours' for a conflict, and theirs' Other, and for a conflict,
/// where its lines start in ours and in theirs.
Struct Chunk
    Field Kind: ChunkKind
    Field Lines: String[]
    Field Other: String[]
    Field Mine: Int = 0
    Field Theirs: Int = 0
End Struct

/// The lines of other in place of base's from start up to finish, as the changes from first up
/// to after map them: before the first change, and after the last, its lines line up with base's.
Function Mapped(changes: Change[], first: Int, after: Int, start: Int, finish: Int,
                other: String[]): String[]
    Local otherStart = start
    Local otherFinish = finish
    If first > 0
        Local before = changes[first - 1]
        otherStart = start + before.OtherFinish - before.Finish
        otherFinish = finish + before.OtherFinish - before.Finish
    End If

    If after > first
        Local opening = changes[first]
        Local closing = changes[after - 1]
        otherStart = opening.OtherStart - (opening.Start - start)
        otherFinish = closing.OtherFinish + (finish - closing.Finish)
    End If

    Return Part(other, otherStart, otherFinish)
End Function

/// The chunks of where both sides changed the same lines, mine in ours from mineAt and others in
/// theirs from othersAt: the lines they both have, and between them, a conflict of each run that
/// differs, unless one side has none, which is one conflict. Two sides that made the same of
/// them, none included, have it as lines both have, as git's merge has the same change on both.
Function Refine(chunks: Chunk[], mine: String[], others: String[], mineAt: Int, othersAt: Int)
    If mine.Count == 0 && others.Count == 0 Then Return
    If mine.Count == 0 || others.Count == 0
        chunks.Add(Chunk(ChunkKind.CONFLICT, mine, others, mineAt, othersAt))
        Return
    End If

    Local changes = ChangesOf(Script(mine, others))
    Local at = 0
    For change In changes
        chunks.Add(Chunk(ChunkKind.SAME, Part(mine, at, change.Start), []))
        chunks.Add(Chunk(ChunkKind.CONFLICT, Part(mine, change.Start, change.Finish),
                         Part(others, change.OtherStart, change.OtherFinish),
                         mineAt + change.Start, othersAt + change.OtherStart))
        at = change.Finish
    End For

    chunks.Add(Chunk(ChunkKind.SAME, Part(mine, at, mine.Count), []))
End Function

/// chunks with the lines both sides have, next to each other, as one run of them, and each two
/// conflicts with only such a run between them, of at most 3 lines or none with an ASCII letter
/// or digit, made one conflict that holds those lines on both sides.
Function Simplified(chunks: Chunk[]): Chunk[]
    Local simplified: Chunk[] = []
    For chunk In chunks
        If chunk.Kind == ChunkKind.SAME && chunk.Lines.Count == 0 Then Continue
        Local count = simplified.Count
        If chunk.Kind == ChunkKind.SAME && count > 0 &&
           simplified[count - 1].Kind == ChunkKind.SAME
            Local lines = simplified[count - 1].Lines.Clone()
            lines.AddAll(chunk.Lines)
            simplified.RemoveLast()
            simplified.Add(Chunk(ChunkKind.SAME, lines, []))
            Continue
        End If

        If chunk.Kind == ChunkKind.CONFLICT && count >= 2
            Local between = simplified[count - 1]
            Local conflict = simplified[count - 2]
            If between.Kind == ChunkKind.SAME && conflict.Kind == ChunkKind.CONFLICT &&
               (between.Lines.Count <= 3 || !HasAlnum(between.Lines))
                Local mine = conflict.Lines.Clone()
                mine.AddAll(between.Lines)
                mine.AddAll(chunk.Lines)
                Local others = conflict.Other.Clone()
                others.AddAll(between.Lines)
                others.AddAll(chunk.Other)
                simplified.RemoveLast()
                simplified.RemoveLast()
                simplified.Add(Chunk(ChunkKind.CONFLICT, mine, others, conflict.Mine,
                                     conflict.Theirs))
                Continue
            End If
        End If

        simplified.Add(chunk)
    End For

    Return simplified
End Function

/// Whether any of lines has an ASCII letter or digit, as git's lines_contain_alnum asks.
Function HasAlnum(lines: String[]): Bool
    For line In lines
        For c In line.Chars
            If c.IsAscii() && c.IsLetterOrDigit() Then Return True
        End For
    End For

    Return False
End Function

/// The line break of a conflict's markers, as git's is_cr_needed picks it: "\r\n" when base's
/// first line ends in one, and neither ours' line before the conflict, which starts at mineAt,
/// nor theirs', at othersAt, ends in "\n" alone, a side's first line standing in for it when the
/// conflict starts the side; "\n" otherwise.
Function MarkerBreak(mine: String[], mineAt: Int, others: String[], othersAt: Int,
                     base: String[]): String
    Local crlf = EndsInCrLf(mine, Max(mineAt - 1, 0))
    If crlf != 0 Then crlf = EndsInCrLf(others, Max(othersAt - 1, 0))
    If crlf != 0 Then crlf = EndsInCrLf(base, 0)
    Return crlf > 0 ? "\r\n" : "\n"
End Function

/// Whether line at of lines ends in "\r\n", as git's is_eol_crlf tells it: 1 when it does, 0 when
/// it ends in "\n" alone, and -1 when it can't tell. The last line without a "\n" tells by the
/// line before it.
Function EndsInCrLf(lines: String[], at: Int): Int
    If lines.Count == 0 Then Return -1
    If at < lines.Count - 1 || lines[at].EndsWith("\n")
        Return lines[at].EndsWith("\r\n") ? 1 : 0
    End If

    If at == 0 Then Return -1
    Return lines[at - 1].EndsWith("\r\n") ? 1 : 0
End Function

/// lines from start up to finish.
Function Part(lines: String[], start: Int, finish: Int): String[]
    Local part: String[] = []
    For i = start Until finish
        part.Add(lines[i])
    End For

    Return part
End Function

/// A hunk's range, from start up to finish, as diff -u writes it: its first line, from 1, and its
/// count unless that's 1; an empty range names the line before it.
Function Range(start: Int, finish: Int): String
    Local count = finish - start
    If count == 1 Then Return "{start + 1}"
    If count == 0 Then Return "{start},0"
    Return "{start + 1},{count}"
End Function

/// A line of a unified diff: its mark, the line, and a note when the line has no line break.
Function Shown(mark: String, line: String): String
    If line.EndsWith("\n") || line.EndsWith("\r") Then Return mark + line
    Return mark + line + "\n\\ No newline at end of file\n"
End Function

/// text, ending in a line break: ending, when it has none.
Function Ended(text: String, ending: String): String
    If text == "" || text.EndsWith("\n") || text.EndsWith("\r") Then Return text
    Return text + ending
End Function
