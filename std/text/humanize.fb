//! std.text.humanize: values as people say them, in English. Plurals ("3 enemies"), how long ago
//! or from now a time is ("3 minutes ago"), ordinals ("22nd"), numbers in words ("forty-two"),
//! and a name in each case style a program uses: snake_case, camelCase, PascalCase, and
//! kebab-case. FormatBytes and FormatDuration say a size ("1.2 MB") and a Duration ("1 hour and 30
//! minutes").

Import std.core
Import std.text.char
Import std.text.string
Import std.time.duration

Extern "runtime"
    Function fb_unicode_category(code: UInt32): Int32
End Extern

/// Humanize's operations.
Public Class Humanize
    /// word's plural: "enemy" is "enemies", "box" "boxes", "leaf" "leaves", "child" "children",
    /// and "sheep" "sheep". Of several words, the last one's. A word keeps its capitals, as
    /// "GameObject" does in "GameObjects", and one in capitals has its ending in them too.
    Public Static Method Plural(word: String): String
        Local space = word.FindLast(" ")
        Local start = space == Null ? 0 : space + 1
        Return word.Slice(0, start) + PluralOf(word.Slice(start, word.Length))
    End Method

    /// count and word, the word in its plural unless count is 1 or -1: "3 enemies", "1 enemy",
    /// and "0 enemies".
    Public Static Method Plural(count: Int64, word: String): String
        If count == 1 || count == -1 Then Return "{count} {word}"
        Return "{count} {Plural(word)}"
    End Method

    /// How long ago a time seconds from now was, when seconds is negative, "3 minutes ago", or how
    /// soon it will be, "in 3 minutes", rounded to the unit people would say: "just now" under 45
    /// seconds either way, then a minute, minutes, an hour, hours, a day, days, a month, months,
    /// a year, and years.
    Public Static Method Relative(seconds: Int64): String
        // The size without the sign, which the most negative Int64 has no room for.
        Local size: UInt64 = seconds < 0 ? ((-(seconds + 1)) As UInt64) + 1 : seconds As UInt64
        If size < 45 Then Return "just now"
        Local said = Span(size)
        If seconds < 0 Then Return "{said} ago"
        Return "in {said}"
    End Method

    /// How long ago a time d before now was, when d is before 0, or how soon one d from now will
    /// be, as Relative says it of d's whole seconds: "3 minutes ago" and "in 2 hours".
    Public Static Method Relative(d: Duration): String => Relative(d.Nanoseconds / 1000000000)

    /// n with its ordinal's ending: "1st", "2nd", "3rd", "4th", "11th", "22nd", and "113th".
    Public Static Method Ordinal(n: Int64): String
        Local size = Magnitude(n)
        Local last = size % 10
        Local ending = "th"
        If size % 100 < 11 || size % 100 > 13
            If last == 1 Then ending = "st"
            If last == 2 Then ending = "nd"
            If last == 3 Then ending = "rd"
        End If

        Return "{n}{ending}"
    End Method

    /// n in words: "zero", "forty-two", "one thousand two hundred thirty-four", and "minus
    /// seven".
    Public Static Method Words(n: Int64): String
        If n == 0 Then Return "zero"
        Local words = WordsOf(Magnitude(n))
        If n < 0 Then Return "minus " + words
        Return words
    End Method

    /// text's words in snake_case: "Hello World", "helloWorld", and "HTTPServer2" are
    /// "hello_world", "hello_world", and "http_server2". Words are split at spaces, punctuation,
    /// and capitals that start one, and a run of capitals is one word.
    Public Static Method SnakeCase(text: String): String => "_".Join(Lowered(WordsIn(text)))

    /// text's words in kebab-case: "hello-world".
    Public Static Method KebabCase(text: String): String => "-".Join(Lowered(WordsIn(text)))

    /// text's words in camelCase: "helloWorld", "httpServer2".
    Public Static Method CamelCase(text: String): String
        Local words = WordsIn(text)
        Local joined = ""
        For i = 0 Until words.Count
            joined += i == 0 ? words[i].ToLower() : Capitalized(words[i])
        End For

        Return joined
    End Method

    /// text's words in PascalCase: "HelloWorld", "HttpServer2".
    Public Static Method PascalCase(text: String): String
        Local joined = ""
        For word In WordsIn(text)
            joined += Capitalized(word)
        End For

        Return joined
    End Method
End Class

/// Nouns that are the same in the plural.
Const SAME = ["sheep", "fish", "deer", "moose", "series", "species", "aircraft", "salmon",
              "trout", "bison", "swine", "news", "information", "equipment", "rice", "money"]

/// Plurals that follow no rule, each after its singular.
Const IRREGULAR = ["person", "people", "man", "men", "woman", "women", "child", "children",
                   "mouse", "mice", "goose", "geese", "tooth", "teeth", "foot", "feet", "ox",
                   "oxen", "louse", "lice", "die", "dice", "cactus", "cacti", "fungus", "fungi",
                   "nucleus", "nuclei", "radius", "radii", "analysis", "analyses", "crisis",
                   "crises", "thesis", "theses", "axis", "axes", "phenomenon", "phenomena",
                   "criterion", "criteria", "matrix", "matrices", "vertex", "vertices", "index",
                   "indices", "appendix", "appendices", "potato", "potatoes", "tomato",
                   "tomatoes", "hero", "heroes", "echo", "echoes", "veto", "vetoes", "torpedo",
                   "torpedoes", "leaf", "leaves", "knife", "knives", "life", "lives", "wife",
                   "wives", "wolf", "wolves", "half", "halves", "elf", "elves", "shelf",
                   "shelves", "thief", "thieves", "calf", "calves", "loaf", "loaves", "self",
                   "selves", "quiz", "quizzes"]

Const ONES = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten",
              "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen",
              "eighteen", "nineteen"]
Const TENS = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty",
              "ninety"]
Const GROUPS = ["", "thousand", "million", "billion", "trillion", "quadrillion", "quintillion"]

/// word's plural, word in lowercase.
Function PluralOf(word: String): String
    Local lower = word.ToLower()
    If lower == "" Then Return word
    For same In SAME
        If lower == same Then Return word
    End For

    For i = 0 Until IRREGULAR.Count Step 2
        If lower == IRREGULAR[i] Then Return Cased(IRREGULAR[i + 1], word)
    End For

    Local capitals = word == word.ToUpper() && word != lower
    Local chars = lower.Chars
    Local count = chars.Count
    If count > 1 && chars[count - 1] == 'y' && !"aeiou".Contains(chars[count - 2])
        Return word.Slice(0, word.Length - 1) + (capitals ? "IES" : "ies")
    End If

    For ending In ["s", "x", "z", "ch", "sh"]
        If lower.EndsWith(ending) Then Return word + (capitals ? "ES" : "es")
    End For

    Return word + (capitals ? "S" : "s")
End Function

/// An irregular plural in the case like's letters are: all capitals, or a capital first.
Function Cased(plural: String, like: String): String
    If like != "" && like == like.ToUpper() && like != like.ToLower() Then Return plural.ToUpper()
    Local chars = like.Chars
    If chars.Count > 0 && chars[0].IsUpper() Then Return Capitalized(plural)
    Return plural
End Function

/// word with its first letter a capital and the rest lowercase.
Function Capitalized(word: String): String
    Local chars = word.Chars
    If chars.Count == 0 Then Return word
    Local first = "{chars[0]}"
    Return first.ToUpper() + word.Slice(first.Length, word.Length).ToLower()
End Function

Function Lowered(words: String[]): String[]
    Local lowered: String[] = []
    For word In words
        lowered.Add(word.ToLower())
    End For

    Return lowered
End Function

/// text's words: runs of letters and digits, with the combining marks after them, split where a
/// capital follows a lowercase letter or a digit, or starts a word after a run of capitals, as
/// the S in "HTTPServer" does.
Function WordsIn(text: String): String[]
    Local words: String[] = []
    Local word = ""
    Local chars = text.Chars
    For i = 0 Until chars.Count
        Local c = chars[i]
        // A mark goes with the letter or digit before it, as the accent of "e\u{301}" does.
        If word != "" && IsMark(c)
            word += "{c}"
            Continue
        End If

        If !c.IsLetterOrDigit()
            If word != "" Then words.Add(word)
            word = ""
            Continue
        End If

        If word != "" && c.IsUpper()
            Local before = chars[Unmarked(chars, i - 1, -1)]
            Local after = Unmarked(chars, i + 1, 1)
            Local starts = before.IsLower() || before.IsDigit()
            If before.IsUpper() && after < chars.Count && chars[after].IsLower() Then starts = True
            If starts
                words.Add(word)
                word = ""
            End If
        End If

        word += "{c}"
    End For

    If word != "" Then words.Add(word)
    Return words
End Function

/// Whether c is a combining mark, Unicode's Mn, Mc, or Me, which goes with the character before.
Function IsMark(c: Char): Bool
    Local category = fb_unicode_category(c As UInt32)
    Return category >= 6 && category <= 8
End Function

/// The first place from at, going by step, whose character isn't a combining mark.
Function Unmarked(chars: Char[], at: Int, step: Int): Int
    Local place = at
    While place >= 0 && place < chars.Count && IsMark(chars[place])
        place += step
    End While

    Return place
End Function

/// How long size seconds is, as people say it.
Function Span(size: UInt64): String
    Local minutes = (size + 30) / 60
    Local hours = (size + 1800) / 3600
    Local days = (size + 43200) / 86400
    If size < 90 Then Return "a minute"
    If size < 2700 Then Return "{minutes} minutes"
    If size < 5400 Then Return "an hour"
    If size < 79200 Then Return "{hours} hours"
    If size < 129600 Then Return "a day"
    If size < 2246400 Then Return "{days} days"
    If size < 3888000 Then Return "a month"
    // A month is a twelfth of a year of 365.25 days, 2629800 seconds, and past "a month" and "a
    // year", there are at least 2.
    If size < 27648000 Then Return "{Max((size + 1314900) / 2629800, 2)} months"
    If size < 47347200 Then Return "a year"
    Return "{Max((size + 15778800) / 31557600, 2)} years"
End Function

/// count bytes as people say them, in the largest unit they make at least 1 of, to a tenth,
/// rounded half up: "1.2 MB", "999 B", and "-3.4 GB". The units are 1000 apart, or with binary,
/// 1024: "1.2 MiB".
Public Function FormatBytes(count: Int64, binary: Bool = False): String
    Local size = Magnitude(count)
    Local sign = count < 0 ? "-" : ""
    Local base: UInt64 = binary ? 1024 : 1000
    If size < base Then Return "{sign}{size} B"
    Local units = ["kB", "MB", "GB", "TB", "PB", "EB"]
    If binary Then units = ["KiB", "MiB", "GiB", "TiB", "PiB", "EiB"]
    Local unit = 0
    Local divisor = base
    Local tenths = Tenths(size, divisor)
    // One that rounds to the next unit's 1, like 999.96 kB, is in that unit.
    While unit < units.Count - 1 && tenths >= base * 10
        unit += 1
        divisor *= base
        tenths = Tenths(size, divisor)
    End While

    Return "{sign}{tenths / 10}.{tenths % 10} {units[unit]}"
End Function

/// d in words: each of its days, hours, minutes, and seconds that isn't 0, the seconds with their
/// fraction, as "1 hour, 2 minutes, and 3.5 seconds" and "2 days and 1 minute". Under a second,
/// it's in its largest unit: "250 milliseconds", "1.5 microseconds", and "80 nanoseconds". It's
/// "0 seconds", and one before 0 is "minus" one after.
Public Function FormatDuration(d: Duration): String
    Local size = Magnitude(d.Nanoseconds)
    Local sign = d.Nanoseconds < 0 ? "minus " : ""
    If size == 0 Then Return "0 seconds"
    If size < 1000 Then Return sign + Counted(size, 0, "nanosecond")
    If size < 1000000 Then Return sign + Counted(size, 3, "microsecond")
    If size < 1000000000 Then Return sign + Counted(size, 6, "millisecond")
    Local seconds = size / 1000000000
    Local parts: String[] = []
    If seconds >= 86400 Then parts.Add(Counted(seconds / 86400, 0, "day"))
    If seconds % 86400 >= 3600 Then parts.Add(Counted(seconds % 86400 / 3600, 0, "hour"))
    If seconds % 3600 >= 60 Then parts.Add(Counted(seconds % 3600 / 60, 0, "minute"))
    Local rest = size % 60000000000
    If rest > 0 Then parts.Add(Counted(rest, 9, "second"))
    If parts.Count == 1 Then Return sign + parts[0]
    If parts.Count == 2 Then Return "{sign}{parts[0]} and {parts[1]}"
    parts[parts.Count - 1] = "and " + parts[parts.Count - 1]
    Return sign + ", ".Join(parts)
End Function

/// count of a unit, as a number with decimals digits after its point, and the unit's name, in
/// its plural unless the number is 1: "1 day", "1.5 seconds", and "250 milliseconds".
Function Counted(count: UInt64, decimals: Int, unit: String): String
    Local scale: UInt64 = 1
    For i = 1 To decimals
        scale *= 10
    End For

    Local number = "{count / scale}"
    Local fraction = count % scale
    If fraction > 0
        Local digits = "{fraction}".PadLeft(decimals, '0')
        While digits.EndsWith("0")
            digits = digits.Slice(0, digits.Length - 1)
        End While

        number += "." + digits
    End If

    Return number == "1" ? "1 {unit}" : "{number} {unit}s"
End Function

/// size / divisor in tenths, rounded half up, in parts that don't overflow.
Function Tenths(size: UInt64, divisor: UInt64): UInt64
    Return size / divisor * 10 + (size % divisor * 10 + divisor / 2) / divisor
End Function

Function Magnitude(n: Int64): UInt64
    If n >= 0 Then Return n As UInt64
    Return ((-(n + 1)) As UInt64) + 1
End Function

/// size, at least 1, in words.
Function WordsOf(size: UInt64): String
    Local groups: String[] = []
    Local rest = size
    Local group = 0
    While rest > 0
        Local part = (rest % 1000) As Int
        If part > 0
            Local words = Hundreds(part)
            If group > 0 Then words += " " + GROUPS[group]
            groups.Insert(0, words)
        End If

        rest /= 1000
        group += 1
    End While

    Return " ".Join(groups)
End Function

/// part, from 1 to 999, in words.
Function Hundreds(part: Int): String
    Local words: String[] = []
    If part >= 100 Then words.Add(ONES[part / 100] + " hundred")
    Local rest = part % 100
    If rest >= 20
        Local tens = TENS[rest / 10]
        If rest % 10 > 0 Then tens += "-" + ONES[rest % 10]
        words.Add(tens)
    ElseIf rest > 0
        words.Add(ONES[rest])
    End If

    Return " ".Join(words)
End Function
