//! Animation: frames of one size, each an Image shown for its delay, played a number of times or
//! forever, which Gif's and Png's DecodeAnimation give and their EncodeAnimation take.

Import std.core
Import std.collections.view
Import std.image.codec
Import std.image.image

/// One of an Animation's frames: its image, and how long it's shown, in milliseconds.
Public Struct Frame
    /// What the frame shows.
    Public Field Image: Image
    /// How long it's shown, in milliseconds.
    Public Field Delay: Int
End Struct

/// Frames of one size, each an Image shown for its delay, played a number of times or forever.
Public Class Animation
    Field Columns: Int
    Field Rows: Int
    Field Times: Int
    Field List: Frame[]

    /// An animation of frames of width by height pixels, with none yet, played `plays` times, or
    /// forever for 0. Panics when the size is one an Image can't be, or plays is negative.
    @PanicsAtCaller
    Public New(width: Int, height: Int, plays: Int = 0)
        CheckSize(width, height)
        CheckPlays(plays)
        Columns = width
        Rows = height
        Times = plays
        List = []
    End New

    /// How many pixels wide its frames are.
    Public Property Width: Int
        Get => Columns
    End Property

    /// How many pixels high its frames are.
    Public Property Height: Int
        Get => Rows
    End Property

    /// How many times its frames play, or 0 for forever. Panics when it's given a negative one.
    @PanicsAtCaller
    Public Property Plays: Int
        Get => Times
        Set(value)
            CheckPlays(value)
            Times = value
        End Set
    End Property

    /// How many frames it has.
    Public Property Count: Int
        Get => List.Count
    End Property

    /// Its frames, in the order they play.
    Public Property Frames: ReadOnlyArray<Frame>
        Get => List.AsReadOnly()
    End Property

    /// The frame at index. Panics when it's out of range.
    @PanicsAtCaller
    Operator [](index: Int): Frame => List[index]

    /// Adds a frame of `image`, which it keeps rather than copies, so what changes the image
    /// changes the frame, shown for `delay` milliseconds. Panics when the image isn't the
    /// animation's size, or the delay is negative or longer than 65535000, APNG's longest, 65535
    /// seconds.
    @PanicsAtCaller
    Public Method Add(image: Image, delay: Int)
        If image.Width != Columns || image.Height != Rows
            Panic("an animation of {Columns} by {Rows} can't have a frame of {image.Width} by " +
                  "{image.Height}")
        End If

        If delay < 0 || delay > LONGEST_DELAY
            Panic("a frame's delay is from 0 to {LONGEST_DELAY} milliseconds, not {delay}")
        End If

        List.Add(Frame(image, delay))
    End Method
End Class

@PanicsAtCaller
Function CheckPlays(plays: Int)
    If plays < 0 Then Panic("an animation plays 0 times, for forever, or more, not {plays}")
End Function

/// Panics when a frame's image isn't the animation's size, as one resized or cropped since it was
/// added isn't, for an encoder of `format`.
@PanicsAtCaller
Package Function CheckFrames(animation: Animation, format: String)
    For i = 0 Until animation.Count
        Local image = animation[i].Image
        If image.Width != animation.Width || image.Height != animation.Height
            Panic("{format}'s frames are each the animation's {animation.Width} by " +
                  "{animation.Height}, and frame {i} is {image.Width} by {image.Height}")
        End If
    End For
End Function

/// The Animation the runtime decoded, or the IOError its result means, for data in `format`.
Package Function DecodedAnimation(image: Ptr<Void>, format: String): Animation Throws IOError
    Try CheckDecoded(image, format)
    Local width = fb_image_width(image) As Int
    Local height = fb_image_height(image) As Int
    Local animation = Animation(width, height, fb_image_plays(image))
    For i = 0 Until fb_image_frames(image) As Int
        animation.Add(Image.Of(width, height, PixelsOf(image, i)), fb_image_delay(image, i))
    End For

    fb_image_free(image)
    Return animation
End Function
