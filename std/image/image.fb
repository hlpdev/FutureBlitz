// Image: a picture's pixels, in rows from the top, each RGBA, 8 bits a channel, its alpha
// straight, which the formats' Decodes give and their Encodes take. Image.Decode reads any
// format std.image knows, by how its bytes start, but HDR's, whose pixels are an HdrImage's.

Import std.core
Import std.math.color
Import std.image.codec

// The formats std.image reads, which Image.FormatOf tells apart.
Public Enum ImageFormat
    PNG, JPEG, BMP, TGA, GIF, HDR, QOI, WEBP
End Enum

Public Class Image
    // Its pixels' bytes, 4 for each, red, green, blue, and alpha.
    Package Field Pixels: UInt8[]
    Field Columns: Int
    Field Rows: Int

    // An image of width by height pixels, each transparent black. Panics when either is negative,
    // or there'd be more pixels than an Image holds, 536870911.
    @PanicsAtCaller
    Public New(width: Int, height: Int)
        CheckSize(width, height)
        Columns = width
        Rows = height
        Pixels = []
        fb_image_blank(Pixels, (width * height * 4) As Int64)
    End New

    New(width: Int, height: Int, pixels: UInt8[])
        Columns = width
        Rows = height
        Pixels = pixels
    End New

    // An image of width by height pixels whose bytes, 4 for each pixel, red, green, blue, and
    // alpha, are a copy of `bytes`. Panics when there aren't that many, or the size is one New
    // panics for.
    @PanicsAtCaller
    Public Static Method FromBytes(width: Int, height: Int, bytes: UInt8[]): Image
        CheckSize(width, height)
        If bytes.Count != width * height * 4
            Panic("an image of {width} by {height} pixels has {width * height * 4} bytes, not " +
                  "{bytes.Count}")
        End If

        Return Image(width, height, bytes.Clone())
    End Method

    // An image of pixels the runtime or a format made, which it keeps.
    Package Static Method Of(width: Int, height: Int, pixels: UInt8[]): Image
        Return Image(width, height, pixels)
    End Method

    Public Property Width: Int
        Get => Columns
    End Property

    Public Property Height: Int
        Get => Rows
    End Property

    // The pixel `x` from the left and `y` from the top. Panics when it's outside the image.
    @PanicsAtCaller
    Operator [](x: Int, y: Int): Color32
        Local at = ByteOf(x, y)
        Return Color32(Pixels[at], Pixels[at + 1], Pixels[at + 2], Pixels[at + 3])
    End Operator

    // Gives the pixel `x` from the left and `y` from the top a color. Panics when it's outside
    // the image.
    @PanicsAtCaller
    Operator []=(x: Int, y: Int, color: Color32)
        Local at = ByteOf(x, y)
        Pixels[at] = color.r
        Pixels[at + 1] = color.g
        Pixels[at + 2] = color.b
        Pixels[at + 3] = color.a
    End Operator

    // A copy of its pixels' bytes, 4 for each, red, green, blue, and alpha.
    Public Method ToBytes(): UInt8[] => Pixels.Clone()

    // A new image of the same pixels.
    Public Method Clone(): Image => Image(Columns, Rows, Pixels.Clone())

    // The image in data, a PNG, JPEG, BMP, TGA, GIF's first frame, QOI, or WebP, by how its
    // bytes start. Throws an IOError of INVALID_DATA when they're none of those, or broken,
    // UNEXPECTED_END when they end too soon, and OTHER when they're an HDR image, which
    // Hdr.Decode reads, or use what isn't supported, or the image has more pixels than `limit`.
    // Panics when the limit is negative.
    @PanicsAtCaller
    Public Static Method Decode(data: UInt8[], limit: Int = MOST_PIXELS): Image Throws IOError
        CheckLimit(limit)
        Local most = Min(limit, MOST_PIXELS)
        Local format = fb_image_format(data)
        If format == 0
            Throw IOError(IOErrorKind.INVALID_DATA, "the data isn't an image std.image reads")
        End If

        If format == 6
            Throw IOError(IOErrorKind.OTHER, "the data is an HDR image, which Hdr.Decode reads")
        End If

        If format == 7 Then Return Try Decoded(fb_image_qoi_decode(data, most), "QOI")
        If format == 8 Then Return Try Decoded(fb_webp_decode(data, most), "WebP")
        If format == 5 Then Return Try Decoded(fb_image_gif_decode(data, 1, most), "GIF")
        Return Try Decoded(fb_stb_decode(data, format, most), FormatName(format))
    End Method

    // The format the data's bytes start as, or Null when they start as none of std.image's. A TGA
    // has no signature, so it's what starts as a TGA's header does once no other format matches.
    Public Static Method FormatOf(data: UInt8[]): ImageFormat?
        Local format = fb_image_format(data)
        If format == 0 Then Return Null
        Return (format - 1) As ImageFormat
    End Method

    // Where the pixel's bytes start in Pixels. Panics when it's outside the image.
    @PanicsAtCaller
    Method ByteOf(x: Int, y: Int): Int
        If x < 0 || x >= Columns || y < 0 || y >= Rows
            Panic("pixel ({x}, {y}) is outside an image of {Columns} by {Rows}")
        End If

        Return (y * Columns + x) * 4
    End Method
End Class

// Panics when an image can't be width by height pixels.
@PanicsAtCaller
Package Function CheckSize(width: Int, height: Int)
    If width < 0 || height < 0
        Panic("an image's width and height can't be negative, like {width} by {height}")
    End If

    If width > 0 && height > MOST_PIXELS / width
        Panic("an image of {width} by {height} has more pixels than an Image holds, " +
              "{MOST_PIXELS}")
    End If
End Function

// The Image the runtime decoded, or the IOError its result means, for data in `format`.
Package Function Decoded(image: Ptr<Void>, format: String): Image Throws IOError
    Try CheckDecoded(image, format)
    Local decoded = Image.Of(fb_image_width(image) As Int, fb_image_height(image) As Int,
                             PixelsOf(image, 0))
    fb_image_free(image)
    Return decoded
End Function

// A format's name, by the runtime's number for it.
Package Function FormatName(format: Int32): String
    Return ["PNG", "JPEG", "BMP", "TGA", "GIF", "HDR", "QOI", "WebP"][format - 1]
End Function
