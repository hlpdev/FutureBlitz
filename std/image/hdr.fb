// HDR: an HdrImage's pixels are light, linear, each RGBA as Floats, past 1 where they're brighter
// than white, which Hdr reads from Radiance's RGBE files, as stb_image reads them, and writes to
// them, run-length encoded, as stb_image_write does. RGBE has no alpha: what Hdr.Decode gives is
// opaque, and Encode leaves the alpha out.

Import std.core
Import std.math.color
Import std.image.codec
Import std.image.image

Public Class HdrImage
    // Its pixels' Floats, 4 for each, red, green, blue, and alpha.
    Package Field Pixels: Float32[]
    Field Columns: Int
    Field Rows: Int

    // An image of width by height pixels, each transparent black. Panics when either is negative,
    // or there'd be more pixels than an HdrImage holds, 536870911.
    @PanicsAtCaller
    Public New(width: Int, height: Int)
        CheckSize(width, height)
        Columns = width
        Rows = height
        Pixels = []
        fb_image_blank_hdr(Pixels, (width * height * 4) As Int64)
    End New

    New(width: Int, height: Int, pixels: Float32[])
        Columns = width
        Rows = height
        Pixels = pixels
    End New

    // An image of width by height pixels whose Floats, 4 for each pixel, red, green, blue, and
    // alpha, are a copy of `values`. Panics when there aren't that many, or the size is one New
    // panics for.
    @PanicsAtCaller
    Public Static Method FromFloats(width: Int, height: Int, values: Float32[]): HdrImage
        CheckSize(width, height)
        If values.Count != width * height * 4
            Panic("an image of {width} by {height} pixels has {width * height * 4} Floats, not " +
                  "{values.Count}")
        End If

        Return HdrImage(width, height, values.Clone())
    End Method

    // An image of pixels the runtime made, which it keeps.
    Package Static Method Of(width: Int, height: Int, pixels: Float32[]): HdrImage
        Return HdrImage(width, height, pixels)
    End Method

    Public Property Width: Int
        Get => Columns
    End Property

    Public Property Height: Int
        Get => Rows
    End Property

    // The pixel `x` from the left and `y` from the top. Panics when it's outside the image.
    @PanicsAtCaller
    Operator [](x: Int, y: Int): Color
        Local at = FloatOf(x, y)
        Return Color(Pixels[at], Pixels[at + 1], Pixels[at + 2], Pixels[at + 3])
    End Operator

    // Gives the pixel `x` from the left and `y` from the top a color. Panics when it's outside
    // the image.
    @PanicsAtCaller
    Operator []=(x: Int, y: Int, color: Color)
        Local at = FloatOf(x, y)
        Pixels[at] = color.r
        Pixels[at + 1] = color.g
        Pixels[at + 2] = color.b
        Pixels[at + 3] = color.a
    End Operator

    // A copy of its pixels' Floats, 4 for each, red, green, blue, and alpha.
    Public Method ToFloats(): Float32[] => Pixels.Clone()

    // A new image of the same pixels.
    Public Method Clone(): HdrImage => HdrImage(Columns, Rows, Pixels.Clone())

    // An image's pixels in linear light, through sRGB's gamma, as Color32's ToColor gives them.
    Public Static Method FromImage(image: Image): HdrImage
        Local linear: Color[] = []
        For byte = 0 To 255
            linear.Add(Color32(byte As UInt8, 0, 0, byte As UInt8).ToColor())
        End For

        Local bytes = image.Pixels
        Local values: Float32[] = []
        values.Reserve(bytes.Count)
        For at = 0 Until bytes.Count Step 4
            values.Add(linear[bytes[at] As Int].r)
            values.Add(linear[bytes[at + 1] As Int].r)
            values.Add(linear[bytes[at + 2] As Int].r)
            values.Add(linear[bytes[at + 3] As Int].a)
        End For
        Return HdrImage(image.Width, image.Height, values)
    End Method

    // Its pixels in sRGB bytes, through sRGB's gamma, as Color's ToColor32 gives them: each kept
    // from 0 to 255, so what's brighter than white is white, and NaN taken as 0.
    Public Method ToImage(): Image
        Local bytes: UInt8[] = []
        bytes.Reserve(Pixels.Count)
        For at = 0 Until Pixels.Count Step 4
            Local color = Color(Pixels[at], Pixels[at + 1], Pixels[at + 2], Pixels[at + 3])
            Local srgb = color.ToColor32()
            bytes.Add(srgb.r)
            bytes.Add(srgb.g)
            bytes.Add(srgb.b)
            bytes.Add(srgb.a)
        End For
        Return Image.Of(Columns, Rows, bytes)
    End Method

    // Where the pixel's Floats start in Pixels. Panics when it's outside the image.
    @PanicsAtCaller
    Method FloatOf(x: Int, y: Int): Int
        If x < 0 || x >= Columns || y < 0 || y >= Rows
            Panic("pixel ({x}, {y}) is outside an image of {Columns} by {Rows}")
        End If

        Return (y * Columns + x) * 4
    End Method
End Class

Public Struct Hdr
    // Hdr isn't made: it's only its Static Methods.
    New()
    End New

    // The image in data, Radiance's RGBE, each pixel opaque. Throws an IOError of INVALID_DATA
    // when the data isn't an HDR image or is broken, and OTHER when the image has more pixels
    // than `limit`. Panics when the limit is negative.
    @PanicsAtCaller
    Public Static Method Decode(data: UInt8[], limit: Int = MOST_PIXELS): HdrImage Throws IOError
        CheckLimit(limit)
        Local image = fb_stb_decode(data, 6, Min(limit, MOST_PIXELS))
        Try CheckDecoded(image, "HDR")
        Local pixels: Float32[] = []
        fb_image_hdr_pixels(image, pixels)
        Local decoded = HdrImage.Of(fb_image_width(image) As Int, fb_image_height(image) As Int,
                                    pixels)
        fb_image_free(image)
        Return decoded
    End Method

    // The image in Radiance's RGBE, run-length encoded, without its alpha. Panics when it has no
    // pixels.
    @PanicsAtCaller
    Public Static Method Encode(image: HdrImage): UInt8[]
        CheckEncodable(image.Width, image.Height, 2147483647, "an HDR image")
        Local output: UInt8[] = []
        fb_stb_encode_hdr(image.Pixels, image.Width, image.Height, output)
        Return output
    End Method
End Struct
