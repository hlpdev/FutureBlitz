//! HDR: an HdrImage's pixels are light, linear, each RGBA as Floats, past 1 where they're brighter
//! than white, in a `Buffer<Float32>`, which Hdr reads from Radiance's RGBE files, as stb_image
//! reads them, and writes to them, run-length encoded, as stb_image_write does. RGBE has no alpha:
//! what Hdr.Decode gives is opaque, and Encode leaves the alpha out.

Import std.core
Import std.ffi
Import std.math.color
Import std.image.codec
Import std.image.image

/// A picture's pixels as light, linear, each RGBA as Floats, past 1 where they're brighter than
/// white.
Public Class HdrImage
    /// Its pixels' Floats, 4 for each, red, green, blue, and alpha.
    Field Memory: Buffer<Float32>
    Field Columns: Int
    Field Rows: Int

    /// An image of `width` by `height` pixels, each transparent black. Panics when either is
    /// negative, or there'd be more pixels than an HdrImage holds, 134217727, as many as stb_image
    /// reads of an HDR image.
    @PanicsAtCaller
    Public New(width: Int, height: Int)
        CheckHdrSize(width, height)
        Columns = width
        Rows = height
        Memory = Buffer<Float32>((width * height * 4) As Int64)
    End New

    New(width: Int, height: Int, pixels: Buffer<Float32>)
        Columns = width
        Rows = height
        Memory = pixels
    End New

    /// An image of `width` by `height` pixels whose Floats, 4 for each pixel, red, green, blue, and
    /// alpha, are a copy of `values`. Panics when there aren't that many, or the size is one New
    /// panics for.
    @PanicsAtCaller
    Public Static Method FromFloats(width: Int, height: Int, values: Float32[]): HdrImage
        CheckHdrSize(width, height)
        If values.Count != width * height * 4
            Panic("an image of {width} by {height} pixels has {width * height * 4} Floats, not " +
                  "{values.Count}")
        End If

        Return HdrImage(width, height, Buffer<Float32>.From(values))
    End Method

    /// An image of `width` by `height` `pixels` whose Floats, 4 for each pixel, red, green, blue,
    /// and alpha, are the Buffer's own, not a copy. Panics when the Buffer doesn't have that many,
    /// or the size is one New panics for.
    @PanicsAtCaller
    Public Static Method Over(width: Int, height: Int, pixels: Buffer<Float32>): HdrImage
        CheckHdrSize(width, height)
        If pixels.Count != width * height * 4
            Panic("an image of {width} by {height} pixels has {width * height * 4} Floats, not " +
                  "{pixels.Count}")
        End If

        Return HdrImage(width, height, pixels)
    End Method

    /// An image of pixels the runtime made, which it keeps.
    Package Static Method Of(width: Int, height: Int, pixels: Buffer<Float32>): HdrImage
        Return HdrImage(width, height, pixels)
    End Method

    /// Its pixels' Floats, 4 for each, red, green, blue, and alpha, in rows from the top: the
    /// image's own, not a copy, which C code can read and write through its Pointer.
    Public Property Pixels: Buffer<Float32>
        Get => Memory
    End Property

    /// How many pixels wide it is.
    Public Property Width: Int
        Get => Columns
    End Property

    /// How many pixels high it is.
    Public Property Height: Int
        Get => Rows
    End Property

    /// The pixel `x` from the left and `y` from the top. Panics when it's outside the image.
    @PanicsAtCaller
    Operator [](x: Int, y: Int): Color
        Local at = FloatOf(x, y)
        Return Color(Memory[at], Memory[at + 1], Memory[at + 2], Memory[at + 3])
    End Operator

    /// Gives the pixel `x` from the left and `y` from the top a color. Panics when it's outside
    /// the image.
    @PanicsAtCaller
    Operator []=(x: Int, y: Int, color: Color)
        Local at = FloatOf(x, y)
        Memory[at] = color.r
        Memory[at + 1] = color.g
        Memory[at + 2] = color.b
        Memory[at + 3] = color.a
    End Operator

    /// A copy of its pixels' Floats, 4 for each, red, green, blue, and alpha.
    Public Method ToFloats(): Float32[] => Memory.ToArray()

    /// A new image of the same pixels, in a Buffer of its own.
    Public Method Clone(): HdrImage => HdrImage(Columns, Rows, Copied(Memory))

    /// An image's pixels in linear light, through sRGB's gamma, as Color32's ToColor gives them.
    /// Panics when the `image` has more pixels than an HdrImage holds.
    @PanicsAtCaller
    Public Static Method FromImage(image: Image): HdrImage
        CheckHdrSize(image.Width, image.Height)
        Local linear: Color[] = []
        For byte = 0 To 255
            linear.Add(Color32(byte As UInt8, 0, 0, byte As UInt8).ToColor())
        End For

        Local bytes = image.Pixels
        Local values: Float32[] = []
        values.Reserve(bytes.Count As Int)
        For at = 0 Until bytes.Count Step 4
            values.Add(linear[bytes[at] As Int].r)
            values.Add(linear[bytes[at + 1] As Int].r)
            values.Add(linear[bytes[at + 2] As Int].r)
            values.Add(linear[bytes[at + 3] As Int].a)
        End For
        Return HdrImage(image.Width, image.Height, Buffer<Float32>.From(values))
    End Method

    /// Its pixels in sRGB bytes, through sRGB's gamma, as Color's ToColor32 gives them: each kept
    /// from 0 to 255, so what's brighter than white is white, and NaN taken as 0.
    Public Method ToImage(): Image
        Local bytes: UInt8[] = []
        bytes.Reserve(Memory.Count As Int)
        For at = 0 Until Memory.Count Step 4
            Local color = Color(Memory[at], Memory[at + 1], Memory[at + 2], Memory[at + 3])
            Local srgb = color.ToColor32()
            bytes.Add(srgb.r)
            bytes.Add(srgb.g)
            bytes.Add(srgb.b)
            bytes.Add(srgb.a)
        End For
        Return Image.Of(Columns, Rows, Buffer<UInt8>.From(bytes))
    End Method

    /// Where the pixel's Floats start in Memory. Panics when it's outside the image.
    @PanicsAtCaller
    Method FloatOf(x: Int, y: Int): Int
        If x < 0 || x >= Columns || y < 0 || y >= Rows
            Panic("pixel ({x}, {y}) is outside an image of {Columns} by {Rows}")
        End If

        Return (y * Columns + x) * 4
    End Method
End Class

/// Panics when an HdrImage of width by height pixels can't be: when either is negative, or there'd
/// be more pixels than it holds.
@PanicsAtCaller
Function CheckHdrSize(width: Int, height: Int)
    CheckSize(width, height)
    If width > 0 && height > MOST_HDR_PIXELS / width
        Panic("an HDR image of {width} by {height} has more pixels than an HdrImage holds, " +
              "{MOST_HDR_PIXELS}, as many as stb_image reads")
    End If
End Function

/// What reads and writes Radiance's RGBE files, in its Static Methods.
Public Struct Hdr
    /// Hdr isn't made: it's only its Static Methods.
    New()
    End New

    /// The image in `data`, Radiance's RGBE, each pixel opaque. Throws an IOError of INVALID_DATA
    /// when the `data` isn't an HDR image or is broken, and OTHER when the image has more pixels
    /// than `limit`. Panics when the `limit` is negative.
    @PanicsAtCaller
    Public Static Method Decode(data: UInt8[], limit: Int = MOST_PIXELS): HdrImage Throws IOError
        CheckLimit(limit)
        Local image = fb_stb_decode(data, 6, Min(limit, MOST_HDR_PIXELS))
        Try CheckDecoded(image, "HDR")
        Local pixels = Buffer<Float32>(fb_image_width(image) * fb_image_height(image) * 4)
        Unsafe
            fb_image_hdr_pixels(image, pixels.Pointer())
        End Unsafe
        Local decoded = HdrImage.Of(fb_image_width(image) As Int, fb_image_height(image) As Int,
                                    pixels)
        fb_image_free(image)
        Return decoded
    End Method

    /// The `image` in Radiance's RGBE, run-length encoded, without its alpha: a channel that's
    /// negative or NaN is 0, and one past the most RGBE holds, 255 times 2^119, about 1.69e38, is
    /// that most. Panics when it has no pixels.
    @PanicsAtCaller
    Public Static Method Encode(image: HdrImage): UInt8[]
        CheckEncodable(image.Width, image.Height, 2147483647, "an HDR image")
        Local output: UInt8[] = []
        Unsafe
            fb_stb_encode_hdr(image.Pixels.Pointer(), image.Width, image.Height, output)
        End Unsafe
        Return output
    End Method
End Struct
