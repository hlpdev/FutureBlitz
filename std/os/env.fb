//! Env, the environment's variables, which the program starts with and passes on to what it
//! starts: Get, Set, Unset, All, and Expand, which any thread can use, and Load, which sets those
//! a .env file names.

Import std.core
Import std.collections.map
Import std.data.text
Import std.io.file
Import std.io.path

Extern "runtime"
    Function fb_os_env_get(name: String): String?
    Function fb_os_env_set(name: String, value: String): Int32
    Function fb_os_env_unset(name: String): Int32
    Function fb_os_env_all(names: String[], values: String[])
End Extern

/// Env's Static Methods.
Public Struct Env
    /// Env isn't made: it's only its Static Methods.
    New()
    End New

    /// The variable name's value, or Null when it isn't set. On Windows a name is the same in any
    /// case, so "Path" is "PATH".
    Public Static Method Get(name: String): String? => fb_os_env_get(name)

    /// Sets the variable name to value. Panics when name is empty or has an '=' or a NUL, or
    /// value has a NUL, which no variable can.
    @PanicsAtCaller
    Public Static Method Set(name: String, value: String)
        Local result = fb_os_env_set(name, value)
        If result == 1 Then BadName("Set", name)
        If result == 2 Then Panic("Env.Set takes a value without a NUL")
    End Method

    /// Removes the variable name, when it's set. Panics when name can't be a variable's, as Set
    /// does.
    @PanicsAtCaller
    Public Static Method Unset(name: String)
        If fb_os_env_unset(name) == 1 Then BadName("Unset", name)
    End Method

    /// Every variable, by its name.
    Public Static Method All(): Map<String, String>
        Local names: String[] = []
        Local values: String[] = []
        fb_os_env_all(names, values)
        Local all: Map<String, String> = {}
        For i = 0 Until names.Count
            all[names[i]] = values[i]
        End For
        Return all
    End Method

    /// text with each $NAME and ${NAME} in it given its variable's value, or "" when it isn't set,
    /// and each $$ given as one '$'. A name is a letter or '_', then letters, digits, and '_'s, as
    /// long as it goes, and any other '$' stays as it is.
    Public Static Method Expand(text: String): String
        Local bytes = text.Bytes
        Local out: UInt8[] = []
        Local bad = -1
        Local at = 0
        While at < bytes.Count
            If bytes[at] == 36
                at = Dollar(bytes, at, bytes.Count, out, ByRef bad)
            Else
                out.Add(bytes[at])
                at += 1
            End If
        End While
        Return TextOf(out)
    End Method

    /// Sets the variables the .env file at path names, each in a line of its own, as NAME=value,
    /// with "export " before it or not, and blanks around the '=' or not. A line that's blank or
    /// starts with '#' is skipped. A value in 's is as it is, and one in "s can hold \n, \r, \t,
    /// \", \\, and \$, and both can go on over lines; one without them ends at its line's end, or
    /// at a '#' at its start or after a blank, which starts a comment, without the blanks before
    /// it. Only a comment can follow a quoted one. A value that isn't in 's is Expanded, its
    /// $NAMEs given what's set, the lines before it included. A variable that's already set is
    /// left as it is, unless replace is True; one the file names again takes its last value.
    /// Throws an IOError when the file can't be read, and a ParseError, with its line and column,
    /// for a line that isn't one of these, a quote that isn't closed, a ${ without a name and '}',
    /// or a value with a NUL, before any variable is set.
    Public Static Method Load(path: Path, replace: Bool = False) Throws IOError, ParseError
        Local bytes = (Try File.ReadText(path)).Bytes
        Try Read(bytes, False, replace)
        Try Read(bytes, True, replace)
    End Method

    /// Reads a .env file's lines, setting its variables when apply is True; without it, only
    /// throws what it would.
    Static Method Read(bytes: UInt8[], apply: Bool, replace: Bool) Throws ParseError
        Local loaded: Map<String, Bool> = {}
        Local at = 0
        If bytes.Count >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF Then at = 3
        While at < bytes.Count
            at = SkipBlanks(bytes, at, bytes.Count)
            If at < bytes.Count && bytes[at] != 35 && !IsBreak(bytes[at])
                at = Try Line(bytes, at, apply, replace, loaded)
            End If
            at = LineEnd(bytes, at)
            at += at + 1 < bytes.Count && bytes[at] == 13 && bytes[at + 1] == 10 ? 2 : 1
        End While
    End Method

    /// Reads the NAME=value at start, setting it when apply is, and returns where what follows
    /// it, its comment or its line's end, starts. loaded has the names this file has set.
    Static Method Line(bytes: UInt8[], start: Int, apply: Bool, replace: Bool,
                       loaded: Map<String, Bool>): Int Throws ParseError
        Local finish = LineEnd(bytes, start)
        Local at = start
        If finish - at > 7 && TextOf(bytes, at, at + 6) == "export" && IsBlank(bytes[at + 6])
            at = SkipBlanks(bytes, at + 7, finish)
        End If

        Local nameStart = at
        While at < finish && IsNamed(bytes[at], at == nameStart)
            at += 1
        End While
        If at == nameStart
            Throw ErrorAt(bytes, at, ParseErrorKind.SYNTAX,
                          "a line is NAME=value, a comment, or blank, and a name starts with a " +
                          "letter or '_'")
        End If

        Local name = TextOf(bytes, nameStart, at)
        at = SkipBlanks(bytes, at, finish)
        If at == finish || bytes[at] != 61
            Throw ErrorAt(bytes, at, ParseErrorKind.SYNTAX, "{name} is followed by '='")
        End If

        at = SkipBlanks(bytes, at + 1, finish)
        Local value: UInt8[] = []
        Local bad = -1
        If at < finish && (bytes[at] == 39 || bytes[at] == 34)
            Local quote = bytes[at]
            Local opened = at
            at += 1
            While True
                If at == bytes.Count
                    Throw ErrorAt(bytes, opened, ParseErrorKind.UNEXPECTED_END,
                                  "{name}'s value's quote isn't closed")
                End If

                Local b = bytes[at]
                If b == quote Then Break
                Local escaped: UInt8 = 0
                If quote == 34 && b == 92 && at + 1 < bytes.Count
                    escaped = Escaped(bytes[at + 1])
                End If
                If escaped != 0
                    value.Add(escaped)
                    at += 2
                ElseIf quote == 34 && b == 36
                    at = Dollar(bytes, at, bytes.Count, value, ByRef bad)
                Else
                    value.Add(b)
                    at += 1
                End If
            End While

            finish = LineEnd(bytes, at + 1)
            at = SkipBlanks(bytes, at + 1, finish)
            If at < finish && bytes[at] != 35
                Throw ErrorAt(bytes, at, ParseErrorKind.SYNTAX,
                              "only a comment can follow {name}'s quoted value")
            End If
        Else
            Local valueEnd = at
            While valueEnd < finish &&
                  !(bytes[valueEnd] == 35 && (valueEnd == at || IsBlank(bytes[valueEnd - 1])))
                valueEnd += 1
            End While
            While valueEnd > at && IsBlank(bytes[valueEnd - 1])
                valueEnd -= 1
            End While
            While at < valueEnd
                If bytes[at] == 36
                    at = Dollar(bytes, at, valueEnd, value, ByRef bad)
                Else
                    value.Add(bytes[at])
                    at += 1
                End If
            End While
        End If

        If bad >= 0
            Throw ErrorAt(bytes, bad, ParseErrorKind.SYNTAX, "a ${{ is followed by a name and '}}'")
        End If
        If value.Contains(0)
            Throw ErrorAt(bytes, nameStart, ParseErrorKind.SYNTAX,
                          "{name}'s value can't hold a NUL")
        End If

        If apply && (replace || loaded.Contains(name) || Get(name) == Null)
            Set(name, TextOf(value))
            loaded[name] = True
        End If
        Return at
    End Method

    /// Adds what the '$' at `at` stands for to out: $NAME's and ${NAME}'s value, or "" when it
    /// isn't set, $$'s '$', or else the '$' itself. Returns where what follows it starts. A ${
    /// without a name and '}' before finish is only a '$', and sets bad to where it is, when bad
    /// is still -1.
    Static Method Dollar(bytes: UInt8[], at: Int, finish: Int, out: UInt8[], ByRef bad: Int): Int
        Local next = at + 1
        If next < finish && bytes[next] == 36
            out.Add(36)
            Return at + 2
        End If

        Local braced = next < finish && bytes[next] == 123
        Local start = braced ? next + 1 : next
        Local stop = start
        While stop < finish && IsNamed(bytes[stop], stop == start)
            stop += 1
        End While
        If braced && (stop == start || stop == finish || bytes[stop] != 125)
            If bad < 0 Then bad = at
            out.Add(36)
            Return next
        End If
        If stop == start
            out.Add(36)
            Return next
        End If

        AddText(out, Get(TextOf(bytes, start, stop)) ?? "")
        Return braced ? stop + 1 : stop
    End Method

    /// The byte \b stands for in a value in "s, or 0 for one that's only a '\' and b.
    Static Method Escaped(b: UInt8): UInt8
        Select b
            Case 110
                Return 10
            Case 114
                Return 13
            Case 116
                Return 9
            Case 34, 92, 36
                Return b
            Default
                Return 0
        End Select
    End Method

    /// Whether b can be in a name, or start one when first is.
    Static Method IsNamed(b: UInt8, first: Bool): Bool
        Return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 ||
               (!first && b >= 48 && b <= 57)
    End Method

    /// Whether b is a space or a tab.
    Static Method IsBlank(b: UInt8): Bool => b == 32 || b == 9

    /// Whether b ends a line.
    Static Method IsBreak(b: UInt8): Bool => b == 10 || b == 13

    /// The first place from at before finish that isn't a blank.
    Static Method SkipBlanks(bytes: UInt8[], at: Int, finish: Int): Int
        Local skipped = at
        While skipped < finish && IsBlank(bytes[skipped])
            skipped += 1
        End While
        Return skipped
    End Method

    /// Where the line at `at` ends: its line break, or the end of bytes.
    Static Method LineEnd(bytes: UInt8[], at: Int): Int
        Local finish = at
        While finish < bytes.Count && !IsBreak(bytes[finish])
            finish += 1
        End While
        Return finish
    End Method
End Struct

@PanicsAtCaller
Function BadName(method: String, name: String)
    Panic("Env.{method} takes a name that isn't empty and has no '=' or NUL, not \"{name}\"")
End Function
