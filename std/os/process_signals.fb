//! Handling the interrupt and terminate signals.
//!
//! Process.OnInterrupt and Process.OnTerminate: handlers for the signals every OS has, which the
//! program then gets instead of ending at once, until its code is done.

Import std.core
Import std.os.process

Extern "runtime"
    Function fb_os_signal_watch(signal: Int32): Int64
    Function fb_os_signal_wait(signal: Int32, seen: Int64): Int64
End Extern

Extend Process
    /// Runs `handler` each time the program is interrupted, by Ctrl+C, or on Windows Ctrl+Break
    /// too, which then doesn't end it. A handler runs on a thread of its own, one at a time, and
    /// once more for the signals that come while it runs. Once the program's code is done, its
    /// coroutines too, none runs, and the signal ends the program again; a call from then on, as
    /// from a thread that runs on, does nothing. A coroutine that waits for nothing but what a
    /// `handler` may give, a TaskSource's Task, waits for the signal.
    ///
    /// # Examples
    ///
    /// ```fb no_run
    /// Global stopping = Atomic<Bool>(False)
    ///
    /// Function Stop()
    ///     stopping.Store(True)
    /// End Function
    ///
    /// Process.OnInterrupt(Stop)
    /// While !stopping.Load()
    ///     // Work, until Ctrl+C.
    /// End While
    /// ```
    Public Static Method OnInterrupt(handler: Sendable Func())
        Watch(1, handler)
    End Method

    /// Runs `handler` each time something asks the program to end, by SIGTERM or SIGHUP, or on
    /// Windows by closing its console, as OnInterrupt runs its handler. Windows still ends the
    /// program a few seconds after its console closes, and has no SIGTERM to send it. On Linux and
    /// macOS, a signal the program started out ignoring, as nohup has it ignore SIGHUP, stays
    /// ignored, for OnInterrupt too, and no handler runs for it.
    Public Static Method OnTerminate(handler: Sendable Func())
        Watch(2, handler)
    End Method
End Extend

/// Has handler run on a thread of its own for each `signal` that comes from now on, until the
/// program's code is done.
Function Watch(signal: Int32, handler: Sendable Func())
    Const seen = fb_os_signal_watch(signal)
    Thread.Start(Function()
        Local count = seen
        Loop
            count = fb_os_signal_wait(signal, count)
            If count == 0 Then Return
            handler()
        End Loop
    End Function)
End Function
