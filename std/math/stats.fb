// Statistics of numbers of any type, worked out in Doubles: the mean, the median, the variance and
// standard deviation of a sample and of a whole population, percentiles, and histograms. Too few
// values for what's asked panics, as Python's statistics raises.

Import std.core
Import std.collections
Import std.math.numbers
Import std.math.scalar

// The values as Doubles, sorted, which Median, Percentile, and Histogram go by. NaN, which no
// order places, panics, naming what.
@PanicsAtCaller
Function SortedDoubles<T: Bounded>(values: T[], what: String): Double[]
    Local sorted: Double[] = []
    sorted.Reserve(values.Count)
    For value In values
        Local x = T.DoubleValue(value)
        If x != x Then Panic("{what} takes values that aren't NaN, which no order places")
        sorted.Add(x)
    End For
    sorted.Sort()
    Return sorted
End Function

// Panics when there are fewer values than what's asked needs.
@PanicsAtCaller
Function CheckCount(what: String, count: Int, least: Int)
    If count < least
        Panic("{what} takes at least {least} value{least == 1 ? "" : "s"}, not {count}")
    End If
End Function

// The mean, the sum over the count. No values panics.
@PanicsAtCaller
Public Function Mean<T: Bounded>(values: T[]): Double
    CheckCount("Mean", values.Count, 1)
    Local sum: Double = 0
    For value In values
        sum += T.DoubleValue(value)
    End For
    Return sum / values.Count
End Function

// The middle value, or the mean of the two middle ones for an even count. No values, or a NaN,
// panics.
@PanicsAtCaller
Public Function Median<T: Bounded>(values: T[]): Double
    CheckCount("Median", values.Count, 1)
    Local sorted = SortedDoubles(values, "Median")
    Local middle = sorted.Count / 2
    If sorted.Count % 2 == 1 Then Return sorted[middle]
    Return Midpoint(sorted[middle - 1], sorted[middle])
End Function

// The mean and the sum of squared differences from it, by Welford's way, which stays exact where
// a sum of squares wouldn't.
Function Spread<T: Bounded>(values: T[]): (Double, Double)
    Local mean: Double = 0
    Local squares: Double = 0
    Local count = 0
    For value In values
        count++
        Local x = T.DoubleValue(value)
        Local difference = x - mean
        mean += difference / count
        squares += difference * (x - mean)
    End For
    Return (mean, squares)
End Function

// The variance of a sample, the squared differences from the mean over the count less 1, as an
// estimate of the variance of all it was drawn from. Fewer than two values panics.
@PanicsAtCaller
Public Function Variance<T: Bounded>(values: T[]): Double
    CheckCount("Variance", values.Count, 2)
    Return Spread(values).1 / (values.Count - 1)
End Function

// The standard deviation of a sample: the square root of its Variance. Fewer than two values
// panics.
@PanicsAtCaller
Public Function StdDev<T: Bounded>(values: T[]): Double
    CheckCount("StdDev", values.Count, 2)
    Return Sqrt(Variance(values))
End Function

// The variance of the values as the whole population: the squared differences from the mean over
// the count. No values panics.
@PanicsAtCaller
Public Function PopulationVariance<T: Bounded>(values: T[]): Double
    CheckCount("PopulationVariance", values.Count, 1)
    Return Spread(values).1 / values.Count
End Function

// The standard deviation of the values as the whole population: the square root of their
// PopulationVariance. No values panics.
@PanicsAtCaller
Public Function PopulationStdDev<T: Bounded>(values: T[]): Double
    CheckCount("PopulationStdDev", values.Count, 1)
    Return Sqrt(PopulationVariance(values))
End Function

// The value below which percent of them lie, from 0 for the least to 100 for the largest, between
// the two nearest when it falls between them, as NumPy's percentile does: 50 is the Median. No
// values, a NaN, or a percent outside 0 to 100, panics.
@PanicsAtCaller
Public Function Percentile<T: Bounded>(values: T[], percent: Double): Double
    CheckCount("Percentile", values.Count, 1)
    If !(percent >= 0 && percent <= 100)
        Panic("Percentile takes a percent from 0 to 100, not {percent}")
    End If

    Local sorted = SortedDoubles(values, "Percentile")
    Local rank = percent / 100 * (sorted.Count - 1)
    Local below = Floor(rank) As Int
    If below >= sorted.Count - 1 Then Return sorted[sorted.Count - 1]
    Return Between(sorted[below], sorted[below + 1], rank - below)
End Function

// The value t of the way from a to b, as NumPy's percentile works it out from their difference:
// a itself at t = 0 or where b is a, and their Midpoint at a half, as Median has it. Where the
// difference overflows, or an end is infinite, it's from each one's share, which can't overflow
// between finite ends and keeps an infinite one.
Function Between(a: Double, b: Double, t: Double): Double
    If t == 0 || a == b Then Return a
    If t == 0.5 Then Return Midpoint(a, b)
    Local difference = b - a
    If !IsFinite(difference) Then Return a * (1 - t) + b * t
    Return t < 0.5 ? a + difference * t : b - difference * (1 - t)
End Function

// The mean of two values, from their halves where their sum overflows.
Function Midpoint(a: Double, b: Double): Double
    Local sum = a + b
    If IsFinite(sum) || !IsFinite(a) || !IsFinite(b) Then Return sum / 2
    Return a / 2 + b / 2
End Function

// How many values fall in each of bins equal ranges from low to high, the last range holding high
// too; those outside, and NaN, are left out. A count of bins that isn't above 0, or a low that
// isn't below high, or isn't finite, panics.
@PanicsAtCaller
Public Function Histogram<T: Bounded>(values: T[], bins: Int, low: Double, high: Double): Int[]
    If bins <= 0 Then Panic("Histogram takes a count of bins above 0, not {bins}")
    If !(low < high) || !IsFinite(low) || !IsFinite(high)
        Panic("Histogram takes a finite low below a finite high, not {low} and {high}")
    End If

    Local counts: Int[] = []
    counts.Resize(bins, 0)
    Local edges = Edges(bins, low, high)
    For value In values
        Local x = T.DoubleValue(value)
        If !(x >= low && x <= high) Then Continue
        counts[BinOf(edges, x)]++
    End For
    Return counts
End Function

// The edges of bins equal ranges from low to high, from low to high itself: low + (high - low) i
// / bins, multiplied before it's divided, so an edge a Double holds is that edge exactly, and in
// halves where that overflows, which halving leaves the edges of, so a Double's whole range
// doesn't. Each is kept from below the one before.
Function Edges(bins: Int, low: Double, high: Double): Double[]
    Local edges: Double[] = [low]
    edges.Reserve(bins + 1)
    Local span = high - low
    Local half = high / 2 - low / 2
    For i = 1 Until bins
        Local edge = low + span * i / bins
        If !IsFinite(span * i)
            Local share = half * i
            edge = 2 * (low / 2 + (IsFinite(share) ? share / bins : half / bins * i))
        End If
        edges.Add(Max(edge, edges[i - 1]))
    End For
    edges.Add(high)
    Return edges
End Function

// The bin x, from low to high, falls in: the last whose lower edge isn't above it, the last bin
// holding high too.
Function BinOf(edges: Double[], x: Double): Int
    Local low = 0
    Local high = edges.Count - 2
    While low < high
        Local middle = (low + high + 1) / 2
        If edges[middle] <= x
            low = middle
        Else
            high = middle - 1
        End If
    End While
    Return low
End Function

// How many values fall in each of bins equal ranges from the least value to the largest, which
// all do. No values, a NaN, or a count of bins that isn't above 0, panics.
@PanicsAtCaller
Public Function Histogram<T: Bounded>(values: T[], bins: Int): Int[]
    CheckCount("Histogram", values.Count, 1)
    If bins <= 0 Then Panic("Histogram takes a count of bins above 0, not {bins}")
    Local sorted = SortedDoubles(values, "Histogram")
    Local low = sorted[0]
    Local high = sorted[sorted.Count - 1]
    If low == high
        Local counts: Int[] = []
        counts.Resize(bins, 0)
        counts[0] = values.Count
        Return counts
    End If
    Return Histogram(values, bins, low, high)
End Function
