/// Saturating arithmetic on UInt8s, which stops at the lowest and highest in place of overflowing.
Extend UInt8
    /// The sum, or the lowest or highest UInt8 in place of an overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// Expect((250 As UInt8).SaturatingAdd(10) == 255)
    /// Expect((5 As UInt8).SaturatingSubtract(10) == 0)
    /// ```
    Public Method SaturatingAdd(other: UInt8): UInt8 => Saturated(CheckedAdd(other), other < 0)

    /// The difference, or the lowest or highest UInt8 in place of an overflow.
    Public Method SaturatingSubtract(other: UInt8): UInt8
        Return Saturated(CheckedSubtract(other), other > 0)
    End Method

    /// The product, or the lowest or highest UInt8 in place of an overflow.
    Public Method SaturatingMultiply(other: UInt8): UInt8
        Return Saturated(CheckedMultiply(other), (Self < 0) != (other < 0))
    End Method
End Extend

