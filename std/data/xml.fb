// XML 1.0: a document's tree of XmlNodes, which Xml.Read builds over an XmlReader and Xml.Write
// writes over an XmlWriter, and Values to and from an element, as xmltodict has them: an
// element's attributes are keys with '@' before their names, its children keys of their names,
// an Array where a name comes more than once, and its text the key "#text", or the element's
// Value itself, a String, when it has neither attributes nor children.

Import std.core
Import std.collections
Import std.data.text
Import std.data.xml_reader
Import std.data.xml_path

// What an XmlNode is.
Public Enum XmlKind
    ELEMENT, TEXT, CDATA, COMMENT, INSTRUCTION, ATTRIBUTE
End Enum

// A node of an XML tree: an element, with a Name, Attributes, and Children; text, CDATA, or a
// comment, with its Content; a processing instruction, with its target as its Name and its
// Content; or an attribute, with its Name and value as its Content, as XmlPath selects one.
Public Class XmlNode Implements Printable
    Public ReadOnly Field Kind: XmlKind
    Public Field Name: String
    Public Field Content: String
    // An element's attributes, by name, in order.
    Public ReadOnly Field Attributes: Map<String, String>
    // An element's children, in order.
    Public ReadOnly Field Children: XmlNode[] = []
    // Its number in the document's order, which XmlPath's Query gives it.
    Package Field Mark: Int

    // A new element named name. Panics when name isn't an XML name.
    @PanicsAtCaller
    Public New(name: String)
        CheckName(name)
        Kind = XmlKind.ELEMENT
        Name = name
        Content = ""
        Attributes = {}
    End New

    Package New(kind: XmlKind, name: String, content: String)
        Kind = kind
        Name = name
        Content = content
        Attributes = {}
    End New

    // A node of text.
    Public Static Method NewText(text: String): XmlNode => XmlNode(XmlKind.TEXT, "", text)

    // A CDATA section of text.
    Public Static Method NewCData(text: String): XmlNode => XmlNode(XmlKind.CDATA, "", text)

    // A comment of text.
    Public Static Method NewComment(text: String): XmlNode => XmlNode(XmlKind.COMMENT, "", text)

    // A processing instruction for target. Panics when target isn't an XML name.
    @PanicsAtCaller
    Public Static Method NewInstruction(target: String, text: String): XmlNode
        CheckName(target)
        Return XmlNode(XmlKind.INSTRUCTION, target, text)
    End Method

    // Its text, as XPath's string() has it: an element's text and CDATA's, and its children's,
    // in order; and another node's Content.
    Public Property Text: String
        Get
            If Kind != XmlKind.ELEMENT Then Return Content
            Local out: UInt8[] = []
            AddValue(out)
            Return TextOf(out)
        End Get
    End Property

    // An element's attribute's value, or Null when it has none of that name.
    Public Method Attribute(name: String): String? => Attributes.Get(name)

    // Gives an element's attribute a value, adding it at the end when it's new. Panics when name
    // isn't an XML name.
    @PanicsAtCaller
    Public Method SetAttribute(name: String, value: String)
        CheckName(name)
        Attributes[name] = value
    End Method

    // An element's first child element named name, or Null.
    Public Method Element(name: String): XmlNode?
        For child In Children
            If child.Kind == XmlKind.ELEMENT && child.Name == name Then Return child
        End For
        Return Null
    End Method

    // An element's child elements, in order, or those named name when it isn't "".
    Public Method Elements(name: String = ""): XmlNode[]
        Local found: XmlNode[] = []
        For child In Children
            If child.Kind == XmlKind.ELEMENT && (name == "" || child.Name == name) Then found.Add(child)
        End For
        Return found
    End Method

    // Adds child at the end of an element's children, and gives it.
    Public Method Add(child: XmlNode): XmlNode
        Children.Add(child)
        Return child
    End Method

    // Adds a new element named name, and gives it. Panics when name isn't an XML name.
    @PanicsAtCaller
    Public Method AddElement(name: String): XmlNode => Add(XmlNode(name))

    // Adds text at the end of an element's children.
    Public Method AddText(text: String)
        Children.Add(XmlNode.NewText(text))
    End Method

    // The nodes path selects, from this one, in the document's order: XmlPath's subset of XPath
    // 1.0. Panics when path isn't one XmlPath reads.
    @PanicsAtCaller
    Public Method Query(path: String): XmlNode[] => XmlPath(path).Query(Self)

    // The first node path selects, or Null when it selects none. Panics as Query does.
    @PanicsAtCaller
    Public Method QueryFirst(path: String): XmlNode?
        Local found = XmlPath(path).Query(Self)
        Return found.Count > 0 ? found[0] : Null
    End Method

    // As XML, on one line: an element as Xml.Write writes it without the declaration, text with
    // its '&', '<', and '>' escaped, a CDATA section, a comment, a processing instruction, or an
    // attribute as name="value". Panics as Xml.Write does, at a node that holds what XML can't.
    @PanicsAtCaller
    Public Method ToString(): String
        If Kind == XmlKind.ELEMENT Then Return Xml.Write(Self, 0, False)
        Local writer = XmlWriter(0)
        writer.Loose = True
        If Kind == XmlKind.ATTRIBUTE
            writer.Out.AddAll(Name.Bytes)
            writer.Out.Add(61)
            writer.Quoted(Content)
        Else
            Xml.WriteNode(writer, Self)
        End If

        Return TextOf(writer.Out)
    End Method

    // Adds its text and CDATA's, and its children's, in order, to out, through a stack of the
    // elements open and their next children's indexes, however deep they go.
    Method AddValue(out: UInt8[])
        Local open: (XmlNode, Int)[] = [(Self, 0)]
        While open.Count > 0
            Local top = open.Count - 1
            Local node, index = open[top]
            If index >= node.Children.Count
                open.RemoveLast()
                Continue
            End If

            open[top] = (node, index + 1)
            Local child = node.Children[index]
            If child.Kind == XmlKind.ELEMENT
                open.Add((child, 0))
            ElseIf child.Kind == XmlKind.TEXT || child.Kind == XmlKind.CDATA
                out.AddAll(child.Content.Bytes)
            End If
        End While
    End Method

    // Whether an element's children hold text or CDATA that isn't empty.
    Method HoldsText(): Bool
        For child In Children
            If (child.Kind == XmlKind.TEXT || child.Kind == XmlKind.CDATA) && child.Content != ""
                Return True
            End If
        End For
        Return False
    End Method
End Class

Public Struct Xml
    // Xml isn't made: it's only its Static Methods.
    New()
    End New

    // The root element of the document text holds, its text, CDATA, comments, and processing
    // instructions its nodes; those outside it are left out. Throws a ParseError as XmlReader's
    // Next does.
    Public Static Method Read(text: String): XmlNode Throws ParseError
        Local reader = XmlReader(text)
        Local open: XmlNode[] = []
        Local root: XmlNode? = Null
        Loop
            Local event = Try reader.Next()
            If event == Null Then Break
            Local parent = open.Count > 0 ? open[open.Count - 1] : Null
            Select event.Kind
                Case XmlEventKind.START
                    Local element = XmlNode(XmlKind.ELEMENT, event.Name, "")
                    For key, value In event.Attributes
                        element.Attributes[key] = value
                    End For
                    If parent == Null
                        root = element
                    Else
                        parent.Children.Add(element)
                    End If

                    open.Add(element)
                Case XmlEventKind.END
                    open.RemoveLast()
                Case XmlEventKind.TEXT
                    If parent == Null Then Continue
                    Local count = parent.Children.Count
                    If count > 0 && parent.Children[count - 1].Kind == XmlKind.TEXT
                        Local last = parent.Children[count - 1]
                        last.Content = last.Content + event.Text
                    Else
                        parent.Children.Add(XmlNode(XmlKind.TEXT, "", event.Text))
                    End If
                Case XmlEventKind.CDATA
                    If parent != Null Then parent.Children.Add(XmlNode(XmlKind.CDATA, "",
                                                                       event.Text))
                Case XmlEventKind.COMMENT
                    If parent != Null Then parent.Children.Add(XmlNode(XmlKind.COMMENT, "",
                                                                       event.Text))
                Default
                    If parent != Null
                        parent.Children.Add(XmlNode(XmlKind.INSTRUCTION, event.Name, event.Text))
                    End If
            End Select
        End Loop
        Return root.Expect("XmlReader gives a document's root element")
    End Method

    // root as an XML document, the XML declaration first when declaration says so. An indent
    // above 0 puts each element on a line of its own, that many spaces in for each element it's
    // in, but for what's in an element that holds text, whose spaces are its own, so what's
    // written reads back as the same tree. Panics when root isn't an element, or a node holds
    // what XML can't, as XmlWriter's Methods say.
    @PanicsAtCaller
    Public Static Method Write(root: XmlNode, indent: Int = 2, declaration: Bool = True): String
        If root.Kind != XmlKind.ELEMENT Then Panic("an XML document's root is an element, not {root.Kind}")
        Local writer = XmlWriter(indent)
        If declaration Then writer.Declaration()
        WriteNode(writer, root)
        Return writer.Finish()
    End Method

    // Writes node, and an element's children, through a stack of the elements open and their next
    // children's indexes, however deep they go.
    @PanicsAtCaller
    Package Static Method WriteNode(writer: XmlWriter, node: XmlNode)
        If node.Kind != XmlKind.ELEMENT
            WriteLeaf(writer, node)
            Return
        End If

        StartNode(writer, node)
        Local open: (XmlNode, Int)[] = [(node, 0)]
        While open.Count > 0
            Local top = open.Count - 1
            Local element, index = open[top]
            If index >= element.Children.Count
                writer.EndElement()
                open.RemoveLast()
                Continue
            End If

            open[top] = (element, index + 1)
            Local child = element.Children[index]
            If child.Kind == XmlKind.ELEMENT
                StartNode(writer, child)
                open.Add((child, 0))
            Else
                WriteLeaf(writer, child)
            End If
        End While
    End Method

    // Starts element, with its attributes, saying whether it holds text from its start, so
    // nothing in it is indented.
    @PanicsAtCaller
    Static Method StartNode(writer: XmlWriter, element: XmlNode)
        writer.StartElement(element.Name)
        If element.HoldsText() Then writer.Mixed[writer.Mixed.Count - 1] = True
        For key, value In element.Attributes
            writer.Attribute(key, value)
        End For
    End Method

    // Writes a node that isn't an element.
    @PanicsAtCaller
    Static Method WriteLeaf(writer: XmlWriter, node: XmlNode)
        Select node.Kind
            Case XmlKind.TEXT
                writer.Text(node.Content)
            Case XmlKind.ATTRIBUTE
                writer.Text(node.Content)
            Case XmlKind.CDATA
                writer.CData(node.Content)
            Case XmlKind.COMMENT
                writer.Comment(node.Content)
            Default
                writer.Instruction(node.Name, node.Content)
        End Select
    End Method

    // element as a Value: an Object of its attributes, with '@' before their names, and its child
    // elements, by name, an Array of those of a name that comes more than once, and "#text" for
    // its text when it isn't only spaces; or its text, a String, when it has no attributes or
    // child elements. Comments and processing instructions are left out.
    Public Static Method ToValue(element: XmlNode): Value
        If IsLeaf(element) Then Return Value(element.Text)
        // Each element's Value goes in its parent's before it's filled, as a Value checks what's
        // put in it for itself, which then has nothing in it to look through. The elements being
        // filled are a stack, however deep they go.
        Local root = Value.Object()
        Local open: (XmlNode, Value)[] = [(element, root)]
        While open.Count > 0
            Local node, value = open.RemoveLast()
            For key, text In node.Attributes
                value["@" + key] = Value(text)
            End For

            // The names that come more than once are Arrays of their elements, in order.
            Local children = node.Elements()
            Local counts = Map<String, Int>()
            For child In children
                counts[child.Name] = counts.Get(child.Name, 0) + 1
            End For
            Local filled: (XmlNode, Value)[] = []
            For child In children
                Local item = IsLeaf(child) ? Value(child.Text) : Value.Object()
                If counts.Get(child.Name, 0) > 1
                    Local items = value[child.Name]
                    If items == Null
                        items = Value.Array()
                        value[child.Name] = items
                    End If

                    items.Add(item)
                Else
                    value[child.Name] = item
                End If

                If !IsLeaf(child) Then filled.Add((child, item))
            End For

            Local text = OwnText(node)
            Local spaces = True
            For b In text.Bytes
                If b != 32 && b != 9 && b != 10 && b != 13 Then spaces = False
            End For
            If !spaces Then value["#text"] = Value(text)
            For i = filled.Count - 1 To 0 Step -1
                open.Add(filled[i])
            End For
        End While
        Return root
    End Method

    // Whether an element has no attributes or child elements, so its Value is its text.
    Static Method IsLeaf(element: XmlNode): Bool
        If element.Attributes.Count > 0 Then Return False
        For child In element.Children
            If child.Kind == XmlKind.ELEMENT Then Return False
        End For
        Return True
    End Method

    // A new element named name of value, as ToValue gives a Value: an Object's keys with '@'
    // before them its attributes, "#text" its text, and the rest its child elements, an Array's
    // items each a child of its key's name; another Value its text, an integer's, a Double's, or a
    // Bool's as its text, and Null's none. Panics when name or a key isn't an XML name, an
    // attribute's value or "#text" is an Array or an Object, an Array's item is an Array, or
    // value is an Array.
    @PanicsAtCaller
    Public Static Method FromValue(name: String, value: Value): XmlNode
        If value.Kind == ValueKind.ARRAY
            Panic("an element is an Object or a value, not an Array, which is its key's elements")
        End If

        Local root = XmlNode(name)
        // The elements made but not filled, each with its Value, however deep they go.
        Local unfilled: (XmlNode, Value)[] = [(root, value)]
        While unfilled.Count > 0
            Local element, of = unfilled.RemoveLast()
            If of.Kind != ValueKind.OBJECT
                Local text = ScalarText(of)
                If text != "" Then element.AddText(text)
                Continue
            End If

            // Its children, made in order, and filled after, the first first.
            Local made: (XmlNode, Value)[] = []
            For key In of.Keys()
                Local item = EntryOf(of, key)
                Local bytes = key.Bytes
                If key == "#text"
                    element.AddText(ScalarText(item))
                ElseIf bytes.Count > 0 && bytes[0] == 64
                    element.SetAttribute(TextOf(bytes, 1, bytes.Count), ScalarText(item))
                ElseIf item.Kind == ValueKind.ARRAY
                    For part In ElementsOf(item)
                        If part.Kind == ValueKind.ARRAY
                            Panic("an Array's items are each an element, not an Array")
                        End If

                        made.Add((element.Add(XmlNode(key)), part))
                    End For
                Else
                    made.Add((element.Add(XmlNode(key)), item))
                End If
            End For
            For i = made.Count - 1 To 0 Step -1
                unfilled.Add(made[i])
            End For
        End While
        Return root
    End Method

    // A Value that isn't an Array or an Object as its text. Panics for those.
    @PanicsAtCaller
    Static Method ScalarText(value: Value): String
        Select value.Kind
            Case ValueKind.NULL
                Return ""
            Case ValueKind.BOOL
                Return value.AsBool() ?? False ? "true" : "false"
            Case ValueKind.INT
                Return "{value.AsInt64() ?? 0}"
            Case ValueKind.UINT
                Return "{value.AsUInt64() ?? 0}"
            Case ValueKind.DOUBLE
                Return "{value.AsDouble() ?? 0.0}"
            Case ValueKind.STRING
                Return value.AsString() ?? ""
            Default
                Panic("an attribute's value or an element's text is a String, a number, a Bool, " +
                      "or Null, not {value.Kind}")
        End Select
    End Method

    // An element's own text and CDATA, without its children's.
    Static Method OwnText(element: XmlNode): String
        Local out: UInt8[] = []
        For child In element.Children
            If child.Kind == XmlKind.TEXT || child.Kind == XmlKind.CDATA Then out.AddAll(child.Content.Bytes)
        End For
        Return TextOf(out)
    End Method
End Struct

// XmlWriter: XML written a part at a time, each element started, given its attributes, its
// content written, and ended, in order, into a String that Finish gives. An indent above 0 puts
// each element on a line of its own, but in an element that holds text, from its first text
// on, as a writer that goes a part at a time can't know of text to come.
Public Class XmlWriter
    Field Out: UInt8[] = []
    Field Indent: Int
    // The open elements' names, the innermost last, and whether each holds text.
    Field Open: String[] = []
    Field Mixed: Bool[] = []
    // Whether the last start tag's '>' isn't written yet, as its attributes can follow it.
    Field Tagged: Bool
    // Whether the innermost open element has content yet.
    Field Filled: Bool
    Field Rooted: Bool
    // The open start tag's attributes' names.
    Field Named: Set<String>
    // Whether text and the rest can be written outside an element, for an XmlNode's ToString.
    Package Field Loose: Bool

    // A writer that indents each element that many spaces for each it's in, or writes them on
    // one line for 0. Panics when indent is negative.
    @PanicsAtCaller
    Public New(indent: Int = 0)
        If indent < 0 Then Panic("an indent can't be negative, like {indent}")
        Indent = indent
        Named = Set<String>()
    End New

    // Writes `<?xml version="1.0" encoding="UTF-8"?>`. Panics after anything else is written.
    @PanicsAtCaller
    Public Method Declaration()
        If Out.Count > 0 Then Panic("the XML declaration comes before all else")
        AddText(Out, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>")
    End Method

    // Starts an element named name. Panics when name isn't an XML name, or the root element has
    // ended.
    @PanicsAtCaller
    Public Method StartElement(name: String)
        CheckName(name)
        If Open.Count == 0 && Rooted Then Panic("a document has one root element, which has ended")
        Content()
        Rooted = True
        Out.Add(60)
        AddText(Out, name)
        Open.Add(name)
        Mixed.Add(False)
        Tagged = True
        Filled = False
        Named.Clear()
    End Method

    // Gives the element just started an attribute. Panics when name isn't an XML name, it isn't
    // right after the start or another attribute, the element has an attribute of that name
    // already, or value holds a character XML hasn't got.
    @PanicsAtCaller
    Public Method Attribute(name: String, value: String)
        CheckName(name)
        If !Tagged Then Panic("an attribute comes right after its element's start")
        If Named.Contains(name)
            Panic("the element <{Open[Open.Count - 1]}> has an attribute {name} already")
        End If

        Named.Add(name)
        Out.Add(32)
        AddText(Out, name)
        Out.Add(61)
        Quoted(value)
    End Method

    // value in quotes, escaped as an attribute's value is. Panics when it holds a character XML
    // hasn't got.
    @PanicsAtCaller
    Package Method Quoted(value: String)
        Out.Add(34)
        For b In Checked(value).Bytes
            If b == 38
                AddText(Out, "&amp;")
            ElseIf b == 60
                AddText(Out, "&lt;")
            ElseIf b == 34
                AddText(Out, "&quot;")
            ElseIf b == 9
                AddText(Out, "&#9;")
            ElseIf b == 10
                AddText(Out, "&#10;")
            ElseIf b == 13
                AddText(Out, "&#13;")
            Else
                Out.Add(b)
            End If
        End For
        Out.Add(34)
    End Method

    // Writes text in the open element. Panics outside one, or when text holds a character XML
    // hasn't got.
    @PanicsAtCaller
    Public Method Text(text: String)
        If Open.Count == 0 && !Loose Then Panic("text goes in an element")
        If text == "" Then Return
        CloseTag()
        If Open.Count > 0 Then Mixed[Mixed.Count - 1] = True
        Filled = True
        For b In Checked(text).Bytes
            If b == 38
                AddText(Out, "&amp;")
            ElseIf b == 60
                AddText(Out, "&lt;")
            ElseIf b == 62
                AddText(Out, "&gt;")
            ElseIf b == 13
                AddText(Out, "&#13;")
            Else
                Out.Add(b)
            End If
        End For
    End Method

    // Writes a CDATA section of text in the open element, one more each time text holds "]]>",
    // whose "]]" ends one and '>' starts the next. Panics outside an element, or when text holds
    // a character XML hasn't got.
    @PanicsAtCaller
    Public Method CData(text: String)
        If Open.Count == 0 && !Loose Then Panic("a CDATA section goes in an element")
        CloseTag()
        If Open.Count > 0 Then Mixed[Mixed.Count - 1] = True
        Filled = True
        AddText(Out, "<![CDATA[")
        Local bytes = Checked(text).Bytes
        Local i = 0
        While i < bytes.Count
            If bytes[i] == 93 && i + 2 < bytes.Count && bytes[i + 1] == 93 && bytes[i + 2] == 62
                AddText(Out, "]]]]><![CDATA[>")
                i += 3
                Continue
            End If

            Out.Add(bytes[i])
            i += 1
        End While
        AddText(Out, "]]>")
    End Method

    // Writes a comment. Panics when text holds "--", ends with '-', or holds a character XML
    // hasn't got.
    @PanicsAtCaller
    Public Method Comment(text: String)
        Local bytes = Checked(text).Bytes
        For i = 0 Until bytes.Count
            If bytes[i] == 45 && (i + 1 == bytes.Count || bytes[i + 1] == 45)
                Panic("a comment can't hold \"--\", or end with '-'")
            End If
        End For
        Content()
        AddText(Out, "<!--")
        Out.AddAll(bytes)
        AddText(Out, "-->")
    End Method

    // Writes a processing instruction. Panics when target isn't an XML name or is xml, or text
    // holds "?>" or a character XML hasn't got.
    @PanicsAtCaller
    Public Method Instruction(target: String, text: String)
        CheckName(target)
        Local lower = target.Bytes
        If lower.Count == 3 && (lower[0] | 32) == 120 && (lower[1] | 32) == 109 &&
           (lower[2] | 32) == 108
            Panic("a processing instruction can't be named xml")
        End If

        Local bytes = Checked(text).Bytes
        For i = 0 Until bytes.Count - 1
            If bytes[i] == 63 && bytes[i + 1] == 62 Then Panic("a processing instruction can't hold \"?>\"")
        End For
        Content()
        AddText(Out, "<?")
        AddText(Out, target)
        If bytes.Count > 0
            Out.Add(32)
            Out.AddAll(bytes)
        End If

        AddText(Out, "?>")
    End Method

    // Ends the open element, as `<name/>` when it's empty. Panics when none is open.
    @PanicsAtCaller
    Public Method EndElement()
        If Open.Count == 0 Then Panic("no element is open to end")
        Local name = Open.RemoveLast()
        Local mixed = Mixed.RemoveLast()
        If Tagged
            AddText(Out, "/>")
            Tagged = False
        Else
            If !mixed Then NewLine(Open.Count)
            AddText(Out, "</")
            AddText(Out, name)
            Out.Add(62)
        End If

        Filled = True
    End Method

    // What was written. Panics when an element is open, or none was written.
    @PanicsAtCaller
    Public Method Finish(): String
        If Open.Count > 0 Then Panic("the element <{Open[Open.Count - 1]}> isn't ended")
        If !Rooted Then Panic("a document has a root element, and none was written")
        Return TextOf(Out)
    End Method

    // Before content: the open start tag's '>', and a new line where the indent puts one.
    Method Content()
        CloseTag()
        If Open.Count > 0 && Mixed[Mixed.Count - 1] Then Return
        If Out.Count > 0 Then NewLine(Open.Count)
    End Method

    Method CloseTag()
        If !Tagged Then Return
        Out.Add(62)
        Tagged = False
    End Method

    // A line break and depth indents, when the indent is above 0.
    Method NewLine(depth: Int)
        If Indent == 0 Then Return
        Out.Add(10)
        For i = 1 To depth * Indent
            Out.Add(32)
        End For
    End Method

    // text, panicking when it holds a character XML hasn't got.
    @PanicsAtCaller
    Static Method Checked(text: String): String
        For c In text.Chars
            Local code = c As Int
            If !IsXmlChar(code) Then Panic("XML can't hold the character U+{HexOf(code, 4)}")
        End For
        Return text
    End Method
End Class

// Panics when name isn't an XML name.
@PanicsAtCaller
Function CheckName(name: String)
    If !IsXmlName(name) Then Panic("\"{name}\" isn't an XML name")
End Function
