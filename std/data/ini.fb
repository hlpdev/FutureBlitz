//! Ini: INI files' sections of keys and values, read into an Object and written from one. Each
//! line, which ends with LF, CRLF, or a CR alone, is a `[section]` header, a `key = value` or
//! `key: value`, a comment, which starts with ';' or '#', or blank. A key and its value have the
//! spaces around them trimmed, and a value in '"'s keeps the spaces inside them, without the '"'s.
//! The keys before any section are the Object's own, as Strings, and each section is an Object of
//! its keys' values, as Strings. INI has no standard; this is the form most programs read.

Import std.core
Import std.collections
Import std.data.text

/// What reads and writes INI files, in its Static Methods.
Public Struct Ini
    /// Ini isn't made: it's only its Static Methods.
    New()
    End New

    /// The keys and sections text holds. A key given again in a section takes its new value, and
    /// a section named again goes on adding to the first. Throws a ParseError of SYNTAX, with its
    /// line and column, for a line that's none of the four, a key that's empty, a header that
    /// doesn't end with ']', or a section named as a key before it is.
    Public Static Method Read(text: String): Value Throws ParseError
        Local bytes = text.Bytes
        Local at = 0
        If bytes.Count >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF Then at = 3
        Local document = Value.Object()
        Local section = document
        While at < bytes.Count
            Local start = at
            While at < bytes.Count && bytes[at] != 10 && bytes[at] != 13
                at += 1
            End While
            Local finish = at
            at += at + 1 < bytes.Count && bytes[at] == 13 && bytes[at + 1] == 10 ? 2 : 1
            Local first = SkipSpace(bytes, start, finish)
            Local last = TrimEnd(bytes, first, finish)
            If first == last || bytes[first] == 59 || bytes[first] == 35 Then Continue

            If bytes[first] == 91
                If bytes[last - 1] != 93
                    Throw ErrorAt(bytes, last, ParseErrorKind.SYNTAX,
                                  "a section's header ends with ']'")
                End If

                Local name = TextOf(bytes, SkipSpace(bytes, first + 1, last - 1),
                                    TrimEnd(bytes, first + 1, last - 1))
                Local found = document[name]
                If found == Null
                    found = Value.Object()
                    document[name] = found
                ElseIf found.Kind != ValueKind.OBJECT
                    Throw ErrorAt(bytes, first, ParseErrorKind.SYNTAX,
                                  "the section [{name}] is named as a key before it")
                End If

                section = found
                Continue
            End If

            Local equals = first
            While equals < last && bytes[equals] != 61 && bytes[equals] != 58
                equals += 1
            End While
            If equals == last
                Throw ErrorAt(bytes, first, ParseErrorKind.SYNTAX,
                              "a line is a [section], a key = value, or a comment")
            End If

            Local keyEnd = TrimEnd(bytes, first, equals)
            If keyEnd == first
                Throw ErrorAt(bytes, equals, ParseErrorKind.SYNTAX,
                              "a key is missing before its '='")
            End If

            Local key = TextOf(bytes, first, keyEnd)
            Local before = section[key]
            If before != Null && before.Kind == ValueKind.OBJECT
                Throw ErrorAt(bytes, first, ParseErrorKind.SYNTAX,
                              "the key {key} is named as a section before it")
            End If

            Local valueStart = SkipSpace(bytes, equals + 1, last)
            Local valueEnd = last
            If valueEnd - valueStart >= 2 && bytes[valueStart] == 34 && bytes[valueEnd - 1] == 34
                valueStart += 1
                valueEnd -= 1
            End If

            section[key] = Value(TextOf(bytes, valueStart, valueEnd))
        End While
        Return document
    End Method

    /// value, an Object, as INI: its own keys whose values aren't Objects, then a section for each
    /// Object in it, of its keys. A String is written as it is, in '"'s when it starts or ends with
    /// a space, a tab, or a '"', a Bool, an integer, or a Double as its text, and Null as nothing.
    /// Panics at what Read wouldn't read back as the same: when value isn't an Object, a section
    /// holds an Object or anything holds an Array, a key is empty, holds '=', ':', or a line break,
    /// starts with '[', ';', '#', or a byte order mark, or starts or ends with a space or a tab, a
    /// section's name holds ']' or a line break or starts or ends with a space or a tab, or a value
    /// holds a line break.
    @PanicsAtCaller
    Public Static Method Write(value: Value): String
        If value.Kind != ValueKind.OBJECT Then Panic("an INI file is an Object, not {value.Kind}")
        Local out: UInt8[] = []
        For key In value.Keys()
            Local item = EntryOf(value, key)
            If item.Kind != ValueKind.OBJECT Then AddEntry(out, key, item)
        End For

        For key In value.Keys()
            Local section = EntryOf(value, key)
            If section.Kind != ValueKind.OBJECT Then Continue
            Local header = key.Bytes
            For b In header
                If b == 93 || b == 10 || b == 13
                    Panic("an INI section's name can't hold ']' or a line break, as \"{key}\" does")
                End If
            End For
            If header.Count > 0 && (IsBlank(header[0]) || IsBlank(header[header.Count - 1]))
                Panic("an INI section's name can't start or end with a space or a tab, as " +
                      "\"{key}\" does")
            End If

            If out.Count > 0 Then out.Add(10)
            AddText(out, "[" + key + "]\n")
            For name In section.Keys()
                Local item = EntryOf(section, name)
                If item.Kind == ValueKind.OBJECT
                    Panic("an INI section holds keys and their values, not the Object {name}")
                End If

                AddEntry(out, name, item)
            End For
        End For
        Return TextOf(out)
    End Method

    /// Adds `key = value` on its line.
    @PanicsAtCaller
    Static Method AddEntry(out: UInt8[], key: String, value: Value)
        Local bytes = key.Bytes
        Local bad = bytes.Count == 0 || bytes[0] == 91 || bytes[0] == 59 || bytes[0] == 35 ||
                    IsBlank(bytes[0]) || IsBlank(bytes[bytes.Count - 1]) ||
                    (bytes.Count >= 3 && bytes[0] == 0xEF && bytes[1] == 0xBB && bytes[2] == 0xBF)
        For b In bytes
            If b == 61 || b == 58 || b == 10 || b == 13 Then bad = True
        End For
        If bad
            Panic("an INI key isn't empty, doesn't start with '[', ';', '#', or a byte order " +
                  "mark, doesn't start or end with a space or a tab, and holds no '=', ':', or " +
                  "line break, as \"{key}\" does")
        End If

        Local text = ""
        Select value.Kind
            Case ValueKind.NULL
                text = ""
            Case ValueKind.BOOL
                text = value.AsBool() ?? False ? "true" : "false"
            Case ValueKind.INT
                text = "{value.AsInt64() ?? 0}"
            Case ValueKind.UINT
                text = "{value.AsUInt64() ?? 0}"
            Case ValueKind.DOUBLE
                text = "{value.AsDouble() ?? 0.0}"
            Case ValueKind.STRING
                text = value.AsString() ?? ""
            Default
                Panic("an INI value is a String, a number, a Bool, or Null, not {value.Kind}")
        End Select

        Local valueBytes = text.Bytes
        For b In valueBytes
            If b == 10 || b == 13 Then Panic("an INI value can't hold a line break, as {key}'s does")
        End For

        Local quoted = valueBytes.Count > 0 &&
                       (valueBytes[0] == 32 || valueBytes[0] == 9 || valueBytes[0] == 34 ||
                        valueBytes[valueBytes.Count - 1] == 32 ||
                        valueBytes[valueBytes.Count - 1] == 9 ||
                        valueBytes[valueBytes.Count - 1] == 34)
        If valueBytes.Count == 0
            AddText(out, key + " =\n")
        Else
            AddText(out, key + " = " + (quoted ? "\"" + text + "\"" : text) + "\n")
        End If
    End Method

    /// Whether b is a space or a tab, which Read trims.
    Static Method IsBlank(b: UInt8): Bool => b == 32 || b == 9

    /// The first place from start before finish that isn't a space or tab.
    Static Method SkipSpace(bytes: UInt8[], start: Int, finish: Int): Int
        Local at = start
        While at < finish && (bytes[at] == 32 || bytes[at] == 9)
            at += 1
        End While
        Return at
    End Method

    /// Where the spaces and tabs at the end of start up to finish start.
    Static Method TrimEnd(bytes: UInt8[], start: Int, finish: Int): Int
        Local at = finish
        While at > start && (bytes[at - 1] == 32 || bytes[at - 1] == 9)
            at -= 1
        End While
        Return at
    End Method
End Struct
