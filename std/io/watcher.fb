//! Watching files and folders for changes.
//!
//! std.io's file watcher: what happens to a file, or to what's in a folder, as the OS tells libuv,
//! which a FileWatcher queues for the program to take in turn, waiting for it, awaiting it, or
//! not.
//!
//! # Examples
//!
//! ```
//! # Import std.time
//! Local folder = Try TempDir()
//! Local watcher = Try FileWatcher(folder.Path)
//! Try File.WriteText(folder.Path / "a.txt", "new")
//! // The OS tells of a change soon after it; TryNext doesn't wait for it, as Next would.
//! Local event = watcher.TryNext()
//! Local tries = 0
//! While event == Null && tries < 500
//!     Sleep(10.Milliseconds)
//!     event = watcher.TryNext()
//!     tries += 1
//! End While
//!
//! Expect(event != Null)
//! watcher.Close()
//! Try folder.Close()
//! ```

Import std.core
Import std.io.path
Import std.io.request

Extern "runtime"
    Function fb_io_watcher_new(path: String, recursive: Int32): Ptr<Void>
    Function fb_io_watcher_error(watcher: Ptr<Void>): Int64
    Function fb_io_watcher_next(watcher: Ptr<Void>, wait: Int32): Int32
    Function fb_io_watcher_wait_async(watcher: Ptr<Void>): Task<Int64>
    Function fb_io_watcher_kind(watcher: Ptr<Void>): Int32
    Function fb_io_watcher_path(watcher: Ptr<Void>): String
    Function fb_io_watcher_close(watcher: Ptr<Void>)
    Function fb_io_watcher_free(watcher: Ptr<Void>)
End Extern

/// What happened at a path, which a watcher tells by the names it knows are there, since OSes call
/// these differently.
Public Enum FileEventKind
    /// Something came there, as the new name of a rename does.
    CREATED
    /// It changed, as a file that another is renamed over does.
    CHANGED
    /// It went, as the old name of a rename does.
    REMOVED
End Enum

/// What happened, and where.
Public Struct FileEvent
    /// What happened.
    Public ReadOnly Field Kind: FileEventKind
    /// The file or folder it happened to: the watcher's Path joined with where it is from there,
    /// like `assets/art/hero.png` in a recursive watcher of `assets`.
    Public ReadOnly Field Path: Path

    Package New(kind: FileEventKind, path: Path)
        Kind = kind
        Path = path
    End New
End Struct

/// Watches a file, or what's in a folder, and a recursive one what's in the folders in it too,
/// and theirs, from when it's made until it's closed or its last reference goes. An OS can tell
/// of one change more than once, as when a write comes in parts, and of a change it makes itself,
/// as of a folder's times. A watched file or folder that's removed may go unwatched on some OSes,
/// even once it's back.
///
/// # Examples
///
/// ```fb no_run
/// Local watcher = Try FileWatcher(Path("assets"), recursive: True)
/// Local event = watcher.Next()
/// While event != Null
///     Print("{event.Kind}: {event.Path}")
///     event = watcher.Next()
/// End While
/// ```
Public Class FileWatcher
    /// The file or folder it watches.
    Public ReadOnly Field Path: Path
    /// Whether it watches the folders in its folder too, and theirs.
    Public ReadOnly Field Recursive: Bool
    /// The runtime's watcher, which keeps whether it's closed, so no Field of this one changes
    /// once it's made.
    ReadOnly Field Native: Ptr<Void>

    /// Starts watching what's at the `path`, which has to be there. With `recursive`, a folder's
    /// watcher watches the folders in it too, and theirs, the ones that come later as well, but
    /// not through links. A folder that comes brings a CREATED for each thing in it, and one that
    /// goes a REMOVED for each it had, what's in a folder before it. A file's watcher is the same
    /// either way. On Linux, which watches each folder apart, a tree with more folders than
    /// inotify watches, as `fs.inotify.max_user_watches` says, is an IOError, and a folder that
    /// comes past that goes unwatched.
    Public New(path: Path, recursive: Bool = False) Throws IOError
        Path = path
        Recursive = recursive
        Native = fb_io_watcher_new(path.Text, recursive As Int32)
        Local error = fb_io_watcher_error(Native)
        If error != 0
            fb_io_watcher_free(Native)
            Throw ErrorOf(error, "watch", path)
        End If
    End New

    /// The next event, waiting for it, or Null once it's closed. Nothing else runs on this thread
    /// meanwhile, so one that nothing comes to waits forever.
    Public Method Next(): FileEvent? => Taken(1)

    /// The next event if one's come, or Null.
    Public Method TryNext(): FileEvent? => Taken(0)

    /// Next's Async twin, which waits on the main thread instead of blocking it.
    Public Async Method NextAsync(): FileEvent?
        Loop
            Local taken = Taken(0)
            If taken != Null Then Return taken
            If (Await fb_io_watcher_wait_async(Native)) == 0 Then Return Taken(0)
        End Loop
    End Method

    /// Stops watching, dropping the events not taken, so what waits for one, and each Next,
    /// gets Null. A second Close does nothing.
    Public Method Close()
        fb_io_watcher_close(Native)
    End Method

    Method Destroy()
        fb_io_watcher_free(Native)
    End Method

    /// The next event, waiting for one unless `wait` is 0.
    Method Taken(wait: Int32): FileEvent?
        If fb_io_watcher_next(Native, wait) == 0 Then Return Null
        Return EventOf(Native, Path.Style)
    End Method
End Class

/// The event a watcher took last, with a path of `style`.
Function EventOf(watcher: Ptr<Void>, style: PathStyle): FileEvent
    Local kind = EventKindOf(fb_io_watcher_kind(watcher))
    Return FileEvent(kind, Path(fb_io_watcher_path(watcher), style))
End Function

Function EventKindOf(number: Int32): FileEventKind
    Select number
        Case 0
            Return FileEventKind.CREATED
        Case 1
            Return FileEventKind.CHANGED
        Default
            Return FileEventKind.REMOVED
    End Select
End Function
