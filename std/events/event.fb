// Event<T>: the handlers that an Emit calls, in the order they were added, held as a Field of
// what emits it, which holds them until they're cancelled. Subscribe gives a Subscription, whose
// Cancel takes its handler off; a handler subscribed for an owner, which it holds weakly, also
// goes once the owner does. An Event and its Subscriptions stay on the thread that made them, as a
// Class's objects do.

Import std.core
Import std.collections.array

// What a Subscription cancels: a handler's place on its Event.
Abstract Class Subscribed
    // Takes the handler off its Event, unless it's off already.
    Abstract Method Drop()

    // Whether the handler is still on its Event.
    Abstract ReadOnly Property IsActive: Bool
End Class

// A handler on an Event, which an Emit calls until it's dropped.
Abstract Class EventHandler<T> Extends Subscribed
    Field On: Bool = True
    Field Emitter: Weak<Event<T>>

    New(event: Event<T>)
        Emitter = event
    End New

    // Calls the handler with value.
    Abstract Method Handle(value: T)

    // Lets go of the handler.
    Abstract Method Release()

    // The handler goes once its Event has counted it off, so what its going runs, like a Destroy
    // that cancels it again, finds it off.
    Override Method Drop()
        If !On Then Return
        On = False
        Emitter?.Dropped()
        Release()
    End Method

    Override Property IsActive: Bool
        Get => On
    End Property
End Class

// A handler that Subscribe(handler) adds.
Class FuncHandler<T> Extends EventHandler<T>
    Field Handler: (Func(T))?

    New(handler: Func(T), event: Event<T>)
        Super.New(event)
        Handler = handler
    End New

    Override Method Handle(value: T)
        Local handler = Handler
        If handler != Null Then handler(value)
    End Method

    Override Method Release()
        Handler = Null
    End Method
End Class

// A handler that Subscribe(owner, handler) adds, which holds its owner weakly and gives it to the
// handler, so the handler needn't capture it. Once the owner goes, it's off.
Class OwnedHandler<T, O> Extends EventHandler<T>
    Where O: Class
    Field Owner: Weak<O>
    Field Handler: (Func(O, T))?

    New(owner: O, handler: Func(O, T), event: Event<T>)
        Super.New(event)
        Owner = owner
        Handler = handler
    End New

    // Calls the handler with the owner and value, or drops it once the owner is gone.
    Override Method Handle(value: T)
        Local owner = Owner
        Local handler = Handler
        If owner == Null
            Drop()
        ElseIf handler != Null
            handler(owner, value)
        End If
    End Method

    Override Method Release()
        Handler = Null
    End Method

    Override Property IsActive: Bool
        Get => On && Owner != Null
    End Property
End Class

Public Class Event<T>
    Field Handlers: EventHandler<T>[] = []
    // How many Emits are calling handlers now, and Clears dropping them. The ones dropped
    // meanwhile are taken out once the last is done, so the Emits go over the handlers as they
    // were, and a Clear takes them all out at once.
    Field Emitting: Int
    // How many dropped handlers are still in Handlers.
    Field Stale: Int
    // How many handlers there were when Subscribe last took out those whose owners have gone.
    Field Looked: Int

    Public New()
    End New

    // How many handlers it has: those not cancelled, whose owners, if they have them, are there.
    Public Property Count: Int
        Get
            Local count = 0
            For handler In Handlers
                If handler.IsActive Then count += 1
            End For
            Return count
        End Get
    End Property

    // Adds handler, which each Emit after this calls, after the handlers added before it, until
    // the Subscription it gives is cancelled. An Emit that's calling handlers meanwhile doesn't.
    Public Method Subscribe(handler: Func(T)): Subscription
        TakeOutGone()
        Local added = FuncHandler<T>(handler, Self)
        Handlers.Add(added)
        Return Subscription(added)
    End Method

    // Adds handler for owner, which it's called with, after the handlers added before it, until the
    // Subscription it gives is cancelled or the owner goes, as the handler holds it weakly. The
    // handler gets the owner, so it needn't capture it, which would keep it: a handler that
    // captures its owner keeps it as long as the Event keeps the handler. The next Emit or Clear
    // after the owner goes takes the handler out, as a Subscribe does now and then.
    Public Method Subscribe<O: Class>(owner: O, handler: Func(O, T)): Subscription
        TakeOutGone()
        Local added = OwnedHandler<T, O>(owner, handler, Self)
        Handlers.Add(added)
        Return Subscription(added)
    End Method

    // Calls each handler with value, in the order they were added. A handler added meanwhile
    // waits for the next Emit, and one cancelled meanwhile, by a handler before it, isn't called.
    Public Method Emit(value: T)
        Local count = Handlers.Count
        Emitting += 1
        For i = 0 Until count
            Local handler = Handlers[i]
            If handler.On Then handler.Handle(value)
        End For

        Emitting -= 1
        If Emitting == 0 && Stale > 0 Then TakeOutDropped()
    End Method

    // Takes every handler off, as their Subscriptions' Cancel would, and out at once at the end, as
    // an Emit does.
    Public Method Clear()
        Emitting += 1
        For handler In Handlers.Clone()
            handler.Drop()
        End For

        Emitting -= 1
        If Emitting == 0 && Stale > 0 Then TakeOutDropped()
    End Method

    // A handler was dropped, which goes now, or once the Emits calling handlers are done.
    Method Dropped()
        Stale += 1
        If Emitting == 0 Then TakeOutDropped()
    End Method

    Method TakeOutDropped()
        Handlers.RemoveAll(Function(handler: EventHandler<T>) => !handler.On)
        Stale = 0
    End Method

    // Drops and takes out the handlers whose owners have gone, once there are twice as many
    // handlers as when it last did, so an Event subscribed to for owners that go, which never
    // emits, doesn't grow without end, and Subscribe stays quick.
    Method TakeOutGone()
        If Emitting > 0 || Handlers.Count < Looked * 2 Then Return
        Emitting += 1
        For handler In Handlers.Clone()
            If !handler.IsActive Then handler.Drop()
        End For

        Emitting -= 1
        If Stale > 0 Then TakeOutDropped()
        Looked = Handlers.Count
    End Method
End Class

// A handler's place on an Event, which Cancel takes it off. It holds neither the Event nor the
// handler, so keeping one keeps neither.
Public Class Subscription
    Field Entry: Weak<Subscribed>

    New(entry: Subscribed)
        Entry = entry
    End New

    // Takes the handler off its Event, so no Emit after calls it, and lets go of it. Cancelling
    // it again, or once the Event has gone, does nothing.
    Public Method Cancel()
        Entry?.Drop()
    End Method

    // Whether the handler is still on its Event.
    Public Property IsActive: Bool
        Get => Entry?.IsActive ?? False
    End Property
End Class
