//! Connections between programs on one machine.
//!
//! std.net's IPC: IpcListener, which takes connections at a name, and IpcStream, a connection's
//! bytes both ways, between programs on one machine. libuv chooses what a name is: a named pipe,
//! \\.\pipe\<name>, on Windows, and a Unix socket, <name>.sock in the temporary folder, elsewhere.
//! A Reader and a Writer, blocking or Async, as TCP's are.

Import std.core
Import std.ffi
Import std.io.streams
Import std.time.duration
Import std.net.socket

/// How many connections a listener keeps that the OS has and the I/O thread hasn't taken yet,
/// unless it's told: Node's, which the OS lowers to what it allows. Past it, Windows refuses a
/// connection, and other OSes have it try again later.
Const BACKLOG = 511

/// The most bytes an IPC name has.
Const LONGEST = 64

/// A connection to an IpcListener: bytes both ways, in order, which it reads and writes as std.io's
/// streams do. A Read or Write that fails throws an IOError whose Cause is a NetError or a
/// TimeoutError. It closes when it goes, or at Close, which the other side reads as its end. A
/// named pipe can't end one way only, so it has no ShutdownWrite, as a TcpStream has.
Public Class IpcStream Implements Reader, Writer
    ReadOnly Field Socket: StreamSocket

    New(socket: StreamSocket)
        Socket = socket
    End New

    /// Connects to the IpcListener of `name`, waiting up to `timeout`, or as long as it takes for
    /// a Null one. Throws a NetError of REFUSED when nothing listens at it, and a TimeoutError when
    /// it takes too long. A name that isn't one panics.
    @PanicsAtCaller
    Public Static Method Connect(
            name: String, timeout: Duration? = Null): IpcStream Throws NetError, TimeoutError
        CheckName(name)
        Local socket = StreamSocket(SocketKind.IPC, "IpcStream", name)
        Local code = fb_io_net_connect_pipe(socket.Handle, name, NanosecondsOf(timeout))
        If code != 0 Then Try ThrowSocketError(code, "connecting to {name}", name)
        Return IpcStream(socket)
    End Method

    /// Connect's Async twin, which waits on the main thread.
    @PanicsAtCaller
    Public Static Async Method ConnectAsync(
            name: String, timeout: Duration? = Null): IpcStream Throws NetError, TimeoutError
        CheckName(name)
        Local socket = StreamSocket(SocketKind.IPC, "IpcStream", name)
        Local code = Await fb_io_net_connect_pipe_async(socket.Handle, name,
                                                        NanosecondsOf(timeout))
        If code != 0 Then Try ThrowSocketError(code, "connecting to {name}", name)
        Return IpcStream(socket)
    End Method

    /// The name of the listener it's connected to, or that it came to.
    Public Property Name: String
        Get => Socket.Peer
    End Property

    /// How long a Read or ReadAsync waits for bytes before it throws, or Null, as it starts, to
    /// wait as long as it takes.
    Public Property ReadTimeout: Duration?
        Get => Socket.ReadTimeout
        Set(value)
            Socket.ReadTimeout = value
        End Set
    End Property

    /// Whether Close closed it.
    Public Property IsClosed: Bool
        Get => Socket.Closed
    End Property

    /// Reads what's come, at least a byte, waiting for some, or 0 once the other side ended what
    /// it writes.
    Public Method Read(into: Buffer<UInt8>): Int64 Throws IOError => Try Socket.Read(into)

    /// Read's Async twin, which waits on the I/O thread for the connection's bytes while the main
    /// thread goes on.
    Public Async Method ReadAsync(into: Buffer<UInt8>): Int64 Throws IOError
        Return Try Await Socket.ReadAsync(into)
    End Method

    /// Writes all of from's bytes, returning once the OS has them.
    Public Method Write(from: Buffer<UInt8>) Throws IOError
        Try Socket.Write(from)
    End Method

    /// Write's Async twin, which waits on the I/O thread while the connection's bytes go, while the
    /// main thread goes on.
    Public Async Method WriteAsync(from: Buffer<UInt8>) Throws IOError
        Try Await Socket.WriteAsync(from)
    End Method

    /// Closes it at once: a Read or Write waiting for it throws an IOError whose Cause is a
    /// NetError of CLOSED, and so does one after. Going closes it too.
    Public Method Close()
        Socket.Close()
    End Method
End Class

/// Takes connections at a name, from programs on the same machine, which Accept gives as
/// IpcStreams. It closes when it goes, or at Close, with the connections nothing accepted, and
/// its name is free again, but on Windows, where a named pipe is there until its connections
/// close too, both ends: a connection to it meanwhile waits, for up to 30 seconds.
///
/// # Examples
///
/// ```fb no_run
/// Local listener = Try IpcListener.Listen("example-app")
/// Local client = Try listener.Accept()
/// Try client.WriteText("hello from the server")
/// client.Close()
/// ```
Public Class IpcListener
    ReadOnly Field Socket: ListenerSocket

    New(socket: ListenerSocket)
        Socket = socket
    End New

    /// Listens at `name`: 1 to 64 ASCII letters, digits, '.', '-', and '_', or it panics, with a
    /// `backlog` of 1 at least. A name is the same whatever its letters' case, as Windows' named
    /// pipes are, so "Game" and "game" are one name on every OS. Throws a NetError when something
    /// listens at it already. A Unix socket's file that a program left when it ended without
    /// closing its listener is taken over, and any other file there stays.
    @PanicsAtCaller
    Public Static Method Listen(name: String, backlog: Int = BACKLOG): IpcListener Throws NetError
        CheckName(name)
        CheckBacklog(backlog)
        Local socket = ListenerSocket(SocketKind.IPC_LISTENER, "IpcListener", name)
        Local code = fb_io_net_listen_pipe(socket.Handle, name, backlog)
        If code != 0 Then Throw NetErrorOf(code, "listening at {name}", name)
        Return IpcListener(socket)
    End Method

    /// Where it listens.
    Public Property Name: String
        Get => Socket.Address
    End Property

    /// Whether Close closed it.
    Public Property IsClosed: Bool
        Get => Socket.Closed
    End Property

    /// The next connection, waiting up to `timeout` for one, or as long as it takes for a Null
    /// one, and throwing a TimeoutError after.
    Public Method Accept(timeout: Duration? = Null): IpcStream Throws NetError, TimeoutError
        Local accepted = Try Socket.Accept(timeout)
        Return IpcStream(StreamSocket(accepted, "IpcStream", Socket.Address))
    End Method

    /// Accept's Async twin, which waits on the main thread.
    Public Async Method AcceptAsync(
            timeout: Duration? = Null): IpcStream Throws NetError, TimeoutError
        Local accepted = Try Await Socket.AcceptAsync(timeout)
        Return IpcStream(StreamSocket(accepted, "IpcStream", Socket.Address))
    End Method

    /// Closes it at once, with the connections nothing accepted: what's waiting for it throws a
    /// NetError of CLOSED, and so does what uses it after. Going closes it too.
    Public Method Close()
        Socket.Close()
    End Method
End Class

/// Panics for a name that isn't an IPC name.
@PanicsAtCaller
Function CheckName(name: String)
    Local bytes = name.Bytes
    Local named = bytes.Count > 0 && bytes.Count <= LONGEST
    For byte In bytes
        named = named && (byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 ||
                          byte >= 97 && byte <= 122 || byte == 45 || byte == 46 || byte == 95)
    End For

    If !named
        Panic("an IPC name is 1 to {LONGEST} ASCII letters, digits, '.', '-', and '_', not " +
              "\"{name}\"")
    End If
End Function
