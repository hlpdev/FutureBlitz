// std.net's TCP: TcpListener, which takes connections at an address, and TcpStream, a
// connection's bytes both ways, a Reader and a Writer as std.io's streams are, each blocking or
// Async.

Import std.core
Import std.ffi
Import std.io.streams
Import std.time.duration
Import std.net.address
Import std.net.dns
Import std.net.socket

// How many connections a listener keeps that the OS has and the I/O thread hasn't taken yet,
// unless it's told: Node's, which the OS lowers to what it allows. Past it, Windows refuses a
// connection, and other OSes have it try again later.
Const BACKLOG = 511

// A TCP connection: bytes both ways, in order, which it reads and writes as std.io's streams do.
// Nagle's algorithm is off, so a small write goes at once, as a game's messages need. A Read or
// Write that fails throws an IOError whose Cause is a NetError, of RESET for a connection the
// other side ended badly, or a TimeoutError. It closes when it goes, or at Close.
Public Class TcpStream Implements Reader, Writer
    ReadOnly Field Socket: StreamSocket

    New(socket: StreamSocket)
        Socket = socket
    End New

    // Connects to `address`, waiting up to `timeout`, or as long as the OS does for a Null one.
    // Throws a NetError of REFUSED when nothing listens there, of UNREACHABLE when the network
    // can't get there, and a TimeoutError when it takes too long.
    Public Static Method Connect(
        address: SocketAddress, timeout: Duration? = Null): TcpStream Throws NetError, TimeoutError
        Local socket = StreamSocket(SocketKind.TCP, "TcpStream", address.ToString())
        Local code = fb_io_net_connect(socket.Handle, SocketBytes(address), NanosecondsOf(timeout))
        If code != 0 Then Try ThrowSocketError(code, "connecting to {address}", socket.Peer)
        Return TcpStream(socket)
    End Method

    // Connects to `host` at `port`, trying its addresses in the order Dns.Resolve gives them,
    // each for up to `timeout`, and throws what the last one did when none connects.
    Public Static Method Connect(
        host: String, port: UInt16, timeout: Duration? = Null): TcpStream Throws NetError,
                                                                           TimeoutError
        Local addresses = Try Dns.Resolve(host)
        For at = 0 Until addresses.Count
            Try
                Return Try Connect(SocketAddress(addresses[at], port), timeout)
            Catch e As NetError
                If at == addresses.Count - 1 Then Throw e
            Catch e As TimeoutError
                If at == addresses.Count - 1 Then Throw e
            End Try
        End For

        Throw NetError(NetErrorKind.HOST_NOT_FOUND, "{host} has no address", host)
    End Method

    // Connect's Async twin, which waits on the main thread.
    Public Static Async Method ConnectAsync(
        address: SocketAddress, timeout: Duration? = Null): TcpStream Throws NetError, TimeoutError
        Local socket = StreamSocket(SocketKind.TCP, "TcpStream", address.ToString())
        Local code = Await fb_io_net_connect_async(socket.Handle, SocketBytes(address),
                                                   NanosecondsOf(timeout))
        If code != 0 Then Try ThrowSocketError(code, "connecting to {address}", socket.Peer)
        Return TcpStream(socket)
    End Method

    // Connect's Async twin to a host, through Dns.ResolveAsync.
    Public Static Async Method ConnectAsync(
        host: String, port: UInt16, timeout: Duration? = Null): TcpStream Throws NetError,
                                                                           TimeoutError
        Local addresses = Try Await Dns.ResolveAsync(host)
        For at = 0 Until addresses.Count
            Try
                Return Try Await ConnectAsync(SocketAddress(addresses[at], port), timeout)
            Catch e As NetError
                If at == addresses.Count - 1 Then Throw e
            Catch e As TimeoutError
                If at == addresses.Count - 1 Then Throw e
            End Try
        End For

        Throw NetError(NetErrorKind.HOST_NOT_FOUND, "{host} has no address", host)
    End Method

    // Its own address.
    Public Property LocalAddress: SocketAddress
        Get => AddressOfSocket(Socket.Handle, False) ?? SocketAddress(IpAddress.Any, 0)
    End Property

    // The other side's address.
    Public Property RemoteAddress: SocketAddress
        Get => AddressOfSocket(Socket.Handle, True) ?? SocketAddress(IpAddress.Any, 0)
    End Property

    // How long a Read or ReadAsync waits for bytes before it throws, or Null, as it starts, to
    // wait as long as it takes.
    Public Property ReadTimeout: Duration?
        Get => Socket.ReadTimeout
        Set(value)
            Socket.ReadTimeout = value
        End Set
    End Property

    // Whether Close closed it.
    Public Property IsClosed: Bool
        Get => Socket.Closed
    End Property

    // Reads what's come, at least a byte, waiting for some, or 0 once the other side ended what
    // it writes.
    Public Method Read(into: Buffer<UInt8>): Int64 Throws IOError => Try Socket.Read(into)

    Public Async Method ReadAsync(into: Buffer<UInt8>): Int64 Throws IOError
        Return Try Await Socket.ReadAsync(into)
    End Method

    // Writes all of from's bytes, returning once the OS has them.
    Public Method Write(from: Buffer<UInt8>) Throws IOError
        Try Socket.Write(from)
    End Method

    Public Async Method WriteAsync(from: Buffer<UInt8>) Throws IOError
        Try Await Socket.WriteAsync(from)
    End Method

    // Ends what it writes, once what's written is sent, so the other side reads its end; it
    // still reads what the other side writes.
    Public Method ShutdownWrite() Throws IOError
        Try Socket.ShutdownWrite()
    End Method

    Public Async Method ShutdownWriteAsync() Throws IOError
        Try Await Socket.ShutdownWriteAsync()
    End Method

    // Closes it at once: what's waiting for it throws a NetError of CLOSED, and so does what uses
    // it after. Going closes it too.
    Public Method Close()
        Socket.Close()
    End Method
End Class

// Takes TCP connections at an address, which Accept gives as TcpStreams. It closes when it
// goes, or at Close, with the connections it has that nothing accepted.
Public Class TcpListener
    ReadOnly Field Socket: ListenerSocket

    New(socket: ListenerSocket)
        Socket = socket
    End New

    // Listens at `address`, whose port 0 has the OS pick one, which LocalAddress tells, keeping
    // up to `backlog` connections the OS has that aren't taken yet, 1 at least, or it panics.
    // Throws a NetError when it can't, as when something listens there already.
    @PanicsAtCaller
    Public Static Method Listen(address: SocketAddress,
                                backlog: Int = BACKLOG): TcpListener Throws NetError
        CheckBacklog(backlog)
        Local socket = ListenerSocket(SocketKind.TCP_LISTENER, "TcpListener", address.ToString())
        Local code = fb_io_net_listen(socket.Handle, SocketBytes(address), backlog)
        If code != 0 Then Throw NetErrorOf(code, "listening at {address}", socket.Address)
        Local listener = TcpListener(socket)
        socket.Address = listener.LocalAddress.ToString()
        Return listener
    End Method

    // Listens at `host`'s first address, as Dns.Resolve gives them, and `port`.
    @PanicsAtCaller
    Public Static Method Listen(host: String, port: UInt16,
                                backlog: Int = BACKLOG): TcpListener Throws NetError
        Local addresses = Try Dns.Resolve(host)
        Return Try Listen(SocketAddress(addresses[0], port), backlog)
    End Method

    // Where it listens, the port the OS picked included.
    Public Property LocalAddress: SocketAddress
        Get => AddressOfSocket(Socket.Handle, False) ?? SocketAddress(IpAddress.Any, 0)
    End Property

    // Whether Close closed it.
    Public Property IsClosed: Bool
        Get => Socket.Closed
    End Property

    // The next connection, waiting up to `timeout` for one, or as long as it takes for a Null
    // one, and throwing a TimeoutError after.
    Public Method Accept(timeout: Duration? = Null): TcpStream Throws NetError, TimeoutError
        Local accepted = Try Socket.Accept(timeout)
        Return TcpStream(StreamSocket(accepted, "TcpStream", PeerOf(accepted)))
    End Method

    // Accept's Async twin, which waits on the main thread.
    Public Async Method AcceptAsync(
        timeout: Duration? = Null): TcpStream Throws NetError, TimeoutError
        Local accepted = Try Await Socket.AcceptAsync(timeout)
        Return TcpStream(StreamSocket(accepted, "TcpStream", PeerOf(accepted)))
    End Method

    // Closes it at once, with the connections nothing accepted: what's waiting for it throws a
    // NetError of CLOSED, and so does what uses it after. Going closes it too.
    Public Method Close()
        Socket.Close()
    End Method
End Class

// The text of an accepted connection's other side.
Function PeerOf(accepted: Ptr<Void>): String
    Local address = AddressOfSocket(accepted, True)
    Return address == Null ? "a TCP connection" : address.ToString()
End Function
