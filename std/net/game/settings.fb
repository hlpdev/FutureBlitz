//! std.net.game's settings, which a GameHost and its peers share, and why a connection ends.

Import std.core
Import std.time.duration
Import std.net.game.channel

/// Why a connection ended.
Public Enum DisconnectReason
    /// It hasn't: an event other than a disconnect's.
    NONE
    /// This side ended it.
    LOCAL
    /// The other side ended it.
    REMOTE
    /// Nothing came for the host's Timeout.
    TIMEOUT
    /// The other host refused it, as full.
    FULL
    /// The other host refused it, with settings that don't match this one's.
    MISMATCH
End Enum

/// What a GameHost does: its channels' kinds, which both sides of a connection must have alike,
/// the most peers that can connect to it, the most bytes a packet takes, the largest message,
/// which both sides must have alike too, the most bytes a connection holds of messages waiting
/// for one before them and of fragments, how long it waits to hear from a peer, how often it sends
/// when it has nothing to, and how often it asks again for a connection.
Public Struct GameSettings
    /// Its channels' kinds, which both sides of a connection must have alike.
    Public Field Channels: ChannelKind[]
    /// The most peers that can connect to it.
    Public Field MaxPeers: Int
    /// The most bytes a packet takes.
    Public Field Mtu: Int
    /// The largest message, in bytes, which both sides must have alike.
    Public Field MaxMessageSize: Int
    /// The most bytes a connection holds of messages waiting for one before them, and of fragments.
    Public Field MaxBuffered: Int
    /// How long it waits to hear from a peer before it disconnects it.
    Public Field Timeout: Duration
    /// How often it sends when it has nothing to, so its peers hear from it.
    Public Field KeepAlive: Duration
    /// How often it asks again for a connection that hasn't answered.
    Public Field ConnectRetry: Duration

    /// Channels of those kinds, or else a reliable-ordered, a reliable-unordered, and an
    /// unreliable one; 32 peers; packets of 1200 bytes, which any path takes; messages of up to
    /// 1 MiB, with 4 MiB held; and a timeout of 10 seconds, with a keepalive and a retry each 250
    /// milliseconds.
    Public New(channels: ChannelKind[]? = Null)
        Channels = channels ?? [ChannelKind.RELIABLE_ORDERED, ChannelKind.RELIABLE_UNORDERED,
                                ChannelKind.UNRELIABLE]
        MaxPeers = 32
        Mtu = 1200
        MaxMessageSize = 1048576
        MaxBuffered = 4194304
        Timeout = Duration.FromNanoseconds(10000000000)
        KeepAlive = Duration.FromNanoseconds(250000000)
        ConnectRetry = Duration.FromNanoseconds(250000000)
    End New
End Struct

/// Panics, at the GameHost's caller, unless settings make sense.
@PanicsAtCaller
Package Function Check(settings: GameSettings)
    If settings.Channels.Count < 1 || settings.Channels.Count > 255
        Panic("a GameHost takes from 1 to 255 channels, not {settings.Channels.Count}")
    End If

    If settings.MaxPeers < 1
        Panic("a GameHost's MaxPeers must be above 0, not {settings.MaxPeers}")
    End If

    If settings.Mtu < 128 || settings.Mtu > 65507
        Panic("a GameHost's Mtu must be from 128 to 65507 bytes, not {settings.Mtu}")
    End If

    // A CONNECT takes 15 bytes and one for each channel, which a packet must hold too.
    If settings.Mtu < 15 + settings.Channels.Count
        Panic("a GameHost's Mtu of {settings.Mtu} bytes can't hold a CONNECT for " +
              "{settings.Channels.Count} channels, which takes {15 + settings.Channels.Count}")
    End If

    // A message's fragments are counted in 16 bits, so 65535 is the most.
    Local partSize = (settings.Mtu - 27) As Int64
    If settings.MaxMessageSize < 1 || (settings.MaxMessageSize As Int64) > 65535 * partSize
        Panic("a GameHost's MaxMessageSize must be from 1 to 65535 packets' worth, not " +
              "{settings.MaxMessageSize}")
    End If

    If settings.MaxBuffered < 0 Then Panic("a GameHost's MaxBuffered can't be negative")
    If settings.Timeout.Nanoseconds <= 0 || settings.KeepAlive.Nanoseconds <= 0 ||
       settings.ConnectRetry.Nanoseconds <= 0
        Panic("a GameHost's Timeout, KeepAlive, and ConnectRetry must be above 0")
    End If

    // Each must come before the Timeout, or a quiet connection, or a handshake, never would.
    If settings.KeepAlive.Nanoseconds >= settings.Timeout.Nanoseconds ||
       settings.ConnectRetry.Nanoseconds >= settings.Timeout.Nanoseconds
        Panic("a GameHost's KeepAlive, {settings.KeepAlive}, and ConnectRetry, " +
              "{settings.ConnectRetry}, must be under its Timeout, {settings.Timeout}")
    End If
End Function

/// Panics, at the caller, for a channel settings don't have, or a message past their
/// MaxMessageSize.
@PanicsAtCaller
Package Function CheckMessage(settings: GameSettings, channel: Int, bytes: UInt8[])
    If channel < 0 || channel >= settings.Channels.Count
        Panic("a host of {settings.Channels.Count} channels has no channel {channel}")
    End If

    If bytes.Count > settings.MaxMessageSize
        Panic("a message of {bytes.Count} bytes is past the host's MaxMessageSize, " +
              "{settings.MaxMessageSize}")
    End If
End Function
