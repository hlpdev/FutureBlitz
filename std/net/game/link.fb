//! What a GameHost sends its packets over, and receives them from.
//!
//! A UdpSocket is one, through GameHost.Bind, and so is any Class that implements GameLink, as a
//! test's link that loses packets on purpose does.

Import std.core
Import std.time.duration
Import std.net.address
Import std.net.udp

/// What a GameHost's datagrams go over, as UDP's do: each one whole or not at all, maybe more than
/// once, in no promised order.
///
/// # Examples
///
/// ```
/// # Import std.net
/// # Import std.time
/// // A link that loses every packet, as a test of what a host does then can have.
/// Class Nowhere Implements GameLink
///     Public Property LocalAddress: SocketAddress
///         Get => SocketAddress(IpAddress.Loopback, 9)
///     End Property
///
///     Public Method Send(bytes: UInt8[], to: SocketAddress) Throws NetError
///     End Method
///
///     Public Method Receive(timeout: Duration): (UInt8[], SocketAddress)? Throws NetError => Null
///
///     Public Method Close()
///     End Method
/// End Class
///
/// Local host = GameHost(Nowhere(), GameSettings())
/// Local peer = host.Connect(SocketAddress(IpAddress.Loopback, 7777))
/// Expect(peer.State == PeerState.CONNECTING)
/// host.Close()
/// ```
Public Interface GameLink
    /// Where it receives, as the other side sends to it.
    ReadOnly Property LocalAddress: SocketAddress

    /// Sends `bytes` to `to` as one datagram.
    Method Send(bytes: UInt8[], to: SocketAddress) Throws NetError

    /// The next datagram that's come, and where from, waiting for `timeout` at most, or Null when
    /// none came by then. A timeout of 0 takes what's come without waiting.
    Method Receive(timeout: Duration): (UInt8[], SocketAddress)? Throws NetError

    /// Receive's Async twin, which waits on the main thread.
    Async Method ReceiveAsync(timeout: Duration): (UInt8[], SocketAddress)? Throws NetError
        Return Try Receive(timeout)
    End Method

    /// Closes it, if it holds anything to close.
    Method Close()
    End Method
End Interface

/// A UdpSocket as a GameLink.
Package Class UdpLink Implements GameLink
    Field Socket: UdpSocket

    Package New(socket: UdpSocket)
        Self.Socket = socket
    End New

    Property LocalAddress: SocketAddress
        Get => Socket.LocalAddress
    End Property

    Method Send(bytes: UInt8[], to: SocketAddress) Throws NetError
        Try Socket.Send(bytes, to)
    End Method

    Method Receive(timeout: Duration): (UInt8[], SocketAddress)? Throws NetError
        Try
            Local datagram = Socket.Receive(timeout)
            Return (datagram.Bytes, datagram.From)
        Catch late As TimeoutError
            Return Null
        End Try
    End Method

    Async Method ReceiveAsync(timeout: Duration): (UInt8[], SocketAddress)? Throws NetError
        Try
            Local datagram = Await Socket.ReceiveAsync(timeout)
            Return (datagram.Bytes, datagram.From)
        Catch late As TimeoutError
            Return Null
        End Try
    End Method

    Method Close()
        Socket.Close()
    End Method
End Class
