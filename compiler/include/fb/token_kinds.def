// Every token kind, as an X-macro list. Define the macros you need, then include this file.
// FB_PUNCTUATION and FB_KEYWORD fall back to FB_TOKEN; anything left undefined expands to
// nothing. Keywords must stay sorted: keyword_kind() binary-searches them.

#ifndef FB_TOKEN
#define FB_TOKEN(name, description)
#endif
#ifndef FB_PUNCTUATION
#define FB_PUNCTUATION(name, spelling) FB_TOKEN(name, "'" spelling "'")
#endif
#ifndef FB_KEYWORD
#define FB_KEYWORD(name, spelling) FB_TOKEN(name, "'" spelling "'")
#endif

// Always the last token, and the only one with an empty span.
FB_TOKEN(END_OF_FILE, "end of file")
// Ends a line that has tokens. Blank and comment-only lines get none.
FB_TOKEN(NEWLINE, "newline")
// A character that starts no token. The lexer already reported it.
FB_TOKEN(INVALID, "invalid token")
FB_TOKEN(IDENTIFIER, "identifier")
FB_TOKEN(INTEGER, "integer literal")
// Has a '.' or an exponent: "1.5", "1e9".
FB_TOKEN(DECIMAL, "decimal literal")
FB_TOKEN(CHARACTER, "character literal")
// A whole string without interpolation, quotes and any 'r' prefix included.
FB_TOKEN(STRING, "string literal")
// An interpolated string is split around its expressions: the start runs from the opening
// quote through the first '{', each middle from a '}' through the next '{', and the end from the
// last '}' through the closing quote.
FB_TOKEN(STRING_START, "start of an interpolated string")
FB_TOKEN(STRING_MIDDLE, "middle of an interpolated string")
FB_TOKEN(STRING_END, "end of an interpolated string")
// An interpolation's format spec: from its ':' up to the '}' that ends the interpolation, as in
// "{price:.2}".
FB_TOKEN(FORMAT_SPEC, "format spec")

FB_PUNCTUATION(LEFT_PAREN, "(")
FB_PUNCTUATION(RIGHT_PAREN, ")")
FB_PUNCTUATION(LEFT_BRACKET, "[")
FB_PUNCTUATION(RIGHT_BRACKET, "]")
FB_PUNCTUATION(LEFT_BRACE, "{")
FB_PUNCTUATION(RIGHT_BRACE, "}")
FB_PUNCTUATION(COMMA, ",")
FB_PUNCTUATION(DOT, ".")
FB_PUNCTUATION(DOT_DOT, "..")
FB_PUNCTUATION(DOT_DOT_DOT, "...")
FB_PUNCTUATION(COLON, ":")
FB_PUNCTUATION(QUESTION, "?")
FB_PUNCTUATION(QUESTION_DOT, "?.")
FB_PUNCTUATION(QUESTION_QUESTION, "??")
FB_PUNCTUATION(AT, "@")
FB_PUNCTUATION(ARROW, "=>")
FB_PUNCTUATION(PLUS, "+")
FB_PUNCTUATION(MINUS, "-")
FB_PUNCTUATION(STAR, "*")
FB_PUNCTUATION(STAR_STAR, "**")
FB_PUNCTUATION(SLASH, "/")
FB_PUNCTUATION(PERCENT, "%")
FB_PUNCTUATION(AMP, "&")
FB_PUNCTUATION(PIPE, "|")
FB_PUNCTUATION(CARET, "^")
FB_PUNCTUATION(TILDE, "~")
FB_PUNCTUATION(LESS_LESS, "<<")
FB_PUNCTUATION(AMP_AMP, "&&")
FB_PUNCTUATION(PIPE_PIPE, "||")
FB_PUNCTUATION(BANG, "!")
FB_PUNCTUATION(EQUAL, "=")
FB_PUNCTUATION(EQUAL_EQUAL, "==")
FB_PUNCTUATION(BANG_EQUAL, "!=")
FB_PUNCTUATION(LESS, "<")
FB_PUNCTUATION(LESS_EQUAL, "<=")
// There's no ">>" or ">>=": the parser joins a '>' with a '>' or ">=" that touches it.
FB_PUNCTUATION(GREATER, ">")
FB_PUNCTUATION(GREATER_EQUAL, ">=")
FB_PUNCTUATION(PLUS_EQUAL, "+=")
FB_PUNCTUATION(MINUS_EQUAL, "-=")
FB_PUNCTUATION(STAR_EQUAL, "*=")
FB_PUNCTUATION(SLASH_EQUAL, "/=")
FB_PUNCTUATION(PERCENT_EQUAL, "%=")
FB_PUNCTUATION(AMP_EQUAL, "&=")
FB_PUNCTUATION(PIPE_EQUAL, "|=")
FB_PUNCTUATION(CARET_EQUAL, "^=")
FB_PUNCTUATION(LESS_LESS_EQUAL, "<<=")
FB_PUNCTUATION(PLUS_PLUS, "++")
FB_PUNCTUATION(MINUS_MINUS, "--")

FB_KEYWORD(KW_ABSTRACT, "Abstract")
FB_KEYWORD(KW_ALIAS, "Alias")
FB_KEYWORD(KW_AS, "As")
FB_KEYWORD(KW_ASYNC, "Async")
FB_KEYWORD(KW_AWAIT, "Await")
FB_KEYWORD(KW_BREAK, "Break")
FB_KEYWORD(KW_BYREF, "ByRef")
FB_KEYWORD(KW_CALLBACK, "Callback")
FB_KEYWORD(KW_CASE, "Case")
FB_KEYWORD(KW_CATCH, "Catch")
FB_KEYWORD(KW_CLASS, "Class")
FB_KEYWORD(KW_CONST, "Const")
FB_KEYWORD(KW_CONTINUE, "Continue")
FB_KEYWORD(KW_DEFAULT, "Default")
FB_KEYWORD(KW_DEFER, "Defer")
FB_KEYWORD(KW_ELSE, "Else")
FB_KEYWORD(KW_ELSEIF, "ElseIf")
FB_KEYWORD(KW_END, "End")
FB_KEYWORD(KW_ENUM, "Enum")
FB_KEYWORD(KW_EXTEND, "Extend")
FB_KEYWORD(KW_EXTENDS, "Extends")
FB_KEYWORD(KW_EXTERN, "Extern")
FB_KEYWORD(KW_FALSE, "False")
FB_KEYWORD(KW_FIELD, "Field")
FB_KEYWORD(KW_FINAL, "Final")
FB_KEYWORD(KW_FINALLY, "Finally")
FB_KEYWORD(KW_FOR, "For")
FB_KEYWORD(KW_FUNC, "Func")
FB_KEYWORD(KW_FUNCTION, "Function")
FB_KEYWORD(KW_GLOBAL, "Global")
FB_KEYWORD(KW_IF, "If")
FB_KEYWORD(KW_IMPLEMENTS, "Implements")
FB_KEYWORD(KW_IMPORT, "Import")
FB_KEYWORD(KW_IN, "In")
FB_KEYWORD(KW_INTERFACE, "Interface")
FB_KEYWORD(KW_IS, "Is")
FB_KEYWORD(KW_LOCAL, "Local")
FB_KEYWORD(KW_LOCK, "Lock")
FB_KEYWORD(KW_LOOP, "Loop")
FB_KEYWORD(KW_METHOD, "Method")
FB_KEYWORD(KW_NEW, "New")
FB_KEYWORD(KW_NULL, "Null")
FB_KEYWORD(KW_OPERATOR, "Operator")
FB_KEYWORD(KW_OVERRIDE, "Override")
FB_KEYWORD(KW_PACKAGE, "Package")
FB_KEYWORD(KW_PARALLEL, "Parallel")
FB_KEYWORD(KW_PRIVATE, "Private")
FB_KEYWORD(KW_PROPERTY, "Property")
FB_KEYWORD(KW_PROTECTED, "Protected")
FB_KEYWORD(KW_PUBLIC, "Public")
FB_KEYWORD(KW_READONLY, "ReadOnly")
FB_KEYWORD(KW_REPEAT, "Repeat")
FB_KEYWORD(KW_RETURN, "Return")
FB_KEYWORD(KW_SELECT, "Select")
FB_KEYWORD(KW_SELF, "Self")
FB_KEYWORD(KW_SHARED, "Shared")
FB_KEYWORD(KW_STATIC, "Static")
FB_KEYWORD(KW_STRUCT, "Struct")
FB_KEYWORD(KW_SUPER, "Super")
FB_KEYWORD(KW_THEN, "Then")
FB_KEYWORD(KW_THREADLOCAL, "ThreadLocal")
FB_KEYWORD(KW_THROW, "Throw")
FB_KEYWORD(KW_THROWS, "Throws")
FB_KEYWORD(KW_TO, "To")
FB_KEYWORD(KW_TRUE, "True")
FB_KEYWORD(KW_TRY, "Try")
FB_KEYWORD(KW_UNSAFE, "Unsafe")
FB_KEYWORD(KW_UNTIL, "Until")
FB_KEYWORD(KW_WHERE, "Where")
FB_KEYWORD(KW_WHILE, "While")

#undef FB_TOKEN
#undef FB_PUNCTUATION
#undef FB_KEYWORD
