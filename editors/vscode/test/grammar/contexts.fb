Struct Quantity<Const L: Int>
    Operator *<Const L2: Int>(a: Quantity<L>, b: Quantity<L2>): Quantity<L + L2>
//            ^ meta.type.parameters.futureblitz punctuation.definition.typeparameters.begin.futureblitz
//                   ^^ meta.type.parameters.futureblitz entity.name.type.futureblitz
//                       ^^^ meta.type.parameters.futureblitz storage.type.primitive.futureblitz
//                                            ^ variable.parameter.futureblitz
End Struct

Local money = Money(cents: a.cents + b.cents)
//                       ^ punctuation.separator.key-value.futureblitz - keyword.operator.ternary
Local counts = {"apple": 3, "pear": 4}
//                     ^ punctuation.separator.key-value.futureblitz
Local sign = x < 0 ? -1 : (x == 0 ? Pick(at: 0) : 1)
//                 ^ keyword.operator.ternary.futureblitz
//                      ^ keyword.operator.ternary.futureblitz
//                                         ^ punctuation.separator.key-value.futureblitz
//                                              ^ keyword.operator.ternary.futureblitz
Local wide = Choose(ready ? first
                          : second)
